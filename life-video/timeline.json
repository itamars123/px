  "captions": [
    { "start": 2.2,   "end": 7.8,   "text": "בהתחלה — היה רק שקט" },
    { "start": 12.0,  "end": 17.6,  "text": "ואז — אור" },
    { "start": 21.5,  "end": 27.6,  "text": "מתוך האבק, נולד עולם" },
    { "start": 31.0,  "end": 37.6,  "text": "החיים מתחילים בקטן. בקטן מאוד." },
    { "start": 42.0,  "end": 48.6,  "text": "ולאט לאט — צומחים" },
    { "start": 52.4,  "end": 57.0,  "text": "לב ראשון פועם" },
    { "start": 60.0,  "end": 66.6,  "text": "ילדות. הכול חדש, הכול אפשרי" },
    { "start": 70.0,  "end": 76.6,  "text": "נעורים. לרוץ, לחלום, להעז" },
    { "start": 80.0,  "end": 86.6,  "text": "ואז מישהו מגיע — והעולם משתנה" },
    { "start": 90.0,  "end": 96.6,  "text": "יש סערות. יש נפילות." },
    { "start": 100.4, "end": 106.6, "text": "אבל תמיד — קמים שוב" },
    { "start": 110.0, "end": 118.4, "text": "הזמן עובר. העונות מתחלפות." },
    { "start": 122.0, "end": 128.6, "text": "ומה שנשאר — הוא האור שהשארנו באחרים" },
    { "start": 132.0, "end": 138.6, "text": "וכל סוף — הוא התחלה חדשה" }
  ],
