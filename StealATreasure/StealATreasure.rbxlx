<Item class="ReplicatedStorage" referent="RBX0000000E"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX0000000D"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">AchievementData</string><ProtectedString name="Source"><![CDATA[-- AchievementData.lua
-- Achievements: a stat, a goal and a gem reward. Checked on the server.

local AchievementData = {}

-- Stat keys: Collected, Steals, Defends, Trades, Hatched, Earned, Rebirths,
-- Level, Discovered, Secrets, Celestial, ChestsOpened, EventsJoined
AchievementData.List = {
	{ Id = "first_find", Name = "First Find", Icon = "✨", Stat = "Collected", Goal = 1, Gems = 10 },
	{ Id = "collector", Name = "Collector", Icon = "🎒", Stat = "Collected", Goal = 25, Gems = 25 },
	{ Id = "hoarder", Name = "Hoarder", Icon = "🏰", Stat = "Collected", Goal = 150, Gems = 75 },
	{ Id = "dragon_hoard", Name = "Dragon's Hoard", Icon = "🐉", Stat = "Collected", Goal = 600, Gems = 200 },
	{ Id = "first_heist", Name = "First Heist", Icon = "🦹", Stat = "Steals", Goal = 1, Gems = 15 },
	{ Id = "master_thief", Name = "Master Thief", Icon = "🎭", Stat = "Steals", Goal = 15, Gems = 60 },
	{ Id = "legendary_thief", Name = "Legendary Thief", Icon = "💎", Stat = "Steals", Goal = 75, Gems = 200 },
	{ Id = "guardian", Name = "Guardian", Icon = "🛡️", Stat = "Defends", Goal = 3, Gems = 25 },
	{ Id = "fortress", Name = "Fortress", Icon = "🏯", Stat = "Defends", Goal = 25, Gems = 100 },
	{ Id = "trader", Name = "Trader", Icon = "🤝", Stat = "Trades", Goal = 1, Gems = 20 },
	{ Id = "merchant", Name = "Merchant", Icon = "💼", Stat = "Trades", Goal = 20, Gems = 80 },
	{ Id = "hatcher", Name = "Egg Hatcher", Icon = "🥚", Stat = "Hatched", Goal = 1, Gems = 10 },
	{ Id = "pet_lover", Name = "Pet Lover", Icon = "🐾", Stat = "Hatched", Goal = 30, Gems = 80 },
	{ Id = "rich", Name = "Getting Rich", Icon = "💵", Stat = "Earned", Goal = 10000, Gems = 15 },
	{ Id = "millionaire", Name = "Millionaire", Icon = "💰", Stat = "Earned", Goal = 1e6, Gems = 50 },
	{ Id = "billionaire", Name = "Billionaire", Icon = "🤑", Stat = "Earned", Goal = 1e9, Gems = 200 },
	{ Id = "reborn", Name = "Reborn", Icon = "🌀", Stat = "Rebirths", Goal = 1, Gems = 50 },
	{ Id = "eternal", Name = "Eternal", Icon = "♾️", Stat = "Rebirths", Goal = 10, Gems = 300 },
	{ Id = "level10", Name = "Rising Star", Icon = "⭐", Stat = "Level", Goal = 10, Gems = 25 },
	{ Id = "level30", Name = "Superstar", Icon = "🌟", Stat = "Level", Goal = 30, Gems = 100 },
	{ Id = "index25", Name = "Curator", Icon = "📖", Stat = "Discovered", Goal = 25, Gems = 30 },
	{ Id = "index75", Name = "Historian", Icon = "📚", Stat = "Discovered", Goal = 75, Gems = 150 },
	{ Id = "explorer", Name = "Explorer", Icon = "🗺️", Stat = "Secrets", Goal = 3, Gems = 75 },
	{ Id = "celestial", Name = "Touched the Stars", Icon = "🌌", Stat = "Celestial", Goal = 1, Gems = 250 },
	{ Id = "chest_opener", Name = "Chest Cracker", Icon = "🧰", Stat = "ChestsOpened", Goal = 10, Gems = 40 },
}

AchievementData.ById = {}
for i, a in ipairs(AchievementData.List) do
	a.Order = i
	AchievementData.ById[a.Id] = a
end

return AchievementData
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Config.lua
-- Central tuning values for STEAL A TREASURE. Everything gameplay-related that a
-- designer might want to tweak lives here so the services stay logic-only.

local Config = {}

Config.GameName = "STEAL A TREASURE"
Config.DataVersion = 3
Config.DataStoreName = "StealATreasure_PlayerData_v3"
Config.LeaderboardStoreName = "StealATreasure_Richest_v3"
Config.RebirthBoardStoreName = "StealATreasure_Rebirths_v3"

-- Economy ------------------------------------------------------------------
Config.StartingMoney = 150
Config.IncomeTickSeconds = 1
Config.SellMultiplier = 0.5 -- treasures sell for 50% of their value
Config.OfflineIncomeRate = 0.1 -- 10% of MPS while offline
Config.OfflineIncomeMaxSeconds = 8 * 3600
Config.AutosaveSeconds = 90
Config.DiscoveryBonusMultiplier = 3 -- first time you own a treasure: +3x its MPS*10

-- Levels -------------------------------------------------------------------
Config.XP = {
	Collect = 10,
	Buy = 15,
	Steal = 40,
	Defend = 25,
	Sell = 3,
}
function Config.XPForLevel(level: number): number
	return math.floor(100 * level ^ 1.45)
end

-- Base ---------------------------------------------------------------------
Config.MaxBases = 8
Config.BaseRingRadius = 230
Config.BaseSize = 72
Config.BaseWallHeight = 22
Config.PlotColumns = 6
Config.PlotRows = 4
Config.PlotSpacing = 9
Config.StartingPlots = 6
Config.PlotsPerBaseLevel = 2
Config.MaxBaseLevel = 10
Config.MaxStorage = 60 -- inventory (unplaced) capacity
Config.SecondFloorPlots = 12
Config.SecondFloorHeight = 13

-- Stealing / protection -----------------------------------------------------
Config.Steal = {
	BaseHoldDuration = 1.6,
	HoldPerProtectionLevel = 0.25,
	ThiefCooldown = 25, -- seconds between successful steals
	SameVictimCooldown = 75, -- seconds before you can steal from the same player again
	VictimAutoLock = 20, -- base locks for this long after being robbed (+ protection)
	VictimAutoLockPerLevel = 4,
	NewPlayerShield = 90, -- new arrivals can't be robbed for this long
	CarryTimeout = 120, -- stolen treasure returns home if not delivered in time
	MaxPromptDistance = 12,
	BonkRange = 9,
	BonkCooldown = 1.2,
	BonkStun = 1.2,
}

Config.Lock = {
	BaseDuration = 30,
	DurationPerLevel = 8,
	BaseCooldown = 60,
	CooldownReductionPerLevel = 3,
}

-- World spawns -------------------------------------------------------------
Config.Spawns = {
	FieldInterval = 6, -- seconds between field spawn attempts
	MaxPerField = 4,
	SecretInterval = 25,
	MaxPerSecret = 2,
	Lifetime = 150,
	PickupDistance = 12,
}

-- Layout: bases line both sides of the Treasure Parade; the plaza sits at
-- the parade's start.
Config.PlazaCenter = Vector3.new(-340, 0, 0)
Config.BaseRowZ = 80 -- base centres at z = +/-80, facing the parade
Config.BaseColumnsX = { -168, -56, 56, 168 }
Config.Parade = {
	StartX = -248,
	EndX = 248,
	Z = 0,
	Width = 14,
	Speed = 7, -- studs per second
	Interval = 2.6, -- seconds between treasures
}

Config.Market = {
	Stalls = 0, -- the walking Treasure Parade replaced the old stalls
	RestockSeconds = 45,
	PriceMultiplier = 1.0,
}

-- Rarity weights used by the different spawn pools.
Config.SpawnPools = {
	Field = { Common = 60, Uncommon = 26, Rare = 10, Epic = 3.2, Legendary = 0.7, Mythical = 0.1 },
	Market = { Common = 30, Uncommon = 30, Rare = 22, Epic = 11, Legendary = 5, Mythical = 1.6, Secret = 0.35, Divine = 0.05, Celestial = 0.01 },
	Secret = { Rare = 40, Epic = 32, Legendary = 18, Mythical = 7, Secret = 2.5, Divine = 0.5, Celestial = 0.08 },
	Meteor = { Epic = 55, Legendary = 30, Mythical = 12, Secret = 2.6, Divine = 0.4, Celestial = 0.05 },
	Divine = { Mythical = 55, Secret = 30, Divine = 12, Celestial = 3 },
	Apocalypse = { Epic = 40, Legendary = 35, Mythical = 18, Secret = 5, Divine = 1.6, Celestial = 0.4 },
	SecretSpawn = { Secret = 75, Divine = 20, Celestial = 5 },
	Lucky = { Rare = 30, Epic = 35, Legendary = 22, Mythical = 9, Secret = 3, Divine = 0.8, Celestial = 0.2 },
}

-- Events -------------------------------------------------------------------
Config.Events = {
	IntervalMin = 240,
	IntervalMax = 360,
	GoldenHourDuration = 120,
	GoldenHourMultiplier = 2,
	TreasureRainCount = 24,
	MeteorCount = 6,
	ApocalypseDuration = 75,
	LuckyDuration = 150,
	LuckyMultiplier = 2,
	CoinValueSeconds = 4, -- golden coins are worth this many seconds of your income
}

-- Gems (premium soft currency) ---------------------------------------------
Config.Gems = {
	Start = 25,
	PerLevel = 3, -- gems = level * PerLevel on level up
	SecretFound = 25,
	Rebirth = 60,
	DiscoveryByRank = { [4] = 2, [5] = 5, [6] = 10, [7] = 20, [8] = 40, [9] = 80 },
}

-- Sprint / stamina ------------------------------------------------------------
Config.Sprint = {
	Multiplier = 1.45,
	MaxStamina = 100,
	Drain = 18, -- per second
	Regen = 12, -- per second
	MinToStart = 15,
}

-- Security systems -----------------------------------------------------------
Config.Security = {
	TrapChancePerLevel = 0.07, -- chance a thief is zapped leaving your base, per Security level
	MaxTrapChance = 0.6,
	CameraAlertCooldown = 20,
	WallHoldBonus = 0.15, -- extra steal hold seconds per wall tier
}

-- World ---------------------------------------------------------------------
Config.World = {
	DayLength = 720, -- seconds for a full day/night cycle
	WeatherMin = 150,
	WeatherMax = 300,
	Weather = { Clear = 40, Cloudy = 25, Rain = 18, Storm = 9, Fog = 8 },
	ChestInterval = 45,
	MaxChests = 5,
	WanderRadius = 7,
}

-- Luck --------------------------------------------------------------------------
Config.Luck = {
	PerUpgrade = 0.1,
	UpgradeChancePerLuck = 0.08, -- chance per +1.0 luck to bump a pickup up one rarity
	MaxUpgradeChance = 0.5,
}

-- Pets -------------------------------------------------------------------------
Config.Pets = {
	StartSlots = 3,
	MaxSlots = 6,
	MaxOwned = 120,
}

-- Rebirth ------------------------------------------------------------------
Config.Rebirth = {
	BaseCost = 250000,
	CostGrowth = 3.5,
	IncomeBonusPerRebirth = 0.5, -- +50% income each rebirth
	SpeedBonusPerRebirth = 1, -- +1 walkspeed each rebirth (cap below)
	MaxSpeedBonus = 10,
	StartingMoneyPerRebirth = 1000,
}
-- Each rebirth also requires owning certain treasures (kept until you rebirth).
local REQ = {
	{ Rarity = "Epic", Count = 1 },
	{ Rarity = "Legendary", Count = 1 },
	{ Rarity = "Legendary", Count = 2 },
	{ Rarity = "Mythical", Count = 1 },
	{ Rarity = "Mythical", Count = 2 },
	{ Rarity = "Secret", Count = 1 },
	{ Rarity = "Secret", Count = 2 },
	{ Rarity = "Divine", Count = 1 },
	{ Rarity = "Divine", Count = 2 },
	{ Rarity = "Celestial", Count = 1 },
}
function Config.RebirthRequirement(rebirths: number)
	return REQ[math.min(rebirths + 1, #REQ)]
end

function Config.RebirthCost(rebirths: number): number
	return math.floor(Config.Rebirth.BaseCost * Config.Rebirth.CostGrowth ^ rebirths)
end

-- Rebirth milestone rewards (exclusive treasures / trails / titles)
Config.RebirthRewards = {
	[1] = { Treasure = "Phoenix Ember", Title = "Reborn", Trail = Color3.fromRGB(255, 140, 40) },
	[3] = { Treasure = "Chrono Hourglass", Title = "Timeless", Trail = Color3.fromRGB(90, 200, 255) },
	[5] = { Treasure = "Void Crown", Title = "Void Walker", Trail = Color3.fromRGB(150, 60, 255) },
	[10] = { Treasure = "Eternity Heart", Title = "Eternal", Trail = Color3.fromRGB(255, 255, 255) },
}

-- Movement ------------------------------------------------------------------
Config.BaseWalkSpeed = 18
Config.BaseJumpPower = 50

-- Remote rate limiting ------------------------------------------------------
Config.RateLimit = {
	Window = 1,
	MaxRequests = 12,
}

-- Trading -------------------------------------------------------------------
Config.Trade = {
	MaxItems = 8,
	RequestTimeout = 20,
	ConfirmCountdown = 3,
	MaxDistance = math.huge, -- trading works across the map
}

-- Sound IDs. rbxasset:// sounds ship with every Roblox client, so they always
-- load. Swap in your own rbxassetid:// uploads for a custom soundtrack.
Config.Sounds = {
	Click = "rbxasset://sounds/button.wav",
	Hover = "rbxasset://sounds/clickfast.wav",
	Pickup = "rbxasset://sounds/electronicpingshort.wav",
	Deposit = "rbxasset://sounds/electronicpingshort.wav",
	Purchase = "rbxasset://sounds/electronicpingshort.wav",
	Error = "rbxasset://sounds/clickfast.wav",
	Alarm = "rbxasset://sounds/electronicpingshort.wav",
	Bonk = "rbxasset://sounds/swordslash.wav",
	Swing = "rbxasset://sounds/swordlunge.wav",
	Dash = "rbxasset://sounds/swoosh.wav",
	Jump = "rbxasset://sounds/action_jump.mp3",
	Rebirth = "rbxasset://sounds/victory.wav",
	LevelUp = "rbxasset://sounds/victory.wav",
	Legendary = "rbxasset://sounds/electronicpingshort.wav",
	Event = "rbxasset://sounds/electronicpingshort.wav",
	Lock = "rbxasset://sounds/snap.wav",
	Collect = "rbxasset://sounds/electronicpingshort.wav",
	Steal = "rbxasset://sounds/swordlunge.wav",
	Spawn = "rbxasset://sounds/clickfast.wav",
	ChestOpen = "rbxasset://sounds/unsheath.wav",
	Hatch = "rbxasset://sounds/snap.wav",
	Thunder = "rbxasset://sounds/Rocket shot.wav",
	Portal = "rbxasset://sounds/swoosh.wav",
	Discovery = "rbxasset://sounds/victory.wav",
	-- The built-in music sequencer plays melodies with this note sample.
	MusicNote = "rbxasset://sounds/electronicpingshort.wav",
	MusicBass = "rbxasset://sounds/button.wav",
	-- Optional: an uploaded/licensed music asset id. When set it replaces the
	-- built-in procedural soundtrack.
	Music = "",
}

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Motion</string><ProtectedString name="Source"><![CDATA[-- Motion.lua
-- Deterministic "wander" movement for treasures roaming the world. The
-- position is a pure function of (seed, server time), so every client animates
-- the exact same walk/run/jump path without any network traffic, and the
-- server uses the same function to validate pickups.
--
-- Each 2*SEG seconds is one cycle: move from waypoint p to p+1 (walk or run),
-- then stay there doing an action (idle, dance or jump).

local Motion = {}

local SEG = 3
local cache = {} -- [seed] = current cycle (avoids re-rolling every frame)
local cacheCount = 0

local function waypoint(seed: number, p: number, radius: number): Vector3
	local r = Random.new(seed * 7919 + p * 104729)
	local a = r:NextNumber(0, math.pi * 2)
	local d = math.sqrt(r:NextNumber()) * radius
	return Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
end

local function cycleKind(seed: number, p: number)
	local r = Random.new(seed * 31 + p * 7)
	local move = r:NextNumber() < 0.7 and "Walk" or "Run"
	local roll = r:NextNumber()
	local stay = roll < 0.45 and "Idle" or (roll < 0.75 and "Dance" or "Jump")
	return move, stay
end

local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end

-- Returns offset (Vector3, relative to home), state string, yaw (radians)
function Motion.Sample(seed: number, t: number, radius: number)
	local p = math.floor(t / (SEG * 2))
	local u = t - p * SEG * 2
	local c = cache[seed]
	if not c or c.P ~= p or c.R ~= radius then
		local move, stay = cycleKind(seed, p)
		c = { P = p, R = radius, A = waypoint(seed, p, radius), B = waypoint(seed, p + 1, radius), Move = move, Stay = stay }
		cache[seed] = c
		cacheCount += 1
		if cacheCount > 2000 then
			table.clear(cache)
			cacheCount = 0
		end
	end
	local a, b, move, stay = c.A, c.B, c.Move, c.Stay
	local dir = b - a
	local yaw = (dir.Magnitude > 0.01) and math.atan2(dir.X, dir.Z) or 0
	if u < SEG then
		local duration = move == "Run" and SEG * 0.45 or SEG
		local f = math.clamp(u / duration, 0, 1)
		local pos = a:Lerp(b, smooth(f))
		if f >= 1 then
			return pos, "Idle", yaw
		end
		local hop = move == "Run" and math.abs(math.sin(u * 14)) * 0.35 or math.abs(math.sin(u * 8)) * 0.15
		return pos + Vector3.new(0, hop, 0), move, yaw
	end
	local v = u - SEG
	if stay == "Jump" then
		local h = math.abs(math.sin(v / SEG * math.pi * 3)) * 2.2
		return b + Vector3.new(0, h, 0), "Jump", yaw
	end
	return b, stay, yaw
end

-- World position for a wandering treasure model / record.
function Motion.Position(home: CFrame, seed: number, t: number, radius: number): Vector3
	local offset = Motion.Sample(seed, t, radius)
	return home.Position + offset
end

return Motion
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Mutations</string><ProtectedString name="Source"><![CDATA[-- Mutations.lua
-- Treasure mutations: rare variants that multiply income and value and
-- change how the treasure looks. Rolled when a treasure spawns on the parade
-- or in the world; kept through stealing, trading and saving.

local Mutations = {}

Mutations.Order = { "Gold", "Diamond", "Rainbow", "Lava", "Galaxy" }

Mutations.Info = {
	Gold = { Multiplier = 1.25, Chance = 0.08, Color = Color3.fromRGB(255, 200, 50), Material = "Foil", Icon = "🟡" },
	Diamond = { Multiplier = 1.5, Chance = 0.03, Color = Color3.fromRGB(150, 230, 255), Material = "Glass", Icon = "💠" },
	Rainbow = { Multiplier = 2, Chance = 0.01, Color = Color3.fromRGB(255, 120, 220), Material = "Neon", Icon = "🌈", Rainbow = true },
	Lava = { Multiplier = 2.5, Chance = 0.004, Color = Color3.fromRGB(255, 90, 20), Material = "CrackedLava", Icon = "🌋", EventOnly = "Lava" },
	Galaxy = { Multiplier = 4, Chance = 0.002, Color = Color3.fromRGB(110, 70, 255), Material = "Neon", Icon = "🌌" },
}

function Mutations.Multiplier(name: string?): number
	local info = name and Mutations.Info[name]
	return info and info.Multiplier or 1
end

-- Rolls a mutation (or nil). luck multiplies every chance; boost (event) adds.
function Mutations.Roll(rng: Random, luck: number?, eventMutation: string?)
	local l = luck or 1
	-- rarest first so a lucky roll lands on the best mutation
	for i = #Mutations.Order, 1, -1 do
		local name = Mutations.Order[i]
		local info = Mutations.Info[name]
		local chance = info.Chance * l
		if info.EventOnly and info.EventOnly ~= eventMutation then
			chance = 0
		end
		if eventMutation == name then
			chance = math.max(chance, 0.25)
		end
		if chance > 0 and rng:NextNumber() < chance then
			return name
		end
	end
	return nil
end

function Mutations.Label(name: string?): string
	local info = name and Mutations.Info[name]
	return info and (info.Icon .. " " .. name:upper()) or ""
end

return Mutations
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">PetData</string><ProtectedString name="Source"><![CDATA[-- PetData.lua
-- 52 pets across 9 rarities, plus the eggs that hatch them.
-- Row: Name | Species | BodyHex | AccentHex | Material | BonusType
-- BonusType: Money (income %), Luck (luck %), Speed (+walk speed), Gems (gem %).

local Rarities = require(script.Parent.Rarities)

local RAW = {
	Common = {
		"Puppy|Dog|d9a066|7a4a22|SmoothPlastic|Money",
		"Kitty|Cat|f2a65a|ffffff|SmoothPlastic|Money",
		"Bunny|Bunny|f4f4f4|ffb6c1|SmoothPlastic|Luck",
