	Star = "⭐",
	Skull = "💀",
	Trophy = "🏆",
	Ring = "💍",
	Crystal = "🔷",
	Idol = "🗿",
	Key = "🗝️",
	Lamp = "🪔",
	Mask = "🎭",
	Potion = "🧪",
	Cube = "🧊",
	Pyramid = "🔺",
	Shield = "🛡️",
	Hourglass = "⌛",
	Heart = "❤️",
	Book = "📖",
	Feather = "🪶",
}

local function niceRound(n: number): number
	if n < 10 then
		return math.floor(n + 0.5)
	end
	local mag = 10 ^ math.floor(math.log10(n) - 1)
	return math.floor(n / mag + 0.5) * mag
end

local function slug(name: string): string
	return (name:lower():gsub("[^%w]+", "_"):gsub("^_+", ""):gsub("_+$", ""))
end

local function parse(row: string)
	local parts = string.split(row, "|")
	return {
		Name = parts[1],
		Shape = parts[2],
		Primary = Color3.fromHex(parts[3]),
		Secondary = Color3.fromHex(parts[4]),
		Material = parts[5],
		Fx = parts[6] or "None",
	}
end

local TreasureData = {}
TreasureData.ById = {} :: { [string]: any }
TreasureData.ByName = {} :: { [string]: any }
TreasureData.List = {} :: { any }
TreasureData.ByRarity = {} :: { [string]: { any } }
TreasureData.ShapeIcons = SHAPE_ICONS

local function register(def)
	def.Id = slug(def.Name)
	def.Icon = SHAPE_ICONS[def.Shape] or "✨"
	assert(TreasureData.ById[def.Id] == nil, "Duplicate treasure id " .. def.Id)
	TreasureData.ById[def.Id] = def
	TreasureData.ByName[def.Name] = def
	table.insert(TreasureData.List, def)
	TreasureData.ByRarity[def.Rarity] = TreasureData.ByRarity[def.Rarity] or {}
	if not def.Exclusive then
		table.insert(TreasureData.ByRarity[def.Rarity], def)
	end
end

for _, rarity in ipairs(Rarities.Order) do
	local rows = RAW[rarity]
	local lo, hi = MPS_RANGE[rarity][1], MPS_RANGE[rarity][2]
	for i, row in ipairs(rows) do
		local def = parse(row)
		local t = (#rows > 1) and (i - 1) / (#rows - 1) or 0
		-- slightly exponential curve inside a tier
		local mps = lo * (hi / lo) ^ t
		def.Rarity = rarity
		def.MPS = niceRound(mps)
		def.Value = niceRound(def.MPS * PRICE_FACTOR[rarity])
		def.Exclusive = false
		def.Order = #TreasureData.List + 1
		register(def)
	end
end

for _, ex in ipairs(EXCLUSIVE) do
	local def = parse(ex.Row)
	def.Rarity = ex.Rarity
	def.MPS = ex.MPS
	def.Value = niceRound(ex.MPS * PRICE_FACTOR[ex.Rarity])
	def.Exclusive = true
	def.Order = #TreasureData.List + 1
	register(def)
end

TreasureData.CollectableCount = 0
for _, def in ipairs(TreasureData.List) do
	if not def.Exclusive then
		TreasureData.CollectableCount += 1
	end
end

function TreasureData.Get(id: string)
	return TreasureData.ById[id]
end

function TreasureData.RandomOfRarity(rarity: string, rng: Random?)
	local pool = TreasureData.ByRarity[rarity]
	if not pool or #pool == 0 then
		pool = TreasureData.ByRarity.Common
	end
	local r = rng or Random.new()
	-- within a tier, cheaper items are more common (weight 1/(index))
	local total = 0
	for i = 1, #pool do
		total += 1 / (1 + (i - 1) * 0.25)
	end
	local pick = r:NextNumber() * total
	for i = 1, #pool do
		local w = 1 / (1 + (i - 1) * 0.25)
		if pick <= w then
			return pool[i]
		end
		pick -= w
	end
	return pool[#pool]
end

function TreasureData.RollFromPool(weights: { [string]: number }, rng: Random?)
	return TreasureData.RandomOfRarity(Rarities.Roll(weights, rng), rng)
end

return TreasureData
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">TreasureModels</string><ProtectedString name="Source"><![CDATA[-- TreasureModels.lua
-- Procedurally builds a unique 3D model for every treasure from its shape,
-- colours, material and effect. Shared so the server (world objects) and the
-- client (viewport previews) build identical models without any asset uploads.
--
-- Every model has an invisible anchor part called "Root" at its base. All other
-- parts are welded to it, so moving Root moves the whole treasure. The client
-- animates Root locally (spin / bob) using the "Home" CFrame attribute.

local Rarities = require(script.Parent.Rarities)

local TreasureModels = {}

local TEX_SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function mat(name: string): Enum.Material
	local ok, m = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	return ok and m or Enum.Material.SmoothPlastic
end

-- Builder context ---------------------------------------------------------
local Builder = {}
Builder.__index = Builder

local function newBuilder(model: Model, root: BasePart, scale: number, def)
	return setmetatable({
		Model = model,
		Root = root,
		S = scale,
		Def = def,
		Primary = def.Primary,
		Secondary = def.Secondary,
		Material = mat(def.Material),
		Count = 0,
	}, Builder)
end

-- Adds a part. `cf` is relative to the root (in unscaled units).
function Builder:Part(shape: string, size: Vector3, cf: CFrame, color: Color3?, material: Enum.Material?, mesh: Vector3?)
	local s = self.S
	local p = Instance.new("Part")
	self.Count += 1
	p.Name = "P" .. self.Count
	if shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "Cyl" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "Wedge" then
		p:Destroy()
		p = Instance.new("WedgePart")
		p.Name = "P" .. self.Count
	end
	p.Size = size * s
	p.Color = color or self.Primary
	p.Material = material or self.Material
	if p.Material == Enum.Material.Glass then
		p.Transparency = 0.25
		p.Reflectance = 0.1
	elseif p.Material == Enum.Material.ForceField then
		p.Transparency = 0
	end
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local pos = cf.Position * s
	p.CFrame = self.Root.CFrame * (CFrame.new(pos) * cf.Rotation)
	if mesh then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Scale = mesh
		m.Parent = p
	end
	local w = Instance.new("WeldConstraint")
	w.Part0 = self.Root
	w.Part1 = p
	w.Parent = p
	p.Parent = self.Model
	return p
end

local UP = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder upright
local function at(x, y, z)
	return CFrame.new(x, y, z)
end

-- Shapes ------------------------------------------------------------------
local Shapes = {}

function Shapes.Gem(b)
	b:Part("Cyl", Vector3.new(0.4, 1.6, 1.6), at(0, 0.2, 0) * UP, b.Secondary, Enum.Material.Metal)
	b:Part("Block", Vector3.new(1.8, 1.8, 1.8), at(0, 1.9, 0) * CFrame.Angles(math.rad(45), 0, math.rad(35.26)))
	b:Part("Block", Vector3.new(1.0, 1.0, 1.0), at(0, 1.9, 0) * CFrame.Angles(0, math.rad(45), 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Crown(b)
	b:Part("Cyl", Vector3.new(1.0, 2.8, 2.8), at(0, 0.6, 0) * UP)
	b:Part("Cyl", Vector3.new(1.02, 2.3, 2.3), at(0, 0.62, 0) * UP, Color3.fromRGB(120, 0, 30), Enum.Material.Fabric)
	for i = 0, 4 do
		local a = math.rad(i * 72)
		local x, z = math.cos(a) * 1.2, math.sin(a) * 1.2
		b:Part("Wedge", Vector3.new(0.3, 1.1, 0.6), at(x, 1.6, z) * CFrame.Angles(0, -a + math.rad(90), 0))
		b:Part("Ball", Vector3.new(0.45, 0.45, 0.45), at(x, 2.25, z), b.Secondary, Enum.Material.Neon)
		b:Part("Ball", Vector3.new(0.35, 0.35, 0.35), at(math.cos(a + 0.6) * 1.42, 0.6, math.sin(a + 0.6) * 1.42), b.Secondary, Enum.Material.Glass)
	end
end

function Shapes.Chalice(b)
	b:Part("Cyl", Vector3.new(0.3, 1.8, 1.8), at(0, 0.15, 0) * UP)
	b:Part("Cyl", Vector3.new(1.4, 0.4, 0.4), at(0, 1.0, 0) * UP)
	b:Part("Ball", Vector3.new(0.6, 0.6, 0.6), at(0, 1.0, 0), b.Secondary)
	b:Part("Cyl", Vector3.new(1.3, 2.0, 2.0), at(0, 2.3, 0) * UP)
	b:Part("Cyl", Vector3.new(0.1, 1.7, 1.7), at(0, 2.95, 0) * UP, b.Secondary, Enum.Material.Neon)
end

function Shapes.CoinStack(b)
	for i = 0, 4 do
		b:Part("Cyl", Vector3.new(0.3, 1.6, 1.6), at(math.sin(i * 1.7) * 0.15, 0.15 + i * 0.3, math.cos(i * 1.3) * 0.15) * UP)
	end
	b:Part("Cyl", Vector3.new(0.3, 1.6, 1.6), at(1.2, 0.8, 0) * CFrame.Angles(0, 0, math.rad(20)))
	b:Part("Cyl", Vector3.new(0.32, 0.9, 0.9), at(1.21, 0.8, 0) * CFrame.Angles(0, 0, math.rad(20)), b.Secondary, Enum.Material.Neon)
	b:Part("Cyl", Vector3.new(0.3, 1.6, 1.6), at(-0.9, 0.15, 0.9) * UP, b.Secondary)
end

function Shapes.Orb(b)
	b:Part("Cyl", Vector3.new(0.4, 1.4, 1.4), at(0, 0.2, 0) * UP, b.Secondary, Enum.Material.Metal)
	for i = 0, 2 do
		local a = math.rad(i * 120)
		b:Part("Block", Vector3.new(0.2, 0.9, 0.2), at(math.cos(a) * 0.55, 0.7, math.sin(a) * 0.55) * CFrame.Angles(math.cos(a) * 0.4, 0, -math.sin(a) * 0.4), b.Secondary, Enum.Material.Metal)
	end
	b:Part("Ball", Vector3.new(2.2, 2.2, 2.2), at(0, 2.0, 0))
	b:Part("Ball", Vector3.new(1.0, 1.0, 1.0), at(0, 2.0, 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Sword(b)
	b:Part("Block", Vector3.new(1.2, 0.5, 1.2), at(0, 0.25, 0), Color3.fromRGB(110, 110, 115), Enum.Material.Slate)
	b:Part("Block", Vector3.new(0.5, 3.2, 0.12), at(0, 1.9, 0))
	b:Part("Wedge", Vector3.new(0.12, 0.5, 0.25), at(0, 0.35, 0.125) * CFrame.Angles(math.rad(180), 0, 0))
	b:Part("Block", Vector3.new(1.6, 0.25, 0.3), at(0, 3.55, 0), b.Secondary, Enum.Material.Metal)
	b:Part("Cyl", Vector3.new(0.9, 0.25, 0.25), at(0, 4.1, 0) * UP, Color3.fromRGB(80, 50, 30), Enum.Material.Fabric)
	b:Part("Ball", Vector3.new(0.4, 0.4, 0.4), at(0, 4.65, 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Chest(b)
	b:Part("Block", Vector3.new(2.8, 1.4, 1.8), at(0, 0.7, 0))
	b:Part("Block", Vector3.new(2.85, 0.25, 1.85), at(0, 1.3, 0), b.Secondary, Enum.Material.Metal)
	b:Part("Block", Vector3.new(2.85, 0.6, 1.85), at(0, 1.85, -0.35) * CFrame.Angles(math.rad(-25), 0, 0))
	b:Part("Ball", Vector3.new(1.6, 1.6, 1.6), at(0, 1.4, 0.15), Color3.fromRGB(255, 210, 60), Enum.Material.Neon)
	for _, x in ipairs({ -1.0, 1.0 }) do
		b:Part("Block", Vector3.new(0.25, 1.45, 1.85), at(x, 0.7, 0), b.Secondary, Enum.Material.Metal)
	end
	b:Part("Block", Vector3.new(0.4, 0.5, 0.15), at(0, 1.0, 0.95), b.Secondary, Enum.Material.Metal)
end

function Shapes.Egg(b)
	b:Part("Cyl", Vector3.new(0.3, 1.6, 1.6), at(0, 0.15, 0) * UP, Color3.fromRGB(240, 230, 200), Enum.Material.Sand)
	b:Part("Block", Vector3.new(1.9, 2.6, 1.9), at(0, 1.55, 0), nil, nil, Vector3.new(1, 1, 1))
	for i = 0, 5 do
		local a = math.rad(i * 60 + 15)
		local y = 1.2 + (i % 2) * 0.7
		b:Part("Ball", Vector3.new(0.35, 0.35, 0.35), at(math.cos(a) * 0.88, y, math.sin(a) * 0.88), b.Secondary, Enum.Material.Neon)
	end
end

function Shapes.Star(b)
	b:Part("Cyl", Vector3.new(0.3, 1.4, 1.4), at(0, 0.15, 0) * UP, b.Secondary, Enum.Material.Metal)
	b:Part("Cyl", Vector3.new(0.9, 0.2, 0.2), at(0, 0.7, 0) * UP, b.Secondary, Enum.Material.Metal)
	b:Part("Cyl", Vector3.new(0.5, 1.0, 1.0), at(0, 2.2, 0) * CFrame.Angles(0, math.rad(90), 0))
	for i = 0, 4 do
		local a = math.rad(i * 72 + 90)
		b:Part("Wedge", Vector3.new(0.4, 1.1, 0.7), at(math.cos(a) * 0.85, 2.2 + math.sin(a) * 0.85, 0) * CFrame.Angles(0, 0, a - math.rad(90)) * CFrame.Angles(0, math.rad(90), 0))
	end
	b:Part("Ball", Vector3.new(0.6, 0.6, 0.6), at(0, 2.2, 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Skull(b)
	b:Part("Block", Vector3.new(2.0, 2.0, 2.2), at(0, 1.6, 0), nil, nil, Vector3.new(1, 0.95, 1))
	b:Part("Block", Vector3.new(1.3, 0.6, 1.0), at(0, 0.5, 0.35))
	for _, x in ipairs({ -0.45, 0.45 }) do
		b:Part("Ball", Vector3.new(0.55, 0.55, 0.55), at(x, 1.55, 0.85), b.Secondary, Enum.Material.Neon)
	end
	b:Part("Wedge", Vector3.new(0.3, 0.35, 0.3), at(0, 1.05, 1.0), Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic)
	for i = -2, 2 do
		b:Part("Block", Vector3.new(0.16, 0.25, 0.1), at(i * 0.22, 0.72, 0.86), Color3.fromRGB(250, 250, 240), Enum.Material.SmoothPlastic)
	end
end

function Shapes.Trophy(b)
	b:Part("Block", Vector3.new(1.6, 0.6, 1.6), at(0, 0.3, 0), Color3.fromRGB(60, 40, 30), Enum.Material.Wood)
	b:Part("Block", Vector3.new(1.62, 0.12, 1.62), at(0, 0.5, 0), b.Secondary, Enum.Material.Metal)
	b:Part("Cyl", Vector3.new(1.0, 0.35, 0.35), at(0, 1.1, 0) * UP)
	b:Part("Cyl", Vector3.new(1.5, 1.8, 1.8), at(0, 2.3, 0) * UP)
	b:Part("Cyl", Vector3.new(0.4, 1.2, 1.2), at(0, 1.55, 0) * UP)
	for _, x in ipairs({ -1.1, 1.1 }) do
		b:Part("Cyl", Vector3.new(0.18, 0.9, 0.9), at(x, 2.4, 0) * CFrame.Angles(0, math.rad(90), 0))
	end
	b:Part("Ball", Vector3.new(0.5, 0.5, 0.5), at(0, 2.3, 0.85), b.Secondary, Enum.Material.Neon)
end

local function torus(b, center: CFrame, radius: number, thick: number, segments: number, color, material)
	for i = 0, segments - 1 do
		local a = (i / segments) * math.pi * 2
		local len = 2 * math.pi * radius / segments + 0.05
		b:Part("Block", Vector3.new(len, thick, thick), center * CFrame.Angles(0, 0, a) * at(0, radius, 0), color, material)
	end
end

function Shapes.Ring(b)
	b:Part("Block", Vector3.new(1.4, 0.4, 1.0), at(0, 0.2, 0), Color3.fromRGB(40, 20, 60), Enum.Material.Fabric)
	torus(b, at(0, 1.55, 0), 1.05, 0.28, 14)
	b:Part("Block", Vector3.new(0.7, 0.7, 0.7), at(0, 2.85, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)), b.Secondary, Enum.Material.Glass)
	b:Part("Ball", Vector3.new(0.4, 0.4, 0.4), at(0, 2.85, 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Crystal(b)
	b:Part("Cyl", Vector3.new(0.4, 2.2, 2.2), at(0, 0.2, 0) * UP, Color3.fromRGB(90, 90, 100), Enum.Material.Slate)
	local spikes = {
		{ 0, 2.0, 0, 3.4, 0, 0 },
		{ 0.6, 1.4, 0.3, 2.2, 20, -25 },
		{ -0.6, 1.3, 0.2, 2.0, -15, 30 },
		{ 0.1, 1.2, -0.6, 1.8, 30, 10 },
		{ -0.2, 1.0, 0.6, 1.4, -25, -10 },
	}
	for i, s in ipairs(spikes) do
		local cf = at(s[1], s[2], s[3]) * CFrame.Angles(math.rad(s[5]), math.rad(i * 33), math.rad(s[6]))
		b:Part("Block", Vector3.new(0.7, s[4], 0.7), cf * CFrame.Angles(0, math.rad(45), 0))
		b:Part("Block", Vector3.new(0.3, s[4] * 0.85, 0.3), cf, b.Secondary, Enum.Material.Neon)
	end
end

function Shapes.Idol(b)
	b:Part("Block", Vector3.new(1.6, 0.4, 1.4), at(0, 0.2, 0), b.Secondary)
	b:Part("Block", Vector3.new(1.2, 1.8, 1.0), at(0, 1.3, 0))
	b:Part("Block", Vector3.new(1.4, 1.2, 1.2), at(0, 2.8, 0))
	b:Part("Block", Vector3.new(1.6, 0.25, 1.4), at(0, 3.5, 0), b.Secondary)
	for _, x in ipairs({ -0.35, 0.35 }) do
		b:Part("Block", Vector3.new(0.3, 0.2, 0.1), at(x, 2.95, 0.61), b.Secondary, Enum.Material.Neon)
	end
	b:Part("Block", Vector3.new(0.6, 0.2, 0.1), at(0, 2.5, 0.61), Color3.fromRGB(30, 30, 30), Enum.Material.SmoothPlastic)
	for _, x in ipairs({ -0.8, 0.8 }) do
		b:Part("Block", Vector3.new(0.35, 1.2, 0.5), at(x, 1.5, 0.1) * CFrame.Angles(0, 0, math.rad(x > 0 and -15 or 15)))
	end
end

function Shapes.Key(b)
	b:Part("Block", Vector3.new(1.4, 0.3, 1.0), at(0, 0.15, 0), Color3.fromRGB(70, 30, 30), Enum.Material.Fabric)
	b:Part("Block", Vector3.new(0.28, 2.4, 0.28), at(0, 1.6, 0))
	for i = 0, 1 do
		b:Part("Block", Vector3.new(0.5, 0.22, 0.28), at(0.35, 0.65 + i * 0.4, 0))
	end
	torus(b, at(0, 3.45, 0), 0.6, 0.25, 12)
	b:Part("Ball", Vector3.new(0.45, 0.45, 0.45), at(0, 3.45, 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Lamp(b)
	b:Part("Cyl", Vector3.new(0.3, 1.2, 1.2), at(0, 0.15, 0) * UP)
	b:Part("Block", Vector3.new(2.2, 1.2, 1.5), at(0, 0.9, 0), nil, nil, Vector3.new(1, 1, 1))
	b:Part("Cyl", Vector3.new(1.4, 0.25, 0.25), at(1.4, 1.2, 0) * CFrame.Angles(0, 0, math.rad(30)))
	b:Part("Cyl", Vector3.new(0.18, 0.9, 0.9), at(-1.25, 1.1, 0) * CFrame.Angles(0, math.rad(90), 0))
	b:Part("Cyl", Vector3.new(0.4, 0.8, 0.8), at(0, 1.55, 0) * UP, b.Secondary)
	b:Part("Ball", Vector3.new(0.35, 0.35, 0.35), at(0, 1.85, 0), b.Secondary, Enum.Material.Neon)
	b:Part("Ball", Vector3.new(0.5, 0.5, 0.5), at(2.0, 1.6, 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Mask(b)
	b:Part("Block", Vector3.new(0.3, 1.2, 0.3), at(0, 0.6, -0.2), Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
	b:Part("Block", Vector3.new(1.2, 0.2, 0.9), at(0, 0.1, -0.2), Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
	b:Part("Block", Vector3.new(2.0, 2.4, 0.8), at(0, 2.2, 0), nil, nil, Vector3.new(1, 1, 0.5))
	for _, x in ipairs({ -0.45, 0.45 }) do
		b:Part("Block", Vector3.new(0.5, 0.3, 0.2), at(x, 2.5, 0.2), b.Secondary, Enum.Material.Neon)
	end
	b:Part("Block", Vector3.new(0.6, 0.15, 0.2), at(0, 1.6, 0.2), b.Secondary)
	for i = -1, 1 do
		b:Part("Wedge", Vector3.new(0.25, 0.7, 0.3), at(i * 0.55, 3.55, 0), b.Secondary)
	end
end

function Shapes.Potion(b)
	b:Part("Block", Vector3.new(1.9, 1.9, 1.9), at(0, 1.0, 0), nil, Enum.Material.Glass, Vector3.new(1, 1, 1))
	b:Part("Block", Vector3.new(1.5, 1.3, 1.5), at(0, 0.85, 0), b.Secondary, Enum.Material.Neon, Vector3.new(1, 1, 1))
	b:Part("Cyl", Vector3.new(0.8, 0.6, 0.6), at(0, 2.2, 0) * UP, nil, Enum.Material.Glass)
	b:Part("Cyl", Vector3.new(0.4, 0.5, 0.5), at(0, 2.7, 0) * UP, Color3.fromRGB(140, 95, 60), Enum.Material.Wood)
	b:Part("Cyl", Vector3.new(0.1, 0.75, 0.75), at(0, 2.0, 0) * UP, b.Secondary, Enum.Material.Metal)
end

function Shapes.Cube(b)
	b:Part("Block", Vector3.new(1.2, 0.3, 1.2), at(0, 0.15, 0), Color3.fromRGB(40, 40, 50), Enum.Material.Metal)
	local core = at(0, 1.8, 0) * CFrame.Angles(math.rad(35), math.rad(45), 0)
	b:Part("Block", Vector3.new(1.8, 1.8, 1.8), core)
	b:Part("Block", Vector3.new(1.0, 1.0, 1.0), core, b.Secondary, Enum.Material.Neon)
	for _, d in ipairs({ Vector3.new(1, 1, 1), Vector3.new(-1, 1, -1), Vector3.new(1, -1, -1), Vector3.new(-1, -1, 1) }) do
		b:Part("Ball", Vector3.new(0.35, 0.35, 0.35), core * at(d.X * 0.9, d.Y * 0.9, d.Z * 0.9), b.Secondary, Enum.Material.Neon)
	end
end

function Shapes.Pyramid(b)
	local y = 0
	for i = 0, 3 do
		local w = 2.8 - i * 0.65
		b:Part("Block", Vector3.new(w, 0.55, w), at(0, y + 0.275, 0), i % 2 == 0 and b.Primary or b.Secondary)
		y += 0.55
	end
	b:Part("Block", Vector3.new(0.6, 0.6, 0.6), at(0, y + 0.4, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)), b.Secondary, Enum.Material.Neon)
end

function Shapes.Shield(b)
	b:Part("Block", Vector3.new(1.4, 0.3, 0.9), at(0, 0.15, 0), Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
	b:Part("Cyl", Vector3.new(0.3, 2.8, 2.8), at(0, 1.8, 0) * CFrame.Angles(0, math.rad(90), 0))
	b:Part("Cyl", Vector3.new(0.32, 2.4, 2.4), at(0, 1.8, 0.01) * CFrame.Angles(0, math.rad(90), 0), b.Secondary)
	b:Part("Block", Vector3.new(0.35, 2.4, 0.35), at(0, 1.8, 0.05))
	b:Part("Block", Vector3.new(2.4, 0.35, 0.35), at(0, 1.8, 0.05))
	b:Part("Ball", Vector3.new(0.7, 0.7, 0.7), at(0, 1.8, 0.2), b.Secondary, Enum.Material.Neon)
end

function Shapes.Hourglass(b)
	b:Part("Cyl", Vector3.new(0.3, 1.8, 1.8), at(0, 0.15, 0) * UP)
	b:Part("Cyl", Vector3.new(0.3, 1.8, 1.8), at(0, 3.25, 0) * UP)
	for i = 0, 3 do
		local a = math.rad(i * 90 + 45)
		b:Part("Cyl", Vector3.new(3.0, 0.15, 0.15), at(math.cos(a) * 0.75, 1.7, math.sin(a) * 0.75) * UP, b.Secondary, Enum.Material.Metal)
	end
	b:Part("Ball", Vector3.new(1.2, 1.2, 1.2), at(0, 2.45, 0), Color3.fromRGB(220, 240, 255), Enum.Material.Glass)
	b:Part("Ball", Vector3.new(1.2, 1.2, 1.2), at(0, 0.95, 0), Color3.fromRGB(220, 240, 255), Enum.Material.Glass)
	b:Part("Ball", Vector3.new(0.8, 0.8, 0.8), at(0, 0.85, 0), b.Secondary, Enum.Material.Neon)
	b:Part("Cyl", Vector3.new(0.6, 0.12, 0.12), at(0, 1.7, 0) * UP, b.Secondary, Enum.Material.Neon)
end

function Shapes.Heart(b)
	b:Part("Cyl", Vector3.new(0.3, 1.4, 1.4), at(0, 0.15, 0) * UP, b.Secondary, Enum.Material.Metal)
	b:Part("Ball", Vector3.new(1.4, 1.4, 1.4), at(-0.5, 2.5, 0))
	b:Part("Ball", Vector3.new(1.4, 1.4, 1.4), at(0.5, 2.5, 0))
	b:Part("Block", Vector3.new(1.4, 1.4, 1.0), at(0, 1.75, 0) * CFrame.Angles(0, 0, math.rad(45)))
	b:Part("Ball", Vector3.new(0.6, 0.6, 0.6), at(0, 2.2, 0.4), b.Secondary, Enum.Material.Neon)
end

function Shapes.Book(b)
	b:Part("Block", Vector3.new(1.6, 0.3, 1.2), at(0, 0.15, 0), Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
	local cf = at(0, 1.5, 0) * CFrame.Angles(math.rad(-15), 0, 0)
	b:Part("Block", Vector3.new(2.0, 2.6, 0.5), cf)
	b:Part("Block", Vector3.new(1.8, 2.45, 0.52), cf * at(0.08, 0, 0), Color3.fromRGB(250, 245, 225), Enum.Material.SmoothPlastic)
	b:Part("Block", Vector3.new(2.05, 2.65, 0.08), cf * at(0, 0, 0.27))
	b:Part("Block", Vector3.new(0.7, 0.7, 0.1), cf * at(0, 0.2, 0.32) * CFrame.Angles(0, 0, math.rad(45)), b.Secondary, Enum.Material.Neon)
end

function Shapes.Feather(b)
	b:Part("Cyl", Vector3.new(0.3, 1.2, 1.2), at(0, 0.15, 0) * UP, Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	local cf = at(0, 2.0, 0) * CFrame.Angles(0, 0, math.rad(12))
	b:Part("Cyl", Vector3.new(3.8, 0.12, 0.12), cf * UP, b.Secondary, Enum.Material.SmoothPlastic)
	b:Part("Block", Vector3.new(1.2, 3.4, 0.2), cf * at(0, 0.2, 0), nil, nil, Vector3.new(1, 1, 0.3))
	b:Part("Block", Vector3.new(0.6, 2.4, 0.22), cf * at(0, 0.3, 0), b.Secondary, Enum.Material.Neon, Vector3.new(1, 1, 0.3))
end

TreasureModels.Shapes = Shapes

-- Effects -------------------------------------------------------------------
local FX = {
	Fire = { Tex = TEX_FIRE, C1 = Color3.fromRGB(255, 170, 40), C2 = Color3.fromRGB(255, 50, 0), Speed = 3, Rise = 4, Size = 0.9, Life = 0.9 },
	Frost = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(200, 245, 255), C2 = Color3.fromRGB(120, 200, 255), Speed = 1, Rise = -1, Size = 0.4, Life = 2 },
	Spark = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(255, 240, 120), C2 = Color3.fromRGB(255, 200, 60), Speed = 3, Rise = 1, Size = 0.35, Life = 1 },
	Void = { Tex = TEX_SMOKE, C1 = Color3.fromRGB(120, 30, 200), C2 = Color3.fromRGB(10, 0, 20), Speed = 0.6, Rise = 1, Size = 1.2, Life = 2.2 },
	Bubbles = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(150, 255, 250), C2 = Color3.fromRGB(80, 180, 255), Speed = 0.8, Rise = 3, Size = 0.5, Life = 2 },
	Leaves = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(140, 255, 120), C2 = Color3.fromRGB(40, 160, 60), Speed = 1.2, Rise = -0.5, Size = 0.45, Life = 2.4 },
	Stars = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(255, 255, 255), C2 = Color3.fromRGB(255, 230, 140), Speed = 2, Rise = 1.5, Size = 0.5, Life = 1.6 },
	Hearts = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(255, 140, 200), C2 = Color3.fromRGB(255, 60, 130), Speed = 1.5, Rise = 2.5, Size = 0.55, Life = 1.6 },
	Lightning = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(255, 255, 140), C2 = Color3.fromRGB(80, 160, 255), Speed = 8, Rise = 0, Size = 0.3, Life = 0.4 },
	Rainbow = { Tex = TEX_SPARKLE, Rainbow = true, Speed = 2.5, Rise = 2, Size = 0.6, Life = 1.8 },
}
TreasureModels.FX = FX

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 60)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(120, 255, 100)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(80, 200, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(160, 100, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 100, 220)),
})

local function addEmitter(parent: Instance, fx, rate: number, scale: number, name: string)
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.Texture = fx.Tex
	e.Color = fx.Rainbow and RAINBOW or ColorSequence.new(fx.C1, fx.C2)
	e.LightEmission = 0.8
	e.LightInfluence = 0
	e.Rate = rate
	e.Lifetime = NumberRange.new(fx.Life * 0.7, fx.Life)
	e.Speed = NumberRange.new(fx.Speed * 0.5, fx.Speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, fx.Rise, 0)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, fx.Size * scale),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Parent = parent
	return e
end

function TreasureModels.AddEffects(model: Model, def, root: BasePart, scale: number)
	local info = Rarities.Info[def.Rarity]
	local height = 2.2 * scale
	local att = Instance.new("Attachment")
	att.Name = "FxAttachment"
	att.Position = Vector3.new(0, height, 0)
	att.Parent = root

	local fx = FX[def.Fx]
	local rarityRate = info.Particles
	if fx then
		addEmitter(att, fx, math.max(3, rarityRate), scale, "FxEmitter")
	end
	if info.Sparkles and rarityRate > 0 then
		addEmitter(att, {
			Tex = TEX_SPARKLE,
			C1 = info.Glow,
			C2 = info.Color,
			Speed = 1.5,
			Rise = 1,
			Size = 0.35,
			Life = 1.2,
			Rainbow = info.Rainbow,
		}, rarityRate, scale, "RarityEmitter")
	end
	if info.Smoke then
		addEmitter(att, FX.Void, 4, scale * 1.4, "SmokeEmitter")
	end
	if info.Light > 0 then
		local light = Instance.new("PointLight")
		light.Name = "Glow"
		light.Color = def.Secondary
		light.Range = info.Light
		light.Brightness = 1.6
		light.Shadows = false
		light.Parent = att
	end
	if info.Beam then
		local a0 = Instance.new("Attachment")
		a0.Name = "BeamBottom"
		a0.Position = Vector3.new(0, 0.2, 0)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Name = "BeamTop"
		a1.Position = Vector3.new(0, 14 * scale, 0)
		a1.Parent = root
		local beam = Instance.new("Beam")
		beam.Name = "RarityBeam"
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = 2.6 * scale
		beam.Width1 = 0.2 * scale
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Color = info.Rainbow and RAINBOW or ColorSequence.new(info.Glow)
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		})
		beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		beam.TextureSpeed = 0.6
		beam.TextureLength = 3
		beam.Parent = root
	end
	if info.Halo then
		local halo = Instance.new("Model")
		halo.Name = "Halo"
		local segs = 10
		local r = 1.9 * scale
		for i = 0, segs - 1 do
			local a = (i / segs) * math.pi * 2
			local p = Instance.new("Part")
			p.Name = "HaloSeg"
			p.Size = Vector3.new(0.35, 0.15, 0.35) * scale
			p.Shape = Enum.PartType.Ball
			p.Material = Enum.Material.Neon
			p.Color = info.Glow
			p.Anchored = false
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = false
			p.Massless = true
			p.CastShadow = false
			p.CFrame = root.CFrame * CFrame.new(math.cos(a) * r, height + 0.4 * scale, math.sin(a) * r)
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = p
			w.Parent = p
			p.Parent = halo
		end
		halo.Parent = model
	end
	model:SetAttribute("Rainbow", info.Rainbow)
	model:SetAttribute("Lightning", def.Fx == "Lightning")
end

-- Public API --------------------------------------------------------------
-- opts: { Scale = number?, Effects = boolean?, CFrame = CFrame?, Anchored = boolean? }
function TreasureModels.Build(def, opts)
	opts = opts or {}
	local scale = opts.Scale or 1
	local model = Instance.new("Model")
	model.Name = def.Name

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Massless = true
	root.CastShadow = false
	root.Anchored = true
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root

	local builder = newBuilder(model, root, scale, def)
	local fn = Shapes[def.Shape] or Shapes.Gem
	fn(builder)

	if opts.Effects ~= false then
		TreasureModels.AddEffects(model, def, root, scale)
	end

	model:SetAttribute("TreasureId", def.Id)
	model:SetAttribute("Rarity", def.Rarity)

	local cf = opts.CFrame or CFrame.new()
	model:PivotTo(cf)
	model:SetAttribute("Home", cf)
	root.Anchored = opts.Anchored ~= false
	return model
end

-- Approximate height so labels can sit above the model.
function TreasureModels.Height(def, scale: number?): number
	local s = scale or 1
	local tall = { Sword = 4.9, Idol = 3.7, Key = 4.1, Feather = 4.0, Mask = 3.9, Crystal = 3.8, Hourglass = 3.4 }
	return (tall[def.Shape] or 3.1) * s
end

return TreasureModels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">UpgradeData</string><ProtectedString name="Source"><![CDATA[-- UpgradeData.lua
-- Shop catalogue: levelled upgrades and one-time special abilities.

local Config = require(script.Parent.Config)

local UpgradeData = {}

-- Levelled upgrades. Cost(level) is the price to go FROM `level` to `level+1`.
UpgradeData.Upgrades = {
	Speed = {
		Order = 1,
		Name = "Swift Boots",
		Icon = "👟",
		Description = "+2 walk speed per level.",
		MaxLevel = 12,
		Cost = function(level)
			return math.floor(200 * 2.1 ^ level)
		end,
	},
	Carry = {
		Order = 2,
		Name = "Treasure Backpack",
		Icon = "🎒",
		Description = "+1 treasure you can carry at once.",
		MaxLevel = 5,
		Cost = function(level)
			return math.floor(1500 * 6 ^ level)
		end,
	},
	Base = {
		Order = 3,
		Name = "Base Expansion",
		Icon = "🏰",
		Description = ("+%d display platforms and +5%% base income."):format(Config.PlotsPerBaseLevel),
		MaxLevel = Config.MaxBaseLevel - 1,
		Cost = function(level)
			return math.floor(500 * 3.2 ^ level)
		end,
	},
	Protection = {
		Order = 4,
		Name = "Fortress Security",
		Icon = "🛡️",
		Description = "Longer base lock, shorter lock cooldown, slower steals and longer post-robbery lockdown.",
		MaxLevel = 10,
		Cost = function(level)
			return math.floor(800 * 2.6 ^ level)
		end,
	},
	Income = {
		Order = 5,
		Name = "Golden Vault",
		Icon = "💰",
		Description = "+10% money from all treasures.",
		MaxLevel = 15,
		Cost = function(level)
			return math.floor(1000 * 2.4 ^ level)
		end,
	},
}

-- One-time abilities.
UpgradeData.Abilities = {
	Dash = {
		Order = 1,
		Name = "Dash",
		Icon = "💨",
		Key = "Q",
		Description = "Burst forward at high speed.",
		Cost = 2500,
		Cooldown = 6,
	},
	SuperJump = {
		Order = 2,
		Name = "Super Jump",
		Icon = "🦘",
		Key = "R",
		Description = "Huge jumps for 8 seconds. Reach secret areas!",
		Cost = 6000,
		Cooldown = 20,
		Duration = 8,
	},
	Cloak = {
		Order = 3,
		Name = "Shadow Cloak",
		Icon = "👻",
		Key = "F",
		Description = "Turn nearly invisible and hide your name for 8 seconds.",
		Cost = 40000,
		Cooldown = 60,
		Duration = 8,
	},
	Magnet = {
		Order = 4,
		Name = "Treasure Magnet",
		Icon = "🧲",
		Key = nil,
		Description = "Passive: automatically grab free world treasures near you.",
		Cost = 120000,
		Cooldown = 0,
		Radius = 18,
	},
}

function UpgradeData.SortedKeys(tbl)
	local keys = {}
	for k in pairs(tbl) do
		table.insert(keys, k)
	end
	table.sort(keys, function(a, b)
		return tbl[a].Order < tbl[b].Order
	end)
	return keys
end

-- Derived stats ------------------------------------------------------------
function UpgradeData.WalkSpeed(data)
	local rebirthBonus = math.min(Config.Rebirth.MaxSpeedBonus, (data.Rebirths or 0) * Config.Rebirth.SpeedBonusPerRebirth)
	return Config.BaseWalkSpeed + (data.Upgrades.Speed or 0) * 2 + rebirthBonus
end

function UpgradeData.CarryCapacity(data)
	return 1 + (data.Upgrades.Carry or 0)
end

function UpgradeData.BaseLevel(data)
	return 1 + (data.Upgrades.Base or 0)
end

function UpgradeData.PlotCount(data)
	local total = Config.PlotColumns * Config.PlotRows
	return math.min(total, Config.StartingPlots + (UpgradeData.BaseLevel(data) - 1) * Config.PlotsPerBaseLevel)
end

function UpgradeData.LockDuration(data)
	return Config.Lock.BaseDuration + (data.Upgrades.Protection or 0) * Config.Lock.DurationPerLevel
end

function UpgradeData.LockCooldown(data)
	return math.max(15, Config.Lock.BaseCooldown - (data.Upgrades.Protection or 0) * Config.Lock.CooldownReductionPerLevel)
end

function UpgradeData.StealHold(data)
	return Config.Steal.BaseHoldDuration + (data.Upgrades.Protection or 0) * Config.Steal.HoldPerProtectionLevel
end

function UpgradeData.VictimLock(data)
	return Config.Steal.VictimAutoLock + (data.Upgrades.Protection or 0) * Config.Steal.VictimAutoLockPerLevel
end

function UpgradeData.IncomeMultiplier(data)
	local m = 1
	m += (data.Rebirths or 0) * Config.Rebirth.IncomeBonusPerRebirth
	m += (data.Upgrades.Income or 0) * 0.10
	m += (UpgradeData.BaseLevel(data) - 1) * 0.05
	return m
end

return UpgradeData
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Util.lua
-- Small helpers shared by client and server.

local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Util.Abbreviate(n: number): string
	n = tonumber(n) or 0
	local neg = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = (n == math.floor(n)) and tostring(math.floor(n)) or string.format("%.1f", n)
		return (neg and "-" or "") .. s
	end
	local i = 1
	while n >= 1000 and i < #SUFFIXES do
		n /= 1000
		i += 1
	end
	local fmt = n >= 100 and "%.0f" or (n >= 10 and "%.1f" or "%.2f")
	local s = string.format(fmt, n)
	if s:find("%.") then
		s = s:gsub("0+$", "") -- only strip zeros after a decimal point
		s = s:gsub("%.$", "")
	end
	return (neg and "-" or "") .. s .. SUFFIXES[i]
end

function Util.Money(n: number): string
	return "$" .. Util.Abbreviate(n)
end

function Util.Commas(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""))
end

function Util.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local m = math.floor(seconds / 60)
	local s = seconds % 60
	if m >= 60 then
		return string.format("%dh %02dm", math.floor(m / 60), m % 60)
	end
	return string.format("%d:%02d", m, s)
end

function Util.DeepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in pairs(t) do
		c[k] = Util.DeepCopy(v)
	end
	return c
end

-- Fills missing keys in `data` from `template` (recursive).
function Util.Reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = Util.DeepCopy(v)
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
			Util.Reconcile(data[k], v)
		end
	end
	return data
end

local counter = 0
function Util.NewUid(): string
	counter += 1
	return string.format("%x%x%x", os.time(), math.random(0, 0xFFFFFF), counter)
end

return Util
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX0000001C"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000001B"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX0000000A"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Main.server.lua
-- Boots every server service in dependency order: Init() wires references,
-- Start() begins loops and connections.

local servicesFolder = script.Parent:WaitForChild("Services")

local ORDER = {
	"NetService",
	"DataService",
	"MapBuilder",
	"StateService",
	"EconomyService",
	"BaseService",
	"CarryService",
	"TreasureService",
	"StealService",
	"PlayerService",
	"ShopService",
	"RebirthService",
	"TradeService",
	"LeaderboardService",
	"EventService",
}

local Services = {}
for _, name in ipairs(ORDER) do
	Services[name] = require(servicesFolder:WaitForChild(name))
end

for _, name in ipairs(ORDER) do
	local svc = Services[name]
	if svc.Init then
		svc.Init(Services)
	end
end

for _, name in ipairs(ORDER) do
	local svc = Services[name]
	if svc.Start then
		local ok, err = pcall(svc.Start)
		if not ok then
			warn(("[Boot] %s failed to start: %s"):format(name, tostring(err)))
		end
	end
end

print(("[STEAL A TREASURE] Server ready — %d services online"):format(#ORDER))
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX0000001A"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">BaseService</string><ProtectedString name="Source"><![CDATA[-- BaseService.lua
-- Personal bases: building the 8 base shells, assigning them to players,
-- rendering placed treasures on display platforms, the door barrier lock,
-- alarm lights and the owner sign.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local TreasureModels = require(Shared.TreasureModels)
local UpgradeData = require(Shared.UpgradeData)
local Rarities = require(Shared.Rarities)
local Util = require(Shared.Util)

local S -- services table

local BaseService = {}
BaseService.Bases = {} :: { any }

local BASE_COLORS = {
	Color3.fromRGB(255, 95, 95),
	Color3.fromRGB(255, 170, 60),
	Color3.fromRGB(250, 220, 70),
	Color3.fromRGB(100, 220, 110),
	Color3.fromRGB(70, 200, 255),
	Color3.fromRGB(120, 120, 255),
	Color3.fromRGB(200, 110, 255),
	Color3.fromRGB(255, 110, 200),
}

local function now()
	return workspace:GetServerTimeNow()
end

local function part(parent, size, cf, color, material, props)
	return S.MapBuilder.Part(parent, size, cf, color, material, props)
end

-- Shell -------------------------------------------------------------------------
local function plotLocal(index: number): Vector3
	local r = math.floor((index - 1) / Config.PlotColumns)
	local c = (index - 1) % Config.PlotColumns
	local x = (c - (Config.PlotColumns - 1) / 2) * Config.PlotSpacing
	local z = 2 + r * Config.PlotSpacing
	return Vector3.new(x, 0, z)
end

local function buildShell(index: number, cf: CFrame, parent: Instance)
	local color = BASE_COLORS[(index - 1) % #BASE_COLORS + 1]
	local half = Config.BaseSize / 2
	local wallH = Config.BaseWallHeight
	local model = Instance.new("Model")
	model.Name = "Base" .. index
	model:SetAttribute("Index", index)
	model:SetAttribute("OwnerId", 0)
	model:SetAttribute("OwnerName", "")
	model:SetAttribute("LockEnd", 0)

	local function L(x, y, z)
		return cf * CFrame.new(x, y, z)
	end

	part(model, Vector3.new(Config.BaseSize, 1, Config.BaseSize), L(0, 0.5, 0), Color3.fromRGB(235, 230, 220), Enum.Material.WoodPlanks, { Name = "Floor" })
	part(model, Vector3.new(Config.BaseSize - 8, 0.2, Config.BaseSize - 30), L(0, 1.05, 12), color:Lerp(Color3.new(1, 1, 1), 0.55), Enum.Material.Fabric, { Name = "Carpet" })

	local walls = Instance.new("Folder")
	walls.Name = "Walls"
	walls.Parent = model
	local wallColor = color:Lerp(Color3.new(1, 1, 1), 0.25)
	part(walls, Vector3.new(2, wallH, Config.BaseSize), L(-half + 1, wallH / 2 + 1, 0), wallColor, Enum.Material.Brick)
	part(walls, Vector3.new(2, wallH, Config.BaseSize), L(half - 1, wallH / 2 + 1, 0), wallColor, Enum.Material.Brick)
	part(walls, Vector3.new(Config.BaseSize, wallH, 2), L(0, wallH / 2 + 1, half - 1), wallColor, Enum.Material.Brick)
	local doorW = 16
	local sideW = (Config.BaseSize - doorW) / 2
	part(walls, Vector3.new(sideW, wallH, 2), L(-(doorW / 2 + sideW / 2), wallH / 2 + 1, -half + 1), wallColor, Enum.Material.Brick)
	part(walls, Vector3.new(sideW, wallH, 2), L(doorW / 2 + sideW / 2, wallH / 2 + 1, -half + 1), wallColor, Enum.Material.Brick)
	part(walls, Vector3.new(doorW, wallH - 14, 2), L(0, wallH - (wallH - 14) / 2 + 1, -half + 1), wallColor, Enum.Material.Brick)
	-- Wall trims
	part(walls, Vector3.new(Config.BaseSize + 1, 1.2, 3), L(0, wallH + 1.6, half - 1), color, Enum.Material.SmoothPlastic)
	part(walls, Vector3.new(Config.BaseSize + 1, 1.2, 3), L(0, wallH + 1.6, -half + 1), color, Enum.Material.SmoothPlastic)
	part(walls, Vector3.new(3, 1.2, Config.BaseSize + 1), L(-half + 1, wallH + 1.6, 0), color, Enum.Material.SmoothPlastic)
	part(walls, Vector3.new(3, 1.2, Config.BaseSize + 1), L(half - 1, wallH + 1.6, 0), color, Enum.Material.SmoothPlastic)
	-- corner towers
	for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		local x, z = c[1] * (half - 1), c[2] * (half - 1)
		part(walls, Vector3.new(6, wallH + 6, 6), L(x, (wallH + 6) / 2 + 1, z), color, Enum.Material.Brick)
		part(walls, Vector3.new(7, 4, 7), L(x, wallH + 9, z), Color3.fromRGB(70, 60, 90), Enum.Material.Slate)
	end

	-- Door barrier (laser wall)
	local barrier = part(model, Vector3.new(doorW, 14, 1), L(0, 8, -half + 1), Color3.fromRGB(255, 40, 60), Enum.Material.ForceField, {
		Name = "Barrier",
		Transparency = 1,
		CanCollide = false,
	})
	for i = 0, 3 do
		part(model, Vector3.new(doorW, 0.25, 0.25), L(0, 2.5 + i * 3.2, -half + 1), Color3.fromRGB(255, 60, 80), Enum.Material.Neon, {
			Name = "Laser",
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
		})
	end
	-- door frame lights
	for _, x in ipairs({ -doorW / 2 - 0.5, doorW / 2 + 0.5 }) do
		part(model, Vector3.new(1, 14, 2.4), L(x, 8, -half + 1), Color3.fromRGB(60, 255, 140), Enum.Material.Neon, { Name = "DoorLight" })
	end

	-- Lock button
	local button = part(model, Vector3.new(3, 3, 3), L(-12, 2.5, -half + 6), Color3.fromRGB(255, 60, 60), Enum.Material.Neon, { Name = "LockButton" })
	part(model, Vector3.new(4, 1, 4), L(-12, 1.5, -half + 6), Color3.fromRGB(50, 50, 60), Enum.Material.Metal)
	local lockPrompt = Instance.new("ProximityPrompt")
	lockPrompt.Name = "LockPrompt"
	lockPrompt.ActionText = "Lock Base"
	lockPrompt.ObjectText = "🔒 Security"
	lockPrompt.MaxActivationDistance = 10
	lockPrompt.RequiresLineOfSight = false
	lockPrompt:SetAttribute("OwnerOnly", true)
	lockPrompt.Parent = button

	-- Alarm lights + siren sound
	local alarms = Instance.new("Folder")
	alarms.Name = "AlarmLights"
	alarms.Parent = model
	for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		local light = part(alarms, Vector3.new(2.5, 2.5, 2.5), L(c[1] * (half - 1), wallH + 12.5, c[2] * (half - 1)), Color3.fromRGB(90, 90, 100), Enum.Material.Glass, { Name = "Alarm", Shape = Enum.PartType.Ball })
		local pl = Instance.new("PointLight")
		pl.Color = Color3.fromRGB(255, 30, 30)
		pl.Range = 40
		pl.Brightness = 4
		pl.Enabled = false
		pl.Parent = light
	end
	local siren = Instance.new("Sound")
	siren.Name = "Siren"
	siren.SoundId = Config.Sounds.Alarm
	siren.Volume = 1
	siren.PlaybackSpeed = 0.6
	siren.RollOffMaxDistance = 220
	siren.Looped = true
	siren.Parent = model:FindFirstChild("Floor")

	-- Sign above the door
	local signPart = part(model, Vector3.new(26, 7, 1), L(0, wallH + 6, -half - 0.6), Color3.fromRGB(30, 30, 50), Enum.Material.SmoothPlastic, { Name = "Sign" })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = signPart
	-- (the sign's Front face already points at the plaza, where visitors come from)
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(1, 0.6)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.3)
	title.Text = "EMPTY BASE"
	title.Parent = gui
	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromScale(0, 0.6)
	sub.Size = UDim2.fromScale(1, 0.4)
	sub.Font = Enum.Font.GothamBold
	sub.TextScaled = true
	sub.TextColor3 = Color3.fromRGB(255, 230, 120)
	sub.Text = ""
	sub.Parent = gui

	-- Plots
	local plots = Instance.new("Folder")
	plots.Name = "Plots"
	plots.Parent = model
	local plotParts = {}
	local total = Config.PlotColumns * Config.PlotRows
	for i = 1, total do
		local lp = plotLocal(i)
		local plot = part(plots, Vector3.new(6, 1.5, 6), L(lp.X, 1.75, lp.Z), Color3.fromRGB(250, 250, 255), Enum.Material.Marble, { Name = "Plot" .. i })
		plot:SetAttribute("Index", i)
		local rim = part(plots, Vector3.new(6.4, 0.3, 6.4), L(lp.X, 2.4, lp.Z), color, Enum.Material.Neon, { Name = "Rim" .. i, CanCollide = false })
		local lockBB, lockLabel = S.MapBuilder.Billboard(plot, "🔒", Color3.fromRGB(255, 255, 255), UDim2.fromOffset(40, 40), 2)
		lockBB.Name = "LockedLabel"
		lockBB.MaxDistance = 80
		lockLabel.Text = "🔒"
		plotParts[i] = { Plot = plot, Rim = rim, LockBB = lockBB }
	end

	local treasures = Instance.new("Folder")
	treasures.Name = "Treasures"
	treasures.Parent = model

	local zone = part(model, Vector3.new(Config.BaseSize - 2, 40, Config.BaseSize - 2), L(0, 20, 0), Color3.new(), nil, {
		Name = "Zone",
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
	})

	model.Parent = parent
	return {
		Index = index,
		Model = model,
		CFrame = cf,
		Color = color,
		Barrier = barrier,
		Button = button,
		LockPrompt = lockPrompt,
		Siren = siren,
		Alarms = alarms,
		Title = title,
		Sub = sub,
		Plots = plotParts,
		TreasureFolder = treasures,
		Zone = zone,
		PlotModels = {}, -- [plotIndex] = { Uid, Model }
		Owner = nil :: Player?,
		AlarmUntil = 0,
	}
end

-- Queries --------------------------------------------------------------------------
function BaseService.Get(player: Player)
	local session = S.DataService.Session(player)
	if not session or not session.BaseIndex then
		return nil
	end
	return BaseService.Bases[session.BaseIndex]
end

function BaseService.IsInside(base, position: Vector3): boolean
	local rel = base.Zone.CFrame:PointToObjectSpace(position)
	local half = base.Zone.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

function BaseService.BaseAt(position: Vector3)
	for _, base in ipairs(BaseService.Bases) do
		if BaseService.IsInside(base, position) then
			return base
		end
	end
	return nil
end

function BaseService.SpawnCFrame(player: Player): CFrame?
	local base = BaseService.Get(player)
	if not base then
		return nil
	end
	return base.CFrame * CFrame.new(0, 4, -Config.BaseSize / 2 + 12) * CFrame.Angles(0, math.pi, 0)
end

function BaseService.IsLocked(player: Player): boolean
	local session = S.DataService.Session(player)
	return session ~= nil and session.LockEnd > now()
end

-- Plot index (1..unlocked) that holds no treasure, or nil.
function BaseService.FreePlot(player: Player): number?
	local data = S.DataService.Get(player)
	if not data then
		return nil
	end
	local used = {}
	for _, t in pairs(data.Treasures) do
		if t.Plot then
			used[t.Plot] = true
		end
	end
	for i = 1, UpgradeData.PlotCount(data) do
		if not used[i] then
			return i
		end
	end
	return nil
end

function BaseService.CountPlaced(data): number
	local n = 0
	for _, t in pairs(data.Treasures) do
		if t.Plot then
			n += 1
		end
	end
	return n
end

function BaseService.CountStored(data): number
	local n = 0
	for _, t in pairs(data.Treasures) do
		if not t.Plot then
			n += 1
		end
	end
	return n
end

-- Rendering -------------------------------------------------------------------------
local function makeLabel(root: BasePart, def, height: number)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(180, 54)
	bb.StudsOffset = Vector3.new(0, height + 1.2, 0)
	bb.MaxDistance = 55
	bb.LightInfluence = 0
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromScale(1, 0.4)
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextColor3 = Color3.new(1, 1, 1)
	name.Text = def.Name
	local st = Instance.new("UIStroke")
	st.Thickness = 2
	st.Parent = name
	name.Parent = bb
	local rarity = Instance.new("TextLabel")
	rarity.BackgroundTransparency = 1
	rarity.Position = UDim2.fromScale(0, 0.4)
	rarity.Size = UDim2.fromScale(1, 0.3)
	rarity.Font = Enum.Font.GothamBlack
	rarity.TextScaled = true
	rarity.TextColor3 = Rarities.Color(def.Rarity)
	rarity.Text = def.Rarity:upper()
	local st2 = Instance.new("UIStroke")
	st2.Thickness = 2
	st2.Parent = rarity
	rarity.Parent = bb
	local mps = Instance.new("TextLabel")
	mps.BackgroundTransparency = 1
	mps.Position = UDim2.fromScale(0, 0.7)
	mps.Size = UDim2.fromScale(1, 0.3)
	mps.Font = Enum.Font.GothamBold
	mps.TextScaled = true
	mps.TextColor3 = Color3.fromRGB(120, 255, 120)
	mps.Text = Util.Money(def.MPS) .. "/s"
	local st3 = Instance.new("UIStroke")
	st3.Thickness = 2
	st3.Parent = mps
	mps.Parent = bb
	bb.Parent = root
	return bb
end
BaseService.MakeLabel = makeLabel

local function promptOn(root: BasePart, name: string, action: string, object: string, hold: number, kind: string)
	local p = Instance.new("ProximityPrompt")
	p.Name = name
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = hold
	p.MaxActivationDistance = 10
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = kind == "Steal" and Enum.KeyCode.E or Enum.KeyCode.G
	p:SetAttribute("Kind", kind)
	p.Parent = root
	return p
end

function BaseService.Refresh(player: Player)
	local base = BaseService.Get(player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not base or not data or not session then
		return
	end
	local unlocked = UpgradeData.PlotCount(data)
	local desired = {}
	for uid, t in pairs(data.Treasures) do
		if t.Plot and not session.Stealing[uid] then
			desired[t.Plot] = uid
		end
	end
	for i, p in ipairs(base.Plots) do
		local isUnlocked = i <= unlocked
		p.Plot.Transparency = isUnlocked and 0 or 0.55
		p.Rim.Transparency = isUnlocked and 0 or 0.8
		p.LockBB.Enabled = not isUnlocked

		local current = base.PlotModels[i]
		local want = desired[i]
		if current and current.Uid ~= want then
			current.Model:Destroy()
			base.PlotModels[i] = nil
			current = nil
		end
		if want and not current then
			local entry = data.Treasures[want]
			local def = TreasureData.Get(entry.Id)
			if def then
				local cf = p.Plot.CFrame * CFrame.new(0, p.Plot.Size.Y / 2, 0)
				local model = TreasureModels.Build(def, { CFrame = cf, Scale = 1 })
				model:SetAttribute("Uid", want)
				model:SetAttribute("OwnerId", player.UserId)
				local root = model.PrimaryPart :: BasePart
				makeLabel(root, def, TreasureModels.Height(def))
				local hold = UpgradeData.StealHold(data)
				local steal = promptOn(root, "StealPrompt", "Steal", def.Name, hold, "Steal")
				local store = promptOn(root, "StorePrompt", "Pick Up", def.Name, 0.3, "Store")
				steal.Triggered:Connect(function(thief)
					S.StealService.TryStart(thief, player, want)
				end)
				store.Triggered:Connect(function(who)
					if who == player then
						S.TreasureService.Store(player, want)
					end
				end)
				model.Parent = base.TreasureFolder
				base.PlotModels[i] = { Uid = want, Model = model }
			end
		end
	end
	BaseService.UpdateSign(player)
end

-- Updates steal hold time on existing prompts (after a protection upgrade).
function BaseService.RefreshPrompts(player: Player)
	local base = BaseService.Get(player)
	local data = S.DataService.Get(player)
	if not base or not data then
		return
	end
	local hold = UpgradeData.StealHold(data)
	for _, pm in pairs(base.PlotModels) do
		local prompt = pm.Model.PrimaryPart and pm.Model.PrimaryPart:FindFirstChild("StealPrompt")
		if prompt then
			prompt.HoldDuration = hold
		end
	end
end

function BaseService.UpdateSign(player: Player)
	local base = BaseService.Get(player)
	local session = S.DataService.Session(player)
	if not base or not session then
		return
	end
	base.Title.Text = player.DisplayName .. "'s Base"
	local lockText = ""
	local remaining = session.LockEnd - now()
	if remaining > 0 then
		lockText = ("  🔒 %ds"):format(math.ceil(remaining))
	end
	base.Sub.Text = ("💰 %s/s%s"):format(Util.Abbreviate(session.MPS or 0), lockText)
end

-- Locking ----------------------------------------------------------------------------
local function applyLockVisual(base, locked: boolean)
	base.Barrier.Transparency = locked and 0.35 or 1
	base.Barrier.CanCollide = locked
	for _, c in ipairs(base.Model:GetChildren()) do
		if c.Name == "Laser" then
			c.Transparency = locked and 0 or 1
		elseif c.Name == "DoorLight" then
			c.Color = locked and Color3.fromRGB(255, 50, 60) or Color3.fromRGB(60, 255, 140)
		end
	end
	base.Button.Color = locked and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 60, 60)
	base.Locked = locked
end

-- Moves non-owners standing inside a base out of the door.
local function ejectIntruders(base)
	local owner = base.Owner
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= owner then
			local char = p.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp and BaseService.IsInside(base, hrp.Position) then
				hrp.CFrame = base.CFrame * CFrame.new(math.random(-6, 6), 4, -Config.BaseSize / 2 - 8)
				S.NetService.Notify(p, "The base locked and kicked you out!", "warn")
			end
		end
	end
end

function BaseService.SetLock(player: Player, seconds: number)
	local base = BaseService.Get(player)
	local session = S.DataService.Session(player)
	if not base or not session then
		return
	end
	session.LockEnd = math.max(session.LockEnd, now() + seconds)
	base.Model:SetAttribute("LockEnd", session.LockEnd)
	applyLockVisual(base, true)
	ejectIntruders(base)
	S.StateService.PushStats(player)
end

function BaseService.RequestLock(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session or not session.BaseIndex then
		return false, "No base"
	end
	local t = now()
	if session.LockEnd > t then
		return false, "Your base is already locked"
	end
	if session.LockCooldownEnd > t then
		return false, ("Lock recharging: %ds"):format(math.ceil(session.LockCooldownEnd - t))
	end
	local duration = UpgradeData.LockDuration(data)
	BaseService.SetLock(player, duration)
	session.LockCooldownEnd = session.LockEnd + UpgradeData.LockCooldown(data)
	S.StateService.PushStats(player)
	return true, ("Base locked for %ds!"):format(duration)
end

-- Alarm ----------------------------------------------------------------------------
function BaseService.TriggerAlarm(owner: Player)
	local base = BaseService.Get(owner)
	if not base then
		return
	end
	base.AlarmUntil = os.clock() + 6
	if not base.Siren.IsPlaying then
		base.Siren:Play()
	end
end

-- Assignment -----------------------------------------------------------------------
function BaseService.Assign(player: Player): number?
	for _, base in ipairs(BaseService.Bases) do
		if base.Owner == nil then
			base.Owner = player
			local session = S.DataService.Session(player)
			session.BaseIndex = base.Index
			base.Model:SetAttribute("OwnerId", player.UserId)
			base.Model:SetAttribute("OwnerName", player.DisplayName)
			base.Model:SetAttribute("LockEnd", 0)
			applyLockVisual(base, false)
			player:SetAttribute("BaseIndex", base.Index)
			return base.Index
		end
	end
	return nil
end

function BaseService.Release(player: Player)
	for _, base in ipairs(BaseService.Bases) do
		if base.Owner == player then
			base.Owner = nil
			for i, pm in pairs(base.PlotModels) do
				pm.Model:Destroy()
				base.PlotModels[i] = nil
			end
			base.Model:SetAttribute("OwnerId", 0)
			base.Model:SetAttribute("OwnerName", "")
			base.Model:SetAttribute("LockEnd", 0)
			base.Title.Text = "EMPTY BASE"
			base.Sub.Text = ""
			base.Siren:Stop()
			applyLockVisual(base, false)
			for _, p in ipairs(base.Plots) do
				p.Plot.Transparency = 0.55
				p.Rim.Transparency = 0.8
				p.LockBB.Enabled = true
			end
		end
	end
end

function BaseService.Init(services)
	S = services
end

function BaseService.Start()
	local folder = Instance.new("Folder")
	folder.Name = "Bases"
	folder.Parent = workspace
	for i, cf in ipairs(S.MapBuilder.Map.BaseSlots) do
		local base = buildShell(i, cf, folder)
		BaseService.Bases[i] = base
		base.LockPrompt.Triggered:Connect(function(who)
			if base.Owner == who then
				local ok, msg = BaseService.RequestLock(who)
				S.NetService.Notify(who, msg or "", ok and "success" or "error")
			end
		end)
	end

	S.NetService.Handle("LockBase", function(player)
		return BaseService.RequestLock(player)
	end)

	-- Lock expiry, alarm flashing and sign updates
	task.spawn(function()
		local tick = 0
		while true do
			task.wait(0.25)
			tick += 1
			local t = now()
			for _, base in ipairs(BaseService.Bases) do
				local owner = base.Owner
				if owner then
					local session = S.DataService.Session(owner)
					if session then
						if base.Locked and session.LockEnd <= t then
							applyLockVisual(base, false)
							base.Model:SetAttribute("LockEnd", 0)
							S.StateService.PushStats(owner)
						end
						if tick % 4 == 0 then
							BaseService.UpdateSign(owner)
						end
					end
				end
				local alarming = os.clock() < base.AlarmUntil
				for _, light in ipairs(base.Alarms:GetChildren()) do
					local on = alarming and (tick % 2 == 0)
					light.Color = on and Color3.fromRGB(255, 30, 30) or Color3.fromRGB(90, 90, 100)
					light.Material = on and Enum.Material.Neon or Enum.Material.Glass
					local pl = light:FindFirstChildOfClass("PointLight")
					if pl then
						pl.Enabled = on
					end
				end
				if not alarming and base.Siren.IsPlaying then
					base.Siren:Stop()
				end
			end
		end
	end)
end

return BaseService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">CarryService</string><ProtectedString name="Source"><![CDATA[-- CarryService.lua
-- Carrying treasures above your head: attaching models, the carry pose (arms
-- raised), movement penalty, delivering to your own base and dropping/returning
-- on death, leave or getting bonked.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local TreasureModels = require(Shared.TreasureModels)
local UpgradeData = require(Shared.UpgradeData)

local S

local CarryService = {}

local CARRY_SCALE = 0.75

local function getCarrying(player: Player)
	local session = S.DataService.Session(player)
	return session and session.Carrying or {}
end

function CarryService.Count(player: Player): number
	return #getCarrying(player)
end

function CarryService.Capacity(player: Player): number
	local data = S.DataService.Get(player)
	return data and UpgradeData.CarryCapacity(data) or 1
end

function CarryService.CanCarry(player: Player): boolean
	return CarryService.Count(player) < CarryService.Capacity(player)
end

function CarryService.IsCarryingStolen(player: Player): boolean
	for _, item in ipairs(getCarrying(player)) do
		if item.Source == "Steal" then
			return true
		end
	end
	return false
end

-- Carry pose: rotate shoulder joints so both arms hold the treasure overhead.
-- Changing Motor6D.C0 on the server replicates to every client and layers on
-- top of the default animations, so the pose is visible to all players.
local POSE_ANGLE = math.rad(165)
local function setPose(character: Model?, on: boolean)
	if not character then
		return
	end
	local joints = {}
	local function add(name: string, parentName: string, kind: string)
		local holder = character:FindFirstChild(parentName)
		local joint = holder and holder:FindFirstChild(name)
		if joint and joint:IsA("Motor6D") then
			table.insert(joints, { joint, kind })
		end
	end
	-- R15
	add("RightShoulder", "RightUpperArm", "R15")
	add("LeftShoulder", "LeftUpperArm", "R15")
	-- R6
	add("Right Shoulder", "Torso", "R6R")
	add("Left Shoulder", "Torso", "R6L")
	for _, j in ipairs(joints) do
		local joint: Motor6D, kind = j[1], j[2]
		local original = joint:GetAttribute("OriginalC0")
		if original == nil then
			joint:SetAttribute("OriginalC0", joint.C0)
			original = joint.C0
		end
		if on then
			if kind == "R15" then
				joint.C0 = original * CFrame.Angles(POSE_ANGLE, 0, 0)
			elseif kind == "R6R" then
				joint.C0 = original * CFrame.Angles(0, 0, POSE_ANGLE)
			else
				joint.C0 = original * CFrame.Angles(0, 0, -POSE_ANGLE)
			end
		else
			joint.C0 = original
		end
	end
end

local function restack(player: Player)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local list = getCarrying(player)
	if not hrp then
		return
	end
	for i, item in ipairs(list) do
		local model = item.Model
		if model and model.Parent then
			local root = model.PrimaryPart
			local weld = root:FindFirstChild("CarryWeld")
			if weld then
				weld:Destroy()
			end
			root.CFrame = hrp.CFrame * CFrame.new(0, 3.4 + (i - 1) * 2.8, 0)
			local w = Instance.new("WeldConstraint")
			w.Name = "CarryWeld"
			w.Part0 = hrp
			w.Part1 = root
			w.Parent = root
		end
	end
	setPose(char, #list > 0)
	S.PlayerService.ApplyMovement(player)
end

function CarryService.Add(player: Player, item)
	local def = TreasureData.Get(item.Id)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not def or not hrp then
		return false
	end
	local model = TreasureModels.Build(def, { Scale = CARRY_SCALE, CFrame = hrp.CFrame, Anchored = false })
	model.Name = "Carried_" .. def.Id
	model:SetAttribute("Carried", true)
	model.Parent = char
	item.Model = model
	item.Start = os.clock()
	table.insert(getCarrying(player), item)
	restack(player)
	S.StateService.PushStats(player)
	return true
end

function CarryService.Remove(player: Player, item)
	local list = getCarrying(player)
	local idx = table.find(list, item)
	if idx then
		table.remove(list, idx)
	end
	if item.Model then
		item.Model:Destroy()
		item.Model = nil
	end
	if player.Parent then
		restack(player)
		S.StateService.PushStats(player)
	end
end

-- Returns stolen items to their owners. Used when bonked.
function CarryService.DropStolen(player: Player): number
	local dropped = 0
	local list = table.clone(getCarrying(player))
	for _, item in ipairs(list) do
		if item.Source == "Steal" then
			CarryService.Remove(player, item)
			S.StealService.Return(item, "bonked")
			dropped += 1
		end
	end
	return dropped
end

-- Death / leaving: stolen go home, world treasures drop on the ground,
-- purchased ones go to storage so nobody loses money.
function CarryService.DropAll(player: Player, position: Vector3?)
	local list = table.clone(getCarrying(player))
	for _, item in ipairs(list) do
		CarryService.Remove(player, item)
		if item.Source == "Steal" then
			S.StealService.Return(item, "dropped")
		elseif item.Source == "Market" then
			S.TreasureService.Give(player, item.Id, { Silent = true, NoAutoPlace = true })
		else
			if position then
				S.TreasureService.DropToWorld(item.Id, position, item.Source)
			end
		end
	end
end

local function deposit(player: Player)
	local list = table.clone(getCarrying(player))
	for _, item in ipairs(list) do
		CarryService.Remove(player, item)
		if item.Source == "Steal" then
			S.StealService.Complete(player, item)
		else
			S.TreasureService.Give(player, item.Id, { Source = item.Source })
		end
	end
end

function CarryService.Init(services)
	S = services
end

function CarryService.Start()
	-- Delivery + timeout loop
	task.spawn(function()
		while true do
			task.wait(0.2)
			for _, player in ipairs(Players:GetPlayers()) do
				local session = S.DataService.Session(player)
				if session and #session.Carrying > 0 then
					local char = player.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					local base = S.BaseService.Get(player)
					if hrp and base and S.BaseService.IsInside(base, hrp.Position) then
						deposit(player)
					else
						-- stolen treasure that takes too long goes back home
						for _, item in ipairs(table.clone(session.Carrying)) do
							if item.Source == "Steal" and os.clock() - item.Start > Config.Steal.CarryTimeout then
								CarryService.Remove(player, item)
								S.StealService.Return(item, "timeout")
								S.NetService.Notify(player, "You took too long! The treasure teleported home.", "warn")
							end
						end
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		CarryService.DropAll(player, hrp and hrp.Position or nil)
	end)
end

-- Called by PlayerService when a character dies.
function CarryService.OnDied(player: Player, position: Vector3?)
	CarryService.DropAll(player, position)
end

return CarryService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- DataService.lua
-- Loads, holds and saves player progress with DataStoreService.
--  * UpdateAsync with a session lock so two servers never write the same save
--  * retries with backoff, autosave, save on leave and on shutdown
--  * works in Studio without API access (progress just isn't persisted)
--  * Sessions[player] holds non-saved runtime state (cooldowns, carrying, ...)

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local DataService = {}

local TEMPLATE = {
	Version = Config.DataVersion,
	Money = Config.StartingMoney,
	TotalEarned = 0,
	Rebirths = 0,
	XP = 0,
	Level = 1,
	Upgrades = { Speed = 0, Carry = 0, Base = 0, Protection = 0, Income = 0 },
	Abilities = {},
	Treasures = {}, -- [uid] = { Id = string, Plot = number? }
	Index = {}, -- [treasureId] = true
	Secrets = {}, -- [secretName] = true
	Settings = { Music = true, Sfx = true, LowGfx = false, UIScale = 1, Effects = true },
	Stats = { Steals = 0, Robbed = 0, Collected = 0, Trades = 0, Defends = 0 },
	Titles = {},
	Title = "",
	Trail = nil,
	LastOnline = 0,
	FirstJoin = 0,
}
DataService.Template = TEMPLATE

local SESSION_STALE = 30 * 60 -- a lock older than this is considered abandoned

local store: DataStore? = nil
local canSave = true

DataService.Profiles = {} :: { [Player]: any }
DataService.Sessions = {} :: { [Player]: any }
DataService.Loaded = Instance.new("BindableEvent")
DataService.Dirty = {} :: { [Player]: boolean } -- full-state resend pending

local function retry(fn, attempts: number)
	local lastErr
	for i = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		task.wait(math.min(2 ^ i, 8))
	end
	return false, lastErr
end

local function newSession(player: Player)
	return {
		Player = player,
		BaseIndex = nil,
		LockEnd = 0,
		LockCooldownEnd = 0,
		StealCooldownEnd = 0,
		ShieldEnd = workspace:GetServerTimeNow() + Config.Steal.NewPlayerShield,
		VictimCooldowns = {}, -- [victimUserId] = endTime
		Carrying = {}, -- list of carried items (CarryService)
		Stealing = {}, -- [uid] = thief Player   (my treasures being stolen right now)
		AbilityCooldowns = {},
		Cloaked = false,
		SuperJump = false,
		LastBonk = 0,
		Trade = nil,
		MPS = 0,
		JoinTime = os.time(),
	}
end

function DataService.Get(player: Player)
	return DataService.Profiles[player]
end

function DataService.Session(player: Player)
	return DataService.Sessions[player]
end

function DataService.IsLoaded(player: Player): boolean
	return DataService.Profiles[player] ~= nil
end

function DataService.MarkDirty(player: Player)
	DataService.Dirty[player] = true
end

-- Waits until a player's data is loaded (or they leave). Returns data or nil.
function DataService.WaitFor(player: Player)
	while player.Parent and not DataService.Profiles[player] do
		task.wait(0.1)
	end
	return DataService.Profiles[player]
end

local function key(player: Player): string
	return "Player_" .. player.UserId
end

local function load(player: Player)
	local data
	if store and canSave then
		local attempts = 0
		while true do
			attempts += 1
			local locked = false
			local ok, result = retry(function()
				return (store :: DataStore):UpdateAsync(key(player), function(old)
					old = old or {}
					local lock = old.SessionLock
					if lock and lock.JobId ~= game.JobId and os.time() - (lock.Time or 0) < SESSION_STALE and attempts < 4 then
						locked = true
						return nil -- cancel, someone else still has it
					end
					old.SessionLock = { JobId = game.JobId, Time = os.time() }
					return old
				end)
			end, 4)
			if not ok then
				warn("[Data] load failed for " .. player.Name .. ": " .. tostring(result))
				player:Kick("Could not load your data. Please rejoin in a moment.")
				return nil
			end
			if not locked then
				data = result
				break
			end
			task.wait(6) -- previous server is still saving, wait and retry
		end
	end
	data = data or {}
	Util.Reconcile(data, TEMPLATE)
	data.SessionLock = nil
	if data.FirstJoin == 0 then
		data.FirstJoin = os.time()
	end
	return data
end

local function serialize(data)
	local copy = Util.DeepCopy(data)
	copy.SessionLock = nil
	return copy
end

function DataService.Save(player: Player, release: boolean?)
	local data = DataService.Profiles[player]
	if not data or not store or not canSave then
		return false
	end
	data.LastOnline = os.time()
	local payload = serialize(data)
	local ok, err = retry(function()
		return (store :: DataStore):UpdateAsync(key(player), function(old)
			local lock = old and old.SessionLock
			if lock and lock.JobId ~= game.JobId and os.time() - (lock.Time or 0) < SESSION_STALE then
				return nil -- another server owns this save now; don't overwrite it
			end
			if not release then
				payload.SessionLock = { JobId = game.JobId, Time = os.time() }
			end
			return payload
		end)
	end, 3)
	if not ok then
		warn("[Data] save failed for " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
		-- In Studio, check API access once so we don't spam errors.
		if RunService:IsStudio() then
			local accessOk = pcall(function()
				(store :: DataStore):GetAsync("__probe")
			end)
			if not accessOk then
				canSave = false
				warn("[Data] DataStore unavailable in Studio (enable 'Studio Access to API Services'). Progress won't save.")
			end
		end
	else
		canSave = false
		warn("[Data] DataStoreService unavailable: " .. tostring(result))
	end
end

function DataService.CanSave()
	return canSave and store ~= nil
end

function DataService.Start()
	local function onJoin(player: Player)
		DataService.Sessions[player] = newSession(player)
		local data = load(player)
		if not data or not player.Parent then
			return
		end
		DataService.Profiles[player] = data
		DataService.Loaded:Fire(player)
	end

	Players.PlayerAdded:Connect(onJoin)
	for _, p in ipairs(Players:GetPlayers()) do
		task.defer(onJoin, p) -- defer so every service has connected first
	end

	Players.PlayerRemoving:Connect(function(player)
		-- Other services clean up on PlayerRemoving too; give them a frame.
		task.defer(function()
			if DataService.Profiles[player] then
				DataService.Save(player, true)
			end
			DataService.Profiles[player] = nil
			DataService.Sessions[player] = nil
			DataService.Dirty[player] = nil
		end)
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in pairs(DataService.Profiles) do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(DataService.Profiles) do
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[-- EconomyService.lua
-- Passive income, money/XP helpers, levels, offline earnings and the global
-- income multiplier used by events (Golden Hour).

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local UpgradeData = require(Shared.UpgradeData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local EconomyService = {}
EconomyService.EventMultiplier = 1

function EconomyService.AddMoney(player: Player, amount: number)
	local data = S.DataService.Get(player)
	if not data or amount ~= amount then -- NaN guard
		return
	end
	data.Money = math.max(0, data.Money + amount)
	if amount > 0 then
		data.TotalEarned += amount
	end
	S.StateService.PushStats(player)
end

function EconomyService.AddXP(player: Player, amount: number)
	local data = S.DataService.Get(player)
	if not data then
		return
	end
	data.XP += amount
	local leveled = false
	while data.XP >= Config.XPForLevel(data.Level) do
		data.XP -= Config.XPForLevel(data.Level)
		data.Level += 1
		leveled = true
		-- level reward
		local reward = 100 * data.Level * data.Level
		data.Money += reward
		S.NetService.Notify(player, ("⭐ LEVEL %d! +%s"):format(data.Level, Util.Money(reward)), "level")
	end
	if leveled then
		Remotes.Effect:FireClient(player, "LevelUp", data.Level)
		S.PlayerService.UpdateOverhead(player)
	end
	S.StateService.PushStats(player)
end

-- Money per second from all placed treasures (not being stolen).
function EconomyService.ComputeMPS(player: Player): number
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return 0
	end
	local total = 0
	for uid, t in pairs(data.Treasures) do
		if t.Plot and not session.Stealing[uid] then
			local def = TreasureData.Get(t.Id)
			if def then
				total += def.MPS
			end
		end
	end
	return total * UpgradeData.IncomeMultiplier(data) * EconomyService.EventMultiplier
end

function EconomyService.GrantOffline(player: Player)
	local data = S.DataService.Get(player)
	if not data or (data.LastOnline or 0) <= 0 then
		return
	end
	local away = math.min(os.time() - data.LastOnline, Config.OfflineIncomeMaxSeconds)
	if away < 60 then
		return
	end
	local mps = 0
	for _, t in pairs(data.Treasures) do
		if t.Plot then
			local def = TreasureData.Get(t.Id)
			mps += def and def.MPS or 0
		end
	end
	mps *= UpgradeData.IncomeMultiplier(data)
	local earned = math.floor(mps * away * Config.OfflineIncomeRate)
	if earned > 0 then
		EconomyService.AddMoney(player, earned)
		S.NetService.Notify(player, ("💤 Welcome back! Your treasures earned %s while you were away (%s)."):format(Util.Money(earned), Util.Time(away)), "discovery")
	end
end

function EconomyService.Init(services)
	S = services
end

function EconomyService.Start()
	task.spawn(function()
		while true do
			task.wait(Config.IncomeTickSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.DataService.Get(player)
				local session = S.DataService.Session(player)
				if data and session then
					local mps = EconomyService.ComputeMPS(player)
					session.MPS = mps
					local gain = mps * Config.IncomeTickSeconds
					if gain > 0 then
						data.Money += gain
						data.TotalEarned += gain
					end
					S.StateService.PushStats(player)
				end
			end
		end
	end)
end

return EconomyService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[-- EventService.lua
-- Timed world events that pull players to special locations:
--   Golden Hour     - 2x income for everyone, fountain turns gold
--   Meteor Shower   - meteors crash into the Meteor Crater dropping Epic+ loot
--   Treasure Rain   - a burst of free treasures across every field
--   Divine Descent  - a Mythical+ treasure descends onto the Celestial Shrine

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local Remotes = require(Shared.Remotes)

local S

local EventService = {}
EventService.Current = nil :: string?

local rng = Random.new()

local function setState(name: string?, duration: number)
	EventService.Current = name
	workspace:SetAttribute("Event", name or "")
	workspace:SetAttribute("EventEnd", name and (workspace:GetServerTimeNow() + duration) or 0)
	Remotes.EventState:FireAllClients(name, duration)
end

local function goldenHour()
	local d = Config.Events.GoldenHourDuration
	setState("Golden Hour", d)
	Remotes.Announce:FireAllClients(("🌟 GOLDEN HOUR! All income x%d for %ds!"):format(Config.Events.GoldenHourMultiplier, d), "Legendary")
	S.EconomyService.EventMultiplier = Config.Events.GoldenHourMultiplier
	local water = S.MapBuilder.Map.FountainWater
	local oldColor = water and water.Color
	if water then
		water.Color = Color3.fromRGB(255, 210, 60)
		water.Material = Enum.Material.Neon
	end
	task.wait(d)
	S.EconomyService.EventMultiplier = 1
	if water then
		water.Color = oldColor
		water.Material = Enum.Material.Glass
	end
	setState(nil, 0)
end

local function meteorShower()
	local crater = S.MapBuilder.Map.Crater
	setState("Meteor Shower", 40)
	Remotes.Announce:FireAllClients("☄️ METEOR SHOWER at the Meteor Crater! Epic+ treasures incoming!", "Epic")
	task.wait(4)
	for i = 1, Config.Events.MeteorCount do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(0, crater.Radius - 6)
		local target = crater.Center + Vector3.new(math.cos(a) * r, 0.5, math.sin(a) * r)
		local start = target + Vector3.new(rng:NextNumber(-60, 60), 260, rng:NextNumber(-60, 60))
		local meteor = Instance.new("Part")
		meteor.Shape = Enum.PartType.Ball
		meteor.Size = Vector3.new(7, 7, 7)
		meteor.Material = Enum.Material.CrackedLava
		meteor.Color = Color3.fromRGB(255, 120, 40)
		meteor.Anchored = true
		meteor.CanCollide = false
		meteor.CanQuery = false
		meteor.CFrame = CFrame.new(start)
		local fire = Instance.new("Fire")
		fire.Size = 14
		fire.Heat = 20
		fire.Parent = meteor
		local light = Instance.new("PointLight")
		light.Range = 40
		light.Brightness = 4
		light.Color = Color3.fromRGB(255, 140, 40)
		light.Parent = meteor
		meteor.Parent = workspace
		local tween = TweenService:Create(meteor, TweenInfo.new(2.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(target) })
		tween:Play()
		task.delay(2.2, function()
			local boom = Instance.new("Explosion")
			boom.Position = target
			boom.BlastRadius = 10
			boom.BlastPressure = 0 -- visual only, nobody gets hurt
			boom.DestroyJointRadiusPercent = 0
			boom.Parent = workspace
			Remotes.Effect:FireAllClients("Shake", target, 0.6)
			meteor.Anchored = true
			Debris:AddItem(meteor, 0.2)
			local def = TreasureData.RollFromPool(Config.SpawnPools.Meteor, rng)
			S.TreasureService.SpawnWorld(def, CFrame.new(target), "Event", { Region = "Meteor Crater", Lifetime = 180 })
		end)
		task.wait(rng:NextNumber(1.5, 4))
	end
	task.wait(20)
	setState(nil, 0)
end

local function treasureRain()
	setState("Treasure Rain", 30)
	Remotes.Announce:FireAllClients("🌧️ TREASURE RAIN! Free treasures are falling on every field!", "Rare")
	local fields = S.MapBuilder.Map.Fields
	for i = 1, Config.Events.TreasureRainCount do
		local field = fields[rng:NextInteger(1, #fields)]
		S.TreasureService.SpawnInField(field, { Uncommon = 40, Rare = 35, Epic = 18, Legendary = 6, Mythical = 1 })
		task.wait(0.6)
	end
	task.wait(15)
	setState(nil, 0)
end

local function divineDescent()
	local altar = S.MapBuilder.Map.ShrineAltar
	setState("Divine Descent", 120)
	Remotes.Announce:FireAllClients("👼 DIVINE DESCENT! A legendary relic is descending on the Celestial Shrine!", "Divine")
	task.wait(6)
	local def = TreasureData.RollFromPool(Config.SpawnPools.Divine, rng)
	local record = S.TreasureService.SpawnWorld(def, altar, "Event", { Region = "Celestial Shrine", Lifetime = 120 })
	Remotes.Announce:FireAllClients(("👼 A %s %s has landed on the shrine! First come, first served!"):format(def.Rarity, def.Name), def.Rarity)
	local t = 0
	while t < 120 and S.TreasureService.World[record.Uid] do
		task.wait(1)
		t += 1
	end
	setState(nil, 0)
end

local EVENTS = {
	{ Fn = goldenHour, Weight = 30 },
	{ Fn = meteorShower, Weight = 30 },
	{ Fn = treasureRain, Weight = 30 },
	{ Fn = divineDescent, Weight = 10 },
}

function EventService.RunRandom()
	local total = 0
	for _, e in ipairs(EVENTS) do
		total += e.Weight
	end
	local pick = rng:NextNumber() * total
	for _, e in ipairs(EVENTS) do
		if pick <= e.Weight then
			e.Fn()
			return
		end
		pick -= e.Weight
	end
end

function EventService.Init(services)
	S = services
end

function EventService.Start()
	setState(nil, 0)
	task.spawn(function()
		while true do
			local wait = rng:NextNumber(Config.Events.IntervalMin, Config.Events.IntervalMax)
			workspace:SetAttribute("NextEvent", workspace:GetServerTimeNow() + wait)
			task.wait(wait)
			local ok, err = pcall(EventService.RunRandom)
			if not ok then
				warn("[Events] " .. tostring(err))
				setState(nil, 0)
				S.EconomyService.EventMultiplier = 1
			end
		end
	end)
end

return EventService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[-- LeaderboardService.lua
-- Global leaderboards (OrderedDataStore) for Richest players and Most
-- Rebirths, plus a live server board. Shown in the UI and on the physical
-- board in the marketplace.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local LeaderboardService = {}
LeaderboardService.Cache = { Richest = {}, Rebirths = {}, Server = {} }

local UPDATE_INTERVAL = 120
local MAX_SAFE = 2 ^ 52

local stores = {}
local nameCache: { [number]: string } = {}

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local p = Players:GetPlayerByUserId(userId)
	if p then
		nameCache[userId] = p.DisplayName
		return p.DisplayName
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	nameCache[userId] = ok and name or ("Player" .. userId)
	return nameCache[userId]
end

local function pushScores()
	if not stores.Richest then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local data = S.DataService.Get(player)
		if data then
			local key = tostring(player.UserId)
			pcall(function()
				stores.Richest:SetAsync(key, math.floor(math.min(data.Money, MAX_SAFE)))
			end)
			pcall(function()
				stores.Rebirths:SetAsync(key, data.Rebirths)
			end)
		end
	end
end

local function fetch(store): { any }
	local list = {}
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, 50)
	end)
	if not ok or not pages then
		return list
	end
	local okPage, entries = pcall(function()
		return pages:GetCurrentPage()
	end)
	if not okPage then
		return list
	end
	for rank, entry in ipairs(entries) do
		local userId = tonumber(entry.key)
		if userId then
			table.insert(list, { Rank = rank, UserId = userId, Name = nameFor(userId), Value = entry.value })
		end
	end
	return list
end

local function buildServer()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local data = S.DataService.Get(player)
		local ses = S.DataService.Session(player)
		if data then
			table.insert(list, {
				UserId = player.UserId,
				Name = player.DisplayName,
				Value = data.Money,
				MPS = ses and ses.MPS or 0,
				Rebirths = data.Rebirths,
				Level = data.Level,
			})
		end
	end
	table.sort(list, function(a, b)
		return a.Value > b.Value
	end)
	for i, e in ipairs(list) do
		e.Rank = i
	end
	return list
end

local boardRows: { TextLabel } = {}
local function buildBoard()
	local board = S.MapBuilder.Map.LeaderboardBoard
	if not board then
		return
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = board
	local title = Instance.new("TextLabel")
	title.BackgroundColor3 = Color3.fromRGB(255, 190, 40)
	title.Size = UDim2.fromScale(1, 0.12)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(40, 25, 0)
	title.Text = "🏆 RICHEST PLAYERS (GLOBAL)"
	title.Parent = gui
	for i = 1, 10 do
		local row = Instance.new("TextLabel")
		row.BackgroundTransparency = i % 2 == 0 and 0.85 or 1
		row.BackgroundColor3 = Color3.new(1, 1, 1)
		row.Position = UDim2.fromScale(0.03, 0.13 + (i - 1) * 0.086)
		row.Size = UDim2.fromScale(0.94, 0.08)
		row.Font = Enum.Font.GothamBold
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = i == 1 and Color3.fromRGB(255, 215, 80) or (i == 2 and Color3.fromRGB(220, 220, 235) or (i == 3 and Color3.fromRGB(230, 150, 90) or Color3.new(1, 1, 1)))
		row.Text = ""
		row.Parent = gui
		boardRows[i] = row
	end
end

local function updateBoard()
	local list = LeaderboardService.Cache.Richest
	if #list == 0 then
		list = LeaderboardService.Cache.Server
	end
	for i, row in ipairs(boardRows) do
		local e = list[i]
		row.Text = e and ("  #%d  %s  —  %s"):format(i, e.Name, Util.Money(e.Value)) or ""
	end
end

local function broadcast(target: Player?)
	if target then
		Remotes.Leaderboard:FireClient(target, LeaderboardService.Cache)
	else
		Remotes.Leaderboard:FireAllClients(LeaderboardService.Cache)
	end
end

function LeaderboardService.Init(services)
	S = services
	local ok = pcall(function()
		stores.Richest = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
		stores.Rebirths = DataStoreService:GetOrderedDataStore(Config.RebirthBoardStoreName)
	end)
	if not ok or not S.DataService.CanSave() then
		stores = {}
	end
end

function LeaderboardService.Start()
	buildBoard()
	S.NetService.Handle("GetLeaderboard", function(player)
		LeaderboardService.Cache.Server = buildServer()
		broadcast(player)
		return true
	end)
	-- live server board every 5s
	task.spawn(function()
		while true do
			LeaderboardService.Cache.Server = buildServer()
			updateBoard()
			task.wait(5)
		end
	end)
	-- global boards
	task.spawn(function()
		task.wait(10)
		while true do
			pushScores()
			if stores.Richest then
				LeaderboardService.Cache.Richest = fetch(stores.Richest)
				LeaderboardService.Cache.Rebirths = fetch(stores.Rebirths)
			end
			updateBoard()
			broadcast()
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return LeaderboardService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- MapBuilder.lua
-- Builds the whole world procedurally at server start:
--   central treasure marketplace (stalls, fountain, shop, rebirth altar, sell
--   station, global leaderboard), 8 base slots, treasure fields, decorations,
--   border mountains, 3 secret areas and 2 special event locations.
-- Everything is generated from code so the place file needs no assets.

local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local MapBuilder = {}
MapBuilder.Map = nil

local rng = Random.new(1337)

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, props: { [string]: any }?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end
MapBuilder.Part = part

local function cyl(parent, height, diameter, cf, color, material, props)
	local p = part(parent, Vector3.new(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.rad(90)), color, material, props)
	p.Shape = Enum.PartType.Cylinder
	return p
end
MapBuilder.Cylinder = cyl

local function ball(parent, d, pos, color, material, props)
	local p = part(parent, Vector3.new(d, d, d), CFrame.new(pos), color, material, props)
	p.Shape = Enum.PartType.Ball
	return p
end

local function folder(name: string, parent: Instance)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function billboardText(adornee: BasePart, text: string, color: Color3, size: UDim2?, offset: number?)
	local bb = Instance.new("BillboardGui")
	bb.Size = size or UDim2.fromOffset(260, 60)
	bb.StudsOffset = Vector3.new(0, offset or 4, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 220
	bb.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(20, 20, 40)
	stroke.Parent = label
	label.Parent = bb
	bb.Parent = adornee
	return bb, label
end
MapBuilder.Billboard = billboardText

local function addPrompt(p: BasePart, action: string, object: string, uiName: string)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt:SetAttribute("OpenUI", uiName)
	prompt.Parent = p
	return prompt
end

-- Lighting ------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 14.2
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(90, 90, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 170)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 2200
	Lighting.FogColor = Color3.fromRGB(190, 220, 255)

	local function ensure(className: string, name: string)
		local inst = Lighting:FindFirstChild(name)
		if not inst then
			inst = Instance.new(className)
			inst.Name = name
			inst.Parent = Lighting
		end
		return inst
	end
	local atmo = ensure("Atmosphere", "Atmosphere") :: Atmosphere
	atmo.Density = 0.28
	atmo.Offset = 0.15
	atmo.Color = Color3.fromRGB(200, 225, 255)
	atmo.Decay = Color3.fromRGB(120, 150, 220)
	atmo.Glare = 0.2
	atmo.Haze = 1.2
	local cc = ensure("ColorCorrectionEffect", "GameColor") :: ColorCorrectionEffect
	cc.Saturation = 0.18
	cc.Contrast = 0.06
	cc.Brightness = 0.02
	local bloom = ensure("BloomEffect", "GameBloom") :: BloomEffect
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.6
	local rays = ensure("SunRaysEffect", "GameSunRays") :: SunRaysEffect
	rays.Intensity = 0.06
	rays.Spread = 0.8
	ensure("Sky", "GameSky")
end

-- Pieces ----------------------------------------------------------------------
local TREE_LEAF_COLORS = {
	Color3.fromRGB(80, 200, 90),
	Color3.fromRGB(60, 170, 80),
	Color3.fromRGB(255, 140, 190),
	Color3.fromRGB(255, 170, 60),
	Color3.fromRGB(150, 220, 70),
	Color3.fromRGB(170, 120, 255),
}

local function tree(parent: Instance, pos: Vector3, scale: number, leafColor: Color3?)
	local m = Instance.new("Model")
	m.Name = "Tree"
	local h = 10 * scale
	cyl(m, h, 2.2 * scale, CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(120, 80, 50), Enum.Material.Wood, { CastShadow = true })
	local c = leafColor or TREE_LEAF_COLORS[rng:NextInteger(1, #TREE_LEAF_COLORS)]
	ball(m, 9 * scale, pos + Vector3.new(0, h + 2 * scale, 0), c, Enum.Material.Grass)
	ball(m, 6 * scale, pos + Vector3.new(2.5 * scale, h + 4.5 * scale, 1 * scale), c:Lerp(Color3.new(1, 1, 1), 0.12), Enum.Material.Grass)
	m.Parent = parent
	return m
end

local function rock(parent, pos: Vector3, size: Vector3, color: Color3?)
	return part(parent, size, CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.3, 0.3)), color or Color3.fromRGB(130, 130, 140), Enum.Material.Slate)
end

local function zonePart(parent, name: string, size: Vector3, cf: CFrame)
	local z = part(parent, size, cf, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
		Name = name,
	})
	return z
end

-- Plaza / marketplace ---------------------------------------------------------
local function buildPlaza(root: Instance, map)
	local plaza = folder("Marketplace", root)
	cyl(plaza, 1, 150, CFrame.new(0, 0.5, 0), Color3.fromRGB(240, 232, 215), Enum.Material.Marble)
	cyl(plaza, 1.1, 100, CFrame.new(0, 0.55, 0), Color3.fromRGB(255, 210, 120), Enum.Material.Sandstone)
	cyl(plaza, 1.2, 70, CFrame.new(0, 0.6, 0), Color3.fromRGB(240, 232, 215), Enum.Material.Marble)

	-- Fountain
	local f = folder("Fountain", plaza)
	cyl(f, 3, 26, CFrame.new(0, 2, 0), Color3.fromRGB(220, 220, 230), Enum.Material.Marble)
	local water = cyl(f, 0.6, 23, CFrame.new(0, 3.4, 0), Color3.fromRGB(80, 190, 255), Enum.Material.Glass, { Transparency = 0.25, Name = "Water" })
	cyl(f, 8, 3, CFrame.new(0, 7, 0), Color3.fromRGB(220, 220, 230), Enum.Material.Marble)
	cyl(f, 1.5, 10, CFrame.new(0, 11, 0), Color3.fromRGB(220, 220, 230), Enum.Material.Marble)
	local top = ball(f, 4, Vector3.new(0, 13.5, 0), Color3.fromRGB(255, 215, 80), Enum.Material.Neon, { Name = "FountainGem" })
	local spray = Instance.new("ParticleEmitter")
	spray.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	spray.Color = ColorSequence.new(Color3.fromRGB(180, 235, 255))
	spray.Rate = 30
	spray.Speed = NumberRange.new(10, 14)
	spray.SpreadAngle = Vector2.new(25, 25)
	spray.Acceleration = Vector3.new(0, -25, 0)
	spray.Lifetime = NumberRange.new(1, 1.4)
	spray.Size = NumberSequence.new(0.5, 0.1)
	spray.LightEmission = 0.5
	spray.Parent = top
	local light = Instance.new("PointLight")
	light.Range = 24
	light.Brightness = 2
	light.Color = Color3.fromRGB(255, 220, 120)
	light.Parent = top
	map.FountainWater = water
	map.FountainGem = top

	-- Title sign
	local sign = part(plaza, Vector3.new(1, 1, 1), CFrame.new(0, 26, 0), Color3.new(1, 1, 1), nil, { Transparency = 1, CanCollide = false, CanQuery = false })
	billboardText(sign, "💎 TREASURE MARKET 💎", Color3.fromRGB(255, 220, 80), UDim2.fromOffset(520, 90), 0).MaxDistance = 600

	-- Market stalls
	local stalls = folder("Stalls", plaza)
	map.Stalls = {}
	local stallColors = {
		Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 170, 60), Color3.fromRGB(255, 230, 80),
		Color3.fromRGB(110, 220, 110), Color3.fromRGB(80, 200, 255), Color3.fromRGB(150, 120, 255),
		Color3.fromRGB(255, 120, 210), Color3.fromRGB(80, 230, 200), Color3.fromRGB(255, 140, 100),
		Color3.fromRGB(180, 230, 90),
	}
	for i = 1, Config.Market.Stalls do
		local a = (i - 1) / Config.Market.Stalls * math.pi * 2
		local pos = Vector3.new(math.cos(a) * 44, 1.2, math.sin(a) * 44)
		local cf = CFrame.lookAt(pos, Vector3.new(0, 1.2, 0))
		local m = Instance.new("Model")
		m.Name = "Stall" .. i
		local color = stallColors[(i - 1) % #stallColors + 1]
		part(m, Vector3.new(8, 3, 8), cf * CFrame.new(0, 1.5, 0), Color3.fromRGB(250, 245, 235), Enum.Material.Wood)
		part(m, Vector3.new(8.4, 0.4, 8.4), cf * CFrame.new(0, 3.1, 0), color, Enum.Material.SmoothPlastic)
		for _, o in ipairs({ Vector3.new(-4, 0, -4), Vector3.new(4, 0, -4), Vector3.new(-4, 0, 4), Vector3.new(4, 0, 4) }) do
			part(m, Vector3.new(0.6, 12, 0.6), cf * CFrame.new(o.X, 6, o.Z), Color3.fromRGB(255, 255, 255), Enum.Material.Wood)
		end
		local roof = Instance.new("WedgePart")
		roof.Anchored = true
		roof.Size = Vector3.new(10, 2.5, 5)
		roof.Color = color
		roof.Material = Enum.Material.Fabric
		roof.CFrame = cf * CFrame.new(0, 13.25, 2.5)
		roof.Parent = m
		local roof2 = roof:Clone()
		roof2.CFrame = cf * CFrame.new(0, 13.25, -2.5) * CFrame.Angles(0, math.pi, 0)
		roof2.Parent = m
		m.Parent = stalls
		table.insert(map.Stalls, { Index = i, CFrame = cf * CFrame.new(0, 3.3, 0) })
	end

	-- Buildings: shop, rebirth altar, sell station, leaderboard
	local function station(name: string, angleDeg: number, color: Color3, label: string, action: string, ui: string)
		local a = math.rad(angleDeg)
		local pos = Vector3.new(math.cos(a) * 64, 1.2, math.sin(a) * 64)
		local cf = CFrame.lookAt(pos, Vector3.new(0, 1.2, 0))
		local m = Instance.new("Model")
		m.Name = name
		part(m, Vector3.new(18, 1, 12), cf * CFrame.new(0, 0.5, 0), Color3.fromRGB(60, 60, 80), Enum.Material.Slate)
		local counter = part(m, Vector3.new(14, 4, 3), cf * CFrame.new(0, 3, -2), color, Enum.Material.SmoothPlastic, { Name = "Counter" })
		part(m, Vector3.new(14.2, 0.4, 3.2), cf * CFrame.new(0, 5.1, -2), Color3.fromRGB(255, 255, 255), Enum.Material.Marble)
		part(m, Vector3.new(18, 1, 12), cf * CFrame.new(0, 16, 0), color, Enum.Material.SmoothPlastic)
		for _, x in ipairs({ -8, 8 }) do
			part(m, Vector3.new(1.2, 15, 1.2), cf * CFrame.new(x, 8.5, 5), Color3.fromRGB(255, 255, 255), Enum.Material.Marble)
			part(m, Vector3.new(1.2, 15, 1.2), cf * CFrame.new(x, 8.5, -5), Color3.fromRGB(255, 255, 255), Enum.Material.Marble)
		end
		local glow = part(m, Vector3.new(3, 3, 3), cf * CFrame.new(0, 7, -2) * CFrame.Angles(math.rad(45), 0, math.rad(45)), color, Enum.Material.Neon, { Name = "Glow", CanCollide = false })
		local pl = Instance.new("PointLight")
		pl.Color = color
		pl.Range = 18
		pl.Brightness = 2
		pl.Parent = glow
		addPrompt(counter, action, label, ui)
		local signPart = part(m, Vector3.new(1, 1, 1), cf * CFrame.new(0, 19, 0), Color3.new(), nil, { Transparency = 1, CanCollide = false, CanQuery = false })
		billboardText(signPart, label, color:Lerp(Color3.new(1, 1, 1), 0.3), UDim2.fromOffset(300, 70), 0)
		m.Parent = plaza
		return m, cf
	end
	map.Shop = station("Shop", 22.5, Color3.fromRGB(60, 170, 255), "🛒 UPGRADE SHOP", "Open Shop", "Shop")
	map.RebirthAltar = station("RebirthAltar", 112.5, Color3.fromRGB(255, 80, 170), "🌀 REBIRTH ALTAR", "Rebirth", "Rebirth")
	map.SellStation = station("SellStation", 202.5, Color3.fromRGB(90, 220, 110), "💰 SELL TREASURES", "Sell", "Sell")

	-- Leaderboard board
	local a = math.rad(292.5)
	local pos = Vector3.new(math.cos(a) * 64, 0, math.sin(a) * 64)
	local cf = CFrame.lookAt(pos, Vector3.new(0, 0, 0))
	local lb = Instance.new("Model")
	lb.Name = "GlobalLeaderboard"
	part(lb, Vector3.new(1.5, 26, 1.5), cf * CFrame.new(-11, 13, 0), Color3.fromRGB(255, 200, 60), Enum.Material.Metal)
	part(lb, Vector3.new(1.5, 26, 1.5), cf * CFrame.new(11, 13, 0), Color3.fromRGB(255, 200, 60), Enum.Material.Metal)
	local board = part(lb, Vector3.new(21, 22, 1), cf * CFrame.new(0, 14, 0), Color3.fromRGB(25, 25, 45), Enum.Material.SmoothPlastic, { Name = "Board" })
	addPrompt(board, "View", "🏆 Leaderboard", "Leaderboard")
	lb.Parent = plaza
	map.LeaderboardBoard = board

	-- Trade booth (opens trade menu)
	map.TradeBooth = station("TradeBooth", 157.5, Color3.fromRGB(255, 200, 60), "🤝 TRADING POST", "Trade", "Trade")
	map.IndexBooth = station("IndexBooth", 337.5, Color3.fromRGB(170, 110, 255), "📖 TREASURE INDEX", "View Index", "Index")

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(0, 1.2, 24)
	spawn.Color = Color3.fromRGB(255, 220, 90)
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.4
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = plaza
end

-- Fields ---------------------------------------------------------------------
local FLOWER_COLORS = {
	Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 220, 60), Color3.fromRGB(140, 120, 255),
	Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 150, 60), Color3.fromRGB(90, 220, 255),
}

local function buildFields(root: Instance, map)
	local fields = folder("TreasureFields", root)
	map.Fields = {}
	local names = { "Sunny Meadow", "Golden Grove", "Crystal Clearing", "Rainbow Patch", "Mushroom Hollow", "Starlight Glade", "Coral Garden", "Lucky Lawn" }
	for i = 0, 7 do
		local a = math.rad(22.5 + i * 45)
		local center = Vector3.new(math.cos(a) * 140, 0, math.sin(a) * 140)
		local m = Instance.new("Model")
		m.Name = names[i + 1]
		local color = FLOWER_COLORS[i % #FLOWER_COLORS + 1]
		cyl(m, 0.4, 48, CFrame.new(center + Vector3.new(0, 0.2, 0)), Color3.fromRGB(120, 220, 100), Enum.Material.Grass)
		cyl(m, 0.5, 44, CFrame.new(center + Vector3.new(0, 0.25, 0)), color:Lerp(Color3.fromRGB(120, 220, 100), 0.75), Enum.Material.Grass)
		for _ = 1, 16 do
			local r = rng:NextNumber(4, 21)
			local t = rng:NextNumber(0, math.pi * 2)
			local p = center + Vector3.new(math.cos(t) * r, 0.9, math.sin(t) * r)
			ball(m, rng:NextNumber(0.8, 1.4), p, FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)], Enum.Material.SmoothPlastic, { CanCollide = false, CastShadow = false })
		end
		local signPost = part(m, Vector3.new(0.6, 6, 0.6), CFrame.new(center + Vector3.new(0, 3, 0) - (center.Unit * 24)), Color3.fromRGB(140, 100, 60), Enum.Material.Wood)
		billboardText(signPost, "✨ " .. names[i + 1], Color3.fromRGB(255, 255, 255), UDim2.fromOffset(240, 50), 4)
		m.Parent = fields
		table.insert(map.Fields, { Name = names[i + 1], Center = center, Radius = 19 })
	end
end

-- Paths ------------------------------------------------------------------------
local function buildPaths(root: Instance)
	local paths = folder("Paths", root)
	for i = 0, Config.MaxBases - 1 do
		local a = math.rad(i * 45)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local from, to = dir * 75, dir * (Config.BaseRingRadius - Config.BaseSize / 2)
		local mid = (from + to) / 2
		local len = (to - from).Magnitude
		part(paths, Vector3.new(14, 0.3, len), CFrame.lookAt(mid + Vector3.new(0, 0.15, 0), to + Vector3.new(0, 0.15, 0)), Color3.fromRGB(230, 200, 150), Enum.Material.Sand)
		part(paths, Vector3.new(16, 0.25, len), CFrame.lookAt(mid + Vector3.new(0, 0.12, 0), to + Vector3.new(0, 0.12, 0)), Color3.fromRGB(190, 160, 120), Enum.Material.Cobblestone)
		-- lamp posts
		for d = 90, Config.BaseRingRadius - 50, 40 do
			for _, side in ipairs({ -1, 1 }) do
				local perp = Vector3.new(-dir.Z, 0, dir.X) * side * 10
				local p = dir * d + perp
				part(paths, Vector3.new(0.6, 9, 0.6), CFrame.new(p + Vector3.new(0, 4.5, 0)), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
				local bulb = ball(paths, 1.6, p + Vector3.new(0, 9.5, 0), Color3.fromRGB(255, 230, 160), Enum.Material.Neon)
				local l = Instance.new("PointLight")
				l.Range = 14
				l.Brightness = 1
				l.Color = Color3.fromRGB(255, 220, 150)
				l.Parent = bulb
			end
		end
	end
end

-- Decorations & border ---------------------------------------------------------------
local function isClear(pos: Vector3, map): boolean
	local flat = Vector3.new(pos.X, 0, pos.Z)
	if flat.Magnitude < 90 then
		return false
	end
	for i = 0, Config.MaxBases - 1 do
		local a = math.rad(i * 45)
		local c = Vector3.new(math.cos(a), 0, math.sin(a)) * Config.BaseRingRadius
		if (flat - c).Magnitude < 62 then
			return false
		end
		-- keep the path corridor free
		local dir = c.Unit
		local along = flat:Dot(dir)
		local perp = (flat - dir * along).Magnitude
		if along > 0 and along < Config.BaseRingRadius and perp < 16 then
			return false
		end
	end
	for _, f in ipairs(map.Fields) do
		if (flat - f.Center).Magnitude < 30 then
			return false
		end
	end
	for _, c in ipairs(map.KeepClear or {}) do
		if (flat - c.Pos).Magnitude < c.R then
			return false
		end
	end
	return true
end

local function buildNature(root: Instance, map)
	local nature = folder("Nature", root)
	local placed = 0
	local tries = 0
	while placed < 110 and tries < 2000 do
		tries += 1
		local r = rng:NextNumber(90, 560)
		local t = rng:NextNumber(0, math.pi * 2)
		local pos = Vector3.new(math.cos(t) * r, 0, math.sin(t) * r)
		if isClear(pos, map) then
			tree(nature, pos, rng:NextNumber(0.8, 1.5))
			placed += 1
		end
	end
	for _ = 1, 50 do
		local r = rng:NextNumber(100, 560)
		local t = rng:NextNumber(0, math.pi * 2)
		local pos = Vector3.new(math.cos(t) * r, 0.5, math.sin(t) * r)
		if isClear(pos, map) then
			rock(nature, pos, Vector3.new(rng:NextNumber(3, 7), rng:NextNumber(2, 5), rng:NextNumber(3, 7)))
		end
	end

	-- Border mountains + invisible wall
	local border = folder("Border", root)
	for i = 0, 47 do
		local a = i / 48 * math.pi * 2
		local r = rng:NextNumber(620, 660)
		local h = rng:NextNumber(70, 150)
		local w = rng:NextNumber(90, 130)
		local p = part(border, Vector3.new(w, h, w), CFrame.new(math.cos(a) * r, h / 2 - 10, math.sin(a) * r) * CFrame.Angles(0, a, math.rad(rng:NextNumber(-8, 8))), Color3.fromRGB(110, 150, 95):Lerp(Color3.fromRGB(150, 140, 130), rng:NextNumber()), Enum.Material.Rock)
		p.CastShadow = false
		part(border, Vector3.new(w * 0.6, 8, w * 0.6), p.CFrame * CFrame.new(0, h / 2, 0), Color3.fromRGB(245, 250, 255), Enum.Material.Snow, { CastShadow = false })
	end
	for i = 0, 3 do
		local a = i * math.pi / 2
		part(border, Vector3.new(1400, 400, 4), CFrame.new(math.cos(a) * 690, 200, math.sin(a) * 690) * CFrame.Angles(0, -a + math.pi / 2, 0), Color3.new(), nil, { Transparency = 1, CastShadow = false })
	end
end

-- Secret areas ------------------------------------------------------------------
local function buildSecretCave(root: Instance, map)
	local cave = folder("SecretCave", root)
	local rockColor = Color3.fromRGB(100, 95, 110)
	local z0 = -500 -- front face
	-- hollow cliff: interior x -15..15, y 0..18, z -535..-500
	part(cave, Vector3.new(45, 60, 40), CFrame.new(-37.5, 30, z0 - 20), rockColor, Enum.Material.Rock)
	part(cave, Vector3.new(45, 60, 40), CFrame.new(37.5, 30, z0 - 20), rockColor, Enum.Material.Rock)
	part(cave, Vector3.new(30, 42, 40), CFrame.new(0, 39, z0 - 20), rockColor, Enum.Material.Rock)
	part(cave, Vector3.new(30, 18, 5), CFrame.new(0, 9, z0 - 37.5), rockColor, Enum.Material.Rock)
	part(cave, Vector3.new(30, 1, 35), CFrame.new(0, 0.5, z0 - 17.5), Color3.fromRGB(60, 50, 80), Enum.Material.Slate)
	-- waterfall curtain (walk through it!)
	local fall = part(cave, Vector3.new(32, 34, 1), CFrame.new(0, 17, z0 + 1), Color3.fromRGB(120, 200, 255), Enum.Material.Glass, {
		Transparency = 0.35,
		CanCollide = false,
		CanQuery = false,
		Name = "Waterfall",
	})
	local mist = Instance.new("ParticleEmitter")
	mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
	mist.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255))
	mist.Rate = 15
	mist.Lifetime = NumberRange.new(1.5, 2.5)
	mist.Speed = NumberRange.new(2, 5)
	mist.Size = NumberSequence.new(3, 6)
	mist.Transparency = NumberSequence.new(0.6, 1)
	mist.EmissionDirection = Enum.NormalId.Bottom
	mist.Parent = fall
	cyl(cave, 0.6, 40, CFrame.new(0, 0.3, z0 + 10), Color3.fromRGB(80, 180, 255), Enum.Material.Glass, { Transparency = 0.3, CanCollide = false })
	-- crystals inside
	local crystalColors = { Color3.fromRGB(120, 255, 240), Color3.fromRGB(200, 120, 255), Color3.fromRGB(255, 120, 200) }
	for i = 1, 14 do
		local x = rng:NextNumber(-13, 13)
		local z = rng:NextNumber(z0 - 33, z0 - 4)
		local side = (i % 2 == 0)
		local pos = side and Vector3.new(x > 0 and 14 or -14, rng:NextNumber(2, 14), z) or Vector3.new(x, 1.5, z)
		if math.abs(x) < 6 and not side then
			pos = Vector3.new(x > 0 and 10 or -10, 1.5, z)
		end
		local c = part(cave, Vector3.new(1.2, rng:NextNumber(2.5, 5), 1.2), CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6), rng:NextNumber(-0.5, 0.5)), crystalColors[i % 3 + 1], Enum.Material.Neon, { CanCollide = false })
		if i % 4 == 0 then
			local l = Instance.new("PointLight")
			l.Color = c.Color
			l.Range = 14
			l.Parent = c
		end
	end
	local zone = zonePart(cave, "CaveZone", Vector3.new(30, 18, 35), CFrame.new(0, 9, z0 - 17.5))
	table.insert(map.Secrets, {
		Name = "Crystal Cave",
		Zone = zone,
		Spawns = { Vector3.new(-6, 1, z0 - 28), Vector3.new(6, 1, z0 - 20), Vector3.new(0, 1, z0 - 12) },
	})
	table.insert(map.KeepClear, { Pos = Vector3.new(0, 0, z0 - 10), R = 60 })
end

local function buildSkyIsland(root: Instance, map)
	local sky = folder("SkyIsland", root)
	local center = Vector3.new(330, 0, 330)
	local islandY = 150
	-- parkour spiral
	local steps = 34
	for i = 1, steps do
		local t = i / steps
		local a = t * math.pi * 4
		local y = 4 + t * (islandY - 8)
		local r = 46
		local pos = center + Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
		local hue = (i / steps)
		part(sky, Vector3.new(7, 1.2, 7), CFrame.new(pos), Color3.fromHSV(hue, 0.55, 1), Enum.Material.SmoothPlastic)
	end
	-- island
	cyl(sky, 8, 80, CFrame.new(center + Vector3.new(0, islandY - 4, 0)), Color3.fromRGB(150, 120, 90), Enum.Material.Ground)
	cyl(sky, 1.5, 80, CFrame.new(center + Vector3.new(0, islandY + 0.75, 0)), Color3.fromRGB(110, 230, 110), Enum.Material.Grass)
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		tree(sky, center + Vector3.new(math.cos(a) * 28, islandY + 1.5, math.sin(a) * 28), 0.9, Color3.fromRGB(255, 180, 230))
	end
	-- rock spikes underneath
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		part(sky, Vector3.new(14, 26, 14), CFrame.new(center + Vector3.new(math.cos(a) * 18, islandY - 18, math.sin(a) * 18)) * CFrame.Angles(0, a, math.rad(180)), Color3.fromRGB(140, 110, 80), Enum.Material.Rock)
	end
	local shrine = part(sky, Vector3.new(6, 6, 6), CFrame.new(center + Vector3.new(0, islandY + 6, 0)) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Color3.fromRGB(255, 240, 150), Enum.Material.Neon, { CanCollide = false })
	local l = Instance.new("PointLight")
	l.Range = 30
	l.Brightness = 3
	l.Color = Color3.fromRGB(255, 240, 150)
	l.Parent = shrine
	local zone = zonePart(sky, "SkyZone", Vector3.new(80, 30, 80), CFrame.new(center + Vector3.new(0, islandY + 15, 0)))
	table.insert(map.Secrets, {
		Name = "Sky Island",
		Zone = zone,
		Spawns = {
			center + Vector3.new(12, islandY + 2, 0),
			center + Vector3.new(-12, islandY + 2, 6),
			center + Vector3.new(0, islandY + 2, -14),
		},
	})
	table.insert(map.KeepClear, { Pos = center, R = 60 })
end

local function buildVault(root: Instance, map)
	local vault = folder("HiddenVault", root)
	-- The entrance: a hollow tree with a glowing pad inside
	local treePos = Vector3.new(-330, 0, 330)
	local trunkColor = Color3.fromRGB(110, 75, 45)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		if i ~= 0 then -- one side open = doorway
			part(vault, Vector3.new(4, 16, 2), CFrame.new(treePos + Vector3.new(math.cos(a) * 4.5, 8, math.sin(a) * 4.5)) * CFrame.Angles(0, -a + math.pi / 2, 0), trunkColor, Enum.Material.Wood)
		end
	end
	ball(vault, 22, treePos + Vector3.new(0, 22, 0), Color3.fromRGB(70, 150, 70), Enum.Material.Grass)
	ball(vault, 14, treePos + Vector3.new(6, 28, 3), Color3.fromRGB(90, 170, 80), Enum.Material.Grass)
	local roomCenter = Vector3.new(-330, -80, 330)
	local pad = part(vault, Vector3.new(5, 0.4, 5), CFrame.new(treePos + Vector3.new(0, 0.3, 0)), Color3.fromRGB(120, 255, 160), Enum.Material.Neon, { Name = "VaultEntrance", CanCollide = false, CanTouch = true })
	pad:SetAttribute("TeleportTo", roomCenter + Vector3.new(0, 4, 10))
	-- Vault room
	local gold = Color3.fromRGB(255, 200, 60)
	part(vault, Vector3.new(50, 1, 50), CFrame.new(roomCenter), Color3.fromRGB(60, 45, 30), Enum.Material.Wood)
	part(vault, Vector3.new(50, 1, 50), CFrame.new(roomCenter + Vector3.new(0, 20, 0)), Color3.fromRGB(70, 60, 50), Enum.Material.Brick)
	for _, d in ipairs({ Vector3.new(25, 0, 0), Vector3.new(-25, 0, 0), Vector3.new(0, 0, 25), Vector3.new(0, 0, -25) }) do
		local size = (d.X ~= 0) and Vector3.new(1, 20, 50) or Vector3.new(50, 20, 1)
		part(vault, size, CFrame.new(roomCenter + d + Vector3.new(0, 10, 0)), Color3.fromRGB(80, 65, 50), Enum.Material.Brick)
	end
	for i = 1, 10 do
		local p = roomCenter + Vector3.new(rng:NextNumber(-20, 20), 1.5, rng:NextNumber(-20, -8))
		ball(vault, rng:NextNumber(2, 4), p, gold, Enum.Material.Foil, { CanCollide = false })
	end
	local torchColor = Color3.fromRGB(255, 160, 60)
	for _, x in ipairs({ -20, 20 }) do
		local t = part(vault, Vector3.new(1, 1, 1), CFrame.new(roomCenter + Vector3.new(x, 12, -24)), torchColor, Enum.Material.Neon)
		local fire = Instance.new("Fire")
		fire.Size = 4
		fire.Parent = t
		local l = Instance.new("PointLight")
		l.Range = 30
		l.Color = torchColor
		l.Brightness = 2
		l.Parent = t
	end
	local exitPad = part(vault, Vector3.new(5, 0.4, 5), CFrame.new(roomCenter + Vector3.new(0, 0.7, 20)), Color3.fromRGB(120, 200, 255), Enum.Material.Neon, { Name = "VaultExit", CanCollide = false, CanTouch = true })
	exitPad:SetAttribute("TeleportTo", treePos + Vector3.new(10, 4, 0))
	billboardText(exitPad, "⬆ EXIT", Color3.fromRGB(150, 220, 255), UDim2.fromOffset(160, 40), 3)
	local zone = zonePart(vault, "VaultZone", Vector3.new(48, 18, 48), CFrame.new(roomCenter + Vector3.new(0, 9, 0)))
	table.insert(map.Secrets, {
		Name = "Hidden Vault",
		Zone = zone,
		Spawns = { roomCenter + Vector3.new(-10, 1.5, -12), roomCenter + Vector3.new(10, 1.5, -12), roomCenter + Vector3.new(0, 1.5, -4) },
	})
	map.TeleportPads = { pad, exitPad }
	table.insert(map.KeepClear, { Pos = treePos, R = 25 })
end

-- Event locations ------------------------------------------------------------
local function buildCrater(root: Instance, map)
	local crater = folder("MeteorCrater", root)
	local center = Vector3.new(-380, 0, -300)
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		part(crater, Vector3.new(12, rng:NextNumber(5, 9), 8), CFrame.new(center + Vector3.new(math.cos(a) * 40, 2, math.sin(a) * 40)) * CFrame.Angles(0, -a, math.rad(-20)), Color3.fromRGB(70, 60, 60), Enum.Material.Basalt)
	end
	cyl(crater, 0.6, 76, CFrame.new(center + Vector3.new(0, 0.3, 0)), Color3.fromRGB(60, 50, 50), Enum.Material.Basalt)
	cyl(crater, 0.7, 16, CFrame.new(center + Vector3.new(0, 0.35, 0)), Color3.fromRGB(255, 90, 20), Enum.Material.CrackedLava, { Name = "LavaCore" })
	local sign = part(crater, Vector3.new(1, 1, 1), CFrame.new(center + Vector3.new(0, 18, 0)), Color3.new(), nil, { Transparency = 1, CanCollide = false, CanQuery = false })
	billboardText(sign, "☄️ METEOR CRATER", Color3.fromRGB(255, 140, 60), UDim2.fromOffset(320, 70), 0).MaxDistance = 500
	map.Crater = { Center = center, Radius = 30 }
	table.insert(map.KeepClear, { Pos = center, R = 60 })
end

local function buildShrine(root: Instance, map)
	local shrine = folder("CelestialShrine", root)
	local center = Vector3.new(380, 0, -320)
	local y = 0
	for i = 0, 5 do
		local w = 60 - i * 9
		part(shrine, Vector3.new(w, 5, w), CFrame.new(center + Vector3.new(0, y + 2.5, 0)), (i % 2 == 0) and Color3.fromRGB(240, 235, 220) or Color3.fromRGB(255, 215, 120), Enum.Material.Marble)
		y += 5
	end
	-- stairs on the front (facing map centre)
	local toCenter = (-center).Unit
	for i = 0, 29 do
		local p = center + toCenter * (32 - i * 0.9) + Vector3.new(0, i + 0.5, 0)
		part(shrine, Vector3.new(10, 1, 1.6), CFrame.lookAt(p, p + toCenter), Color3.fromRGB(250, 245, 235), Enum.Material.Marble)
	end
	local altar = part(shrine, Vector3.new(8, 2, 8), CFrame.new(center + Vector3.new(0, y + 1, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.Marble)
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		local pillar = part(shrine, Vector3.new(1.5, 12, 1.5), CFrame.new(center + Vector3.new(math.cos(a) * 7, y + 6, math.sin(a) * 7)), Color3.fromRGB(255, 230, 150), Enum.Material.Marble)
		ball(shrine, 2, pillar.Position + Vector3.new(0, 7, 0), Color3.fromRGB(255, 250, 200), Enum.Material.Neon)
	end
	local sign = part(shrine, Vector3.new(1, 1, 1), CFrame.new(center + Vector3.new(0, y + 20, 0)), Color3.new(), nil, { Transparency = 1, CanCollide = false, CanQuery = false })
	billboardText(sign, "🌟 CELESTIAL SHRINE", Color3.fromRGB(255, 240, 160), UDim2.fromOffset(340, 70), 0).MaxDistance = 500
	map.ShrineAltar = altar.CFrame * CFrame.new(0, 1, 0)
	table.insert(map.KeepClear, { Pos = center, R = 60 })
end

function MapBuilder.Build()
	local root = workspace:FindFirstChild("Map")
	if root then
		root:Destroy()
	end
	root = folder("Map", workspace)
	setupLighting()

	local map = {
		Root = root,
		Secrets = {},
		KeepClear = {},
	}

	-- Ground (a few large tiles; parts can't exceed 2048 studs)
	part(root, Vector3.new(1400, 4, 1400), CFrame.new(0, -2, 0), Color3.fromRGB(110, 205, 95), Enum.Material.Grass, { Name = "Ground" })
	-- Kill floor far below for anyone who glitches out
	part(root, Vector3.new(2000, 2, 2000), CFrame.new(0, -200, 0), Color3.new(), nil, { Name = "KillFloor", Transparency = 1, CanCollide = false, CanTouch = true })

	buildPlaza(root, map)
	buildFields(root, map)
	buildPaths(root)
	buildSecretCave(root, map)
	buildSkyIsland(root, map)
	buildVault(root, map)
	buildCrater(root, map)
	buildShrine(root, map)
	buildNature(root, map)

	-- Base slot transforms (BaseService builds the bases themselves)
	map.BaseSlots = {}
	for i = 1, Config.MaxBases do
		local a = math.rad((i - 1) * 45)
		local pos = Vector3.new(math.cos(a), 0, math.sin(a)) * Config.BaseRingRadius
		map.BaseSlots[i] = CFrame.lookAt(pos, Vector3.new(0, 0, 0))
	end

	MapBuilder.Map = map
	return map
end

function MapBuilder.Init()
	MapBuilder.Build()
end

function MapBuilder.Start()
	local map = MapBuilder.Map
	-- Teleport pads (hidden vault)
	for _, pad in ipairs(map.TeleportPads) do
		local debounce = {}
		pad.Touched:Connect(function(hit)
			local char = hit.Parent
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hum or not hrp then
				return
			end
			if debounce[char] and os.clock() - debounce[char] < 2 then
				return
			end
			debounce[char] = os.clock()
			local target = pad:GetAttribute("TeleportTo")
			if typeof(target) == "Vector3" then
				(hrp :: BasePart).CFrame = CFrame.new(target)
			end
		end)
	end
	-- Kill floor
	local kill = map.Root:FindFirstChild("KillFloor")
	if kill then
		kill.Touched:Connect(function(hit)
			local hum = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.Health = 0
			end
		end)
	end
end

return MapBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">NetService</string><ProtectedString name="Source"><![CDATA[-- NetService.lua
-- Single entry point for all client requests. Every request is rate limited,
-- type checked by its handler and wrapped in pcall so a bad request can never
-- break the server. Handlers return (ok: boolean, message: string?, extra: any?).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local NetService = {}
NetService.Handlers = {} :: { [string]: (Player, ...any) -> (boolean, string?, any?) }

local buckets: { [Player]: { Start: number, Count: number } } = {}

local function allowed(player: Player): boolean
	local now = os.clock()
	local b = buckets[player]
	if not b or now - b.Start > Config.RateLimit.Window then
		buckets[player] = { Start = now, Count = 1 }
		return true
	end
	b.Count += 1
	return b.Count <= Config.RateLimit.MaxRequests
end

function NetService.Handle(action: string, fn)
	assert(NetService.Handlers[action] == nil, "Duplicate handler " .. action)
	NetService.Handlers[action] = fn
end

function NetService.Notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function NetService.Init() end

function NetService.Start()
	Remotes.Action.OnServerInvoke = function(player: Player, action: any, ...)
		if typeof(action) ~= "string" then
			return { ok = false, msg = "Bad request" }
		end
		if not allowed(player) then
			return { ok = false, msg = "Slow down!" }
		end
		local handler = NetService.Handlers[action]
		if not handler then
			return { ok = false, msg = "Unknown action" }
		end
		local success, ok, msg, extra = pcall(handler, player, ...)
		if not success then
			warn(("[Net] %s failed for %s: %s"):format(action, player.Name, tostring(ok)))
			return { ok = false, msg = "Something went wrong" }
		end
		return { ok = ok == true, msg = msg, data = extra }
	end
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		buckets[p] = nil
	end)
end

return NetService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source"><![CDATA[-- PlayerService.lua
-- Player lifecycle: leaderstats, base assignment, character setup (spawn at
-- base, movement stats, Bonk Hammer, overhead name tag, rebirth trail),
-- death handling and the settings / title remotes.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local UpgradeData = require(Shared.UpgradeData)

local S

local PlayerService = {}

function PlayerService.ApplyMovement(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not session or not hum then
		return
	end
	local speed = UpgradeData.WalkSpeed(data)
	if #session.Carrying > 0 then
		speed *= S.CarryService.IsCarryingStolen(player) and 0.85 or 0.95
	end
	hum.WalkSpeed = speed
	hum.UseJumpPower = true
	hum.JumpPower = session.SuperJump and 115 or Config.BaseJumpPower
end

function PlayerService.UpdateOverhead(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not data or not head then
		return
	end
	local bb = head:FindFirstChild("Overhead")
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "Overhead"
		bb.Size = UDim2.fromOffset(200, 64)
		bb.StudsOffset = Vector3.new(0, 2.6, 0)
		bb.MaxDistance = 90
		bb.LightInfluence = 0
		local title = Instance.new("TextLabel")
		title.Name = "Title"
		title.BackgroundTransparency = 1
		title.Size = UDim2.fromScale(1, 0.3)
		title.Font = Enum.Font.GothamBlack
		title.TextScaled = true
		title.TextColor3 = Color3.fromRGB(255, 200, 80)
		local s1 = Instance.new("UIStroke")
		s1.Thickness = 2
		s1.Parent = title
		title.Parent = bb
		local name = Instance.new("TextLabel")
		name.Name = "PlayerName"
		name.BackgroundTransparency = 1
		name.Position = UDim2.fromScale(0, 0.3)
		name.Size = UDim2.fromScale(1, 0.4)
		name.Font = Enum.Font.FredokaOne
		name.TextScaled = true
		name.TextColor3 = Color3.new(1, 1, 1)
		local s2 = Instance.new("UIStroke")
		s2.Thickness = 2
		s2.Parent = name
		name.Parent = bb
		local info = Instance.new("TextLabel")
		info.Name = "Info"
		info.BackgroundTransparency = 1
		info.Position = UDim2.fromScale(0, 0.7)
		info.Size = UDim2.fromScale(1, 0.3)
		info.Font = Enum.Font.GothamBold
		info.TextScaled = true
		info.TextColor3 = Color3.fromRGB(150, 230, 255)
		local s3 = Instance.new("UIStroke")
		s3.Thickness = 2
		s3.Parent = info
		info.Parent = bb
		bb.Parent = head
	end
	bb.Title.Text = data.Title ~= "" and ("« " .. data.Title .. " »") or ""
	bb.PlayerName.Text = player.DisplayName
	bb.Info.Text = ("⭐ Lv.%d   🌀 %d"):format(data.Level, data.Rebirths)
	bb.Enabled = not (session and session.Cloaked)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
end

function PlayerService.ApplyTrail(player: Player)
	local data = S.DataService.Get(player)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not data or not hrp then
		return
	end
	local old = hrp:FindFirstChild("RebirthTrail")
	if old then
		old:Destroy()
	end
	if not data.Trail or data.Trail == "" then
		return
	end
	local ok, color = pcall(Color3.fromHex, data.Trail)
	if not ok then
		return
	end
	local a0 = hrp:FindFirstChild("TrailA0") or Instance.new("Attachment")
	a0.Name = "TrailA0"
	a0.Position = Vector3.new(0, 0.8, 0)
	a0.Parent = hrp
	local a1 = hrp:FindFirstChild("TrailA1") or Instance.new("Attachment")
	a1.Name = "TrailA1"
	a1.Position = Vector3.new(0, -0.8, 0)
	a1.Parent = hrp
	local trail = Instance.new("Trail")
	trail.Name = "RebirthTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.6
	trail.LightEmission = 0.8
	trail.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Parent = hrp
end

local function setupCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	local hrp = char:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not hum or not hrp then
		return
	end
	local session = S.DataService.Session(player)
	if session then
		session.Cloaked = false
		session.SuperJump = false
	end
	task.defer(function()
		local cf = S.BaseService.SpawnCFrame(player)
		if cf and hrp.Parent then
			hrp.CFrame = cf
		end
	end)
	PlayerService.ApplyMovement(player)
	PlayerService.UpdateOverhead(player)
	PlayerService.ApplyTrail(player)
	S.StealService.GiveHammer(player)
	hum.Died:Connect(function()
		S.CarryService.OnDied(player, hrp.Position)
	end)
end

local function onLoaded(player: Player)
	-- NOTE: BindableEvents copy tables, so always use the live profile table.
	local data = S.DataService.Get(player)
	if not player.Parent or not data then
		return
	end
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local money = Instance.new("StringValue")
	money.Name = "Money"
	money.Parent = ls
	local rb = Instance.new("IntValue")
	rb.Name = "Rebirths"
	rb.Parent = ls
	local lvl = Instance.new("IntValue")
	lvl.Name = "Level"
	lvl.Parent = ls
	ls.Parent = player

	local index = S.BaseService.Assign(player)
	if not index then
		player:Kick("This server is full (all bases taken). Please join another server!")
		return
	end
	-- treasures on now-locked plots (data from older versions) go to storage
	local plots = UpgradeData.PlotCount(data)
	for _, t in pairs(data.Treasures) do
		if t.Plot and (t.Plot > plots or t.Plot < 1) then
			t.Plot = nil
		end
	end
	S.BaseService.Refresh(player)
	S.EconomyService.GrantOffline(player)
	S.StateService.MarkFull(player)
	player:SetAttribute("Loaded", true)

	player.CharacterAdded:Connect(function(char)
		setupCharacter(player, char)
	end)
	if player.Character then
		task.spawn(setupCharacter, player, player.Character)
	end
	if not S.DataService.CanSave() then
		task.delay(4, function()
			S.NetService.Notify(player, "⚠️ Saving is off in this session (Studio without API access).", "warn")
		end)
	end
end

function PlayerService.Init(services)
	S = services
	Players.CharacterAutoLoads = true
end

function PlayerService.Start()
	S.DataService.Loaded.Event:Connect(onLoaded)
	Players.PlayerRemoving:Connect(function(player)
		S.BaseService.Release(player)
	end)

	S.NetService.Handle("UpdateSettings", function(player, settings)
		local data = S.DataService.Get(player)
		if not data or typeof(settings) ~= "table" then
			return false, "Bad request"
		end
		for _, key in ipairs({ "Music", "Sfx", "LowGfx", "Effects" }) do
			if typeof(settings[key]) == "boolean" then
				data.Settings[key] = settings[key]
			end
		end
		if typeof(settings.UIScale) == "number" then
			data.Settings.UIScale = math.clamp(settings.UIScale, 0.6, 1.4)
		end
		S.StateService.MarkFull(player)
		return true
	end)

	S.NetService.Handle("SetTitle", function(player, title)
		local data = S.DataService.Get(player)
		if not data or typeof(title) ~= "string" then
			return false, "Bad request"
		end
		if title ~= "" and not table.find(data.Titles, title) then
			return false, "You haven't unlocked that title"
		end
		data.Title = title
		PlayerService.UpdateOverhead(player)
		S.StateService.MarkFull(player)
		return true, title == "" and "Title removed" or ("Title set: " .. title)
	end)
end

return PlayerService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">RebirthService</string><ProtectedString name="Source"><![CDATA[-- RebirthService.lua
-- Rebirth: trade your money, treasures and upgrades for a permanent income
-- and speed bonus, plus exclusive treasures, titles and trails at milestones.
-- Abilities, the treasure index, secrets, titles and exclusive treasures are kept.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local RebirthService = {}

function RebirthService.Rebirth(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return false, "Not ready"
	end
	local cost = Config.RebirthCost(data.Rebirths)
	if data.Money < cost then
		return false, ("You need %s to rebirth"):format(Util.Money(cost))
	end
	if #session.Carrying > 0 then
		return false, "Deliver what you're carrying first"
	end
	if session.Trade then
		return false, "Finish your trade first"
	end
	if next(session.Stealing) then
		return false, "Someone is robbing you! Deal with them first"
	end

	-- keep exclusive treasures only
	local kept = {}
	for uid, t in pairs(data.Treasures) do
		local def = TreasureData.Get(t.Id)
		if def and def.Exclusive then
			kept[uid] = { Id = t.Id, Plot = nil }
		end
	end
	data.Treasures = kept
	data.Rebirths += 1
	data.Money = Config.StartingMoney + data.Rebirths * Config.Rebirth.StartingMoneyPerRebirth
	for k in pairs(data.Upgrades) do
		data.Upgrades[k] = 0
	end

	-- milestone rewards
	local reward = Config.RebirthRewards[data.Rebirths]
	local rewardText = ""
	if reward then
		if reward.Title and not table.find(data.Titles, reward.Title) then
			table.insert(data.Titles, reward.Title)
			data.Title = reward.Title
		end
		if reward.Trail then
			data.Trail = reward.Trail:ToHex()
		end
		if reward.Treasure then
			local def = TreasureData.ByName[reward.Treasure]
			if def then
				local uid = Util.NewUid()
				data.Treasures[uid] = { Id = def.Id, Plot = nil }
				data.Index[def.Id] = true
				rewardText = (" Exclusive reward: %s!"):format(def.Name)
			end
		end
	end
	-- re-place exclusives on the (now smaller) base
	for _, t in pairs(data.Treasures) do
		t.Plot = S.BaseService.FreePlot(player)
	end

	S.BaseService.Refresh(player)
	S.PlayerService.ApplyMovement(player)
	S.PlayerService.UpdateOverhead(player)
	S.PlayerService.ApplyTrail(player)
	S.StateService.MarkFull(player)
	task.spawn(S.DataService.Save, player, false)
	Remotes.Effect:FireClient(player, "Rebirth", data.Rebirths)
	Remotes.Announce:FireAllClients(("🌀 %s reached Rebirth %d!"):format(player.DisplayName, data.Rebirths), "Mythical")
	return true, ("REBIRTH %d! +%d%% income forever.%s"):format(data.Rebirths, math.floor(data.Rebirths * Config.Rebirth.IncomeBonusPerRebirth * 100), rewardText)
end

function RebirthService.Init(services)
	S = services
end

function RebirthService.Start()
	S.NetService.Handle("Rebirth", function(player)
		local ok, msg = RebirthService.Rebirth(player)
		return ok, msg
	end)
end

return RebirthService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- ShopService.lua
-- Upgrade shop + special abilities (purchase and server-validated use).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local UpgradeData = require(Shared.UpgradeData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local ShopService = {}

local function now()
	return workspace:GetServerTimeNow()
end

function ShopService.BuyUpgrade(player: Player, key: string)
	local data = S.DataService.Get(player)
	if not data or typeof(key) ~= "string" then
		return false, "Bad request"
	end
	local up = UpgradeData.Upgrades[key]
	if not up then
		return false, "Unknown upgrade"
	end
	local level = data.Upgrades[key] or 0
	if level >= up.MaxLevel then
		return false, "Already maxed!"
	end
	local cost = up.Cost(level)
	if data.Money < cost then
		return false, ("Need %s more"):format(Util.Money(cost - data.Money))
	end
	data.Money -= cost
	data.Upgrades[key] = level + 1

	if key == "Speed" then
		S.PlayerService.ApplyMovement(player)
	elseif key == "Base" then
		S.BaseService.Refresh(player)
	elseif key == "Protection" then
		S.BaseService.RefreshPrompts(player)
	end
	Remotes.Effect:FireClient(player, "Purchase")
	S.StateService.MarkFull(player)
	return true, ("%s upgraded to level %d!"):format(up.Name, level + 1)
end

function ShopService.BuyAbility(player: Player, key: string)
	local data = S.DataService.Get(player)
	if not data or typeof(key) ~= "string" then
		return false, "Bad request"
	end
	local ab = UpgradeData.Abilities[key]
	if not ab then
		return false, "Unknown ability"
	end
	if data.Abilities[key] then
		return false, "You already own this"
	end
	if data.Money < ab.Cost then
		return false, ("Need %s more"):format(Util.Money(ab.Cost - data.Money))
	end
	data.Money -= ab.Cost
	data.Abilities[key] = true
	Remotes.Effect:FireClient(player, "Purchase")
	S.StateService.MarkFull(player)
	local hint = ab.Key and (" Press " .. ab.Key .. " or tap its button to use it.") or ""
	return true, ("Unlocked %s!%s"):format(ab.Name, hint)
end

local function setCloak(player: Player, on: boolean)
	local session = S.DataService.Session(player)
	local char = player.Character
	if not session or not char then
		return
	end
	session.Cloaked = on
	for _, d in ipairs(char:GetDescendants()) do
		local owner = d:FindFirstAncestorWhichIsA("Model")
		local isCarried = owner ~= nil and owner:GetAttribute("Carried") == true
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and not isCarried then
			if on then
				if d:GetAttribute("CloakOrig") == nil then
					d:SetAttribute("CloakOrig", d.Transparency)
				end
				d.Transparency = 0.92
			else
				local orig = d:GetAttribute("CloakOrig")
				if orig ~= nil then
					d.Transparency = orig
					d:SetAttribute("CloakOrig", nil)
				end
			end
		elseif d:IsA("Decal") and d.Name == "face" then
			d.Transparency = on and 1 or 0
		end
	end
	S.PlayerService.UpdateOverhead(player)
end

function ShopService.UseAbility(player: Player, key: string)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session or typeof(key) ~= "string" then
		return false, "Bad request"
	end
	local ab = UpgradeData.Abilities[key]
	if not ab or not ab.Key then
		return false, "Not usable"
	end
	if not data.Abilities[key] then
		return false, ("Buy %s in the shop first!"):format(ab.Name)
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return false, "You're not alive"
	end
	local t = now()
	local cd = session.AbilityCooldowns[key] or 0
	if cd > t then
		return false, ("%s ready in %ds"):format(ab.Name, math.ceil(cd - t))
	end
	session.AbilityCooldowns[key] = t + ab.Cooldown

	if key == "Dash" then
		Remotes.Effect:FireClient(player, "Dash")
	elseif key == "SuperJump" then
		session.SuperJump = true
		S.PlayerService.ApplyMovement(player)
		Remotes.Effect:FireClient(player, "SuperJump", ab.Duration)
		task.delay(ab.Duration, function()
			if session.SuperJump then
				session.SuperJump = false
				S.PlayerService.ApplyMovement(player)
			end
		end)
	elseif key == "Cloak" then
		setCloak(player, true)
		Remotes.Effect:FireClient(player, "Cloak", ab.Duration)
		task.delay(ab.Duration, function()
			if player.Parent and player.Character == char then
				setCloak(player, false)
			end
		end)
	end
	S.StateService.PushStats(player)
	return true
end

function ShopService.Init(services)
	S = services
end

function ShopService.Start()
	S.NetService.Handle("BuyUpgrade", ShopService.BuyUpgrade)
	S.NetService.Handle("BuyAbility", ShopService.BuyAbility)
	S.NetService.Handle("UseAbility", ShopService.UseAbility)
end

return ShopService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">StateService</string><ProtectedString name="Source"><![CDATA[-- StateService.lua
-- Replicates player state to its owning client. Two channels:
--   FullState: everything (inventory, upgrades, settings ...) when it changes
--   Stats:     small, frequent payload (money, mps, timers, carrying)
-- Both are debounced so bursts of changes collapse into a single send.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local UpgradeData = require(Shared.UpgradeData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local StateService = {}

local fullPending: { [Player]: boolean } = {}
local statsPending: { [Player]: boolean } = {}

function StateService.MarkFull(player: Player)
	fullPending[player] = true
	statsPending[player] = true
end

function StateService.PushStats(player: Player)
	statsPending[player] = true
end

local function buildFull(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return nil
	end
	local treasures = {}
	local tradeOffer = session.Trade and session.Trade.MyOffer or {}
	for uid, t in pairs(data.Treasures) do
		table.insert(treasures, {
			Uid = uid,
			Id = t.Id,
			Plot = t.Plot,
			Stealing = session.Stealing[uid] ~= nil,
			InTrade = table.find(tradeOffer, uid) ~= nil,
		})
	end
	local index = {}
	for id in pairs(data.Index) do
		table.insert(index, id)
	end
	local secrets = {}
	for name in pairs(data.Secrets) do
		table.insert(secrets, name)
	end
	return {
		Money = data.Money,
		TotalEarned = data.TotalEarned,
		Rebirths = data.Rebirths,
		Level = data.Level,
		XP = data.XP,
		XPNext = Config.XPForLevel(data.Level),
		Upgrades = data.Upgrades,
		Abilities = data.Abilities,
		Treasures = treasures,
		Index = index,
		Secrets = secrets,
		Settings = data.Settings,
		Stats = data.Stats,
		Title = data.Title,
		Titles = data.Titles,
		PlotCount = UpgradeData.PlotCount(data),
		CarryCap = UpgradeData.CarryCapacity(data),
		MaxStorage = Config.MaxStorage,
		BaseIndex = session.BaseIndex,
		Multiplier = UpgradeData.IncomeMultiplier(data),
		RebirthCost = Config.RebirthCost(data.Rebirths),
		LockDuration = UpgradeData.LockDuration(data),
		CanSave = S.DataService.CanSave(),
	}
end

local function buildStats(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return nil
	end
	local carrying = {}
	for _, item in ipairs(session.Carrying) do
		table.insert(carrying, { Id = item.Id, Source = item.Source, Victim = item.Victim and item.Victim.DisplayName or nil })
	end
	return {
		Money = data.Money,
		MPS = session.MPS,
		Level = data.Level,
		XP = data.XP,
		XPNext = Config.XPForLevel(data.Level),
		Rebirths = data.Rebirths,
		Carrying = carrying,
		CarryCap = UpgradeData.CarryCapacity(data),
		LockEnd = session.LockEnd,
		LockCooldownEnd = session.LockCooldownEnd,
		StealCooldownEnd = session.StealCooldownEnd,
		ShieldEnd = session.ShieldEnd,
		AbilityCooldowns = session.AbilityCooldowns,
		EventMultiplier = S.EconomyService.EventMultiplier,
	}
end

local function updateLeaderstats(player: Player)
	local data = S.DataService.Get(player)
	local ls = player:FindFirstChild("leaderstats")
	if not data or not ls then
		return
	end
	local money = ls:FindFirstChild("Money")
	if money then
		money.Value = Util.Money(data.Money)
	end
	local rb = ls:FindFirstChild("Rebirths")
	if rb then
		rb.Value = data.Rebirths
	end
	local lvl = ls:FindFirstChild("Level")
	if lvl then
		lvl.Value = data.Level
	end
end

function StateService.SendFullNow(player: Player)
	local snap = buildFull(player)
	if snap then
		Remotes.FullState:FireClient(player, snap)
	end
end

function StateService.Init(services)
	S = services
end

function StateService.Start()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		for player in pairs(fullPending) do
			fullPending[player] = nil
			if player.Parent then
				StateService.SendFullNow(player)
			end
		end
		for player in pairs(statsPending) do
			statsPending[player] = nil
			if player.Parent then
				local snap = buildStats(player)
				if snap then
					Remotes.Stats:FireClient(player, snap)
				end
				updateLeaderstats(player)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		fullPending[p] = nil
		statsPending[p] = nil
	end)
	S.NetService.Handle("RequestState", function(player)
		StateService.MarkFull(player)
		return true
	end)
end

return StateService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">StealService</string><ProtectedString name="Source"><![CDATA[-- StealService.lua
-- Server-authoritative stealing:
--   validation (locks, shields, cooldowns, distance, capacity, ownership),
--   alarms, delivery, returning treasure, post-robbery lockdown and the
--   Bonk Hammer that lets defenders knock stolen loot out of a thief's hands.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local UpgradeData = require(Shared.UpgradeData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local StealService = {}

local function now()
	return workspace:GetServerTimeNow()
end

local function hrpOf(player: Player): BasePart?
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Returns (ok, reason)
function StealService.CanSteal(thief: Player, owner: Player, uid: string)
	if thief == owner then
		return false, "That's your own treasure!"
	end
	local tData, oData = S.DataService.Get(thief), S.DataService.Get(owner)
	local tSes, oSes = S.DataService.Session(thief), S.DataService.Session(owner)
	if not (tData and oData and tSes and oSes) then
		return false, "Not ready"
	end
	local t = now()
	local entry = oData.Treasures[uid]
	if not entry or not entry.Plot then
		return false, "That treasure is gone"
	end
	if oSes.Stealing[uid] then
		return false, "Someone is already stealing that!"
	end
	if oSes.LockEnd > t then
		return false, "This base is locked! 🔒"
	end
	if oSes.ShieldEnd > t then
		return false, ("%s just arrived and is shielded (%ds)"):format(owner.DisplayName, math.ceil(oSes.ShieldEnd - t))
	end
	if tSes.StealCooldownEnd > t then
		return false, ("Steal cooldown: %ds"):format(math.ceil(tSes.StealCooldownEnd - t))
	end
	local victimCd = tSes.VictimCooldowns[owner.UserId]
	if victimCd and victimCd > t then
		return false, ("You robbed %s recently. Wait %ds"):format(owner.DisplayName, math.ceil(victimCd - t))
	end
	if tSes.Trade then
		return false, "Finish your trade first"
	end
	if not S.CarryService.CanCarry(thief) then
		return false, "Your hands are full! Upgrade your backpack."
	end
	if S.TreasureService.IsFull(thief, S.CarryService.Count(thief) + 1) then
		return false, "Your base and storage are full!"
	end
	-- physical validation: thief must be alive and next to the treasure
	local hrp = hrpOf(thief)
	local base = S.BaseService.Get(owner)
	if not hrp or not base then
		return false, "Not ready"
	end
	local pm = base.PlotModels[entry.Plot]
	if not pm or pm.Uid ~= uid then
		return false, "That treasure is gone"
	end
	local dist = (pm.Model:GetPivot().Position - hrp.Position).Magnitude
	if dist > Config.Steal.MaxPromptDistance + 4 then
		return false, "Too far away"
	end
	return true
end

function StealService.TryStart(thief: Player, owner: Player, uid: string)
	local ok, reason = StealService.CanSteal(thief, owner, uid)
	if not ok then
		S.NetService.Notify(thief, reason or "Can't steal that", "error")
		return false
	end
	local oData = S.DataService.Get(owner)
	local oSes = S.DataService.Session(owner)
	local entry = oData.Treasures[uid]
	local def = TreasureData.Get(entry.Id)
	oSes.Stealing[uid] = thief
	-- stealing ends your own new-player shield
	S.DataService.Session(thief).ShieldEnd = 0
	S.BaseService.Refresh(owner)
	S.CarryService.Add(thief, {
		Id = entry.Id,
		Source = "Steal",
		Victim = owner,
		VictimUid = uid,
	})
	S.BaseService.TriggerAlarm(owner)
	Remotes.Alarm:FireClient(owner, thief.DisplayName, def and def.Name or "a treasure")
	S.NetService.Notify(thief, ("You grabbed %s! Run back to your base!"):format(def and def.Name or "it"), "success")
	S.StateService.PushStats(owner)
	return true
end

-- Stolen treasure goes back to its owner's plot.
function StealService.Return(item, reason: string?)
	local owner = item.Victim
	if not owner or not owner.Parent then
		return
	end
	local oSes = S.DataService.Session(owner)
	if oSes then
		oSes.Stealing[item.VictimUid] = nil
	end
	S.BaseService.Refresh(owner)
	if reason == "bonked" then
		S.NetService.Notify(owner, "Your treasure was recovered! 🛡️", "success")
	elseif reason == "timeout" or reason == "dropped" then
		S.NetService.Notify(owner, "Your stolen treasure returned home.", "info")
	end
	S.StateService.MarkFull(owner)
end

-- Thief made it home: transfer ownership.
function StealService.Complete(thief: Player, item)
	local owner = item.Victim
	local def = TreasureData.Get(item.Id)
	local oData = owner and owner.Parent and S.DataService.Get(owner)
	local oSes = owner and S.DataService.Session(owner)
	if not oData or not oSes or not oData.Treasures[item.VictimUid] then
		S.NetService.Notify(thief, "The owner left — the treasure vanished back to them.", "warn")
		return
	end
	-- validate the treasure is still the same item
	if oData.Treasures[item.VictimUid].Id ~= item.Id then
		oSes.Stealing[item.VictimUid] = nil
		return
	end
	oData.Treasures[item.VictimUid] = nil
	oSes.Stealing[item.VictimUid] = nil
	oData.Stats.Robbed += 1

	local tSes = S.DataService.Session(thief)
	local tData = S.DataService.Get(thief)
	local t = now()
	if tSes then
		tSes.StealCooldownEnd = t + Config.Steal.ThiefCooldown
		tSes.VictimCooldowns[owner.UserId] = t + Config.Steal.SameVictimCooldown
	end
	if tData then
		tData.Stats.Steals += 1
	end

	S.TreasureService.Give(thief, item.Id, { Source = "Steal" })
	S.EconomyService.AddXP(thief, Config.XP.Steal)

	-- victim's base locks down for a while (fair cooldown)
	S.BaseService.SetLock(owner, UpgradeData.VictimLock(oData))
	S.BaseService.Refresh(owner)
	S.StateService.MarkFull(owner)

	local name = def and def.Name or "a treasure"
	S.NetService.Notify(owner, ("%s stole your %s! Base auto-locked."):format(thief.DisplayName, name), "error")
	S.NetService.Notify(thief, ("Heist complete! +%s %s"):format(name, def and ("(" .. Util.Money(def.MPS) .. "/s)") or ""), "success")
	if def and (def.Rarity == "Mythical" or def.Rarity == "Secret" or def.Rarity == "Divine") then
		Remotes.Announce:FireAllClients(("🚨 %s stole a %s %s from %s!"):format(thief.DisplayName, def.Rarity, name, owner.DisplayName), def.Rarity)
	end
end

-- If the owner leaves while being robbed, cancel all of those thefts.
local function onOwnerLeaving(owner: Player)
	for _, p in ipairs(Players:GetPlayers()) do
		local ses = S.DataService.Session(p)
		if ses and p ~= owner then
			for _, item in ipairs(table.clone(ses.Carrying)) do
				if item.Source == "Steal" and item.Victim == owner then
					S.CarryService.Remove(p, item)
					S.NetService.Notify(p, owner.DisplayName .. " left — the treasure returned to them.", "warn")
				end
			end
		end
	end
end

-- Bonk Hammer ---------------------------------------------------------------------
local function makeHammer(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Bonk Hammer"
	tool.ToolTip = "Bonk thieves to recover stolen treasure!"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.GripPos = Vector3.new(0, -1.2, 0)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 3, 0.4)
	handle.Color = Color3.fromRGB(140, 90, 50)
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.6, 1.2, 1.2)
	head.Color = Color3.fromRGB(255, 80, 90)
	head.Material = Enum.Material.SmoothPlastic
	head.CanCollide = false
	head.Massless = true
	head.CFrame = handle.CFrame * CFrame.new(0, 1.6, 0)
	head.Parent = tool
	local stripe = Instance.new("Part")
	stripe.Name = "Stripe"
	stripe.Size = Vector3.new(1.65, 0.3, 1.25)
	stripe.Color = Color3.fromRGB(255, 230, 80)
	stripe.Material = Enum.Material.Neon
	stripe.CanCollide = false
	stripe.Massless = true
	stripe.CFrame = head.CFrame
	stripe.Parent = tool
	for _, p in ipairs({ head, stripe }) do
		local w = Instance.new("WeldConstraint")
		w.Part0 = handle
		w.Part1 = p
		w.Parent = p
	end
	local sound = Instance.new("Sound")
	sound.Name = "Swing"
	sound.SoundId = Config.Sounds.Swing
	sound.Volume = 0.6
	sound.Parent = handle
	local hit = Instance.new("Sound")
	hit.Name = "Hit"
	hit.SoundId = Config.Sounds.Bonk
	hit.Volume = 0.9
	hit.Parent = handle
	return tool
end

local hammerTemplate: Tool

local function onSwing(player: Player, tool: Tool)
	local session = S.DataService.Session(player)
	local hrp = hrpOf(player)
	if not session or not hrp then
		return
	end
	local t = os.clock()
	if t - session.LastBonk < Config.Steal.BonkCooldown then
		return
	end
	session.LastBonk = t
	local handle = tool:FindFirstChild("Handle")
	if handle then
		local swing = handle:FindFirstChild("Swing")
		if swing then
			swing:Play()
		end
	end
	-- swing "animation": tilt the grip forward then back
	tool.Grip = CFrame.new(0, -1.2, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	task.delay(0.25, function()
		if tool.Parent then
			tool.Grip = CFrame.new(0, -1.2, 0)
		end
	end)
	-- find a target in front of us
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local ohrp = hrpOf(other)
			if ohrp then
				local offset = ohrp.Position - hrp.Position
				local dist = offset.Magnitude
				if dist <= Config.Steal.BonkRange and (dist < 3 or hrp.CFrame.LookVector:Dot(offset.Unit) > 0.2) then
					local hitSound = handle and handle:FindFirstChild("Hit")
					if hitSound then
						hitSound:Play()
					end
					local recovered = 0
					if S.CarryService.IsCarryingStolen(other) then
						recovered = S.CarryService.DropStolen(other)
					end
					Remotes.Effect:FireClient(other, "Knockback", (offset.Unit + Vector3.new(0, 0.6, 0)) * 60, Config.Steal.BonkStun)
					Remotes.Effect:FireClient(player, "BonkHit", ohrp.Position)
					if recovered > 0 then
						local data = S.DataService.Get(player)
						if data then
							data.Stats.Defends += 1
						end
						S.EconomyService.AddXP(player, Config.XP.Defend)
						S.NetService.Notify(player, ("BONK! %s dropped the loot!"):format(other.DisplayName), "success")
						S.NetService.Notify(other, ("%s bonked you! The treasure went home."):format(player.DisplayName), "error")
					end
					break
				end
			end
		end
	end
end

function StealService.GiveHammer(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if not backpack or backpack:FindFirstChild("Bonk Hammer") then
		return
	end
	local tool = hammerTemplate:Clone()
	tool.Activated:Connect(function()
		onSwing(player, tool)
	end)
	tool.Parent = backpack
end

function StealService.Init(services)
	S = services
	hammerTemplate = makeHammer()
end

function StealService.Start()
	Players.PlayerRemoving:Connect(onOwnerLeaving)
end

return StealService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">TradeService</string><ProtectedString name="Source"><![CDATA[-- TradeService.lua
-- Player-to-player trading, fully server validated:
--   request -> accept -> both sides set offers (treasures + money) -> both
--   ready -> 3 second confirm countdown (any change cancels ready) -> atomic
--   swap with re-validation, then both saves are written immediately.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local TradeService = {}

local pending: { [Player]: { [Player]: number } } = {} -- pending[target][from] = expiry
local nextId = 0

local function now()
	return workspace:GetServerTimeNow()
end

local function view(trade, player: Player)
	local other = trade.A == player and trade.B or trade.A
	local function side(p)
		local items = {}
		local data = S.DataService.Get(p)
		for _, uid in ipairs(trade.Offers[p].Uids) do
			local t = data and data.Treasures[uid]
			if t then
				table.insert(items, { Uid = uid, Id = t.Id })
			end
		end
		return { Items = items, Money = trade.Offers[p].Money, Ready = trade.Ready[p] }
	end
	return {
		Id = trade.Id,
		Partner = { Name = other.DisplayName, UserId = other.UserId },
		Mine = side(player),
		Theirs = side(other),
		Status = trade.Status,
		CountdownEnd = trade.CountdownEnd,
	}
end

local function broadcast(trade)
	for _, p in ipairs({ trade.A, trade.B }) do
		if p.Parent then
			Remotes.TradeUpdate:FireClient(p, view(trade, p))
		end
	end
end

local function close(trade, reason: string?)
	if trade.Status == "Closed" then
		return
	end
	trade.Status = "Closed"
	for _, p in ipairs({ trade.A, trade.B }) do
		local ses = S.DataService.Session(p)
		if ses and ses.Trade and ses.Trade.Ref == trade then
			ses.Trade = nil
		end
		if p.Parent then
			Remotes.TradeUpdate:FireClient(p, false, reason)
			S.StateService.MarkFull(p)
		end
	end
end

local function tradeOf(player: Player)
	local ses = S.DataService.Session(player)
	return ses and ses.Trade and ses.Trade.Ref
end

local function unready(trade)
	trade.Ready[trade.A] = false
	trade.Ready[trade.B] = false
	trade.Status = "Open"
	trade.CountdownEnd = 0
end

-- Validates that `player` can give their current offer and receive the other.
local function validateSide(trade, giver: Player, receiver: Player)
	local gData, rData = S.DataService.Get(giver), S.DataService.Get(receiver)
	local gSes = S.DataService.Session(giver)
	if not gData or not rData or not gSes then
		return false, "A player left"
	end
	local offer = trade.Offers[giver]
	for _, uid in ipairs(offer.Uids) do
		local entry = gData.Treasures[uid]
		if not entry then
			return false, "An offered treasure no longer exists"
		end
		if gSes.Stealing[uid] then
			return false, "An offered treasure is being stolen!"
		end
	end
	if gData.Money < offer.Money then
		return false, giver.DisplayName .. " doesn't have enough money"
	end
	local recvOffer = trade.Offers[receiver]
	local newCount = S.TreasureService.Count(rData) - #recvOffer.Uids + #offer.Uids
	if newCount > S.TreasureService.Capacity(rData) then
		return false, receiver.DisplayName .. " doesn't have enough room"
	end
	return true
end

local function execute(trade)
	local ok, err = validateSide(trade, trade.A, trade.B)
	if ok then
		ok, err = validateSide(trade, trade.B, trade.A)
	end
	if not ok then
		unready(trade)
		broadcast(trade)
		for _, p in ipairs({ trade.A, trade.B }) do
			S.NetService.Notify(p, "Trade failed: " .. tostring(err), "error")
		end
		return
	end
	local aData, bData = S.DataService.Get(trade.A), S.DataService.Get(trade.B)
	-- remove from both first, then add (so capacity checks above hold)
	local moving = { [trade.A] = {}, [trade.B] = {} }
	for _, pair in ipairs({ { trade.A, aData }, { trade.B, bData } }) do
		local p, data = pair[1], pair[2]
		for _, uid in ipairs(trade.Offers[p].Uids) do
			table.insert(moving[p], data.Treasures[uid].Id)
			data.Treasures[uid] = nil
		end
		data.Money -= trade.Offers[p].Money
	end
	local function receive(p: Player, data, ids, money)
		for _, id in ipairs(ids) do
			local uid = Util.NewUid()
			while data.Treasures[uid] do
				uid = Util.NewUid()
			end
			data.Treasures[uid] = { Id = id, Plot = nil }
			data.Index[id] = true
		end
		data.Money += money
		data.Stats.Trades += 1
	end
	receive(trade.A, aData, moving[trade.B], trade.Offers[trade.B].Money)
	receive(trade.B, bData, moving[trade.A], trade.Offers[trade.A].Money)

	for _, p in ipairs({ trade.A, trade.B }) do
		S.BaseService.Refresh(p)
		task.spawn(S.DataService.Save, p, false)
		S.NetService.Notify(p, "🤝 Trade complete! New treasures are in your storage.", "success")
		Remotes.Effect:FireClient(p, "Confetti")
	end
	close(trade, "Trade complete!")
end

local function start(a: Player, b: Player)
	nextId += 1
	local trade = {
		Id = nextId,
		A = a,
		B = b,
		Offers = { [a] = { Uids = {}, Money = 0 }, [b] = { Uids = {}, Money = 0 } },
		Ready = { [a] = false, [b] = false },
		Status = "Open",
		CountdownEnd = 0,
	}
	S.DataService.Session(a).Trade = { Ref = trade, MyOffer = trade.Offers[a].Uids }
	S.DataService.Session(b).Trade = { Ref = trade, MyOffer = trade.Offers[b].Uids }
	broadcast(trade)
end

-- Handlers ----------------------------------------------------------------------
local function busy(p: Player): string?
	local ses = S.DataService.Session(p)
	if not ses then
		return "not loaded"
	end
	if ses.Trade then
		return "already trading"
	end
	if #ses.Carrying > 0 then
		return "carrying treasure"
	end
	return nil
end

local function onRequest(player: Player, targetUserId)
	if typeof(targetUserId) ~= "number" then
		return false, "Bad request"
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or target == player then
		return false, "Player not found"
	end
	local b1 = busy(player)
	if b1 then
		return false, "You are " .. b1
	end
	local b2 = busy(target)
	if b2 then
		return false, target.DisplayName .. " is " .. b2
	end
	-- if they already asked us, just start
	if pending[player] and pending[player][target] and pending[player][target] > now() then
		pending[player][target] = nil
		start(target, player)
		return true, "Trade started!"
	end
	pending[target] = pending[target] or {}
	if pending[target][player] and pending[target][player] > now() then
		return false, "Request already sent"
	end
	pending[target][player] = now() + Config.Trade.RequestTimeout
	Remotes.TradeRequest:FireClient(target, player.UserId, player.DisplayName, Config.Trade.RequestTimeout)
	return true, "Trade request sent to " .. target.DisplayName
end

local function onRespond(player: Player, fromUserId, accept)
	if typeof(fromUserId) ~= "number" then
		return false, "Bad request"
	end
	local from = Players:GetPlayerByUserId(fromUserId)
	local list = pending[player]
	if not from or not list or not list[from] or list[from] < now() then
		return false, "That request expired"
	end
	list[from] = nil
	if not accept then
		S.NetService.Notify(from, player.DisplayName .. " declined your trade.", "warn")
		return true
	end
	local b1, b2 = busy(player), busy(from)
	if b1 or b2 then
		return false, "Someone is busy right now"
	end
	start(from, player)
	return true
end

local function onOffer(player: Player, uids, money)
	local trade = tradeOf(player)
	if not trade or trade.Status == "Closed" then
		return false, "No active trade"
	end
	if typeof(uids) ~= "table" then
		return false, "Bad request"
	end
	local data = S.DataService.Get(player)
	local ses = S.DataService.Session(player)
	local clean = {}
	local seen = {}
	for _, uid in ipairs(uids) do
		if typeof(uid) == "string" and not seen[uid] and data.Treasures[uid] and not ses.Stealing[uid] then
			seen[uid] = true
			table.insert(clean, uid)
			if #clean >= Config.Trade.MaxItems then
				break
			end
		end
	end
	local m = (typeof(money) == "number" and money == money) and math.floor(math.clamp(money, 0, data.Money)) or 0
	trade.Offers[player].Uids = clean
	trade.Offers[player].Money = m
	ses.Trade.MyOffer = clean
	-- offered treasures leave their platforms so they can't earn/be stolen mid-trade
	for _, uid in ipairs(clean) do
		data.Treasures[uid].Plot = nil
	end
	S.BaseService.Refresh(player)
	unready(trade)
	broadcast(trade)
	S.StateService.MarkFull(player)
	return true
end

local function onReady(player: Player, ready)
	local trade = tradeOf(player)
	if not trade or trade.Status == "Closed" then
		return false, "No active trade"
	end
	trade.Ready[player] = ready == true
	if trade.Ready[trade.A] and trade.Ready[trade.B] then
		trade.Status = "Confirming"
		trade.CountdownEnd = now() + Config.Trade.ConfirmCountdown
		local myToken = {}
		trade.Token = myToken
		task.delay(Config.Trade.ConfirmCountdown, function()
			if trade.Token == myToken and trade.Status == "Confirming" and trade.Ready[trade.A] and trade.Ready[trade.B] then
				execute(trade)
			end
		end)
	else
		trade.Status = "Open"
		trade.CountdownEnd = 0
	end
	broadcast(trade)
	return true
end

local function onCancel(player: Player)
	local trade = tradeOf(player)
	if not trade then
		return false, "No active trade"
	end
	close(trade, player.DisplayName .. " cancelled the trade.")
	return true
end

function TradeService.Init(services)
	S = services
end

function TradeService.Start()
	S.NetService.Handle("TradeRequest", onRequest)
	S.NetService.Handle("TradeRespond", onRespond)
	S.NetService.Handle("TradeOffer", onOffer)
	S.NetService.Handle("TradeReady", onReady)
	S.NetService.Handle("TradeCancel", onCancel)
	Players.PlayerRemoving:Connect(function(player)
		local trade = tradeOf(player)
		if trade then
			close(trade, player.DisplayName .. " left the game.")
		end
		pending[player] = nil
		for _, list in pairs(pending) do
			list[player] = nil
		end
	end)
end

return TradeService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">TreasureService</string><ProtectedString name="Source"><![CDATA[-- TreasureService.lua
-- Treasure ownership + the world economy:
--   * free treasures spawning in fields / secret areas / events
--   * the central marketplace stalls (buy with money, carry home)
--   * giving, placing, storing and selling owned treasures
--   * secret-area discovery rewards and the Treasure Magnet ability

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local TreasureModels = require(Shared.TreasureModels)
local UpgradeData = require(Shared.UpgradeData)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local TreasureService = {}
TreasureService.World = {} :: { [string]: any }

local rng = Random.new()
local worldFolder: Folder
local marketSign: TextLabel?
local nextRestock = 0

local function now()
	return workspace:GetServerTimeNow()
end

local function hrpOf(player: Player): BasePart?
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Ownership ---------------------------------------------------------------------
function TreasureService.Count(data): number
	local n = 0
	for _ in pairs(data.Treasures) do
		n += 1
	end
	return n
end

function TreasureService.Capacity(data): number
	return UpgradeData.PlotCount(data) + Config.MaxStorage
end

function TreasureService.IsFull(player: Player, extra: number?): boolean
	local data = S.DataService.Get(player)
	if not data then
		return true
	end
	return TreasureService.Count(data) + (extra or 0) > TreasureService.Capacity(data)
end

-- Adds a treasure to a player. opts: { Source, Silent, NoAutoPlace }
function TreasureService.Give(player: Player, id: string, opts)
	opts = opts or {}
	local data = S.DataService.Get(player)
	local def = TreasureData.Get(id)
	if not data or not def then
		return nil
	end
	if TreasureService.Count(data) >= TreasureService.Capacity(data) then
		local value = math.floor(def.Value * Config.SellMultiplier)
		S.EconomyService.AddMoney(player, value)
		S.NetService.Notify(player, ("No room! %s was auto-sold for %s"):format(def.Name, Util.Money(value)), "warn")
		return nil
	end
	local uid = Util.NewUid()
	while data.Treasures[uid] do
		uid = Util.NewUid()
	end
	local plot = (not opts.NoAutoPlace) and S.BaseService.FreePlot(player) or nil
	data.Treasures[uid] = { Id = id, Plot = plot }
	data.Stats.Collected += 1

	-- discovery bonus
	if not data.Index[id] then
		data.Index[id] = true
		local bonus = math.floor(def.MPS * 10 * Config.DiscoveryBonusMultiplier)
		S.EconomyService.AddMoney(player, bonus)
		if not opts.Silent then
			S.NetService.Notify(player, ("📖 NEW DISCOVERY: %s! +%s"):format(def.Name, Util.Money(bonus)), "discovery")
		end
	elseif not opts.Silent then
		S.NetService.Notify(player, ("+ %s (%s)%s"):format(def.Name, def.Rarity, plot and "" or " → storage"), "success")
	end
	local xp = opts.Source == "Market" and Config.XP.Buy or Config.XP.Collect
	if opts.Source ~= "Steal" and opts.Source ~= "Trade" and opts.Source ~= "Rebirth" then
		S.EconomyService.AddXP(player, xp)
	end
	Remotes.Effect:FireClient(player, "Deposit", def.Rarity)
	S.BaseService.Refresh(player)
	S.StateService.MarkFull(player)
	return uid
end

function TreasureService.Store(player: Player, uid: string)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return false, "Not ready"
	end
	local entry = data.Treasures[uid]
	if typeof(uid) ~= "string" or not entry then
		return false, "Unknown treasure"
	end
	if not entry.Plot then
		return false, "Already in storage"
	end
	if session.Stealing[uid] then
		return false, "It's being stolen!"
	end
	if S.BaseService.CountStored(data) >= Config.MaxStorage then
		return false, "Storage is full"
	end
	entry.Plot = nil
	S.BaseService.Refresh(player)
	S.StateService.MarkFull(player)
	return true, "Moved to storage"
end

function TreasureService.Place(player: Player, uid: string, plot: number?)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return false, "Not ready"
	end
	if typeof(uid) ~= "string" then
		return false, "Bad request"
	end
	local entry = data.Treasures[uid]
	if not entry then
		return false, "Unknown treasure"
	end
	if session.Trade and table.find(session.Trade.MyOffer or {}, uid) then
		return false, "That treasure is in a trade"
	end
	local target = nil
	if typeof(plot) == "number" then
		plot = math.floor(plot)
		if plot < 1 or plot > UpgradeData.PlotCount(data) then
			return false, "That platform is locked"
		end
		for _, t in pairs(data.Treasures) do
			if t.Plot == plot then
				return false, "That platform is taken"
			end
		end
		target = plot
	else
		target = S.BaseService.FreePlot(player)
	end
	if not target then
		return false, "No free platforms! Expand your base."
	end
	if entry.Plot then
		return false, "Already placed"
	end
	entry.Plot = target
	S.BaseService.Refresh(player)
	S.StateService.MarkFull(player)
	return true, "Placed on platform " .. target
end

local function sellOne(player: Player, data, session, uid: string): number?
	local entry = data.Treasures[uid]
	if not entry or session.Stealing[uid] then
		return nil
	end
	if session.Trade and table.find(session.Trade.MyOffer or {}, uid) then
		return nil
	end
	local def = TreasureData.Get(entry.Id)
	local value = def and math.floor(def.Value * Config.SellMultiplier) or 0
	data.Treasures[uid] = nil
	return value
end

function TreasureService.Sell(player: Player, uid: string)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session or typeof(uid) ~= "string" then
		return false, "Bad request"
	end
	local value = sellOne(player, data, session, uid)
	if not value then
		return false, "Can't sell that right now"
	end
	S.EconomyService.AddMoney(player, value)
	S.EconomyService.AddXP(player, Config.XP.Sell)
	S.BaseService.Refresh(player)
	S.StateService.MarkFull(player)
	Remotes.Effect:FireClient(player, "Sell", value)
	return true, "Sold for " .. Util.Money(value)
end

-- Sells everything in storage (optionally only up to a rarity rank).
function TreasureService.SellStorage(player: Player, maxRank: number?)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return false, "Not ready"
	end
	local cap = typeof(maxRank) == "number" and maxRank or 99
	local total, count = 0, 0
	for uid, entry in pairs(table.clone(data.Treasures)) do
		local def = TreasureData.Get(entry.Id)
		if not entry.Plot and def and Rarities.Rank(def.Rarity) <= cap and not def.Exclusive then
			local v = sellOne(player, data, session, uid)
			if v then
				total += v
				count += 1
			end
		end
	end
	if count == 0 then
		return false, "Nothing to sell in storage"
	end
	S.EconomyService.AddMoney(player, total)
	S.StateService.MarkFull(player)
	Remotes.Effect:FireClient(player, "Sell", total)
	return true, ("Sold %d treasures for %s"):format(count, Util.Money(total))
end

-- World treasures --------------------------------------------------------------
local KIND_TEXT = {
	Field = { "Grab", 0.4 },
	Secret = { "Grab", 0.6 },
	Event = { "Grab", 0.8 },
	Market = { "Buy", 0.3 },
}

local function groundAt(pos: Vector3): Vector3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = { worldFolder }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	local result = workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -80, 0), params)
	return result and result.Position or pos
end

function TreasureService.RemoveWorld(uid: string)
	local w = TreasureService.World[uid]
	if w then
		TreasureService.World[uid] = nil
		if w.Model then
			w.Model:Destroy()
		end
	end
end

local tryPickup -- forward

function TreasureService.SpawnWorld(def, cf: CFrame, kind: string, extra)
	local uid = Util.NewUid()
	local scale = kind == "Market" and 1.1 or 1
	local model = TreasureModels.Build(def, { CFrame = cf, Scale = scale })
	model:SetAttribute("WorldUid", uid)
	model:SetAttribute("Kind", kind)
	local root = model.PrimaryPart :: BasePart
	local label = S.BaseService.MakeLabel(root, def, TreasureModels.Height(def, scale))
	label.MaxDistance = 90
	local price = extra and extra.Price
	if price then
		model:SetAttribute("Price", price)
		local priceLabel = Instance.new("TextLabel")
		priceLabel.Name = "Price"
		priceLabel.BackgroundColor3 = Color3.fromRGB(30, 160, 60)
		priceLabel.Position = UDim2.new(0.15, 0, -0.45, 0)
		priceLabel.Size = UDim2.fromScale(0.7, 0.4)
		priceLabel.Font = Enum.Font.FredokaOne
		priceLabel.TextScaled = true
		priceLabel.TextColor3 = Color3.new(1, 1, 1)
		priceLabel.Text = Util.Money(price)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.3, 0)
		corner.Parent = priceLabel
		priceLabel.Parent = label
		label.Size = UDim2.fromOffset(180, 54)
		label.StudsOffset += Vector3.new(0, 1.2, 0)
	end
	local text = KIND_TEXT[kind] or KIND_TEXT.Field
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GrabPrompt"
	prompt.ActionText = price and ("Buy " .. Util.Money(price)) or text[1]
	prompt.ObjectText = def.Name .. " (" .. def.Rarity .. ")"
	prompt.HoldDuration = text[2]
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Kind", kind)
	prompt.Parent = root
	local record = {
		Uid = uid,
		Id = def.Id,
		Kind = kind,
		Model = model,
		Spawned = os.clock(),
		Price = price,
		Region = extra and extra.Region,
		Lifetime = extra and extra.Lifetime or Config.Spawns.Lifetime,
	}
	TreasureService.World[uid] = record
	prompt.Triggered:Connect(function(player)
		tryPickup(player, uid)
	end)
	model.Parent = worldFolder
	if Rarities.Info[def.Rarity].Announce and kind ~= "Event" then
		local where = kind == "Market" and "the Treasure Market" or (extra and extra.Region) or "the world"
		Remotes.Announce:FireAllClients(("✨ A %s %s appeared in %s!"):format(def.Rarity, def.Name, tostring(where)), def.Rarity)
	end
	return record
end

function TreasureService.DropToWorld(id: string, position: Vector3, kind: string?)
	local def = TreasureData.Get(id)
	if not def then
		return
	end
	local ground = groundAt(position)
	TreasureService.SpawnWorld(def, CFrame.new(ground), kind == "Market" and "Field" or (kind or "Field"), { Lifetime = 60, Region = "Dropped" })
end

tryPickup = function(player: Player, uid: string)
	local record = TreasureService.World[uid]
	local session = S.DataService.Session(player)
	local data = S.DataService.Get(player)
	if not record or not session or not data then
		return false
	end
	local hrp = hrpOf(player)
	if not hrp then
		return false
	end
	if (record.Model:GetPivot().Position - hrp.Position).Magnitude > Config.Spawns.PickupDistance + 4 then
		return false
	end
	if session.Trade then
		S.NetService.Notify(player, "Finish your trade first", "error")
		return false
	end
	if not S.CarryService.CanCarry(player) then
		S.NetService.Notify(player, "Your hands are full! Bring your treasure home first.", "error")
		return false
	end
	if TreasureService.IsFull(player, S.CarryService.Count(player) + 1) then
		S.NetService.Notify(player, "Your base & storage are full! Sell or expand.", "error")
		return false
	end
	if record.Price then
		if data.Money < record.Price then
			S.NetService.Notify(player, ("You need %s more!"):format(Util.Money(record.Price - data.Money)), "error")
			return false
		end
		data.Money -= record.Price
	end
	TreasureService.RemoveWorld(uid)
	S.CarryService.Add(player, { Id = record.Id, Source = record.Kind })
	Remotes.Effect:FireClient(player, "Pickup", TreasureData.Get(record.Id).Rarity)
	if record.Price then
		S.NetService.Notify(player, "Purchased! Carry it back to your base.", "success")
	end
	S.StateService.PushStats(player)
	return true
end
TreasureService.TryPickup = tryPickup

local function countKind(kind: string, region): number
	local n = 0
	for _, w in pairs(TreasureService.World) do
		if w.Kind == kind and w.Region == region then
			n += 1
		end
	end
	return n
end

local function spawnInField(field, pool)
	local r = rng:NextNumber(0, field.Radius)
	local a = rng:NextNumber(0, math.pi * 2)
	local pos = field.Center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
	local ground = groundAt(pos)
	local def = TreasureData.RollFromPool(pool or Config.SpawnPools.Field, rng)
	return TreasureService.SpawnWorld(def, CFrame.new(ground) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), "Field", { Region = field.Name })
end
TreasureService.SpawnInField = spawnInField

local function restockMarket()
	-- clear old stock
	for uid, w in pairs(TreasureService.World) do
		if w.Kind == "Market" then
			TreasureService.RemoveWorld(uid)
		end
	end
	for _, stall in ipairs(S.MapBuilder.Map.Stalls) do
		local def = TreasureData.RollFromPool(Config.SpawnPools.Market, rng)
		local price = math.floor(def.Value * Config.Market.PriceMultiplier)
		TreasureService.SpawnWorld(def, stall.CFrame, "Market", { Price = price, Region = "Stall" .. stall.Index, Lifetime = math.huge })
	end
	nextRestock = now() + Config.Market.RestockSeconds
	workspace:SetAttribute("MarketRestock", nextRestock)
end

-- Remote handlers ------------------------------------------------------------------
function TreasureService.Init(services)
	S = services
end

function TreasureService.Start()
	worldFolder = Instance.new("Folder")
	worldFolder.Name = "WorldTreasures"
	worldFolder.Parent = workspace

	local gem = S.MapBuilder.Map.FountainGem
	if gem then
		local _, label = S.MapBuilder.Billboard(gem, "", Color3.fromRGB(255, 255, 255), UDim2.fromOffset(300, 50), 9)
		marketSign = label
	end

	S.NetService.Handle("Store", function(player, uid)
		return TreasureService.Store(player, uid)
	end)
	S.NetService.Handle("Place", function(player, uid, plot)
		return TreasureService.Place(player, uid, plot)
	end)
	S.NetService.Handle("Sell", function(player, uid)
		return TreasureService.Sell(player, uid)
	end)
	S.NetService.Handle("SellStorage", function(player, maxRank)
		return TreasureService.SellStorage(player, maxRank)
	end)
	S.NetService.Handle("PlaceAll", function(player)
		local data = S.DataService.Get(player)
		if not data then
			return false, "Not ready"
		end
		local placed = 0
		for uid, entry in pairs(data.Treasures) do
			if not entry.Plot then
				local plot = S.BaseService.FreePlot(player)
				if not plot then
					break
				end
				entry.Plot = plot
				placed += 1
			end
		end
		S.BaseService.Refresh(player)
		S.StateService.MarkFull(player)
		return placed > 0, placed > 0 and ("Placed %d treasures"):format(placed) or "No free platforms"
	end)

	restockMarket()

	-- spawn + cleanup loop
	task.spawn(function()
		local fieldTimer, secretTimer = 0, 0
		while true do
			task.wait(1)
			fieldTimer += 1
			secretTimer += 1
			if fieldTimer >= Config.Spawns.FieldInterval then
				fieldTimer = 0
				for _, field in ipairs(S.MapBuilder.Map.Fields) do
					if countKind("Field", field.Name) < Config.Spawns.MaxPerField and rng:NextNumber() < 0.6 then
						spawnInField(field)
					end
				end
			end
			if secretTimer >= Config.Spawns.SecretInterval then
				secretTimer = 0
				for _, secret in ipairs(S.MapBuilder.Map.Secrets) do
					if countKind("Secret", secret.Name) < Config.Spawns.MaxPerSecret then
						local spot = secret.Spawns[rng:NextInteger(1, #secret.Spawns)]
						local def = TreasureData.RollFromPool(Config.SpawnPools.Secret, rng)
						TreasureService.SpawnWorld(def, CFrame.new(spot) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), "Secret", { Region = secret.Name })
					end
				end
			end
			-- despawn expired
			local t = os.clock()
			for uid, w in pairs(TreasureService.World) do
				if w.Kind ~= "Market" and t - w.Spawned > w.Lifetime then
					TreasureService.RemoveWorld(uid)
				end
			end
			-- market restock
			local remaining = nextRestock - now()
			if remaining <= 0 then
				restockMarket()
				remaining = Config.Market.RestockSeconds
			end
			if marketSign then
				marketSign.Text = ("🛒 New stock in %ds"):format(math.ceil(remaining))
			end
		end
	end)

	-- secret discovery + treasure magnet
	task.spawn(function()
		local tickN = 0
		while true do
			task.wait(0.5)
			tickN += 1
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.DataService.Get(player)
				local hrp = hrpOf(player)
				if data and hrp then
					if tickN % 2 == 0 then
						for _, secret in ipairs(S.MapBuilder.Map.Secrets) do
							if not data.Secrets[secret.Name] then
								local rel = secret.Zone.CFrame:PointToObjectSpace(hrp.Position)
								local half = secret.Zone.Size / 2
								if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z then
									data.Secrets[secret.Name] = true
									local reward = 2500 * (1 + data.Rebirths)
									S.EconomyService.AddMoney(player, reward)
									S.EconomyService.AddXP(player, 100)
									S.NetService.Notify(player, ("🗺️ SECRET FOUND: %s! +%s"):format(secret.Name, Util.Money(reward)), "discovery")
									Remotes.Effect:FireClient(player, "Confetti")
									S.StateService.MarkFull(player)
								end
							end
						end
					end
					if data.Abilities.Magnet then
						local radius = 18
						for uid, w in pairs(TreasureService.World) do
							if w.Kind ~= "Market" and w.Model then
								if (w.Model:GetPivot().Position - hrp.Position).Magnitude <= radius then
									if not S.CarryService.CanCarry(player) then
										break
									end
									-- pull it close then pick up (server validates distance)
									w.Model:PivotTo(CFrame.new(hrp.Position))
									tryPickup(player, uid)
								end
							end
						end
					end
				end
			end
		end
	end)
end

return TreasureService
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX00000032"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000031"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000030"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX00000021"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">Input</string><ProtectedString name="Source"><![CDATA[-- Input.lua
-- Keyboard / gamepad bindings for abilities and menus. Touch players use the
-- on-screen HUD buttons, which call the same actions.

local ContextActionService = game:GetService("ContextActionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local UpgradeData = require(Shared.UpgradeData)
local State = require(script.Parent.State)

local Input = {}

function Input.Init(windows)
	for key, ab in pairs(UpgradeData.Abilities) do
		if ab.Key then
			ContextActionService:BindAction("Ability_" .. key, function(_, inputState)
				if inputState == Enum.UserInputState.Begin then
					if State.Full and State.Full.Abilities[key] then
						State.Request("UseAbility", key)
					end
				end
				return Enum.ContextActionResult.Pass
			end, false, Enum.KeyCode[ab.Key])
		end
	end
	local menuKeys = {
		{ Enum.KeyCode.B, "Inventory" },
		{ Enum.KeyCode.N, "Index" },
		{ Enum.KeyCode.M, "Shop" },
		{ Enum.KeyCode.L, "LockBase" },
	}
	for _, mk in ipairs(menuKeys) do
		ContextActionService:BindAction("Menu_" .. mk[2], function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				if mk[2] == "LockBase" then
					State.Request("LockBase")
				else
					windows.Toggle(mk[2])
				end
			end
			return Enum.ContextActionResult.Pass
		end, false, mk[1])
	end
	ContextActionService:BindAction("CloseMenu", function(_, inputState)
		if inputState == Enum.UserInputState.Begin and windows.Current then
			windows.Close()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.ButtonB)
end

return Input
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">Sound</string><ProtectedString name="Source"><![CDATA[-- Sound.lua
-- Plays UI / gameplay sound effects locally and handles background music,
-- respecting the player's settings.

local SoundService = game:GetService("SoundService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Sound = {}
Sound.SfxEnabled = true
Sound.MusicEnabled = true

local cache: { [string]: Sound } = {}
local music: Sound? = nil

local PITCH = {
	Pickup = 1.2,
	Deposit = 1.5,
	Purchase = 1.0,
	Error = 0.6,
	Legendary = 0.8,
	Event = 0.7,
	LevelUp = 1.0,
	Hover = 1.3,
}

local function get(name: string): Sound?
	local id = Config.Sounds[name]
	if not id or id == "" then
		return nil
	end
	local s = cache[name]
	if not s then
		s = Instance.new("Sound")
		s.Name = "Sfx_" .. name
		s.SoundId = id
		s.Volume = 0.55
		s.PlaybackSpeed = PITCH[name] or 1
		s.Parent = SoundService
		cache[name] = s
	end
	return s
end

function Sound.Play(name: string, volume: number?, pitch: number?)
	if not Sound.SfxEnabled then
		return
	end
	local s = get(name)
	if not s then
		return
	end
	if volume then
		s.Volume = volume
	end
	if pitch then
		s.PlaybackSpeed = pitch
	end
	SoundService:PlayLocalSound(s)
end

function Sound.SetSettings(settings)
	Sound.SfxEnabled = settings.Sfx ~= false
	Sound.MusicEnabled = settings.Music ~= false
	if music then
		if Sound.MusicEnabled and not music.IsPlaying then
			music:Play()
		elseif not Sound.MusicEnabled and music.IsPlaying then
			music:Pause()
		end
	end
end

function Sound.Init()
	if Config.Sounds.Music ~= "" then
		music = Instance.new("Sound")
		music.Name = "Music"
		music.SoundId = Config.Sounds.Music
		music.Looped = true
		music.Volume = 0.25
		music.Parent = SoundService
		music:Play()
	end
end

return Sound
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- State.lua
-- Client mirror of the server state + a request helper.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local State = {}
State.Full = nil
State.Stats = nil
State.Leaderboard = nil
State.FullChanged = Instance.new("BindableEvent")
State.StatsChanged = Instance.new("BindableEvent")
State.LeaderboardChanged = Instance.new("BindableEvent")

local notifier -- set by Notifications to show request messages

function State.SetNotifier(fn)
	notifier = fn
end

function State.Now(): number
	return workspace:GetServerTimeNow()
end

-- Sends an action to the server. Shows the returned message as a toast
-- unless `silent` is true. Returns ok, msg, data.
function State.Request(action: string, ...)
	local ok, result = pcall(function(...)
		return Remotes.Action:InvokeServer(action, ...)
	end, ...)
	if not ok or typeof(result) ~= "table" then
		if notifier then
			notifier("Connection problem, try again", "error")
		end
		return false, "Connection problem"
	end
	if result.msg and result.msg ~= "" and notifier then
		notifier(result.msg, result.ok and "success" or "error")
	end
	return result.ok, result.msg, result.data
end

-- Silent variant
function State.Ask(action: string, ...)
	local ok, result = pcall(function(...)
		return Remotes.Action:InvokeServer(action, ...)
	end, ...)
	if not ok or typeof(result) ~= "table" then
		return false
	end
	return result.ok, result.msg, result.data
end

function State.Init()
	Remotes.FullState.OnClientEvent:Connect(function(snap)
		State.Full = snap
		State.FullChanged:Fire(snap)
	end)
	Remotes.Stats.OnClientEvent:Connect(function(stats)
		State.Stats = stats
		if State.Full then
			State.Full.Money = stats.Money
			State.Full.Level = stats.Level
			State.Full.XP = stats.XP
			State.Full.XPNext = stats.XPNext
		end
		State.StatsChanged:Fire(stats)
	end)
	Remotes.Leaderboard.OnClientEvent:Connect(function(board)
		State.Leaderboard = board
		State.LeaderboardChanged:Fire(board)
	end)
	task.spawn(function()
		-- ask for a fresh state in case we missed the first send
		while not State.Full do
			State.Ask("RequestState")
			task.wait(2)
		end
	end)
end

return State
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">WorldFX</string><ProtectedString name="Source"><![CDATA[-- WorldFX.lua
-- Client-side world logic and polish:
--   * treasure idle animation (spin + bob), rainbow / lightning flicker
--   * performance mode (turns off particles, beams and lights locally)
--   * shows only the relevant prompts (Steal on others, Pick Up on yours)
--   * lets the owner walk through their own locked barrier
--   * guide beam to your base while carrying
--   * dash, knockback, camera shake, FOV punch effects
--   * opening menus from world prompts (shop, rebirth altar, ...)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Rarities = require(Shared.Rarities)
local State = require(script.Parent.State)
local Sound = require(script.Parent.Sound)

local player = Players.LocalPlayer

local WorldFX = {}
WorldFX.LowGfx = false
WorldFX.Effects = true

local Windows, Notifications -- injected

local tracked: { [Model]: { Root: BasePart, Speed: number, Phase: number, Rank: number } } = {}
local ANIM_DISTANCE = 140

local SPIN = { 0.6, 0.7, 0.8, 0.9, 1.1, 1.3, 1.5, 1.8 }

local function track(model: Model)
	if tracked[model] or model:GetAttribute("Carried") then
		return
	end
	local root = model:FindFirstChild("Root")
	if not root or not root:IsA("BasePart") then
		return
	end
	local rank = Rarities.Rank(model:GetAttribute("Rarity") or "Common")
	tracked[model] = { Root = root, Speed = SPIN[rank] or 1, Phase = math.random() * 6, Rank = rank }
	WorldFX.ApplyQuality(model)
end

local function untrack(model: Model)
	tracked[model] = nil
end

function WorldFX.ApplyQuality(model: Instance)
	local showFx = WorldFX.Effects and not WorldFX.LowGfx
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Beam") then
			d.Enabled = showFx
		elseif d:IsA("PointLight") then
			d.Enabled = showFx
		end
	end
end

local function applyAllQuality()
	for model in pairs(tracked) do
		WorldFX.ApplyQuality(model)
	end
	-- global quality
	Lighting.GlobalShadows = not WorldFX.LowGfx
	local bloom = Lighting:FindFirstChild("GameBloom")
	if bloom then
		bloom.Enabled = not WorldFX.LowGfx
	end
	local rays = Lighting:FindFirstChild("GameSunRays")
	if rays then
		rays.Enabled = not WorldFX.LowGfx
	end
end

function WorldFX.SetSettings(settings)
	local low = settings.LowGfx == true
	local fx = settings.Effects ~= false
	if low ~= WorldFX.LowGfx or fx ~= WorldFX.Effects then
		WorldFX.LowGfx = low
		WorldFX.Effects = fx
		applyAllQuality()
	end
end

-- Treasure animation ------------------------------------------------------
local RAINBOW_SPEED = 0.25
local function animate()
	if WorldFX.LowGfx then
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local t = os.clock()
	for model, info in pairs(tracked) do
		if not model.Parent then
			tracked[model] = nil
		else
			local home = model:GetAttribute("Home")
			if typeof(home) == "CFrame" and info.Root.Anchored then
				if (home.Position - camPos).Magnitude < ANIM_DISTANCE then
					local bob = math.sin(t * 2 + info.Phase) * 0.25 + 0.3
					info.Root.CFrame = home * CFrame.new(0, bob, 0) * CFrame.Angles(0, (t * info.Speed + info.Phase) % (math.pi * 2), 0)
					if model:GetAttribute("Rainbow") then
						local c = Color3.fromHSV((t * RAINBOW_SPEED + info.Phase) % 1, 0.7, 1)
						local halo = model:FindFirstChild("Halo")
						if halo then
							for _, seg in ipairs(halo:GetChildren()) do
								(seg :: BasePart).Color = c
							end
						end
					end
					if model:GetAttribute("Lightning") then
						local glow = info.Root:FindFirstChild("FxAttachment") and info.Root.FxAttachment:FindFirstChild("Glow")
						if glow then
							glow.Brightness = (math.random() < 0.08) and 6 or 1.6
						end
					end
				end
			end
		end
	end
end

-- Prompts ---------------------------------------------------------------------
local function myBaseIndex(): number?
	return player:GetAttribute("BaseIndex")
end

local function updatePrompt(prompt: ProximityPrompt)
	local kind = prompt:GetAttribute("Kind")
	if kind == "Steal" or kind == "Store" then
		local model = prompt:FindFirstAncestorWhichIsA("Model")
		local owner = model and model:GetAttribute("OwnerId")
		local mine = owner == player.UserId
		prompt.Enabled = (kind == "Store") == mine
	elseif prompt:GetAttribute("OwnerOnly") then
		local base = prompt:FindFirstAncestor("Bases") and prompt.Parent and prompt.Parent.Parent
		local owner = base and base:GetAttribute("OwnerId")
		prompt.Enabled = owner == player.UserId
	end
end

local function watchDescendant(d: Instance)
	if d:IsA("ProximityPrompt") then
		updatePrompt(d)
	elseif d:IsA("Model") and d:GetAttribute("TreasureId") then
		track(d)
	end
end

-- Barrier: the owner may always pass through their own laser wall.
local function hookBarrier(base: Instance)
	local barrier = base:FindFirstChild("Barrier")
	if not barrier then
		return
	end
	local function apply()
		if base:GetAttribute("OwnerId") == player.UserId then
			barrier.CanCollide = false
		end
	end
	barrier:GetPropertyChangedSignal("CanCollide"):Connect(apply)
	base:GetAttributeChangedSignal("OwnerId"):Connect(function()
		apply()
		local lockPrompt = base:FindFirstChild("LockButton") and base.LockButton:FindFirstChild("LockPrompt")
		if lockPrompt then
			updatePrompt(lockPrompt)
		end
	end)
	apply()
end

-- Guide beam while carrying -----------------------------------------------------
local guide = {}
local function updateGuide(stats)
	local carrying = stats and #stats.Carrying > 0
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local bases = workspace:FindFirstChild("Bases")
	local base = bases and myBaseIndex() and bases:FindFirstChild("Base" .. myBaseIndex())
	if not carrying or not hrp or not base then
		if guide.Beam then
			guide.Beam.Enabled = false
		end
		return
	end
	if not guide.Target or not guide.Target.Parent then
		local floor = base:FindFirstChild("Floor")
		if not floor then
			return
		end
		local p = Instance.new("Part")
		p.Name = "GuideTarget"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = Vector3.new(1, 1, 1)
		p.CFrame = floor.CFrame * CFrame.new(0, 4, 0)
		p.Parent = workspace
		guide.Target = p
		guide.A1 = Instance.new("Attachment")
		guide.A1.Parent = p
	end
	if not guide.A0 or guide.A0.Parent ~= hrp then
		guide.A0 = Instance.new("Attachment")
		guide.A0.Position = Vector3.new(0, -2.5, 0)
		guide.A0.Parent = hrp
		if guide.Beam then
			guide.Beam:Destroy()
		end
		local beam = Instance.new("Beam")
		beam.Attachment0 = guide.A0
		beam.Attachment1 = guide.A1
		beam.Width0 = 1.4
		beam.Width1 = 1.4
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 220, 80))
		beam.Transparency = NumberSequence.new(0.3)
		beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		beam.TextureMode = Enum.TextureMode.Static
		beam.TextureLength = 4
		beam.TextureSpeed = 2
		beam.Parent = hrp
		guide.Beam = beam
	end
	local floor = base:FindFirstChild("Floor")
	if floor then
		guide.Target.CFrame = floor.CFrame * CFrame.new(0, 4, 0)
	end
	local stolen = false
	for _, item in ipairs(stats.Carrying) do
		stolen = stolen or item.Source == "Steal"
	end
	guide.Beam.Color = ColorSequence.new(stolen and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 220, 80))
	guide.Beam.Enabled = true
end

-- Effects -------------------------------------------------------------------------
local function fovPunch(amount: number, duration: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local base = 70
	cam.FieldOfView = base + amount
	TweenService:Create(cam, TweenInfo.new(duration, Enum.EasingStyle.Quad), { FieldOfView = base }):Play()
end

local shakeUntil, shakeAmount = 0, 0
local function shake(amount: number, duration: number)
	shakeAmount = amount
	shakeUntil = os.clock() + duration
end

local function onEffect(kind: string, a, b)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if kind == "Dash" and hrp then
		local look = hrp.CFrame.LookVector
		hrp.AssemblyLinearVelocity = Vector3.new(look.X * 110, 18, look.Z * 110)
		fovPunch(18, 0.5)
		Sound.Play("Dash", 0.6)
	elseif kind == "SuperJump" then
		Sound.Play("Jump", 0.6)
		Notifications.Toast("🦘 Super Jump active!", "info")
	elseif kind == "Cloak" then
		Notifications.Toast("👻 You are cloaked!", "info")
	elseif kind == "Knockback" and hrp and hum then
		hrp.AssemblyLinearVelocity = a
		hum.PlatformStand = true
		shake(0.6, 0.4)
		Sound.Play("Bonk", 0.8)
		task.delay(b or 1, function()
			if hum.Parent then
				hum.PlatformStand = false
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
	elseif kind == "BonkHit" then
		shake(0.25, 0.2)
	elseif kind == "Shake" and hrp and typeof(a) == "Vector3" then
		local d = (hrp.Position - a).Magnitude
		if d < 160 then
			shake((b or 0.5) * (1 - d / 160), 0.6)
		end
	elseif kind == "Pickup" then
		Sound.Play("Pickup", 0.6)
		if Rarities.Rank(a or "Common") >= 5 then
			Sound.Play("Legendary", 0.8)
			fovPunch(8, 0.6)
		end
	elseif kind == "Deposit" then
		Sound.Play("Deposit", 0.7)
		if Rarities.Rank(a or "Common") >= 5 then
			Notifications.Confetti()
		end
	elseif kind == "Sell" or kind == "Purchase" then
		Sound.Play("Purchase", 0.6)
	elseif kind == "LevelUp" then
		Sound.Play("LevelUp", 0.7)
		Notifications.Splash(("LEVEL %d!"):format(a or 0), "Keep collecting treasures!", Color3.fromRGB(255, 220, 80))
	elseif kind == "Rebirth" then
		Sound.Play("Rebirth", 0.8)
		Notifications.Splash(("REBIRTH %d"):format(a or 0), "Permanent income bonus unlocked!", Color3.fromRGB(255, 110, 200))
		fovPunch(25, 1.2)
	elseif kind == "Confetti" then
		Notifications.Confetti()
		Sound.Play("Legendary", 0.6)
	end
end

function WorldFX.Init(windows, notifications)
	Windows = windows
	Notifications = notifications
end

function WorldFX.Start()
	-- track everything that exists and appears later
	for _, d in ipairs(workspace:GetDescendants()) do
		watchDescendant(d)
	end
	workspace.DescendantAdded:Connect(watchDescendant)
	workspace.DescendantRemoving:Connect(function(d)
		if d:IsA("Model") and tracked[d] then
			untrack(d)
		end
	end)

	local function hookBases()
		local bases = workspace:WaitForChild("Bases", 30)
		if not bases then
			return
		end
		for _, b in ipairs(bases:GetChildren()) do
			hookBarrier(b)
		end
		bases.ChildAdded:Connect(hookBarrier)
	end
	task.spawn(hookBases)

	player:GetAttributeChangedSignal("BaseIndex"):Connect(function()
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				updatePrompt(d)
			end
		end
	end)

	-- world prompts that open menus
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who ~= player then
			return
		end
		local ui = prompt:GetAttribute("OpenUI")
		if ui == "Sell" then
			Windows.Open("Inventory", "Sell")
		elseif ui then
			Windows.Open(ui)
		end
	end)

	RunService.RenderStepped:Connect(function()
		animate()
		if os.clock() < shakeUntil then
			local cam = workspace.CurrentCamera
			local s = shakeAmount
			cam.CFrame = cam.CFrame * CFrame.Angles(math.rad((math.random() - 0.5) * s * 4), math.rad((math.random() - 0.5) * s * 4), 0)
		end
	end)

	Remotes.Effect.OnClientEvent:Connect(onEffect)
	Remotes.Alarm.OnClientEvent:Connect(function(thief, treasure)
		Notifications.Alarm(thief, treasure)
		shake(0.3, 0.5)
	end)
	Remotes.Announce.OnClientEvent:Connect(function(text, rarity)
		Notifications.Banner(text, rarity)
	end)
	Remotes.Notify.OnClientEvent:Connect(function(text, kind)
		Notifications.Toast(text, kind)
	end)
	State.StatsChanged.Event:Connect(updateGuide)
	player.CharacterAdded:Connect(function()
		guide.A0 = nil
		if guide.Beam then
			guide.Beam:Destroy()
			guide.Beam = nil
		end
	end)
end

return WorldFX
]]></ProtectedString></Properties></Item>
</Item>
<Item class="LocalScript" referent="RBX00000022"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Main.client.lua
-- Client bootstrap: builds the interface, starts controllers and applies
-- player settings (UI scale for PC/mobile, sound, graphics).

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")

local State = require(Controllers.State)
local Sound = require(Controllers.Sound)
local WorldFX = require(Controllers.WorldFX)
local Input = require(Controllers.Input)

local Lib = require(UI.Lib)
local Windows = require(UI.Windows)
local Notifications = require(UI.Notifications)
local HUD = require(UI.HUD)

local gui = Lib.new("ScreenGui", {
	Name = "StealATreasureUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = false,
	Parent = player:WaitForChild("PlayerGui"),
})
local uiScale = Lib.new("UIScale", { Parent = gui })

-- Responsive scaling: designed for 1280x720, scaled for phones/tablets/4K
local userScale = 1
local function rescale()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local vp = cam.ViewportSize
	local base = math.min(vp.X / 1280, vp.Y / 720)
	uiScale.Scale = math.clamp(base, 0.62, 1.5) * userScale
end
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
end)

State.Init()
Sound.Init()
Notifications.Init(gui)
State.SetNotifier(Notifications.Toast)
Windows.Init(gui)
HUD.Init(gui)

Windows.Register("Inventory", require(UI.InventoryWindow), { Title = "Inventory", Icon = "🎒", Color = Lib.Theme.Blue })
Windows.Register("Index", require(UI.IndexWindow), { Title = "Treasure Index", Icon = "📖", Color = Lib.Theme.Purple })
Windows.Register("Shop", require(UI.ShopWindow), { Title = "Upgrade Shop", Icon = "🛒", Color = Lib.Theme.Green })
Windows.Register("Rebirth", require(UI.RebirthWindow), { Title = "Rebirth", Icon = "🌀", Color = Lib.Theme.Pink })
Windows.Register("Leaderboard", require(UI.LeaderboardWindow), { Title = "Leaderboards", Icon = "🏆", Color = Lib.Theme.Accent })
Windows.Register("Settings", require(UI.SettingsWindow), { Title = "Settings", Icon = "⚙️", Color = Lib.Theme.Panel2, Size = UDim2.fromScale(0.6, 0.8), MaxSize = Vector2.new(700, 620) })
Windows.Register("Trade", require(UI.TradeWindow), { Title = "Trading", Icon = "🤝", Color = Lib.Theme.Orange })

WorldFX.Init(Windows, Notifications)
WorldFX.Start()
Input.Init(Windows)

State.FullChanged.Event:Connect(function(full)
	local s = full.Settings or {}
	userScale = s.UIScale or 1
	rescale()
	Sound.SetSettings(s)
	WorldFX.SetSettings(s)
end)

-- Welcome
task.delay(2, function()
	Notifications.Banner("💎 Welcome to STEAL A TREASURE! 💎", "Legendary")
	Notifications.Toast("Grab treasures in the fields or buy them at the market, then bring them home!", "info")
end)
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX0000002F"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- HUD.lua
-- Always-on interface: money counter, income, level bar, menu buttons,
-- carrying status, base lock button, cooldown chips, ability buttons (also
-- the mobile controls), world event timer and incoming trade requests.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Lib = require(script.Parent.Lib)
local Windows = require(script.Parent.Windows)
local Notifications = require(script.Parent.Notifications)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TreasureData = require(Shared.TreasureData)
local UpgradeData = require(Shared.UpgradeData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local HUD = {}

local gui: ScreenGui
local moneyLabel: TextLabel
local mpsLabel: TextLabel
local levelSet
local levelLabel: TextLabel
local rebirthLabel: TextLabel
local carryLabel: TextLabel
local lockButton: TextButton
local chips: Frame
local chipLabels = {}
local abilityButtons = {}
local eventFrame: Frame
local eventLabel: TextLabel
local displayedMoney = 0
local targetMoney = 0
local lastMoney = nil

function HUD.Gui()
	return gui
end

local function menuButton(parent, order, icon, text, color, window)
	local b = Lib.button({
		Text = "",
		Color = color,
		Size = UDim2.fromOffset(64, 64),
		LayoutOrder = order,
		Radius = 16,
		Parent = parent,
		OnClick = function()
			Windows.Toggle(window)
		end,
	})
	Lib.label({ Size = UDim2.new(1, 0, 0.68, 0), Text = icon, MaxText = 32, Parent = b })
	local l = Lib.label({ Size = UDim2.new(1, 4, 0.32, 0), Position = UDim2.new(0, -2, 0.66, 0), Text = text, Font = T.Title, MaxText = 13, Parent = b })
	Lib.textStroke(1.5).Parent = l
	return b
end

local function chip(name: string, color: Color3)
	local c = Lib.panel({ Size = UDim2.fromOffset(150, 30), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.15, Visible = false, Parent = chips })
	Lib.stroke(color, 2).Parent = c
	local l = Lib.label({ Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), Text = "", TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.4), MaxText = 15, Parent = c })
	Lib.textStroke(1).Parent = l
	chipLabels[name] = { Frame = c, Label = l }
end

local function setChip(name: string, text: string?)
	local c = chipLabels[name]
	c.Frame.Visible = text ~= nil
	if text then
		c.Label.Text = text
	end
end

local function buildTop()
	local top = Lib.panel({
		Name = "MoneyPanel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(300, 74),
		BackgroundColor3 = T.Bg,
		BackgroundTransparency = 0.1,
		Radius = 16,
		Parent = gui,
	})
	Lib.stroke(T.Accent, 3).Parent = top
	moneyLabel = Lib.label({ Size = UDim2.new(1, -16, 0, 44), Position = UDim2.fromOffset(8, 4), Text = "$0", Font = T.Title, TextColor3 = T.Accent, MaxText = 40, Parent = top })
	Lib.textStroke(2.5).Parent = moneyLabel
	mpsLabel = Lib.label({ Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 48), Text = "+$0/s", TextColor3 = T.Green, MaxText = 18, Parent = top })
	Lib.textStroke(1.5).Parent = mpsLabel

	local lvl = Lib.panel({ Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(230, 56), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.1, Radius = 14, Parent = gui })
	Lib.stroke(T.Blue, 2.5).Parent = lvl
	levelLabel = Lib.label({ Size = UDim2.new(0.6, 0, 0, 24), Position = UDim2.fromOffset(10, 3), Text = "⭐ Level 1", Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = lvl })
	Lib.textStroke(1.5).Parent = levelLabel
	rebirthLabel = Lib.label({ Size = UDim2.new(0.4, -10, 0, 24), Position = UDim2.new(0.6, 0, 0, 3), Text = "🌀 0", Font = T.Title, TextColor3 = T.Pink, TextXAlignment = Enum.TextXAlignment.Right, MaxText = 20, Parent = lvl })
	Lib.textStroke(1.5).Parent = rebirthLabel
	local _, setter = Lib.bar({ Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 30), Color = T.Blue, Parent = lvl })
	levelSet = setter

	eventFrame = Lib.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 88),
		Size = UDim2.fromOffset(320, 36),
		BackgroundColor3 = T.Bg,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = gui,
	})
	Lib.stroke(T.Pink, 2.5).Parent = eventFrame
	eventLabel = Lib.label({ Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), Text = "", Font = T.Title, TextColor3 = T.Pink:Lerp(Color3.new(1, 1, 1), 0.4), MaxText = 18, Parent = eventFrame })
	Lib.textStroke(1.5).Parent = eventLabel
end

local function buildMenu()
	local menu = new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(140, 300),
		Parent = gui,
	}, {
		new("UIGridLayout", {
			CellSize = UDim2.fromOffset(64, 64),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			FillDirectionMaxCells = 2,
		}),
	})
	menuButton(menu, 1, "🎒", "Items", T.Blue, "Inventory")
	menuButton(menu, 2, "📖", "Index", T.Purple, "Index")
	menuButton(menu, 3, "🛒", "Shop", T.Green, "Shop")
	menuButton(menu, 4, "🌀", "Rebirth", T.Pink, "Rebirth")
	menuButton(menu, 5, "🏆", "Top", T.Accent, "Leaderboard")
	menuButton(menu, 6, "🤝", "Trade", T.Orange, "Trade")
	menuButton(menu, 7, "⚙️", "Settings", T.Panel2, "Settings")
end

local function buildBottom()
	local bottom = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(520, 120),
		Parent = gui,
	})
	carryLabel = Lib.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -54),
		Size = UDim2.new(1, 0, 0, 28),
		Text = "",
		Font = T.Title,
		TextColor3 = T.Accent,
		MaxText = 20,
		Parent = bottom,
	})
	Lib.textStroke(2).Parent = carryLabel
	lockButton = Lib.button({
		Text = "🔒 LOCK BASE",
		Color = T.Red,
		Size = UDim2.fromOffset(190, 46),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Parent = bottom,
		OnClick = function()
			State.Request("LockBase")
		end,
	})
	chips = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -86),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = bottom,
	}, { Lib.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	chip("Shield", T.Blue)
	chip("Steal", T.Orange)
	chip("Locked", T.Green)
	chip("Gold", T.Accent)
end

local function buildAbilities()
	local holder = new("Frame", {
		Name = "Abilities",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, UserInputService.TouchEnabled and -190 or -24),
		Size = UDim2.fromOffset(76, 260),
		Parent = gui,
	}, { Lib.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom) })
	for i, key in ipairs(UpgradeData.SortedKeys(UpgradeData.Abilities)) do
		local ab = UpgradeData.Abilities[key]
		if ab.Key then
			local b = Lib.button({
				Text = "",
				Color = T.Purple,
				Size = UDim2.fromOffset(70, 70),
				LayoutOrder = i,
				Radius = 35,
				Visible = false,
				Parent = holder,
				OnClick = function()
					State.Request("UseAbility", key)
				end,
			})
			Lib.label({ Size = UDim2.new(1, 0, 0.62, 0), Position = UDim2.fromScale(0, 0.06), Text = ab.Icon, MaxText = 30, Parent = b })
			local keyLabel = Lib.label({ Size = UDim2.new(1, 0, 0.3, 0), Position = UDim2.fromScale(0, 0.64), Text = UserInputService.TouchEnabled and ab.Name or ("[" .. ab.Key .. "]"), Font = T.Title, MaxText = 13, Parent = b })
			Lib.textStroke(1.5).Parent = keyLabel
			local cd = new("TextLabel", {
				Name = "Cooldown",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0.45,
				Font = T.Title,
				TextScaled = true,
				TextColor3 = Color3.new(1, 1, 1),
				Text = "",
				Visible = false,
				ZIndex = 5,
				Parent = b,
			}, { Lib.corner(35) })
			abilityButtons[key] = { Button = b, Cooldown = cd }
		end
	end
end

local function tradePopup(fromUserId: number, fromName: string, timeout: number)
	local popup = Lib.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 140),
		Size = UDim2.fromOffset(340, 120),
		BackgroundColor3 = T.Bg,
		ZIndex = 20,
		Parent = gui,
	})
	Lib.stroke(T.Orange, 3).Parent = popup
	local l = Lib.label({ Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 8), Text = ("🤝 %s wants to trade!"):format(fromName), Font = T.Title, ZIndex = 21, MaxText = 22, Parent = popup })
	Lib.textStroke(1.5).Parent = l
	local function respond(accept)
		popup:Destroy()
		State.Request("TradeRespond", fromUserId, accept)
	end
	Lib.button({ Text = "Accept", Color = T.Green, Size = UDim2.fromOffset(140, 44), Position = UDim2.new(0.5, -6, 1, -12), AnchorPoint = Vector2.new(1, 1), ZIndex = 22, Parent = popup, OnClick = function()
		respond(true)
	end })
	Lib.button({ Text = "Decline", Color = T.Red, Size = UDim2.fromOffset(140, 44), Position = UDim2.new(0.5, 6, 1, -12), AnchorPoint = Vector2.new(0, 1), ZIndex = 22, Parent = popup, OnClick = function()
		respond(false)
	end })
	task.delay(timeout, function()
		if popup.Parent then
			popup:Destroy()
		end
	end)
end

local function onStats(stats)
	targetMoney = stats.Money
	if lastMoney and stats.Money - lastMoney > 0 and stats.Money - lastMoney > (stats.MPS or 0) * 1.5 then
		Notifications.MoneyPop("+" .. Util.Money(stats.Money - lastMoney))
		-- bounce the money panel on big gains
		local panel = gui:FindFirstChild("MoneyPanel")
		if panel then
			local sc = panel:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = panel })
			sc.Scale = 1.12
			TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
	end
	lastMoney = stats.Money
	local mult = (stats.EventMultiplier or 1) > 1 and ("  🌟x" .. stats.EventMultiplier) or ""
	mpsLabel.Text = ("+%s/s%s"):format(Util.Money(stats.MPS or 0), mult)
	levelLabel.Text = ("⭐ Level %d"):format(stats.Level)
	rebirthLabel.Text = ("🌀 %d"):format(stats.Rebirths or 0)
	levelSet(stats.XP / math.max(1, stats.XPNext), ("%s / %s XP"):format(Util.Abbreviate(stats.XP), Util.Abbreviate(stats.XPNext)))
	if #stats.Carrying > 0 then
		local names = {}
		local stolen = false
		for _, item in ipairs(stats.Carrying) do
			local def = TreasureData.Get(item.Id)
			table.insert(names, def and def.Name or "?")
			stolen = stolen or item.Source == "Steal"
		end
		carryLabel.Text = ("%s %s (%d/%d) — bring it to your base!"):format(stolen and "🏃‍♂️💨" or "📦", table.concat(names, ", "), #stats.Carrying, stats.CarryCap)
		carryLabel.TextColor3 = stolen and T.Red:Lerp(Color3.new(1, 1, 1), 0.3) or T.Accent
	else
		carryLabel.Text = ""
	end
end

local function tick()
	local stats = State.Stats
	local now = State.Now()
	if stats then
		local shield = stats.ShieldEnd - now
		setChip("Shield", shield > 0 and ("🛡️ New player shield %ds"):format(math.ceil(shield)) or nil)
		local steal = stats.StealCooldownEnd - now
		setChip("Steal", steal > 0 and ("🦹 Steal ready in %ds"):format(math.ceil(steal)) or nil)
		local lock = stats.LockEnd - now
		setChip("Locked", lock > 0 and ("🔒 Base locked %ds"):format(math.ceil(lock)) or nil)
		local gold = (stats.EventMultiplier or 1) > 1
		setChip("Gold", gold and "🌟 GOLDEN HOUR" or nil)
		local cooldown = stats.LockCooldownEnd - now
		if lock > 0 then
			lockButton.Text = ("🔒 LOCKED %ds"):format(math.ceil(lock))
			Lib.setButtonColor(lockButton, T.Green)
		elseif cooldown > 0 then
			lockButton.Text = ("⏳ LOCK IN %ds"):format(math.ceil(cooldown))
			Lib.setButtonColor(lockButton, T.Panel2)
		else
			lockButton.Text = "🔒 LOCK BASE"
			Lib.setButtonColor(lockButton, T.Red)
		end
		for key, ab in pairs(abilityButtons) do
			local cdEnd = stats.AbilityCooldowns and stats.AbilityCooldowns[key] or 0
			local left = cdEnd - now
			ab.Cooldown.Visible = left > 0
			ab.Cooldown.Text = left > 0 and tostring(math.ceil(left)) or ""
		end
	end
	local full = State.Full
	if full then
		for key, ab in pairs(abilityButtons) do
			ab.Button.Visible = full.Abilities[key] == true
		end
	end
	local eventName = workspace:GetAttribute("Event")
	if eventName and eventName ~= "" then
		local left = (workspace:GetAttribute("EventEnd") or 0) - now
		eventFrame.Visible = true
		eventLabel.Text = ("🎉 %s — %s"):format(eventName, Util.Time(left))
	else
		local nextEvent = (workspace:GetAttribute("NextEvent") or 0) - now
		eventFrame.Visible = nextEvent > 0 and nextEvent < 60
		eventLabel.Text = ("⏰ Next event in %ds"):format(math.ceil(nextEvent))
	end
end

function HUD.Init(parentGui: ScreenGui)
	gui = parentGui
	buildTop()
	buildMenu()
	buildBottom()
	buildAbilities()
	State.StatsChanged.Event:Connect(onStats)
	State.FullChanged.Event:Connect(function(full)
		targetMoney = full.Money
	end)
	Remotes.TradeRequest.OnClientEvent:Connect(tradePopup)
	-- smooth money counter
	game:GetService("RunService").RenderStepped:Connect(function(dt)
		if displayedMoney ~= targetMoney then
			local diff = targetMoney - displayedMoney
			if math.abs(diff) < 1 then
				displayedMoney = targetMoney
			else
				displayedMoney += diff * math.min(1, dt * 8)
			end
			moneyLabel.Text = Util.Money(math.floor(displayedMoney))
		end
	end)
	task.spawn(function()
		while true do
			tick()
			task.wait(0.25)
		end
	end)
end

return HUD
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">IndexWindow</string><ProtectedString name="Source"><![CDATA[-- IndexWindow.lua
-- The Treasure Index: every treasure in the game, discovered or not,
-- filterable by rarity, with completion progress and 3D previews.

local Lib = require(script.Parent.Lib)
local Preview = require(script.Parent.Preview)
local Inventory = require(script.Parent.InventoryWindow)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TreasureData = require(Shared.TreasureData)
local Rarities = require(Shared.Rarities)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local Index = {}

local filter = "All"
local grid: ScrollingFrame
local progressSet
local filterButtons = {}
local detailName: TextLabel
local detailInfo: TextLabel
local viewport: ViewportFrame
local cleanup = function() end
local isOpen = false

local function discovered(): { [string]: boolean }
	local set = {}
	if State.Full then
		for _, id in ipairs(State.Full.Index) do
			set[id] = true
		end
	end
	return set
end

local function selectDef(def, known: boolean)
	cleanup()
	if known then
		cleanup = Preview.Show(viewport, def)
		detailName.Text = def.Name
		detailName.TextColor3 = Rarities.Color(def.Rarity)
		detailInfo.Text = ("%s%s\n💰 %s/s\n💎 %s\n✨ %s effect"):format(
			def.Rarity,
			def.Exclusive and " • Rebirth Exclusive" or "",
			Util.Money(def.MPS),
			Util.Money(def.Value),
			def.Fx == "None" and "Classic" or def.Fx
		)
	else
		cleanup = function() end
		viewport:ClearAllChildren()
		detailName.Text = "???"
		detailName.TextColor3 = Rarities.Color(def.Rarity)
		detailInfo.Text = def.Rarity .. "\nNot discovered yet.\n" .. (def.Exclusive and "Unlocked through rebirth." or "Find, buy or steal it!")
	end
end

local function refresh()
	if not isOpen then
		return
	end
	Lib.clear(grid)
	local known = discovered()
	local found, total = 0, 0
	for _, def in ipairs(TreasureData.List) do
		if not def.Exclusive then
			total += 1
			if known[def.Id] then
				found += 1
			end
		end
	end
	progressSet(found / total, ("📖 %d / %d discovered"):format(found, total))
	for _, def in ipairs(TreasureData.List) do
		if filter == "All" or def.Rarity == filter then
			local isKnown = known[def.Id] == true
			local card = Inventory.Card(def, { Order = def.Order, Hidden = not isKnown, Sub = isKnown and (Util.Money(def.MPS) .. "/s") or def.Rarity })
			card.Activated:Connect(function()
				selectDef(def, isKnown)
			end)
			card.Parent = grid
		end
	end
	for name, b in pairs(filterButtons) do
		Lib.setButtonColor(b, name == filter and (name == "All" and T.Accent or Rarities.Color(name)) or T.Panel2)
	end
end

function Index.Build(content: Frame)
	local _, setter = Lib.bar({ Size = UDim2.new(1, 0, 0, 26), Color = T.Purple, Parent = content })
	progressSet = setter
	local filters = Lib.scroll({
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 40),
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollBarThickness = 3,
		Parent = content,
	})
	Lib.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center).Parent = filters
	local names = { "All" }
	for _, r in ipairs(Rarities.Order) do
		table.insert(names, r)
	end
	for i, name in ipairs(names) do
		filterButtons[name] = Lib.button({
			Text = name,
			Color = T.Panel2,
			Size = UDim2.fromOffset(92, 32),
			LayoutOrder = i,
			MaxText = 16,
			Parent = filters,
			OnClick = function()
				filter = name
				refresh()
			end,
		})
	end
	grid = Lib.scroll({ Position = UDim2.fromOffset(0, 78), Size = UDim2.new(0.68, -8, 1, -78), Parent = content })
	Lib.grid(UDim2.fromOffset(96, 112), 8).Parent = grid
	Lib.padding(4).Parent = grid
	local panel = Lib.panel({ Position = UDim2.new(0.68, 0, 0, 78), Size = UDim2.new(0.32, 0, 1, -78), Parent = content })
	Lib.padding(10).Parent = panel
	viewport = new("ViewportFrame", { Size = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = T.Panel2, Parent = panel }, { Lib.corner(12) })
	detailName = Lib.label({ Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0.52, 0), Font = T.Title, Text = "Pick a treasure", MaxText = 22, Parent = panel })
	Lib.textStroke(1.5).Parent = detailName
	detailInfo = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0.48, -36),
		Position = UDim2.new(0, 0, 0.52, 34),
		Font = T.Body,
		TextSize = 15,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = T.SubText,
		Text = "",
		Parent = panel,
	})
	State.FullChanged.Event:Connect(refresh)
end

function Index.OnOpen()
	isOpen = true
	refresh()
end

function Index.OnClose()
	isOpen = false
	cleanup()
	cleanup = function() end
end

return Index
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">InventoryWindow</string><ProtectedString name="Source"><![CDATA[-- InventoryWindow.lua
-- Your treasures: placed on platforms or in storage. Place, store and sell,
-- with a rotating 3D preview of the selected treasure.

local Lib = require(script.Parent.Lib)
local Preview = require(script.Parent.Preview)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TreasureData = require(Shared.TreasureData)
local Rarities = require(Shared.Rarities)
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local Inventory = {}

local tab = "All"
local selectedUid: string? = nil
local grid: ScrollingFrame
local tabButtons = {}
local countLabel: TextLabel
local detail = {}
local cleanupPreview = function() end
local isOpen = false

function Inventory.Card(def, opts)
	local color = Rarities.Color(def.Rarity)
	local card = new("TextButton", {
		Name = def.Id,
		BackgroundColor3 = color,
		AutoButtonColor = true,
		Text = "",
		LayoutOrder = opts.Order or 0,
	}, {
		Lib.corner(12),
		Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(110, 110, 130), 90),
		Lib.stroke(opts.Selected and T.Accent or color:Lerp(Color3.new(0, 0, 0), 0.4), opts.Selected and 4 or 2),
	})
	local icon = Lib.label({
		Size = UDim2.new(1, 0, 0.5, 0),
		Position = UDim2.fromScale(0, 0.04),
		Text = opts.Hidden and "❓" or def.Icon,
		Font = T.Title,
		MaxText = 44,
		Parent = card,
	})
	icon.TextTransparency = opts.Hidden and 0.3 or 0
	local name = Lib.label({
		Size = UDim2.new(1, -8, 0.22, 0),
		Position = UDim2.new(0, 4, 0.54, 0),
		Text = opts.Hidden and "???" or def.Name,
		Font = T.Title,
		MaxText = 15,
		Parent = card,
	})
	Lib.textStroke(1.5).Parent = name
	local sub = Lib.label({
		Size = UDim2.new(1, -8, 0.18, 0),
		Position = UDim2.new(0, 4, 0.78, 0),
		Text = opts.Sub or (Util.Money(def.MPS) .. "/s"),
		TextColor3 = Color3.fromRGB(190, 255, 190),
		MaxText = 13,
		Parent = card,
	})
	Lib.textStroke(1.5).Parent = sub
	if opts.Badge then
		local badge = Lib.label({
			Size = UDim2.fromOffset(22, 22),
			Position = UDim2.fromOffset(4, 4),
			Text = opts.Badge,
			MaxText = 18,
			Parent = card,
		})
		badge.ZIndex = 3
	end
	return card
end

local function entries()
	local full = State.Full
	if not full then
		return {}
	end
	local list = {}
	for _, t in ipairs(full.Treasures) do
		local def = TreasureData.Get(t.Id)
		if def then
			local placed = t.Plot ~= nil
			if tab == "All" or (tab == "Placed" and placed) or (tab == "Storage" and not placed) then
				table.insert(list, { Entry = t, Def = def })
			end
		end
	end
	table.sort(list, function(a, b)
		if a.Def.MPS ~= b.Def.MPS then
			return a.Def.MPS > b.Def.MPS
		end
		return a.Entry.Uid < b.Entry.Uid
	end)
	return list
end

local function findEntry(uid: string?)
	if not uid or not State.Full then
		return nil
	end
	for _, t in ipairs(State.Full.Treasures) do
		if t.Uid == uid then
			return t
		end
	end
	return nil
end

local function refreshDetail()
	local t = findEntry(selectedUid)
	cleanupPreview()
	if not t then
		detail.Name.Text = "Select a treasure"
		detail.Rarity.Text = ""
		detail.Info.Text = "Tap a card to see it in 3D and manage it."
		detail.Place.Visible = false
		detail.Store.Visible = false
		detail.Sell.Visible = false
		cleanupPreview = function() end
		return
	end
	local def = TreasureData.Get(t.Id)
	cleanupPreview = Preview.Show(detail.Viewport, def)
	detail.Name.Text = def.Name
	detail.Rarity.Text = def.Rarity:upper() .. (def.Exclusive and " • EXCLUSIVE" or "")
	detail.Rarity.TextColor3 = Rarities.Color(def.Rarity)
	local status = t.Stealing and "🚨 BEING STOLEN!" or (t.InTrade and "🤝 In trade" or (t.Plot and ("📍 Platform " .. t.Plot) or "📦 In storage"))
	detail.Info.Text = ("💰 %s/s\n💎 Value %s\n🏷️ Sells for %s\n%s"):format(
		Util.Money(def.MPS),
		Util.Money(def.Value),
		Util.Money(math.floor(def.Value * Config.SellMultiplier)),
		status
	)
	detail.Place.Visible = t.Plot == nil and not t.InTrade
	detail.Store.Visible = t.Plot ~= nil and not t.Stealing
	detail.Sell.Visible = not t.Stealing and not t.InTrade
end

local function refresh()
	if not isOpen then
		return
	end
	Lib.clear(grid)
	local full = State.Full
	if not full then
		return
	end
	local placed, stored = 0, 0
	for _, t in ipairs(full.Treasures) do
		if t.Plot then
			placed += 1
		else
			stored += 1
		end
	end
	countLabel.Text = ("📍 %d/%d platforms   📦 %d/%d storage"):format(placed, full.PlotCount, stored, full.MaxStorage)
	for i, e in ipairs(entries()) do
		local badge = e.Entry.Stealing and "🚨" or (e.Entry.Plot and "📍" or nil)
		local card = Inventory.Card(e.Def, { Order = i, Selected = e.Entry.Uid == selectedUid, Badge = badge })
		card.Activated:Connect(function()
			selectedUid = e.Entry.Uid
			refresh()
		end)
		card.Parent = grid
	end
	for name, b in pairs(tabButtons) do
		Lib.setButtonColor(b, name == tab and T.Accent or T.Panel2)
	end
	refreshDetail()
end

function Inventory.Build(content: Frame)
	-- top bar
	local top = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Parent = content }, {
		Lib.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center),
	})
	for i, name in ipairs({ "All", "Placed", "Storage" }) do
		tabButtons[name] = Lib.button({
			Text = name,
			Color = T.Panel2,
			Size = UDim2.fromOffset(90, 34),
			LayoutOrder = i,
			Parent = top,
			OnClick = function()
				tab = name
				refresh()
			end,
		})
	end
	Lib.button({
		Text = "📍 Place All",
		Color = T.Green,
		Size = UDim2.fromOffset(120, 34),
		LayoutOrder = 10,
		Parent = top,
		OnClick = function()
			State.Request("PlaceAll")
		end,
	})
	Lib.button({
		Text = "💰 Sell Storage ≤ Rare",
		Color = T.Orange,
		Size = UDim2.fromOffset(170, 34),
		LayoutOrder = 11,
		Parent = top,
		OnClick = function()
			State.Request("SellStorage", 3)
		end,
	})
	countLabel = Lib.label({
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 44),
		Text = "",
		TextColor3 = T.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 16,
		Parent = content,
	})

	grid = Lib.scroll({
		Position = UDim2.fromOffset(0, 70),
		Size = UDim2.new(0.64, -8, 1, -70),
		Parent = content,
	})
	Lib.grid(UDim2.fromOffset(104, 118), 8).Parent = grid
	Lib.padding(4).Parent = grid

	local panel = Lib.panel({
		Position = UDim2.new(0.64, 0, 0, 70),
		Size = UDim2.new(0.36, 0, 1, -70),
		BackgroundColor3 = T.Panel,
		Parent = content,
	})
	Lib.padding(10).Parent = panel
	detail.Viewport = new("ViewportFrame", {
		Size = UDim2.new(1, 0, 0.42, 0),
		BackgroundColor3 = T.Panel2,
		Parent = panel,
	}, { Lib.corner(12) })
	detail.Name = Lib.label({ Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0.43, 0), Font = T.Title, MaxText = 24, Parent = panel })
	detail.Rarity = Lib.label({ Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0.43, 30), Font = T.Title, MaxText = 18, Parent = panel })
	Lib.textStroke(1.5).Parent = detail.Rarity
	detail.Info = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0.3, -50),
		Position = UDim2.new(0, 0, 0.43, 52),
		Font = T.Body,
		TextSize = 15,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = T.SubText,
		Text = "",
		Parent = panel,
	})
	local buttons = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.new(0, 0, 1, -40),
		Parent = panel,
	}, { Lib.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center) })
	detail.Place = Lib.button({ Text = "Place", Color = T.Green, Size = UDim2.new(0.32, 0, 1, 0), Parent = buttons, OnClick = function()
		if selectedUid then
			State.Request("Place", selectedUid)
		end
	end })
	detail.Store = Lib.button({ Text = "Store", Color = T.Blue, Size = UDim2.new(0.32, 0, 1, 0), Parent = buttons, OnClick = function()
		if selectedUid then
			State.Request("Store", selectedUid)
		end
	end })
	detail.Sell = Lib.button({ Text = "Sell", Color = T.Red, Size = UDim2.new(0.32, 0, 1, 0), Parent = buttons, OnClick = function()
		if selectedUid then
			local ok = State.Request("Sell", selectedUid)
			if ok then
				selectedUid = nil
			end
		end
	end })

	State.FullChanged.Event:Connect(refresh)
end

function Inventory.OnOpen(arg)
	isOpen = true
	if arg == "Sell" then
		tab = "Storage"
	end
	refresh()
end

function Inventory.OnClose()
	isOpen = false
	cleanupPreview()
	cleanupPreview = function() end
end

return Inventory
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">LeaderboardWindow</string><ProtectedString name="Source"><![CDATA[-- LeaderboardWindow.lua
-- Server board (live) and global boards (Richest, Rebirths).

local Players = game:GetService("Players")

local Lib = require(script.Parent.Lib)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local Board = {}

local tab = "Server"
local list: ScrollingFrame
local tabs = {}
local isOpen = false

local MEDAL = { "🥇", "🥈", "🥉" }

local function refresh()
	if not isOpen then
		return
	end
	Lib.clear(list)
	for name, b in pairs(tabs) do
		Lib.setButtonColor(b, name == tab and T.Accent or T.Panel2)
	end
	local board = State.Leaderboard
	local entries = board and board[tab] or {}
	if #entries == 0 then
		Lib.label({
			Size = UDim2.new(1, 0, 0, 40),
			Text = tab == "Server" and "Loading..." or "Global boards update every 2 minutes (requires a published game with DataStores).",
			TextColor3 = T.SubText,
			MaxText = 16,
			Parent = list,
		})
		return
	end
	for i, e in ipairs(entries) do
		local isMe = e.UserId == Players.LocalPlayer.UserId
		local row = Lib.panel({
			Size = UDim2.new(1, -8, 0, 48),
			BackgroundColor3 = isMe and T.Accent:Lerp(T.Panel, 0.6) or (i % 2 == 0 and T.Panel or T.Panel2),
			LayoutOrder = i,
			Parent = list,
		})
		Lib.label({ Size = UDim2.fromOffset(60, 40), Position = UDim2.fromOffset(6, 4), Text = MEDAL[i] or ("#" .. i), Font = T.Title, MaxText = 24, Parent = row })
		new("ImageLabel", {
			Size = UDim2.fromOffset(38, 38),
			Position = UDim2.fromOffset(70, 5),
			BackgroundColor3 = T.Bg,
			Image = ("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48"):format(e.UserId),
			Parent = row,
		}, { Lib.corner(19) })
		local name = Lib.label({ Size = UDim2.new(0.5, -120, 1, -8), Position = UDim2.fromOffset(116, 4), Text = e.Name, Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = row })
		Lib.textStroke(1.5).Parent = name
		local valueText
		if tab == "Rebirths" then
			valueText = ("🌀 %s"):format(Util.Commas(e.Value))
		elseif tab == "Server" then
			valueText = ("%s  •  %s/s  •  🌀%d"):format(Util.Money(e.Value), Util.Abbreviate(e.MPS or 0), e.Rebirths or 0)
		else
			valueText = Util.Money(e.Value)
		end
		local v = Lib.label({ Size = UDim2.new(0.5, -10, 1, -8), Position = UDim2.new(0.5, 0, 0, 4), Text = valueText, TextColor3 = T.Green, TextXAlignment = Enum.TextXAlignment.Right, MaxText = 18, Parent = row })
		Lib.textStroke(1.5).Parent = v
	end
end

function Board.Build(content: Frame)
	local top = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Parent = content }, {
		Lib.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center),
	})
	for i, info in ipairs({ { "Server", "🖥️ This Server" }, { "Richest", "🌍 Richest" }, { "Rebirths", "🌍 Rebirths" } }) do
		tabs[info[1]] = Lib.button({
			Text = info[2],
			Color = T.Panel2,
			Size = UDim2.fromOffset(150, 34),
			LayoutOrder = i,
			Parent = top,
			OnClick = function()
				tab = info[1]
				refresh()
			end,
		})
	end
	list = Lib.scroll({ Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 1, -48), Parent = content })
	Lib.list(Enum.FillDirection.Vertical, 6).Parent = list
	Lib.padding(4).Parent = list
	State.LeaderboardChanged.Event:Connect(refresh)
end

function Board.OnOpen()
	isOpen = true
	refresh()
	State.Ask("GetLeaderboard")
end

function Board.OnClose()
	isOpen = false
end

return Board
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">Lib</string><ProtectedString name="Source"><![CDATA[-- Lib.lua
-- Tiny declarative UI helper + theme used by every window.

local TweenService = game:GetService("TweenService")

local Lib = {}

Lib.Theme = {
	Bg = Color3.fromRGB(22, 24, 44),
	Panel = Color3.fromRGB(34, 37, 66),
	Panel2 = Color3.fromRGB(46, 50, 88),
	Stroke = Color3.fromRGB(255, 255, 255),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(190, 195, 230),
	Accent = Color3.fromRGB(255, 196, 50),
	Green = Color3.fromRGB(70, 210, 100),
	Red = Color3.fromRGB(240, 70, 80),
	Blue = Color3.fromRGB(70, 160, 255),
	Purple = Color3.fromRGB(160, 90, 255),
	Pink = Color3.fromRGB(255, 100, 190),
	Orange = Color3.fromRGB(255, 140, 50),
	Title = Enum.Font.FredokaOne,
	Body = Enum.Font.GothamBold,
	Light = Enum.Font.Gotham,
}
local T = Lib.Theme

-- Lib.new("Frame", { Size = ..., Parent = ... }, { children })
function Lib.new(className: string, props: { [string]: any }?, children: { Instance }?)
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
local new = Lib.new

function Lib.corner(r: number?)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 12) })
end

function Lib.stroke(color: Color3?, thickness: number?, transparency: number?)
	return new("UIStroke", {
		Color = color or Color3.fromRGB(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Lib.textStroke(thickness: number?)
	return new("UIStroke", { Color = Color3.fromRGB(15, 15, 30), Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

function Lib.gradient(c1: Color3, c2: Color3, rotation: number?)
	return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rotation or 90 })
end

function Lib.padding(px: number)
	local u = UDim.new(0, px)
	return new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Lib.list(direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?)
	return new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Lib.grid(cell: UDim2, padding: number?)
	return new("UIGridLayout", {
		CellSize = cell,
		CellPadding = UDim2.fromOffset(padding or 8, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	})
end

function Lib.label(props)
	local p = {
		BackgroundTransparency = 1,
		Font = T.Body,
		TextColor3 = T.Text,
		TextScaled = true,
		Text = "",
	}
	for k, v in pairs(props) do
		if k ~= "MaxText" then
			p[k] = v
		end
	end
	local l = new("TextLabel", p)
	if props.TextScaled ~= false then
		new("UITextSizeConstraint", { MaxTextSize = props.MaxText or 28, MinTextSize = 8, Parent = l })
	end
	return l
end

-- Animated button. props.Color, props.OnClick, props.Text ...
local Sound -- lazily required (avoid cyclic requires)
function Lib.button(props)
	local color = props.Color or T.Blue
	local b = new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(140, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Text = props.Text or "",
		Font = props.Font or T.Title,
		TextColor3 = props.TextColor or T.Text,
		TextScaled = true,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, {
		Lib.corner(props.Radius or 10),
		Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190), 90),
		Lib.stroke(color:Lerp(Color3.new(0, 0, 0), 0.45), 2.5),
		new("UITextSizeConstraint", { MaxTextSize = props.MaxText or 24, MinTextSize = 8 }),
		new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }),
		Lib.textStroke(1.5),
	})
	local scale = new("UIScale", { Parent = b })
	b.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.06 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.94 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)
	if props.OnClick then
		b.Activated:Connect(function()
			Sound = Sound or require(script.Parent.Parent.Controllers.Sound)
			Sound.Play("Click")
			props.OnClick(b)
		end)
	end
	return b
end

function Lib.setButtonColor(b: GuiObject, color: Color3)
	b.BackgroundColor3 = color
	for _, s in ipairs(b:GetChildren()) do
		if s:IsA("UIStroke") and s.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then
			s.Color = color:Lerp(Color3.new(0, 0, 0), 0.45)
		end
	end
end

function Lib.panel(props)
	local p = {
		BackgroundColor3 = T.Panel,
		BorderSizePixel = 0,
	}
	for k, v in pairs(props) do
		if k ~= "Radius" then
			p[k] = v
		end
	end
	local f = new("Frame", p)
	Lib.corner(props.Radius or 12).Parent = f
	return f
end

function Lib.scroll(props)
	local p = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = T.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}
	for k, v in pairs(props) do
		p[k] = v
	end
	return new("ScrollingFrame", p)
end

function Lib.clear(container: Instance)
	for _, c in ipairs(container:GetChildren()) do
		if not c:IsA("UIGridStyleLayout") and not c:IsA("UIPadding") and not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
end

-- Progress bar; returns frame and a setter(fraction)
function Lib.bar(props)
	local bg = Lib.panel({
		Name = props.Name or "Bar",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = Color3.fromRGB(15, 15, 30),
		Radius = 8,
		Parent = props.Parent,
		LayoutOrder = props.LayoutOrder or 0,
	})
	Lib.stroke(Color3.fromRGB(0, 0, 0), 2).Parent = bg
	local fill = Lib.panel({ Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = props.Color or T.Accent, Radius = 8, Parent = bg })
	Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)).Parent = fill
	local text = Lib.label({ Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 3, Parent = bg, MaxText = 18 })
	Lib.textStroke(1.5).Parent = text
	return bg, function(f: number, t: string?)
		f = math.clamp(f, 0, 1)
		TweenService:Create(fill, TweenInfo.new(0.25), { Size = UDim2.fromScale(f, 1) }):Play()
		if t then
			text.Text = t
		end
	end
end

return Lib
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">Notifications</string><ProtectedString name="Source"><![CDATA[-- Notifications.lua
-- Toasts, big announcement banners, the robbery alarm overlay, level-up /
-- rebirth splashes and confetti.

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Lib = require(script.Parent.Lib)
local Sound = require(script.Parent.Parent.Controllers.Sound)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rarities = require(Shared.Rarities)

local T = Lib.Theme
local new = Lib.new

local Notifications = {}

local gui: ScreenGui
local toastHolder: Frame
local bannerHolder: Frame
local alarmFrame: Frame
local alarmText: TextLabel

local KIND_COLORS = {
	info = T.Blue,
	success = T.Green,
	error = T.Red,
	warn = T.Orange,
	discovery = T.Purple,
	level = T.Accent,
}

function Notifications.Toast(text: string, kind: string?)
	kind = kind or "info"
	local color = KIND_COLORS[kind] or T.Blue
	local toast = Lib.panel({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Bg,
		BackgroundTransparency = 0.1,
		Parent = toastHolder,
	})
	Lib.stroke(color, 2.5).Parent = toast
	Lib.padding(8).Parent = toast
	local bar = Lib.panel({ Size = UDim2.new(0, 5, 1, 0), BackgroundColor3 = color, Radius = 3, Parent = toast })
	bar.Position = UDim2.fromOffset(-4, 0)
	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 0),
		Position = UDim2.fromOffset(8, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = T.Body,
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = T.Text,
		Text = text,
		Parent = toast,
	})
	local scale = new("UIScale", { Scale = 0.6, Parent = toast })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	if kind == "error" then
		Sound.Play("Error", 0.4)
	elseif kind == "discovery" or kind == "level" then
		Sound.Play("Legendary", 0.6)
	end
	task.delay(4, function()
		if toast.Parent then
			TweenService:Create(toast, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			task.wait(0.3)
			toast:Destroy()
		end
	end)
	-- keep at most 5
	local toasts = {}
	for _, c in ipairs(toastHolder:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(toasts, c)
		end
	end
	if #toasts > 5 then
		toasts[1]:Destroy()
	end
end

function Notifications.Banner(text: string, rarity: string?)
	local color = rarity and Rarities.Color(rarity) or T.Accent
	if rarity == "Secret" then
		color = Color3.fromRGB(130, 255, 230)
	end
	local banner = Lib.panel({
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = T.Bg,
		BackgroundTransparency = 0.05,
		Parent = bannerHolder,
	})
	Lib.stroke(color, 3).Parent = banner
	Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 170), 90).Parent = banner
	local label = Lib.label({
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromOffset(10, 4),
		Font = T.Title,
		Text = text,
		TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.35),
		Parent = banner,
		MaxText = 26,
	})
	Lib.textStroke(2).Parent = label
	local scale = new("UIScale", { Scale = 0.3, Parent = banner })
	TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	Sound.Play(rarity and Rarities.Rank(rarity) >= 5 and "Legendary" or "Event", 0.6)
	Debris:AddItem(banner, 6)
	local count = 0
	for _, c in ipairs(bannerHolder:GetChildren()) do
		if c:IsA("Frame") then
			count += 1
		end
	end
	if count > 3 then
		for _, c in ipairs(bannerHolder:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
				break
			end
		end
	end
end

function Notifications.Alarm(thief: string, treasure: string)
	alarmText.Text = ("🚨 %s IS STEALING YOUR %s! 🚨\nBonk them with your hammer!"):format(thief:upper(), treasure:upper())
	alarmFrame.Visible = true
	task.spawn(function()
		for i = 1, 8 do
			alarmFrame.BackgroundTransparency = (i % 2 == 0) and 0.55 or 0.8
			if i % 2 == 1 then
				Sound.Play("Alarm", 0.8, 0.6)
			end
			task.wait(0.35)
		end
		alarmFrame.Visible = false
	end)
end

function Notifications.Splash(title: string, subtitle: string, color: Color3)
	local frame = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
		ZIndex = 50,
	})
	local t = Lib.label({
		Size = UDim2.fromScale(0.8, 0.14),
		Position = UDim2.fromScale(0.5, 0.38),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = T.Title,
		Text = title,
		TextColor3 = color,
		ZIndex = 51,
		Parent = frame,
		MaxText = 80,
	})
	Lib.textStroke(4).Parent = t
	local s = Lib.label({
		Size = UDim2.fromScale(0.7, 0.06),
		Position = UDim2.fromScale(0.5, 0.48),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = T.Body,
		Text = subtitle,
		ZIndex = 51,
		Parent = frame,
		MaxText = 32,
	})
	Lib.textStroke(2).Parent = s
	local scale = new("UIScale", { Scale = 0.2, Parent = frame })
	TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(2.2, function()
		TweenService:Create(t, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		TweenService:Create(s, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		task.wait(0.6)
		frame:Destroy()
	end)
	Notifications.Confetti()
end

function Notifications.Confetti()
	local colors = { T.Accent, T.Pink, T.Blue, T.Green, T.Purple, T.Orange }
	for _ = 1, 40 do
		local piece = new("Frame", {
			Size = UDim2.fromOffset(math.random(8, 14), math.random(12, 20)),
			Position = UDim2.new(math.random(), 0, -0.05, 0),
			BackgroundColor3 = colors[math.random(1, #colors)],
			BorderSizePixel = 0,
			Rotation = math.random(0, 360),
			ZIndex = 60,
			Parent = gui,
		})
		local dur = math.random(15, 30) / 10
		TweenService:Create(piece, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.3, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-360, 360),
		}):Play()
		Debris:AddItem(piece, dur)
	end
end

-- Floating "+$123" near the money counter
function Notifications.MoneyPop(text: string, color: Color3?)
	local l = Lib.label({
		Size = UDim2.fromOffset(220, 36),
		Position = UDim2.new(0.5, math.random(-60, 60), 0, 92),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = T.Title,
		Text = text,
		TextColor3 = color or T.Green,
		ZIndex = 40,
		Parent = gui,
		MaxText = 30,
	})
	Lib.textStroke(2).Parent = l
	TweenService:Create(l, TweenInfo.new(1.2, Enum.EasingStyle.Quad), { Position = l.Position + UDim2.fromOffset(0, 50), TextTransparency = 1 }):Play()
	Debris:AddItem(l, 1.3)
end

function Notifications.Init(parentGui: ScreenGui)
	gui = parentGui
	toastHolder = new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 8),
		Size = UDim2.fromOffset(300, 400),
		Parent = gui,
	}, { Lib.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Top) })
	bannerHolder = new("Frame", {
		Name = "Banners",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 132),
		Size = UDim2.fromOffset(640, 200),
		Parent = gui,
	}, {
		Lib.list(Enum.FillDirection.Vertical, 6),
		new("UISizeConstraint", { MaxSize = Vector2.new(640, 200) }),
	})
	bannerHolder.Size = UDim2.new(0.9, 0, 0, 200)
	alarmFrame = new("Frame", {
		Name = "Alarm",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 0, 20),
		BackgroundTransparency = 0.7,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})
	alarmText = Lib.label({
		Size = UDim2.fromScale(0.85, 0.16),
		Position = UDim2.fromScale(0.5, 0.25),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = T.Title,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 31,
		Parent = alarmFrame,
		MaxText = 48,
	})
	Lib.textStroke(3).Parent = alarmText
end

return Notifications
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">Preview</string><ProtectedString name="Source"><![CDATA[-- Preview.lua
-- Rotating 3D treasure preview inside a ViewportFrame (built from the same
-- procedural model the world uses).

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TreasureModels = require(Shared.TreasureModels)

local Preview = {}

-- Fills `viewport` with the treasure. Returns a cleanup function.
function Preview.Show(viewport: ViewportFrame, def)
	viewport:ClearAllChildren()
	if not def then
		return function() end
	end
	local world = Instance.new("WorldModel")
	world.Parent = viewport
	local model = TreasureModels.Build(def, { Effects = false })
	model.Parent = world
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = viewport
	viewport.CurrentCamera = cam
	viewport.LightColor = Color3.fromRGB(255, 255, 255)
	viewport.Ambient = Color3.fromRGB(170, 170, 190)
	viewport.LightDirection = Vector3.new(-1, -1, -1)
	local height = TreasureModels.Height(def)
	local focus = Vector3.new(0, height / 2, 0)
	local dist = math.max(7, height * 2.1)
	local angle = 0
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		if not viewport.Parent or not model.Parent then
			conn:Disconnect()
			return
		end
		if not viewport.Visible then
			return
		end
		angle += dt * 0.9
		cam.CFrame = CFrame.lookAt(focus + Vector3.new(math.sin(angle) * dist, height * 0.45, math.cos(angle) * dist), focus)
	end)
	return function()
		conn:Disconnect()
		viewport:ClearAllChildren()
	end
end

return Preview
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">RebirthWindow</string><ProtectedString name="Source"><![CDATA[-- RebirthWindow.lua
-- Rebirth progress, permanent bonuses, milestone rewards and title picker.

local Lib = require(script.Parent.Lib)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local Rebirth = {}

local isOpen = false
local info: TextLabel
local setProgress
local rebirthButton: TextButton
local confirmUntil = 0
local rewardsList: Frame
local titlesList: Frame

local function refresh()
	if not isOpen or not State.Full then
		return
	end
	local full = State.Full
	local cost = full.RebirthCost
	local nextR = full.Rebirths + 1
	local bonus = math.floor(nextR * Config.Rebirth.IncomeBonusPerRebirth * 100)
	info.Text = ("You have rebirthed %d times.\nCurrent income multiplier: x%.2f\n\nRebirth %d gives: +%d%% total income, +%d walk speed and %s starting cash.\nYou keep: abilities, index, secrets, titles & exclusive treasures.\nYou lose: money, treasures and upgrades.")
		:format(full.Rebirths, full.Multiplier, nextR, bonus, Config.Rebirth.SpeedBonusPerRebirth, Util.Money(Config.StartingMoney + nextR * Config.Rebirth.StartingMoneyPerRebirth))
	setProgress(full.Money / cost, ("%s / %s"):format(Util.Money(full.Money), Util.Money(cost)))
	local canAfford = full.Money >= cost
	if os.clock() < confirmUntil then
		rebirthButton.Text = "⚠️ TAP AGAIN TO CONFIRM"
		Lib.setButtonColor(rebirthButton, T.Orange)
	else
		rebirthButton.Text = canAfford and "🌀 REBIRTH NOW" or "🔒 NOT ENOUGH MONEY"
		Lib.setButtonColor(rebirthButton, canAfford and T.Pink or T.Panel2)
	end

	Lib.clear(rewardsList)
	local milestones = {}
	for n in pairs(Config.RebirthRewards) do
		table.insert(milestones, n)
	end
	table.sort(milestones)
	for i, n in ipairs(milestones) do
		local r = Config.RebirthRewards[n]
		local unlocked = full.Rebirths >= n
		local row = Lib.panel({ Size = UDim2.new(1, -6, 0, 44), BackgroundColor3 = unlocked and T.Green:Lerp(T.Panel, 0.5) or T.Panel2, LayoutOrder = i, Parent = rewardsList })
		local l = Lib.label({
			Size = UDim2.new(1, -16, 1, -8),
			Position = UDim2.fromOffset(8, 4),
			Text = ("%s Rebirth %d: %s + \"%s\" title + trail"):format(unlocked and "✅" or "🔒", n, r.Treasure, r.Title),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 16,
			Parent = row,
		})
		Lib.textStroke(1).Parent = l
	end

	Lib.clear(titlesList)
	local options = { "" }
	for _, t in ipairs(full.Titles) do
		table.insert(options, t)
	end
	for i, title in ipairs(options) do
		local active = full.Title == title
		Lib.button({
			Text = title == "" and "No title" or title,
			Color = active and T.Accent or T.Panel2,
			Size = UDim2.fromOffset(120, 32),
			LayoutOrder = i,
			MaxText = 16,
			Parent = titlesList,
			OnClick = function()
				State.Request("SetTitle", title)
			end,
		})
	end
end

function Rebirth.Build(content: Frame)
	local left = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.55, -8, 1, 0), Parent = content })
	local big = Lib.label({ Size = UDim2.new(1, 0, 0, 44), Text = "🌀 REBIRTH", Font = T.Title, TextColor3 = T.Pink, MaxText = 40, Parent = left })
	Lib.textStroke(2.5).Parent = big
	info = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 170),
		Position = UDim2.fromOffset(0, 48),
		Font = T.Body,
		TextSize = 15,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = T.SubText,
		Parent = left,
	})
	local _, setter = Lib.bar({ Size = UDim2.new(1, 0, 0, 32), Position = UDim2.new(0, 0, 0, 224), Color = T.Pink, Parent = left })
	setProgress = setter
	rebirthButton = Lib.button({
		Text = "REBIRTH",
		Color = T.Pink,
		Size = UDim2.new(1, 0, 0, 58),
		Position = UDim2.fromOffset(0, 266),
		MaxText = 28,
		Parent = left,
		OnClick = function()
			if os.clock() < confirmUntil then
				confirmUntil = 0
				State.Request("Rebirth")
			elseif State.Full and State.Full.Money >= State.Full.RebirthCost then
				confirmUntil = os.clock() + 4
				refresh()
				task.delay(4.1, refresh)
			else
				State.Request("Rebirth")
			end
		end,
	})
	local right = Lib.panel({ Position = UDim2.new(0.55, 0, 0, 0), Size = UDim2.new(0.45, 0, 1, 0), Parent = content })
	Lib.padding(8).Parent = right
	local h = Lib.label({ Size = UDim2.new(1, 0, 0, 26), Text = "🎁 Milestone Rewards", Font = T.Title, TextColor3 = T.Accent, MaxText = 20, Parent = right })
	Lib.textStroke(1.5).Parent = h
	rewardsList = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 200), Parent = right }, { Lib.list(Enum.FillDirection.Vertical, 6) })
	local h2 = Lib.label({ Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 236), Text = "🏷️ Your Titles", Font = T.Title, TextColor3 = T.Accent, MaxText = 20, Parent = right })
	Lib.textStroke(1.5).Parent = h2
	titlesList = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 266), Size = UDim2.new(1, 0, 1, -266), Parent = right }, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(120, 32), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	State.FullChanged.Event:Connect(refresh)
	State.StatsChanged.Event:Connect(refresh)
end

function Rebirth.OnOpen()
	isOpen = true
	refresh()
end

function Rebirth.OnClose()
	isOpen = false
end

return Rebirth
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">SettingsWindow</string><ProtectedString name="Source"><![CDATA[-- SettingsWindow.lua
-- Music, sound effects, graphics quality, treasure effects and UI scale.
-- Settings are saved on the server with the rest of your progress.

local Lib = require(script.Parent.Lib)
local State = require(script.Parent.Parent.Controllers.State)

local T = Lib.Theme
local new = Lib.new

local Settings = {}

local toggles = {}
local scaleLabel: TextLabel
local saveLabel: TextLabel
local statsLabel: TextLabel

local OPTIONS = {
	{ Key = "Music", Text = "🎵 Music", Desc = "Background music" },
	{ Key = "Sfx", Text = "🔊 Sound Effects", Desc = "Pickups, alarms, purchases" },
	{ Key = "Effects", Text = "✨ Treasure Effects", Desc = "Particles, beams and glow on treasures" },
	{ Key = "LowGfx", Text = "📱 Performance Mode", Desc = "Lower quality for older phones (no shadows, no treasure animation)" },
}

local function current()
	return State.Full and State.Full.Settings or {}
end

local function refresh()
	local s = current()
	for key, b in pairs(toggles) do
		local on = s[key] == true
		b.Text = on and "ON" or "OFF"
		Lib.setButtonColor(b, on and T.Green or T.Red)
	end
	scaleLabel.Text = ("%d%%"):format(math.floor((s.UIScale or 1) * 100 + 0.5))
	if State.Full then
		saveLabel.Text = State.Full.CanSave and "💾 Progress saves automatically." or "⚠️ Saving disabled (Studio without API access)."
		local st = State.Full.Stats or {}
		statsLabel.Text = ("📊 Steals: %d   Robbed: %d   Defends: %d   Collected: %d   Trades: %d   Secrets: %d/3"):format(
			st.Steals or 0,
			st.Robbed or 0,
			st.Defends or 0,
			st.Collected or 0,
			st.Trades or 0,
			#(State.Full.Secrets or {})
		)
	end
end

function Settings.Build(content: Frame)
	local scroll = Lib.scroll({ Size = UDim2.fromScale(1, 1), Parent = content })
	Lib.list(Enum.FillDirection.Vertical, 8).Parent = scroll
	Lib.padding(4).Parent = scroll
	for i, opt in ipairs(OPTIONS) do
		local row = Lib.panel({ Size = UDim2.new(1, -8, 0, 62), LayoutOrder = i, Parent = scroll })
		local t = Lib.label({ Size = UDim2.new(1, -140, 0, 28), Position = UDim2.fromOffset(14, 6), Text = opt.Text, Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = row })
		Lib.textStroke(1.5).Parent = t
		Lib.label({ Size = UDim2.new(1, -140, 0, 20), Position = UDim2.fromOffset(14, 34), Text = opt.Desc, TextColor3 = T.SubText, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 14, Parent = row })
		toggles[opt.Key] = Lib.button({
			Text = "",
			Size = UDim2.fromOffset(100, 42),
			Position = UDim2.new(1, -12, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Parent = row,
			OnClick = function()
				local s = current()
				State.Ask("UpdateSettings", { [opt.Key] = not (s[opt.Key] == true) })
			end,
		})
	end
	local row = Lib.panel({ Size = UDim2.new(1, -8, 0, 62), LayoutOrder = 10, Parent = scroll })
	local t = Lib.label({ Size = UDim2.new(0.5, 0, 1, -12), Position = UDim2.fromOffset(14, 6), Text = "🔍 Interface Size", Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = row })
	Lib.textStroke(1.5).Parent = t
	local function change(d)
		local s = current()
		State.Ask("UpdateSettings", { UIScale = math.clamp((s.UIScale or 1) + d, 0.6, 1.4) })
	end
	Lib.button({ Text = "−", Size = UDim2.fromOffset(46, 42), Position = UDim2.new(1, -170, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Color = T.Panel2, Parent = row, OnClick = function()
		change(-0.1)
	end })
	scaleLabel = Lib.label({ Size = UDim2.fromOffset(60, 42), Position = UDim2.new(1, -120, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Text = "100%", Font = T.Title, Parent = row })
	Lib.button({ Text = "+", Size = UDim2.fromOffset(46, 42), Position = UDim2.new(1, -58, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Color = T.Panel2, Parent = row, OnClick = function()
		change(0.1)
	end })
	saveLabel = Lib.label({ Size = UDim2.new(1, -8, 0, 26), LayoutOrder = 20, TextColor3 = T.SubText, MaxText = 16, Parent = scroll })
	statsLabel = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 44),
		LayoutOrder = 21,
		Font = T.Body,
		TextSize = 14,
		TextWrapped = true,
		TextColor3 = T.SubText,
		Parent = scroll,
	})
	new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 120),
		LayoutOrder = 22,
		Font = T.Body,
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = T.SubText,
		Text = "HOW TO PLAY\n• Grab free treasures in the fields or buy them at the market, then carry them home.\n• Treasures on your platforms earn money every second.\n• Sneak into other bases and hold [E] on a treasure to steal it — get it home before they bonk you!\n• Lock your base with the red button. Upgrade protection in the shop.\n• Keys: Q Dash • R Super Jump • F Cloak",
		Parent = scroll,
	})
	State.FullChanged.Event:Connect(refresh)
end

function Settings.OnOpen()
	refresh()
end

return Settings
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">ShopWindow</string><ProtectedString name="Source"><![CDATA[-- ShopWindow.lua
-- Upgrades (speed, carry capacity, base expansion, protection, income) and
-- special abilities.

local Lib = require(script.Parent.Lib)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local UpgradeData = require(Shared.UpgradeData)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local Shop = {}

local rows = {}
local isOpen = false

local function makeRow(parent: Instance, order: number, icon: string, title: string, desc: string, color: Color3)
	local row = Lib.panel({ Size = UDim2.new(1, -8, 0, 84), BackgroundColor3 = T.Panel, LayoutOrder = order, Parent = parent })
	Lib.stroke(color, 2).Parent = row
	local iconBox = Lib.panel({ Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = color, Parent = row })
	Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(140, 140, 160)).Parent = iconBox
	Lib.label({ Size = UDim2.fromScale(1, 1), Text = icon, MaxText = 38, Parent = iconBox })
	local t = Lib.label({ Size = UDim2.new(1, -250, 0, 28), Position = UDim2.fromOffset(86, 8), Text = title, Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 22, Parent = row })
	Lib.textStroke(1.5).Parent = t
	local d = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -250, 0, 40),
		Position = UDim2.fromOffset(86, 36),
		Font = T.Body,
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = T.SubText,
		Text = desc,
		Parent = row,
	})
	local btn = Lib.button({ Text = "", Color = T.Green, Size = UDim2.fromOffset(150, 50), Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = row })
	return { Row = row, Title = t, Desc = d, Button = btn }
end

local function refresh()
	if not isOpen or not State.Full then
		return
	end
	local full = State.Full
	for key, r in pairs(rows) do
		if r.Kind == "Upgrade" then
			local up = UpgradeData.Upgrades[key]
			local level = full.Upgrades[key] or 0
			r.UI.Title.Text = ("%s  (Lv %d/%d)"):format(up.Name, level, up.MaxLevel)
			if level >= up.MaxLevel then
				r.UI.Button.Text = "MAXED"
				Lib.setButtonColor(r.UI.Button, T.Panel2)
			else
				local cost = up.Cost(level)
				r.UI.Button.Text = Util.Money(cost)
				Lib.setButtonColor(r.UI.Button, full.Money >= cost and T.Green or T.Red)
			end
		else
			local ab = UpgradeData.Abilities[key]
			if full.Abilities[key] then
				r.UI.Button.Text = ab.Key and ("OWNED [" .. ab.Key .. "]") or "OWNED"
				Lib.setButtonColor(r.UI.Button, T.Panel2)
			else
				r.UI.Button.Text = Util.Money(ab.Cost)
				Lib.setButtonColor(r.UI.Button, full.Money >= ab.Cost and T.Green or T.Red)
			end
		end
	end
end

function Shop.Build(content: Frame)
	local scroll = Lib.scroll({ Size = UDim2.fromScale(1, 1), Parent = content })
	Lib.list(Enum.FillDirection.Vertical, 8).Parent = scroll
	Lib.padding(4).Parent = scroll
	local header1 = Lib.label({ Size = UDim2.new(1, 0, 0, 30), Text = "⬆️ UPGRADES", Font = T.Title, TextColor3 = T.Accent, LayoutOrder = 0, MaxText = 24, Parent = scroll })
	Lib.textStroke(2).Parent = header1
	local colors = { T.Blue, T.Orange, T.Green, T.Purple, T.Accent }
	for i, key in ipairs(UpgradeData.SortedKeys(UpgradeData.Upgrades)) do
		local up = UpgradeData.Upgrades[key]
		local ui = makeRow(scroll, i, up.Icon, up.Name, up.Description, colors[(i - 1) % #colors + 1])
		ui.Button.Activated:Connect(function()
			State.Request("BuyUpgrade", key)
		end)
		rows[key] = { Kind = "Upgrade", UI = ui }
	end
	local header2 = Lib.label({ Size = UDim2.new(1, 0, 0, 30), Text = "⚡ SPECIAL ABILITIES", Font = T.Title, TextColor3 = T.Pink, LayoutOrder = 50, MaxText = 24, Parent = scroll })
	Lib.textStroke(2).Parent = header2
	for i, key in ipairs(UpgradeData.SortedKeys(UpgradeData.Abilities)) do
		local ab = UpgradeData.Abilities[key]
		local desc = ab.Description .. (ab.Cooldown > 0 and ("  (cooldown %ds)"):format(ab.Cooldown) or "")
		local ui = makeRow(scroll, 50 + i, ab.Icon, ab.Name, desc, T.Pink)
		ui.Button.Activated:Connect(function()
			if not (State.Full and State.Full.Abilities[key]) then
				State.Request("BuyAbility", key)
			end
		end)
		rows[key] = { Kind = "Ability", UI = ui }
	end
	State.FullChanged.Event:Connect(refresh)
	State.StatsChanged.Event:Connect(refresh)
end

function Shop.OnOpen()
	isOpen = true
	refresh()
end

function Shop.OnClose()
	isOpen = false
end

return Shop
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">TradeWindow</string><ProtectedString name="Source"><![CDATA[-- TradeWindow.lua
-- Trading UI: pick a player, then build offers (treasures + money), mark
-- ready and watch the confirm countdown. Everything is validated server side.

local Players = game:GetService("Players")

local Lib = require(script.Parent.Lib)
local Inventory = require(script.Parent.InventoryWindow)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TreasureData = require(Shared.TreasureData)
local Remotes = require(Shared.Remotes)
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local Trade = {}

local Windows -- set in Build
local trade = nil -- current trade view from server
local isOpen = false

local lobby: Frame
local session: Frame
local playerList: ScrollingFrame
local myOffer: ScrollingFrame
local theirOffer: ScrollingFrame
local picker: ScrollingFrame
local myMoney: TextBox
local theirMoney: TextLabel
local myStatus: TextLabel
local theirStatus: TextLabel
local readyButton: TextButton
local countdown: TextLabel
local partnerLabel: TextLabel

local function offerUids(): { string }
	local list = {}
	if trade then
		for _, item in ipairs(trade.Mine.Items) do
			table.insert(list, item.Uid)
		end
	end
	return list
end

local function sendOffer(uids)
	local money = tonumber(myMoney.Text) or 0
	State.Request("TradeOffer", uids, money)
end

local function refreshLobby()
	Lib.clear(playerList)
	local count = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= Players.LocalPlayer then
			count += 1
			local row = Lib.panel({ Size = UDim2.new(1, -8, 0, 54), BackgroundColor3 = T.Panel2, LayoutOrder = count, Parent = playerList })
			new("ImageLabel", {
				Size = UDim2.fromOffset(44, 44),
				Position = UDim2.fromOffset(6, 5),
				BackgroundColor3 = T.Bg,
				Image = ("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48"):format(p.UserId),
				Parent = row,
			}, { Lib.corner(22) })
			local n = Lib.label({ Size = UDim2.new(1, -200, 1, -10), Position = UDim2.fromOffset(58, 5), Text = p.DisplayName, Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = row })
			Lib.textStroke(1.5).Parent = n
			Lib.button({
				Text = "🤝 Request",
				Color = T.Accent,
				Size = UDim2.fromOffset(130, 40),
				Position = UDim2.new(1, -8, 0.5, 0),
				AnchorPoint = Vector2.new(1, 0.5),
				Parent = row,
				OnClick = function()
					State.Request("TradeRequest", p.UserId)
				end,
			})
		end
	end
	if count == 0 then
		Lib.label({ Size = UDim2.new(1, 0, 0, 40), Text = "No other players in this server yet.", TextColor3 = T.SubText, MaxText = 18, Parent = playerList })
	end
end

local function fillItems(container: ScrollingFrame, items, clickable: boolean)
	Lib.clear(container)
	for i, item in ipairs(items) do
		local def = TreasureData.Get(item.Id)
		if def then
			local card = Inventory.Card(def, { Order = i, Sub = clickable and "tap to remove" or nil })
			if clickable then
				card.Activated:Connect(function()
					local uids = offerUids()
					local idx = table.find(uids, item.Uid)
					if idx then
						table.remove(uids, idx)
					end
					sendOffer(uids)
				end)
			end
			card.Parent = container
		end
	end
end

local function refreshPicker()
	Lib.clear(picker)
	local full = State.Full
	if not full or not trade then
		return
	end
	local offered = {}
	for _, uid in ipairs(offerUids()) do
		offered[uid] = true
	end
	local list = {}
	for _, t in ipairs(full.Treasures) do
		if not offered[t.Uid] and not t.Stealing then
			local def = TreasureData.Get(t.Id)
			if def then
				table.insert(list, { t = t, def = def })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.def.MPS > b.def.MPS
	end)
	for i, e in ipairs(list) do
		local card = Inventory.Card(e.def, { Order = i, Badge = e.t.Plot and "📍" or nil })
		card.Activated:Connect(function()
			local uids = offerUids()
			if #uids >= Config.Trade.MaxItems then
				return
			end
			table.insert(uids, e.t.Uid)
			sendOffer(uids)
		end)
		card.Parent = picker
	end
end

local function refreshSession()
	if not trade then
		return
	end
	partnerLabel.Text = "Trading with " .. trade.Partner.Name
	fillItems(myOffer, trade.Mine.Items, true)
	fillItems(theirOffer, trade.Theirs.Items, false)
	theirMoney.Text = "💰 " .. Util.Money(trade.Theirs.Money)
	if not myMoney:IsFocused() then
		myMoney.Text = tostring(trade.Mine.Money)
	end
	myStatus.Text = trade.Mine.Ready and "✅ READY" or "⏳ Not ready"
	myStatus.TextColor3 = trade.Mine.Ready and T.Green or T.SubText
	theirStatus.Text = trade.Theirs.Ready and "✅ READY" or "⏳ Not ready"
	theirStatus.TextColor3 = trade.Theirs.Ready and T.Green or T.SubText
	readyButton.Text = trade.Mine.Ready and "UNREADY" or "✅ READY"
	Lib.setButtonColor(readyButton, trade.Mine.Ready and T.Orange or T.Green)
	refreshPicker()
end

local function refresh()
	lobby.Visible = trade == nil
	session.Visible = trade ~= nil
	if trade then
		refreshSession()
	else
		refreshLobby()
	end
end

local function itemGrid(parent, pos, size)
	local s = Lib.scroll({ Position = pos, Size = size, Parent = parent })
	Lib.grid(UDim2.fromOffset(84, 98), 6).Parent = s
	Lib.padding(4).Parent = s
	return s
end

function Trade.Build(content: Frame, windows)
	Windows = windows
	-- Lobby
	lobby = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = content })
	local h = Lib.label({ Size = UDim2.new(1, 0, 0, 30), Text = "Choose a player to trade with", Font = T.Title, MaxText = 22, Parent = lobby })
	Lib.textStroke(1.5).Parent = h
	playerList = Lib.scroll({ Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 1, -36), Parent = lobby })
	Lib.list(Enum.FillDirection.Vertical, 6).Parent = playerList
	Lib.padding(4).Parent = playerList

	-- Session
	session = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = content })
	partnerLabel = Lib.label({ Size = UDim2.new(0.6, 0, 0, 28), Text = "", Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 22, Parent = session })
	Lib.textStroke(1.5).Parent = partnerLabel
	countdown = Lib.label({ Size = UDim2.new(0.4, 0, 0, 28), Position = UDim2.fromScale(0.6, 0), Text = "", Font = T.Title, TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Right, MaxText = 22, Parent = session })
	Lib.textStroke(1.5).Parent = countdown

	local mine = Lib.panel({ Position = UDim2.fromOffset(0, 34), Size = UDim2.new(0.5, -4, 0.5, -34), Parent = session })
	Lib.padding(6).Parent = mine
	Lib.label({ Size = UDim2.new(0.5, 0, 0, 22), Text = "YOUR OFFER", Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 18, Parent = mine })
	myStatus = Lib.label({ Size = UDim2.new(0.5, 0, 0, 22), Position = UDim2.fromScale(0.5, 0), Text = "", TextXAlignment = Enum.TextXAlignment.Right, MaxText = 16, Parent = mine })
	myOffer = itemGrid(mine, UDim2.fromOffset(0, 26), UDim2.new(1, 0, 1, -64))
	myMoney = new("TextBox", {
		Size = UDim2.new(1, 0, 0, 32),
		Position = UDim2.new(0, 0, 1, -34),
		BackgroundColor3 = T.Bg,
		Font = T.Body,
		TextSize = 16,
		TextColor3 = T.Text,
		PlaceholderText = "💰 Add money (number)",
		Text = "0",
		ClearTextOnFocus = false,
		Parent = mine,
	}, { Lib.corner(8) })
	myMoney.FocusLost:Connect(function()
		sendOffer(offerUids())
	end)

	local theirs = Lib.panel({ Position = UDim2.new(0.5, 4, 0, 34), Size = UDim2.new(0.5, -4, 0.5, -34), Parent = session })
	Lib.padding(6).Parent = theirs
	Lib.label({ Size = UDim2.new(0.5, 0, 0, 22), Text = "THEIR OFFER", Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 18, Parent = theirs })
	theirStatus = Lib.label({ Size = UDim2.new(0.5, 0, 0, 22), Position = UDim2.fromScale(0.5, 0), Text = "", TextXAlignment = Enum.TextXAlignment.Right, MaxText = 16, Parent = theirs })
	theirOffer = itemGrid(theirs, UDim2.fromOffset(0, 26), UDim2.new(1, 0, 1, -64))
	theirMoney = Lib.label({ Size = UDim2.new(1, 0, 0, 32), Position = UDim2.new(0, 0, 1, -34), Text = "", TextColor3 = T.Green, MaxText = 18, Parent = theirs })

	local pick = Lib.panel({ Position = UDim2.new(0, 0, 0.5, 6), Size = UDim2.new(1, 0, 0.5, -60), Parent = session })
	Lib.padding(6).Parent = pick
	Lib.label({ Size = UDim2.new(1, 0, 0, 20), Text = "Tap your treasures to add them (max " .. Config.Trade.MaxItems .. ")", TextColor3 = T.SubText, MaxText = 15, Parent = pick })
	picker = itemGrid(pick, UDim2.fromOffset(0, 24), UDim2.new(1, 0, 1, -24))

	local buttons = new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -48), Size = UDim2.new(1, 0, 0, 46), Parent = session }, {
		Lib.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center),
	})
	readyButton = Lib.button({ Text = "READY", Color = T.Green, Size = UDim2.fromOffset(170, 44), Parent = buttons, OnClick = function()
		if trade then
			State.Request("TradeReady", not trade.Mine.Ready)
		end
	end })
	Lib.button({ Text = "✕ Cancel", Color = T.Red, Size = UDim2.fromOffset(150, 44), Parent = buttons, OnClick = function()
		State.Request("TradeCancel")
	end })

	Remotes.TradeUpdate.OnClientEvent:Connect(function(view, reason)
		local wasTrading = trade ~= nil
		trade = view or nil
		if view and not wasTrading then
			Windows.Open("Trade")
		end
		if not view and reason and Windows.IsOpen("Trade") then
			Windows.Close()
		end
		refresh()
	end)
	State.FullChanged.Event:Connect(function()
		if isOpen and trade then
			refreshPicker()
		end
	end)
	Players.PlayerAdded:Connect(function()
		if isOpen and not trade then
			refreshLobby()
		end
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(function()
			if isOpen and not trade then
				refreshLobby()
			end
		end)
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			if trade and trade.Status == "Confirming" then
				local left = math.max(0, trade.CountdownEnd - State.Now())
				countdown.Text = ("Trading in %.1fs..."):format(left)
			elseif countdown then
				countdown.Text = ""
			end
		end
	end)
end

function Trade.OnOpen()
	isOpen = true
	refresh()
end

function Trade.OnClose()
	isOpen = false
	if trade then
		-- closing the window cancels the trade so nobody gets stuck
		State.Ask("TradeCancel")
	end
end

return Trade
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">Windows</string><ProtectedString name="Source"><![CDATA[-- Windows.lua
-- Window manager: one menu open at a time, animated open/close, shared
-- title bar and close button. Each window module implements:
--   Build(content: Frame, api)  -- called once
--   OnOpen(arg)?                -- every time it opens
--   OnClose()?                  -- every time it closes

local TweenService = game:GetService("TweenService")

local Lib = require(script.Parent.Lib)
local Sound = require(script.Parent.Parent.Controllers.Sound)

local T = Lib.Theme
local new = Lib.new

local Windows = {}
Windows.Registry = {}
Windows.Current = nil :: string?
Windows.Changed = Instance.new("BindableEvent")

local gui: ScreenGui
local dim: Frame

function Windows.Register(name: string, module, opts)
	opts = opts or {}
	local frame = Lib.panel({
		Name = name .. "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = opts.Size or UDim2.fromScale(0.74, 0.8),
		BackgroundColor3 = T.Bg,
		Visible = false,
		ZIndex = 10,
		Radius = 18,
		Parent = gui,
	})
	new("UISizeConstraint", { MaxSize = opts.MaxSize or Vector2.new(920, 640), MinSize = Vector2.new(300, 260), Parent = frame })
	Lib.stroke(opts.Color or T.Accent, 3).Parent = frame
	local scale = new("UIScale", { Parent = frame })

	local header = Lib.panel({
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = opts.Color or T.Accent,
		Radius = 18,
		ZIndex = 11,
		Parent = frame,
	})
	Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(180, 180, 180)).Parent = header
	-- square off the header's bottom corners
	new("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 1, -18),
		BackgroundColor3 = opts.Color or T.Accent,
		BorderSizePixel = 0,
		ZIndex = 11,
		Parent = header,
	}, { Lib.gradient(Color3.fromRGB(200, 200, 200), Color3.fromRGB(180, 180, 180)) })
	local title = Lib.label({
		Size = UDim2.new(1, -120, 1, -12),
		Position = UDim2.fromOffset(18, 6),
		Font = T.Title,
		Text = (opts.Icon or "") .. "  " .. (opts.Title or name),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 12,
		Parent = header,
		MaxText = 30,
	})
	Lib.textStroke(2).Parent = title
	Lib.button({
		Name = "Close",
		Text = "✕",
		Color = T.Red,
		Size = UDim2.fromOffset(42, 38),
		Position = UDim2.new(1, -10, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		ZIndex = 13,
		Parent = header,
		OnClick = function()
			Windows.Close()
		end,
	})
	local content = new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 62),
		Size = UDim2.new(1, -28, 1, -74),
		ZIndex = 11,
		Parent = frame,
	})
	local entry = { Name = name, Frame = frame, Scale = scale, Module = module, Content = content, Title = title }
	Windows.Registry[name] = entry
	module.Build(content, Windows)
	return entry
end

function Windows.IsOpen(name: string): boolean
	return Windows.Current == name
end

function Windows.Open(name: string, arg: any?)
	local entry = Windows.Registry[name]
	if not entry then
		return
	end
	if Windows.Current and Windows.Current ~= name then
		Windows.Close(true)
	end
	Windows.Current = name
	entry.Frame.Visible = true
	dim.Visible = true
	entry.Scale.Scale = 0.7
	TweenService:Create(entry.Scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	Sound.Play("Hover", 0.5)
	if entry.Module.OnOpen then
		task.spawn(entry.Module.OnOpen, arg)
	end
	Windows.Changed:Fire(name)
end

function Windows.Close(instant: boolean?)
	local name = Windows.Current
	if not name then
		return
	end
	local entry = Windows.Registry[name]
	Windows.Current = nil
	if entry.Module.OnClose then
		task.spawn(entry.Module.OnClose)
	end
	if instant then
		entry.Frame.Visible = false
	else
		local tw = TweenService:Create(entry.Scale, TweenInfo.new(0.15), { Scale = 0.7 })
		tw:Play()
		tw.Completed:Once(function()
			if Windows.Current ~= name then
				entry.Frame.Visible = false
			end
		end)
	end
	dim.Visible = false
	Windows.Changed:Fire(nil)
end

function Windows.Toggle(name: string, arg: any?)
	if Windows.Current == name then
		Windows.Close()
	else
		Windows.Open(name, arg)
	end
end

function Windows.Init(parentGui: ScreenGui)
	gui = parentGui
	dim = new("TextButton", {
		Name = "Dim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 9,
		Parent = gui,
	})
	dim.Activated:Connect(function()
		Windows.Close()
	end)
end

return Windows
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
</Item>
<Item class="Workspace" referent="RBX00000033"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item>
</roblox>
