	Celestial = {
		"Nebula Dragon|Dragon|3a0ca3|4cc9f0|Neon|Money",
		"Starlight Unicorn|Unicorn|caf0f8|b388ff|Neon|Luck",
		"Cosmic Whale|Whale|1a237e|80d8ff|Neon|Gems",
	},
}

-- Species flags used by the procedural builder and the follow animation.
local SPECIES = {
	Dog = { Ears = "Floppy", Tail = "Short", Legs = 4, Snout = true },
	Cat = { Ears = "Pointy", Tail = "Long", Legs = 4 },
	Bunny = { Ears = "Long", Tail = "Puff", Legs = 4, Hops = true },
	Chick = { Beak = true, Legs = 2, Wings = "Small" },
	Frog = { Eyes = "Top", Legs = 4, Hops = true, Wide = true },
	Mouse = { Ears = "Round", Tail = "Thin", Legs = 4 },
	Pig = { Ears = "Pointy", Snout = true, Tail = "Curl", Legs = 4 },
	Slime = { Blob = true, Hops = true },
	Fox = { Ears = "Pointy", Tail = "Fluffy", Legs = 4, Snout = true },
	Bear = { Ears = "Round", Tail = "Puff", Legs = 4 },
	Penguin = { Beak = true, Legs = 2, Wings = "Flipper" },
	Bee = { Flies = true, Wings = "Bug", Antenna = true, Stripes = true },
	Owl = { Flies = true, Wings = "Bird", Beak = true, Ears = "Tuft" },
	Turtle = { Shell = true, Legs = 4 },
	Hamster = { Ears = "Round", Legs = 4, Wide = true },
	Wolf = { Ears = "Pointy", Tail = "Fluffy", Legs = 4, Snout = true },
	Parrot = { Flies = true, Wings = "Bird", Beak = true, Tail = "Feather" },
	Bat = { Flies = true, Wings = "Bat", Ears = "Pointy" },
	Unicorn = { Ears = "Pointy", Horn = true, Legs = 4, Snout = true, Tail = "Long" },
	Ghost = { Flies = true, Blob = true, Ghostly = true },
	Robot = { Boxy = true, Antenna = true, Legs = 2 },
	Dragon = { Flies = true, Wings = "Bat", Horn = true, Tail = "Long", Snout = true },
	Phoenix = { Flies = true, Wings = "Bird", Beak = true, Tail = "Feather", Fiery = true },
	Squid = { Flies = true, Tentacles = true },
	Whale = { Flies = true, Fins = true, Tail = "Fin", Wide = true },
}

local POWER = {
	Common = 0.05,
	Uncommon = 0.10,
	Rare = 0.18,
	Epic = 0.30,
	Legendary = 0.50,
	Mythical = 0.80,
	Secret = 1.20,
	Divine = 1.80,
	Celestial = 3.00,
}

local PetData = {}
PetData.Species = SPECIES
PetData.Icons = {
	Dog = "🐶", Cat = "🐱", Bunny = "🐰", Chick = "🐥", Frog = "🐸", Mouse = "🐭", Pig = "🐷",
	Slime = "🟢", Fox = "🦊", Bear = "🐻", Penguin = "🐧", Bee = "🐝", Owl = "🦉", Turtle = "🐢",
	Hamster = "🐹", Wolf = "🐺", Parrot = "🦜", Bat = "🦇", Unicorn = "🦄", Ghost = "👻",
	Robot = "🤖", Dragon = "🐉", Phoenix = "🔥", Squid = "🦑", Whale = "🐋",
}
PetData.ById = {}
PetData.List = {}
PetData.ByRarity = {}

local function slug(name: string): string
	return (name:lower():gsub("[^%w]+", "_"))
end

for _, rarity in ipairs(Rarities.Order) do
	PetData.ByRarity[rarity] = {}
	for i, row in ipairs(RAW[rarity] or {}) do
		local p = string.split(row, "|")
		local def = {
			Name = p[1],
			Species = p[2],
			Body = Color3.fromHex(p[3]),
			Accent = Color3.fromHex(p[4]),
			Material = p[5],
			BonusType = p[6],
			Rarity = rarity,
			Id = "pet_" .. slug(p[1]),
		}
		local power = POWER[rarity] * (1 + (i - 1) * 0.06)
		if def.BonusType == "Speed" then
			def.Bonus = math.floor(power * 10 + 0.5) -- walk speed studs
		else
			def.Bonus = math.floor(power * 100 + 0.5) / 100 -- fraction
		end
		def.Flies = SPECIES[def.Species] and SPECIES[def.Species].Flies or false
		def.Order = #PetData.List + 1
		PetData.ById[def.Id] = def
		table.insert(PetData.List, def)
		table.insert(PetData.ByRarity[rarity], def)
	end
end

function PetData.Get(id: string)
	return PetData.ById[id]
end

function PetData.BonusText(def): string
	if def.BonusType == "Speed" then
		return ("+%d Speed"):format(def.Bonus)
	end
	local label = def.BonusType == "Money" and "Income" or (def.BonusType == "Luck" and "Luck" or "Gems")
	return ("+%d%% %s"):format(math.floor(def.Bonus * 100 + 0.5), label)
end

-- Eggs ---------------------------------------------------------------------
PetData.Eggs = {
	Meadow = {
		Order = 1,
		Name = "Meadow Egg",
		Currency = "Money",
		Cost = 2500,
		Color = Color3.fromRGB(150, 230, 120),
		Weights = { Common = 70, Uncommon = 25, Rare = 5 },
	},
	Golden = {
		Order = 2,
		Name = "Golden Egg",
		Currency = "Money",
		Cost = 250000,
		Color = Color3.fromRGB(255, 210, 60),
		Weights = { Uncommon = 35, Rare = 40, Epic = 20, Legendary = 5 },
	},
	Gem = {
		Order = 3,
		Name = "Gem Egg",
		Currency = "Gems",
		Cost = 150,
		Color = Color3.fromRGB(120, 200, 255),
		Weights = { Rare = 30, Epic = 40, Legendary = 22, Mythical = 7, Secret = 1 },
	},
	Cosmic = {
		Order = 4,
		Name = "Cosmic Egg",
		Currency = "Gems",
		Cost = 1000,
		Color = Color3.fromRGB(170, 110, 255),
		Weights = { Legendary = 50, Mythical = 30, Secret = 12, Divine = 6, Celestial = 2 },
	},
}

-- Rolls a pet from an egg. Luck (1 = normal) boosts rarer tiers.
function PetData.Roll(eggKey: string, luck: number, rng: Random?)
	local egg = PetData.Eggs[eggKey]
	if not egg then
		return nil
	end
	local r = rng or Random.new()
	local weights = {}
	local lowest = math.huge
	for name in pairs(egg.Weights) do
		lowest = math.min(lowest, Rarities.Rank(name))
	end
	for name, w in pairs(egg.Weights) do
		local steps = Rarities.Rank(name) - lowest
		weights[name] = w * (luck ^ steps)
	end
	local rarity = Rarities.Roll(weights, r)
	local pool = PetData.ByRarity[rarity]
	return pool[r:NextInteger(1, #pool)]
end

return PetData
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">PetModels</string><ProtectedString name="Source"><![CDATA[-- PetModels.lua
-- Procedural pet builder. Every part is anchored and tagged with a Role so
-- the client follower can animate legs, wings, tails and ears each frame by
-- moving parts relative to the pet's root (BulkMoveTo, no physics).

local PetData = require(script.Parent.PetData)
local Rarities = require(script.Parent.Rarities)

local PetModels = {}

local function mat(name: string): Enum.Material
	local ok, m = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	return ok and m or Enum.Material.SmoothPlastic
end

-- Builds a pet. Returns model, parts list { {Part, Offset: CFrame, Role} }
function PetModels.Build(def, scale: number?)
	local s = scale or 1
	local sp = PetData.Species[def.Species] or {}
	local model = Instance.new("Model")
	model.Name = def.Name
	local parts = {}
	local bodyMat = mat(def.Material)

	local function add(shape: string, size: Vector3, offset: CFrame, color: Color3, role: string?, material: Enum.Material?)
		local p = Instance.new("Part")
		if shape == "Ball" then
			p.Shape = Enum.PartType.Ball
		elseif shape == "Cyl" then
			p.Shape = Enum.PartType.Cylinder
		elseif shape == "Wedge" then
			p = Instance.new("WedgePart")
		end
		p.Size = size * s
		p.Color = color
		p.Material = material or bodyMat
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if p.Material == Enum.Material.Glass then
			p.Transparency = 0.3
		end
		if sp.Ghostly then
			p.Transparency = 0.25
		end
		local off = CFrame.new(offset.Position * s) * offset.Rotation
		p.CFrame = off
		p.Parent = model
		table.insert(parts, { Part = p, Offset = off, Role = role or "Body" })
		return p
	end

	local body, accent = def.Body, def.Accent
	local eye = Color3.fromRGB(20, 20, 30)

	-- Body + head
	if sp.Boxy then
		add("Block", Vector3.new(1.6, 1.4, 1.2), CFrame.new(0, 1.2, 0), body)
		add("Block", Vector3.new(1.3, 1.1, 1.1), CFrame.new(0, 2.45, 0.05), body, "Head")
		add("Block", Vector3.new(1.0, 0.5, 0.05), CFrame.new(0, 2.5, 0.6), accent, "Head", Enum.Material.Neon)
	elseif sp.Blob then
		local b = add("Block", Vector3.new(2, 1.7, 2), CFrame.new(0, 1, 0), body, "Squash")
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = b
	elseif sp.Tentacles then
		add("Ball", Vector3.new(1.8, 1.8, 1.8), CFrame.new(0, 1.8, 0), body, "Head")
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			add("Cyl", Vector3.new(1.4, 0.35, 0.35), CFrame.new(math.cos(a) * 0.55, 0.7, math.sin(a) * 0.55) * CFrame.Angles(0, 0, math.rad(90)), accent, "Tentacle")
		end
	else
		local bodyW = sp.Wide and 1.8 or 1.4
		local b = add("Block", Vector3.new(bodyW, 1.2, sp.Legs == 4 and 1.8 or 1.3), CFrame.new(0, 1.15, 0), body, "Body")
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = b
		add("Ball", Vector3.new(1.35, 1.35, 1.35), CFrame.new(0, 2.05, sp.Legs == 4 and 0.75 or 0.15), body, "Head")
	end

	local headZ = (sp.Legs == 4) and 0.75 or 0.15
	local headY = sp.Boxy and 2.45 or (sp.Blob and 1.1 or (sp.Tentacles and 1.8 or 2.05))
	local faceZ = headZ + (sp.Blob and 0.95 or (sp.Tentacles and 0.85 or 0.62))
	if sp.Boxy then
		faceZ = 0.62
	end

	-- Eyes
	local eyeY = sp.Eyes == "Top" and headY + 0.55 or headY + 0.12
	for _, x in ipairs({ -0.28, 0.28 }) do
		add("Ball", Vector3.new(0.3, 0.3, 0.3), CFrame.new(x, eyeY, faceZ), eye, "Head", Enum.Material.SmoothPlastic)
		add("Ball", Vector3.new(0.1, 0.1, 0.1), CFrame.new(x + 0.05, eyeY + 0.07, faceZ + 0.12), Color3.new(1, 1, 1), "Head", Enum.Material.Neon)
	end
	-- Snout / beak / nose
	if sp.Snout then
		add("Ball", Vector3.new(0.6, 0.5, 0.6), CFrame.new(0, headY - 0.2, faceZ + 0.05), accent, "Head")
		add("Ball", Vector3.new(0.2, 0.15, 0.15), CFrame.new(0, headY - 0.1, faceZ + 0.32), eye, "Head", Enum.Material.SmoothPlastic)
	elseif sp.Beak then
		add("Wedge", Vector3.new(0.3, 0.25, 0.4), CFrame.new(0, headY - 0.15, faceZ + 0.15) * CFrame.Angles(math.rad(90), 0, 0), Color3.fromRGB(255, 170, 40), "Head", Enum.Material.SmoothPlastic)
	elseif not sp.Boxy then
		add("Block", Vector3.new(0.3, 0.06, 0.06), CFrame.new(0, headY - 0.2, faceZ), eye, "Head", Enum.Material.SmoothPlastic)
	end
	-- Ears
	if sp.Ears == "Pointy" or sp.Ears == "Tuft" then
		for _, x in ipairs({ -0.4, 0.4 }) do
			add("Wedge", Vector3.new(0.2, 0.55, 0.4), CFrame.new(x, headY + 0.7, headZ) * CFrame.Angles(0, 0, math.rad(x > 0 and -15 or 15)), accent, "Ear")
		end
	elseif sp.Ears == "Round" then
		for _, x in ipairs({ -0.5, 0.5 }) do
			add("Ball", Vector3.new(0.5, 0.5, 0.5), CFrame.new(x, headY + 0.55, headZ), accent, "Ear")
		end
	elseif sp.Ears == "Long" then
		for _, x in ipairs({ -0.25, 0.25 }) do
			add("Block", Vector3.new(0.25, 1.1, 0.15), CFrame.new(x, headY + 1.05, headZ - 0.05), body, "Ear")
			add("Block", Vector3.new(0.14, 0.8, 0.05), CFrame.new(x, headY + 1.05, headZ + 0.03), accent, "Ear")
		end
	elseif sp.Ears == "Floppy" then
		for _, x in ipairs({ -0.62, 0.62 }) do
			add("Block", Vector3.new(0.2, 0.8, 0.45), CFrame.new(x, headY, headZ) * CFrame.Angles(0, 0, math.rad(x > 0 and 15 or -15)), accent, "Ear")
		end
	end
	if sp.Horn then
		add("Wedge", Vector3.new(0.18, 0.8, 0.25), CFrame.new(0, headY + 0.9, headZ + 0.3), Color3.fromRGB(255, 230, 120), "Head", Enum.Material.Neon)
	end
	if sp.Antenna then
		for _, x in ipairs({ -0.25, 0.25 }) do
			add("Cyl", Vector3.new(0.6, 0.08, 0.08), CFrame.new(x, headY + 0.85, headZ) * CFrame.Angles(0, 0, math.rad(90)), eye, "Ear")
			add("Ball", Vector3.new(0.2, 0.2, 0.2), CFrame.new(x, headY + 1.15, headZ), accent, "Ear", Enum.Material.Neon)
		end
	end
	-- Legs
	if sp.Legs == 4 then
		for _, lp in ipairs({ { -0.45, 0.6, "LegA" }, { 0.45, -0.6, "LegA" }, { 0.45, 0.6, "LegB" }, { -0.45, -0.6, "LegB" } }) do
			add("Cyl", Vector3.new(0.6, 0.35, 0.35), CFrame.new(lp[1], 0.35, lp[2]) * CFrame.Angles(0, 0, math.rad(90)), body, lp[3])
		end
	elseif sp.Legs == 2 then
		add("Cyl", Vector3.new(0.6, 0.3, 0.3), CFrame.new(-0.35, 0.35, 0) * CFrame.Angles(0, 0, math.rad(90)), sp.Boxy and accent or Color3.fromRGB(255, 170, 40), "LegA")
		add("Cyl", Vector3.new(0.6, 0.3, 0.3), CFrame.new(0.35, 0.35, 0) * CFrame.Angles(0, 0, math.rad(90)), sp.Boxy and accent or Color3.fromRGB(255, 170, 40), "LegB")
	end
	-- Wings
	if sp.Wings then
		local wingSize = sp.Wings == "Small" and Vector3.new(0.6, 0.15, 0.5)
			or (sp.Wings == "Flipper" and Vector3.new(0.5, 0.12, 0.3) or (sp.Wings == "Bug" and Vector3.new(1.0, 0.05, 0.6) or Vector3.new(1.6, 0.12, 0.9)))
		local wingMat = sp.Wings == "Bug" and Enum.Material.Glass or nil
		add("Block", wingSize, CFrame.new(-0.7 - wingSize.X / 2, 1.5, -0.1), accent, "WingL", wingMat)
		add("Block", wingSize, CFrame.new(0.7 + wingSize.X / 2, 1.5, -0.1), accent, "WingR", wingMat)
	end
	if sp.Fins then
		add("Block", Vector3.new(1.0, 0.12, 0.6), CFrame.new(-1.0, 1.0, 0.2), accent, "WingL")
		add("Block", Vector3.new(1.0, 0.12, 0.6), CFrame.new(1.0, 1.0, 0.2), accent, "WingR")
	end
	-- Tail
	if sp.Tail then
		local tailSize = (sp.Tail == "Long" or sp.Tail == "Thin") and Vector3.new(0.2, 0.2, 1.2)
			or (sp.Tail == "Fluffy" and Vector3.new(0.55, 0.55, 1.1) or (sp.Tail == "Feather" and Vector3.new(0.5, 0.1, 1.2) or (sp.Tail == "Fin" and Vector3.new(1.4, 0.15, 0.6) or Vector3.new(0.4, 0.4, 0.4))))
		local shape = (sp.Tail == "Puff" or sp.Tail == "Curl") and "Ball" or "Block"
		add(shape, tailSize, CFrame.new(0, 1.3, -1.0 - tailSize.Z / 3) * CFrame.Angles(math.rad(-25), 0, 0), sp.Tail == "Fluffy" and accent or body, "Tail")
	end
	if sp.Stripes then
		for i = -1, 1 do
			add("Block", Vector3.new(1.45, 0.18, 0.2), CFrame.new(0, 1.15, i * 0.35), accent, "Body", Enum.Material.SmoothPlastic)
		end
	end
	if sp.Shell then
		local sh = add("Block", Vector3.new(1.7, 0.9, 2), CFrame.new(0, 1.55, -0.1), accent, "Body")
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = sh
	end

	-- Rarity effects
	local info = Rarities.Info[def.Rarity]
	local rootPart = parts[1].Part
	rootPart.Name = "PetRoot"
	model.PrimaryPart = rootPart
	if info and info.Particles > 0 then
		local e = Instance.new("ParticleEmitter")
		e.Texture = sp.Fiery and "rbxasset://textures/particles/fire_main.dds" or "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ColorSequence.new(info.Glow, def.Accent)
		e.LightEmission = 0.8
		e.Rate = math.max(2, info.Particles * 0.5)
		e.Lifetime = NumberRange.new(0.6, 1.2)
		e.Speed = NumberRange.new(0.5, 1.5)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new(0.3 * s, 0)
		e.Parent = rootPart
	end
	if info and info.Light > 0 then
		local l = Instance.new("PointLight")
		l.Color = def.Accent
		l.Range = 6 + info.Rank
		l.Brightness = 1.2
		l.Parent = rootPart
	end
	model:SetAttribute("PetId", def.Id)
	return model, parts
end

return PetModels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Rarities</string><ProtectedString name="Source"><![CDATA[-- Rarities.lua
-- Rarity tiers, their colours and which visual effects they get.

local Rarities = {}

Rarities.Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical", "Secret", "Divine", "Celestial" }

Rarities.Info = {
	Common = {
		Rank = 1,
		Color = Color3.fromRGB(200, 205, 215),
		Glow = Color3.fromRGB(255, 255, 255),
		Sparkles = false,
		Particles = 0,
		Light = 0,
		Beam = false,
		Halo = false,
		Rainbow = false,
		Smoke = false,
		Announce = false,
	},
	Uncommon = {
		Rank = 2,
		Color = Color3.fromRGB(90, 220, 110),
		Glow = Color3.fromRGB(120, 255, 140),
		Sparkles = true,
		Particles = 2,
		Light = 0,
		Beam = false,
		Halo = false,
		Rainbow = false,
		Smoke = false,
		Announce = false,
	},
	Rare = {
		Rank = 3,
		Color = Color3.fromRGB(70, 150, 255),
		Glow = Color3.fromRGB(110, 180, 255),
		Sparkles = true,
		Particles = 5,
		Light = 6,
		Beam = false,
		Halo = false,
		Rainbow = false,
		Smoke = false,
		Announce = false,
	},
	Epic = {
		Rank = 4,
		Color = Color3.fromRGB(175, 85, 255),
		Glow = Color3.fromRGB(200, 120, 255),
		Sparkles = true,
		Particles = 9,
		Light = 10,
		Beam = false,
		Halo = false,
		Rainbow = false,
		Smoke = false,
		Announce = false,
	},
	Legendary = {
		Rank = 5,
		Color = Color3.fromRGB(255, 185, 40),
		Glow = Color3.fromRGB(255, 220, 90),
		Sparkles = true,
		Particles = 14,
		Light = 14,
		Beam = true,
		Halo = false,
		Rainbow = false,
		Smoke = false,
		Announce = true,
	},
	Mythical = {
		Rank = 6,
		Color = Color3.fromRGB(255, 70, 120),
		Glow = Color3.fromRGB(255, 120, 170),
		Sparkles = true,
		Particles = 18,
		Light = 16,
		Beam = true,
		Halo = true,
		Rainbow = false,
		Smoke = false,
		Announce = true,
	},
	Secret = {
		Rank = 7,
		Color = Color3.fromRGB(40, 40, 50),
		Glow = Color3.fromRGB(130, 255, 230),
		Sparkles = true,
		Particles = 20,
		Light = 18,
		Beam = true,
		Halo = true,
		Rainbow = false,
		Smoke = true,
		Announce = true,
	},
	Divine = {
		Rank = 8,
		Color = Color3.fromRGB(255, 250, 220),
		Glow = Color3.fromRGB(255, 245, 180),
		Sparkles = true,
		Particles = 26,
		Light = 22,
		Beam = true,
		Halo = true,
		Rainbow = true,
		Smoke = false,
		Announce = true,
	},
	Celestial = {
		Rank = 9,
		Color = Color3.fromRGB(110, 210, 255),
		Glow = Color3.fromRGB(190, 160, 255),
		Sparkles = true,
		Particles = 30,
		Light = 26,
		Beam = true,
		Halo = true,
		Rainbow = true,
		Smoke = false,
		Announce = true,
		Orbit = true, -- orbiting star moons
	},
}

function Rarities.Rank(name: string): number
	local info = Rarities.Info[name]
	return info and info.Rank or 0
end

function Rarities.Color(name: string): Color3
	local info = Rarities.Info[name]
	return info and info.Color or Color3.new(1, 1, 1)
end

-- Weighted random roll over a { RarityName = weight } table.
function Rarities.Roll(weights: { [string]: number }, rng: Random?): string
	local r = rng or Random.new()
	local total = 0
	for _, name in ipairs(Rarities.Order) do
		total += weights[name] or 0
	end
	local pick = r:NextNumber() * total
	for _, name in ipairs(Rarities.Order) do
		local w = weights[name] or 0
		if w > 0 then
			if pick <= w then
				return name
			end
			pick -= w
		end
	end
	return "Common"
end

return Rarities
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Remotes.lua
-- Declares every RemoteEvent / RemoteFunction. The server creates them, the
-- client waits for them. All client->server traffic goes through `Action`
-- (validated & rate limited on the server).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"FullState", -- server -> client: complete player state snapshot
	"Stats", -- server -> client: lightweight stats every tick
	"Notify", -- server -> client: toast message
	"Alarm", -- server -> client: your base is being robbed
	"Announce", -- server -> all: big banner (events, legendary pulls)
	"TradeUpdate", -- server -> client: trade session state
	"TradeRequest", -- server -> client: incoming trade request
	"Leaderboard", -- server -> client: leaderboard data
	"Effect", -- server -> client: play a local effect (dash, knockback, confetti)
	"EventState", -- server -> all: current world event
}

local FUNCTIONS = {
	"Action", -- client -> server: every request
}

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes") :: Folder
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local e = Instance.new("RemoteEvent")
			e.Name = name
			e.Parent = folder
		end
	end
	for _, name in ipairs(FUNCTIONS) do
		if not folder:FindFirstChild(name) then
			local f = Instance.new("RemoteFunction")
			f.Name = name
			f.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

for _, name in ipairs(EVENTS) do
	Remotes[name] = folder:WaitForChild(name)
end
for _, name in ipairs(FUNCTIONS) do
	Remotes[name] = folder:WaitForChild(name)
end

return Remotes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">TreasureData</string><ProtectedString name="Source"><![CDATA[-- TreasureData.lua
-- 102 collectable treasures + 4 rebirth-exclusive treasures.
-- Each row: Name | Shape | PrimaryHex | SecondaryHex | Material | Fx(optional)
-- Value and money-per-second are derived from rarity and position in the tier so
-- the economy curve stays smooth; every treasure is still unique in model,
-- colours, material, effect, value and income.

local Rarities = require(script.Parent.Rarities)

local RAW = {
	Common = {
		"Rusty Coin|CoinStack|8a5a3c|b07040|Metal",
		"Copper Coins|CoinStack|c87533|e09050|Metal",
