		"Wooden Chest|Chest|8b5a2b|5a3a1a|Wood",
		"Clay Chalice|Chalice|b5651d|d08040|Slate",
		"Tin Ring|Ring|a8a9ad|d0d0d0|Metal",
		"Old Key|Key|6e5a3a|9a8060|Metal",
		"Glass Marble|Orb|7fc8ff|ffffff|Glass",
		"Stone Idol|Idol|7d7d7d|5a5a5a|Slate",
		"Candle Lamp|Lamp|e8d8a0|ff9a30|SmoothPlastic",
		"Mossy Egg|Egg|6b8e23|9acd32|Grass",
		"Paper Crown|Crown|f0e0b0|e05050|Fabric",
		"Bone Skull|Skull|e8e0d0|a09080|SmoothPlastic",
		"Plain Potion|Potion|a0d0a0|ffffff|Glass",
		"Iron Shield|Shield|808890|505860|DiamondPlate",
		"Toy Sword|Sword|d0d0d0|4060c0|Plastic",
		"Sand Pyramid|Pyramid|e0c080|c0a060|Sand",
		"Cobble Cube|Cube|b0b0a0|909080|Cobblestone",
	},
	Uncommon = {
		"Silver Coins|CoinStack|c0c0c8|e8e8f0|Metal",
		"Jade Gem|Gem|00a86b|50d0a0|Glass|Leaves",
		"Bronze Trophy|Trophy|cd7f32|a0602a|Metal",
		"Emerald Ring|Ring|d4af37|50c878|Metal",
		"Sea Shell Orb|Orb|ffc0cb|ffffff|Marble|Bubbles",
		"Fern Feather|Feather|4caf50|8bc34a|Grass|Leaves",
		"Copper Lamp|Lamp|b87333|ffcc66|Metal",
		"Clover Charm|Star|3cb043|a0e080|Neon|Leaves",
		"Amber Egg|Egg|ffbf00|ff8c00|Glass",
		"Bandit Mask|Mask|303030|c03030|Fabric",
		"Silver Key|Key|c0c0c0|80d0ff|Metal|Spark",
		"Herbal Potion|Potion|40c040|a0ff80|Glass|Bubbles",
		"Knight Shield|Shield|4060a0|d0d0d0|Metal",
		"Steel Sword|Sword|c8ccd0|8b4513|Metal",
		"Spell Book|Book|6a3d9a|e0c060|Fabric",
		"Rose Quartz|Crystal|f7cac9|ffffff|Glass",
	},
	Rare = {
		"Gold Coins|CoinStack|ffd700|ffec80|Metal|Spark",
		"Sapphire|Gem|0f52ba|60a0ff|Glass",
		"Golden Chalice|Chalice|ffd700|c04040|Metal",
		"Ruby Ring|Ring|ffd700|e0115f|Metal",
		"Crystal Ball|Orb|a0e0ff|ffffff|Glass|Stars",
		"Pirate Chest|Chest|6b3e1a|ffd700|Wood|Spark",
		"Frost Crystal|Crystal|a0f0ff|ffffff|Ice|Frost",
		"Pharaoh Mask|Mask|ffd700|1e90ff|Metal",
		"Owl Idol|Idol|8b6914|ffd700|Marble",
		"Sand Hourglass|Hourglass|d4a017|f0d090|Glass",
		"Ember Potion|Potion|ff4500|ffa500|Glass|Fire",
		"Silver Trophy|Trophy|e0e0e8|80c0ff|Metal|Stars",
		"Thunder Feather|Feather|4060ff|ffff60|Neon|Lightning",
		"Sea Lantern|Lamp|20b2aa|80ffff|Glass|Bubbles",
		"Dragon Egg|Egg|8b0000|ff6347|Slate|Fire",
	},
	Epic = {
		"Amethyst Cluster|Crystal|9966cc|e0b0ff|Glass|Stars",
		"Diamond|Gem|e0ffff|ffffff|Glass|Spark",
		"Royal Crown|Crown|ffd700|c00030|Metal|Spark",
		"Volcano Heart|Heart|ff3300|ffcc00|CrackedLava|Fire",
		"Wizard Tome|Book|2a2a80|80e0ff|Fabric|Stars",
		"Kraken Orb|Orb|006060|40ffd0|Glass|Bubbles",
		"Samurai Blade|Sword|e8e8f0|aa0000|Metal|Spark",
		"Golden Idol|Idol|ffd700|ffaa00|Metal|Spark",
		"Storm Shield|Shield|404870|60c0ff|DiamondPlate|Lightning",
		"Glacier Skull|Skull|b0e8ff|ffffff|Ice|Frost",
		"Elixir of Life|Potion|ff60a0|ffffff|Glass|Hearts",
		"Starfall Star|Star|ffe060|ffffff|Neon|Stars",
		"Emerald Pyramid|Pyramid|50c878|a0ffc0|Glass|Leaves",
		"Cursed Key|Key|303040|a040ff|Metal|Void",
	},
	Legendary = {
		"King's Chest|Chest|8b0000|ffd700|Wood|Spark",
		"Sun Gem|Gem|ffb000|fff080|Neon|Fire",
		"Excalibur|Sword|f0f0ff|ffd700|Metal|Stars",
		"Crown of Ages|Crown|e0c040|40e0ff|Foil|Stars",
		"Phoenix Egg|Egg|ffa000|ff4000|Foil|Fire",
		"Moonstone Orb|Orb|c0d0ff|ffffff|Glass|Stars",
		"Aztec Mask|Mask|00a080|ffd040|Marble|Spark",
		"Champion Trophy|Trophy|ffd700|ff4040|Foil|Spark",
		"Leviathan Shield|Shield|006080|40ffd0|Glass|Bubbles",
		"Ancient Hourglass|Hourglass|c0a040|80ffff|Metal|Spark",
		"Lightning Crystal|Crystal|ffff40|ffffff|Neon|Lightning",
		"Heart of the Forest|Heart|228b22|a0ff60|Grass|Leaves",
		"Djinn Lamp|Lamp|ffd700|a040ff|Foil|Void",
	},
	Mythical = {
		"Dragon Heart|Heart|c00000|ff8000|Neon|Fire",
		"Nebula Orb|Orb|6020a0|ff60ff|Glass|Stars",
		"Trident of Tides|Sword|20b0c0|ffd700|Metal|Bubbles",
		"Celestial Crown|Crown|e0f0ff|8080ff|Glass|Stars",
		"Infinity Ring|Ring|ffd700|ff00ff|Neon|Spark",
		"Frozen Star|Star|a0f0ff|ffffff|Ice|Frost",
		"Grimoire of Shadows|Book|101010|a000ff|Fabric|Void",
		"Titan Idol|Idol|707080|ffd040|Granite|Lightning",
		"Plasma Cube|Cube|ff00ff|00ffff|Neon|Lightning",
		"Unicorn Egg|Egg|ffffff|ff80ff|Marble|Hearts",
		"Golden Skull|Skull|ffd700|ff4000|Foil|Fire",
	},
	Secret = {
		"Void Gem|Gem|100020|8000ff|Glass|Void",
		"Shadow King Crown|Crown|101018|00ffc0|Metal|Void",
		"Glitch Cube|Cube|00ff80|ff0080|Neon|Lightning",
		"Black Hole Orb|Orb|050505|ff6000|Glass|Void",
		"Ghost Lantern|Lamp|60ffd0|ffffff|ForceField|Void",
		"Reaper Skull|Skull|202020|00ff90|Slate|Void",
		"Forbidden Key|Key|200000|ff2020|Metal|Fire",
		"Eclipse Star|Star|202030|ffb000|Neon|Void",
	},
	Divine = {
		"Angel Feather|Feather|ffffff|fff0a0|Neon|Stars",
		"Heart of the Cosmos|Heart|ff80ff|80ffff|Neon|Rainbow",
		"Crown of the Gods|Crown|fff8d0|ffffff|Foil|Rainbow",
		"Genesis Orb|Orb|ffffff|ffe080|Glass|Rainbow",
		"Sword of Light|Sword|ffffff|ffff80|Neon|Stars",
		"Eternal Hourglass|Hourglass|fff0c0|80e0ff|Foil|Rainbow",
		"Prism Diamond|Gem|ffffff|ff80c0|Glass|Rainbow",
	},
	Celestial = {
		"Star Forge|Star|80d0ff|ffffff|Neon|Stars",
		"Astral Chalice|Chalice|c0a0ff|80ffff|Glass|Stars",
		"Comet Crown|Crown|a0e0ff|ffffff|Foil|Stars",
		"Nova Heart|Heart|60c0ff|ffffff|Neon|Lightning",
		"Galaxy Orb|Orb|3020a0|80e0ff|Glass|Rainbow",
		"Constellation Blade|Sword|1a1a40|80e0ff|Neon|Stars",
	},
}

-- Rebirth-exclusive treasures (never spawn in the world)
local EXCLUSIVE = {
	{ Row = "Phoenix Ember|Egg|ff6000|ffd000|Neon|Fire", Rarity = "Mythical", MPS = 40000 },
	{ Row = "Chrono Hourglass|Hourglass|40c0ff|ffffff|Glass|Stars", Rarity = "Secret", MPS = 250000 },
	{ Row = "Void Crown|Crown|1a0030|c060ff|Foil|Void", Rarity = "Secret", MPS = 400000 },
	{ Row = "Eternity Heart|Heart|ffffff|ffd0ff|Neon|Rainbow", Rarity = "Divine", MPS = 2500000 },
}

local MPS_RANGE = {
	Common = { 1, 8 },
	Uncommon = { 12, 40 },
	Rare = { 60, 180 },
	Epic = { 300, 900 },
	Legendary = { 1500, 5000 },
	Mythical = { 9000, 30000 },
	Secret = { 60000, 200000 },
	Divine = { 450000, 1500000 },
	Celestial = { 4000000, 12000000 },
}

local PRICE_FACTOR = {
	Common = 25,
	Uncommon = 30,
	Rare = 35,
	Epic = 40,
	Legendary = 45,
	Mythical = 50,
	Secret = 55,
	Divine = 60,
	Celestial = 65,
}

local SHAPE_ICONS = {
	Gem = "💎",
	Crown = "👑",
	Chalice = "🏆",
	CoinStack = "🪙",
	Orb = "🔮",
	Sword = "⚔️",
	Chest = "🧰",
	Egg = "🥚",
	Star = "⭐",
	Skull = "💀",
	Trophy = "🏆",
	Ring = "💍",
	Crystal = "🔷",
	Idol = "🗿",
	Key = "🗝️",
	Lamp = "🪔",
	Mask = "🎭",
	Potion = "🧪",
	Cube = "🧊",
	Pyramid = "🔺",
	Shield = "🛡️",
	Hourglass = "⌛",
	Heart = "❤️",
	Book = "📖",
	Feather = "🪶",
}

-- Idle "personality" animations the client plays for each treasure.
local PERSONALITIES = { "Hop", "Dance", "Float", "Spin", "Wiggle", "Bounce" }

-- Mythical+ treasures have an Aura ability: +X% income for the whole base.
local AURA = { Mythical = 0.02, Secret = 0.04, Divine = 0.06, Celestial = 0.10 }
local ABILITY_NAMES = {
	Mythical = "Lucky Aura",
	Secret = "Shadow Aura",
	Divine = "Holy Aura",
	Celestial = "Cosmic Aura",
}

local function niceRound(n: number): number
	if n < 10 then
		return math.floor(n + 0.5)
	end
	local mag = 10 ^ math.floor(math.log10(n) - 1)
	return math.floor(n / mag + 0.5) * mag
end

local function slug(name: string): string
	return (name:lower():gsub("[^%w]+", "_"):gsub("^_+", ""):gsub("_+$", ""))
end

local function parse(row: string)
	local parts = string.split(row, "|")
	return {
		Name = parts[1],
		Shape = parts[2],
		Primary = Color3.fromHex(parts[3]),
		Secondary = Color3.fromHex(parts[4]),
		Material = parts[5],
		Fx = parts[6] or "None",
	}
end

local TreasureData = {}
TreasureData.Personalities = PERSONALITIES
TreasureData.ById = {} :: { [string]: any }
TreasureData.ByName = {} :: { [string]: any }
TreasureData.List = {} :: { any }
TreasureData.ByRarity = {} :: { [string]: { any } }
TreasureData.ShapeIcons = SHAPE_ICONS

local function register(def)
	def.Id = slug(def.Name)
	def.Personality = PERSONALITIES[(#def.Name + #def.Shape) % #PERSONALITIES + 1]
	def.Aura = AURA[def.Rarity] or 0
	def.Ability = ABILITY_NAMES[def.Rarity]
	def.Icon = SHAPE_ICONS[def.Shape] or "✨"
	assert(TreasureData.ById[def.Id] == nil, "Duplicate treasure id " .. def.Id)
	TreasureData.ById[def.Id] = def
	TreasureData.ByName[def.Name] = def
	table.insert(TreasureData.List, def)
	TreasureData.ByRarity[def.Rarity] = TreasureData.ByRarity[def.Rarity] or {}
	if not def.Exclusive then
		table.insert(TreasureData.ByRarity[def.Rarity], def)
	end
end

for _, rarity in ipairs(Rarities.Order) do
	local rows = RAW[rarity]
	local lo, hi = MPS_RANGE[rarity][1], MPS_RANGE[rarity][2]
	for i, row in ipairs(rows) do
		local def = parse(row)
		local t = (#rows > 1) and (i - 1) / (#rows - 1) or 0
		-- slightly exponential curve inside a tier
		local mps = lo * (hi / lo) ^ t
		def.Rarity = rarity
		def.MPS = niceRound(mps)
		def.Value = niceRound(def.MPS * PRICE_FACTOR[rarity])
		def.Exclusive = false
		def.Order = #TreasureData.List + 1
		register(def)
	end
end

for _, ex in ipairs(EXCLUSIVE) do
	local def = parse(ex.Row)
	def.Rarity = ex.Rarity
	def.MPS = ex.MPS
	def.Value = niceRound(ex.MPS * PRICE_FACTOR[ex.Rarity])
	def.Exclusive = true
	def.Order = #TreasureData.List + 1
	register(def)
end

TreasureData.CollectableCount = 0
for _, def in ipairs(TreasureData.List) do
	if not def.Exclusive then
		TreasureData.CollectableCount += 1
	end
end

function TreasureData.Get(id: string)
	return TreasureData.ById[id]
end

function TreasureData.RandomOfRarity(rarity: string, rng: Random?)
	local pool = TreasureData.ByRarity[rarity]
	if not pool or #pool == 0 then
		pool = TreasureData.ByRarity.Common
	end
	local r = rng or Random.new()
	-- within a tier, cheaper items are more common (weight 1/(index))
	local total = 0
	for i = 1, #pool do
		total += 1 / (1 + (i - 1) * 0.25)
	end
	local pick = r:NextNumber() * total
	for i = 1, #pool do
		local w = 1 / (1 + (i - 1) * 0.25)
		if pick <= w then
			return pool[i]
		end
		pick -= w
	end
	return pool[#pool]
end

function TreasureData.RollFromPool(weights: { [string]: number }, rng: Random?)
	return TreasureData.RandomOfRarity(Rarities.Roll(weights, rng), rng)
end

return TreasureData
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">TreasureModels</string><ProtectedString name="Source"><![CDATA[-- TreasureModels.lua
-- Procedurally builds a unique 3D model for every treasure from its shape,
-- colours, material and effect. Shared so the server (world objects) and the
-- client (viewport previews) build identical models without any asset uploads.
--
-- Every model has an invisible anchor part called "Root" at its base. All other
-- parts are welded to it, so moving Root moves the whole treasure. The client
-- animates Root locally (spin / bob) using the "Home" CFrame attribute.

local Rarities = require(script.Parent.Rarities)
local Mutations = require(script.Parent.Mutations)

local TreasureModels = {}

local TEX_SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function mat(name: string): Enum.Material
	local ok, m = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	return ok and m or Enum.Material.SmoothPlastic
end

-- Builder context ---------------------------------------------------------
local Builder = {}
Builder.__index = Builder

local function newBuilder(model: Model, root: BasePart, scale: number, def)
	return setmetatable({
		Model = model,
		Root = root,
		S = scale,
		Def = def,
		Primary = def.Primary,
		Secondary = def.Secondary,
		Material = mat(def.Material),
		Count = 0,
	}, Builder)
end

-- Adds a part. `cf` is relative to the root (in unscaled units).
function Builder:Part(shape: string, size: Vector3, cf: CFrame, color: Color3?, material: Enum.Material?, mesh: Vector3?)
	local s = self.S
	local p = Instance.new("Part")
	self.Count += 1
	p.Name = "P" .. self.Count
	if shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "Cyl" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "Wedge" then
		p:Destroy()
		p = Instance.new("WedgePart")
		p.Name = "P" .. self.Count
	end
	p.Size = size * s
	p.Color = color or self.Primary
	p.Material = material or self.Material
	if p.Material == Enum.Material.Glass then
		p.Transparency = 0.25
		p.Reflectance = 0.1
	elseif p.Material == Enum.Material.ForceField then
		p.Transparency = 0
	end
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local pos = cf.Position * s
	p.CFrame = self.Root.CFrame * (CFrame.new(pos) * cf.Rotation)
	if mesh then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Scale = mesh
		m.Parent = p
	end
	local w = Instance.new("WeldConstraint")
	w.Part0 = self.Root
	w.Part1 = p
	w.Parent = p
	p.Parent = self.Model
	return p
end

local UP = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder upright
local function at(x, y, z)
	return CFrame.new(x, y, z)
end

-- Shapes ------------------------------------------------------------------
local Shapes = {}

function Shapes.Gem(b)
	b:Part("Cyl", Vector3.new(0.4, 1.6, 1.6), at(0, 0.2, 0) * UP, b.Secondary, Enum.Material.Metal)
	b:Part("Block", Vector3.new(1.8, 1.8, 1.8), at(0, 1.9, 0) * CFrame.Angles(math.rad(45), 0, math.rad(35.26)))
	b:Part("Block", Vector3.new(1.0, 1.0, 1.0), at(0, 1.9, 0) * CFrame.Angles(0, math.rad(45), 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Crown(b)
	b:Part("Cyl", Vector3.new(1.0, 2.8, 2.8), at(0, 0.6, 0) * UP)
	b:Part("Cyl", Vector3.new(1.02, 2.3, 2.3), at(0, 0.62, 0) * UP, Color3.fromRGB(120, 0, 30), Enum.Material.Fabric)
	for i = 0, 4 do
		local a = math.rad(i * 72)
		local x, z = math.cos(a) * 1.2, math.sin(a) * 1.2
		b:Part("Wedge", Vector3.new(0.3, 1.1, 0.6), at(x, 1.6, z) * CFrame.Angles(0, -a + math.rad(90), 0))
		b:Part("Ball", Vector3.new(0.45, 0.45, 0.45), at(x, 2.25, z), b.Secondary, Enum.Material.Neon)
		b:Part("Ball", Vector3.new(0.35, 0.35, 0.35), at(math.cos(a + 0.6) * 1.42, 0.6, math.sin(a + 0.6) * 1.42), b.Secondary, Enum.Material.Glass)
	end
end

function Shapes.Chalice(b)
	b:Part("Cyl", Vector3.new(0.3, 1.8, 1.8), at(0, 0.15, 0) * UP)
	b:Part("Cyl", Vector3.new(1.4, 0.4, 0.4), at(0, 1.0, 0) * UP)
	b:Part("Ball", Vector3.new(0.6, 0.6, 0.6), at(0, 1.0, 0), b.Secondary)
	b:Part("Cyl", Vector3.new(1.3, 2.0, 2.0), at(0, 2.3, 0) * UP)
	b:Part("Cyl", Vector3.new(0.1, 1.7, 1.7), at(0, 2.95, 0) * UP, b.Secondary, Enum.Material.Neon)
end

function Shapes.CoinStack(b)
	for i = 0, 4 do
		b:Part("Cyl", Vector3.new(0.3, 1.6, 1.6), at(math.sin(i * 1.7) * 0.15, 0.15 + i * 0.3, math.cos(i * 1.3) * 0.15) * UP)
	end
	b:Part("Cyl", Vector3.new(0.3, 1.6, 1.6), at(1.2, 0.8, 0) * CFrame.Angles(0, 0, math.rad(20)))
	b:Part("Cyl", Vector3.new(0.32, 0.9, 0.9), at(1.21, 0.8, 0) * CFrame.Angles(0, 0, math.rad(20)), b.Secondary, Enum.Material.Neon)
	b:Part("Cyl", Vector3.new(0.3, 1.6, 1.6), at(-0.9, 0.15, 0.9) * UP, b.Secondary)
end

function Shapes.Orb(b)
	b:Part("Cyl", Vector3.new(0.4, 1.4, 1.4), at(0, 0.2, 0) * UP, b.Secondary, Enum.Material.Metal)
	for i = 0, 2 do
		local a = math.rad(i * 120)
		b:Part("Block", Vector3.new(0.2, 0.9, 0.2), at(math.cos(a) * 0.55, 0.7, math.sin(a) * 0.55) * CFrame.Angles(math.cos(a) * 0.4, 0, -math.sin(a) * 0.4), b.Secondary, Enum.Material.Metal)
	end
	b:Part("Ball", Vector3.new(2.2, 2.2, 2.2), at(0, 2.0, 0))
	b:Part("Ball", Vector3.new(1.0, 1.0, 1.0), at(0, 2.0, 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Sword(b)
	b:Part("Block", Vector3.new(1.2, 0.5, 1.2), at(0, 0.25, 0), Color3.fromRGB(110, 110, 115), Enum.Material.Slate)
	b:Part("Block", Vector3.new(0.5, 3.2, 0.12), at(0, 1.9, 0))
	b:Part("Wedge", Vector3.new(0.12, 0.5, 0.25), at(0, 0.35, 0.125) * CFrame.Angles(math.rad(180), 0, 0))
	b:Part("Block", Vector3.new(1.6, 0.25, 0.3), at(0, 3.55, 0), b.Secondary, Enum.Material.Metal)
	b:Part("Cyl", Vector3.new(0.9, 0.25, 0.25), at(0, 4.1, 0) * UP, Color3.fromRGB(80, 50, 30), Enum.Material.Fabric)
	b:Part("Ball", Vector3.new(0.4, 0.4, 0.4), at(0, 4.65, 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Chest(b)
	b:Part("Block", Vector3.new(2.8, 1.4, 1.8), at(0, 0.7, 0))
	b:Part("Block", Vector3.new(2.85, 0.25, 1.85), at(0, 1.3, 0), b.Secondary, Enum.Material.Metal)
	b:Part("Block", Vector3.new(2.85, 0.6, 1.85), at(0, 1.85, -0.35) * CFrame.Angles(math.rad(-25), 0, 0))
	b:Part("Ball", Vector3.new(1.6, 1.6, 1.6), at(0, 1.4, 0.15), Color3.fromRGB(255, 210, 60), Enum.Material.Neon)
	for _, x in ipairs({ -1.0, 1.0 }) do
		b:Part("Block", Vector3.new(0.25, 1.45, 1.85), at(x, 0.7, 0), b.Secondary, Enum.Material.Metal)
	end
	b:Part("Block", Vector3.new(0.4, 0.5, 0.15), at(0, 1.0, 0.95), b.Secondary, Enum.Material.Metal)
end

function Shapes.Egg(b)
	b:Part("Cyl", Vector3.new(0.3, 1.6, 1.6), at(0, 0.15, 0) * UP, Color3.fromRGB(240, 230, 200), Enum.Material.Sand)
	b:Part("Block", Vector3.new(1.9, 2.6, 1.9), at(0, 1.55, 0), nil, nil, Vector3.new(1, 1, 1))
	for i = 0, 5 do
		local a = math.rad(i * 60 + 15)
		local y = 1.2 + (i % 2) * 0.7
		b:Part("Ball", Vector3.new(0.35, 0.35, 0.35), at(math.cos(a) * 0.88, y, math.sin(a) * 0.88), b.Secondary, Enum.Material.Neon)
	end
end

function Shapes.Star(b)
	b:Part("Cyl", Vector3.new(0.3, 1.4, 1.4), at(0, 0.15, 0) * UP, b.Secondary, Enum.Material.Metal)
	b:Part("Cyl", Vector3.new(0.9, 0.2, 0.2), at(0, 0.7, 0) * UP, b.Secondary, Enum.Material.Metal)
	b:Part("Cyl", Vector3.new(0.5, 1.0, 1.0), at(0, 2.2, 0) * CFrame.Angles(0, math.rad(90), 0))
	for i = 0, 4 do
		local a = math.rad(i * 72 + 90)
		b:Part("Wedge", Vector3.new(0.4, 1.1, 0.7), at(math.cos(a) * 0.85, 2.2 + math.sin(a) * 0.85, 0) * CFrame.Angles(0, 0, a - math.rad(90)) * CFrame.Angles(0, math.rad(90), 0))
	end
	b:Part("Ball", Vector3.new(0.6, 0.6, 0.6), at(0, 2.2, 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Skull(b)
	b:Part("Block", Vector3.new(2.0, 2.0, 2.2), at(0, 1.6, 0), nil, nil, Vector3.new(1, 0.95, 1))
	b:Part("Block", Vector3.new(1.3, 0.6, 1.0), at(0, 0.5, 0.35))
	for _, x in ipairs({ -0.45, 0.45 }) do
		b:Part("Ball", Vector3.new(0.55, 0.55, 0.55), at(x, 1.55, 0.85), b.Secondary, Enum.Material.Neon)
	end
	b:Part("Wedge", Vector3.new(0.3, 0.35, 0.3), at(0, 1.05, 1.0), Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic)
	for i = -2, 2 do
		b:Part("Block", Vector3.new(0.16, 0.25, 0.1), at(i * 0.22, 0.72, 0.86), Color3.fromRGB(250, 250, 240), Enum.Material.SmoothPlastic)
	end
end

function Shapes.Trophy(b)
	b:Part("Block", Vector3.new(1.6, 0.6, 1.6), at(0, 0.3, 0), Color3.fromRGB(60, 40, 30), Enum.Material.Wood)
	b:Part("Block", Vector3.new(1.62, 0.12, 1.62), at(0, 0.5, 0), b.Secondary, Enum.Material.Metal)
	b:Part("Cyl", Vector3.new(1.0, 0.35, 0.35), at(0, 1.1, 0) * UP)
	b:Part("Cyl", Vector3.new(1.5, 1.8, 1.8), at(0, 2.3, 0) * UP)
	b:Part("Cyl", Vector3.new(0.4, 1.2, 1.2), at(0, 1.55, 0) * UP)
	for _, x in ipairs({ -1.1, 1.1 }) do
		b:Part("Cyl", Vector3.new(0.18, 0.9, 0.9), at(x, 2.4, 0) * CFrame.Angles(0, math.rad(90), 0))
	end
	b:Part("Ball", Vector3.new(0.5, 0.5, 0.5), at(0, 2.3, 0.85), b.Secondary, Enum.Material.Neon)
end

local function torus(b, center: CFrame, radius: number, thick: number, segments: number, color, material)
	for i = 0, segments - 1 do
		local a = (i / segments) * math.pi * 2
		local len = 2 * math.pi * radius / segments + 0.05
		b:Part("Block", Vector3.new(len, thick, thick), center * CFrame.Angles(0, 0, a) * at(0, radius, 0), color, material)
	end
end

function Shapes.Ring(b)
	b:Part("Block", Vector3.new(1.4, 0.4, 1.0), at(0, 0.2, 0), Color3.fromRGB(40, 20, 60), Enum.Material.Fabric)
	torus(b, at(0, 1.55, 0), 1.05, 0.28, 14)
	b:Part("Block", Vector3.new(0.7, 0.7, 0.7), at(0, 2.85, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)), b.Secondary, Enum.Material.Glass)
	b:Part("Ball", Vector3.new(0.4, 0.4, 0.4), at(0, 2.85, 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Crystal(b)
	b:Part("Cyl", Vector3.new(0.4, 2.2, 2.2), at(0, 0.2, 0) * UP, Color3.fromRGB(90, 90, 100), Enum.Material.Slate)
	local spikes = {
		{ 0, 2.0, 0, 3.4, 0, 0 },
		{ 0.6, 1.4, 0.3, 2.2, 20, -25 },
		{ -0.6, 1.3, 0.2, 2.0, -15, 30 },
		{ 0.1, 1.2, -0.6, 1.8, 30, 10 },
		{ -0.2, 1.0, 0.6, 1.4, -25, -10 },
	}
	for i, s in ipairs(spikes) do
		local cf = at(s[1], s[2], s[3]) * CFrame.Angles(math.rad(s[5]), math.rad(i * 33), math.rad(s[6]))
		b:Part("Block", Vector3.new(0.7, s[4], 0.7), cf * CFrame.Angles(0, math.rad(45), 0))
		b:Part("Block", Vector3.new(0.3, s[4] * 0.85, 0.3), cf, b.Secondary, Enum.Material.Neon)
	end
end

function Shapes.Idol(b)
	b:Part("Block", Vector3.new(1.6, 0.4, 1.4), at(0, 0.2, 0), b.Secondary)
	b:Part("Block", Vector3.new(1.2, 1.8, 1.0), at(0, 1.3, 0))
	b:Part("Block", Vector3.new(1.4, 1.2, 1.2), at(0, 2.8, 0))
	b:Part("Block", Vector3.new(1.6, 0.25, 1.4), at(0, 3.5, 0), b.Secondary)
	for _, x in ipairs({ -0.35, 0.35 }) do
		b:Part("Block", Vector3.new(0.3, 0.2, 0.1), at(x, 2.95, 0.61), b.Secondary, Enum.Material.Neon)
	end
	b:Part("Block", Vector3.new(0.6, 0.2, 0.1), at(0, 2.5, 0.61), Color3.fromRGB(30, 30, 30), Enum.Material.SmoothPlastic)
	for _, x in ipairs({ -0.8, 0.8 }) do
		b:Part("Block", Vector3.new(0.35, 1.2, 0.5), at(x, 1.5, 0.1) * CFrame.Angles(0, 0, math.rad(x > 0 and -15 or 15)))
	end
end

function Shapes.Key(b)
	b:Part("Block", Vector3.new(1.4, 0.3, 1.0), at(0, 0.15, 0), Color3.fromRGB(70, 30, 30), Enum.Material.Fabric)
	b:Part("Block", Vector3.new(0.28, 2.4, 0.28), at(0, 1.6, 0))
	for i = 0, 1 do
		b:Part("Block", Vector3.new(0.5, 0.22, 0.28), at(0.35, 0.65 + i * 0.4, 0))
	end
	torus(b, at(0, 3.45, 0), 0.6, 0.25, 12)
	b:Part("Ball", Vector3.new(0.45, 0.45, 0.45), at(0, 3.45, 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Lamp(b)
	b:Part("Cyl", Vector3.new(0.3, 1.2, 1.2), at(0, 0.15, 0) * UP)
	b:Part("Block", Vector3.new(2.2, 1.2, 1.5), at(0, 0.9, 0), nil, nil, Vector3.new(1, 1, 1))
	b:Part("Cyl", Vector3.new(1.4, 0.25, 0.25), at(1.4, 1.2, 0) * CFrame.Angles(0, 0, math.rad(30)))
	b:Part("Cyl", Vector3.new(0.18, 0.9, 0.9), at(-1.25, 1.1, 0) * CFrame.Angles(0, math.rad(90), 0))
	b:Part("Cyl", Vector3.new(0.4, 0.8, 0.8), at(0, 1.55, 0) * UP, b.Secondary)
	b:Part("Ball", Vector3.new(0.35, 0.35, 0.35), at(0, 1.85, 0), b.Secondary, Enum.Material.Neon)
	b:Part("Ball", Vector3.new(0.5, 0.5, 0.5), at(2.0, 1.6, 0), b.Secondary, Enum.Material.Neon)
end

function Shapes.Mask(b)
	b:Part("Block", Vector3.new(0.3, 1.2, 0.3), at(0, 0.6, -0.2), Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
	b:Part("Block", Vector3.new(1.2, 0.2, 0.9), at(0, 0.1, -0.2), Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
	b:Part("Block", Vector3.new(2.0, 2.4, 0.8), at(0, 2.2, 0), nil, nil, Vector3.new(1, 1, 0.5))
	for _, x in ipairs({ -0.45, 0.45 }) do
		b:Part("Block", Vector3.new(0.5, 0.3, 0.2), at(x, 2.5, 0.2), b.Secondary, Enum.Material.Neon)
	end
	b:Part("Block", Vector3.new(0.6, 0.15, 0.2), at(0, 1.6, 0.2), b.Secondary)
	for i = -1, 1 do
		b:Part("Wedge", Vector3.new(0.25, 0.7, 0.3), at(i * 0.55, 3.55, 0), b.Secondary)
	end
end

function Shapes.Potion(b)
	b:Part("Block", Vector3.new(1.9, 1.9, 1.9), at(0, 1.0, 0), nil, Enum.Material.Glass, Vector3.new(1, 1, 1))
	b:Part("Block", Vector3.new(1.5, 1.3, 1.5), at(0, 0.85, 0), b.Secondary, Enum.Material.Neon, Vector3.new(1, 1, 1))
	b:Part("Cyl", Vector3.new(0.8, 0.6, 0.6), at(0, 2.2, 0) * UP, nil, Enum.Material.Glass)
	b:Part("Cyl", Vector3.new(0.4, 0.5, 0.5), at(0, 2.7, 0) * UP, Color3.fromRGB(140, 95, 60), Enum.Material.Wood)
	b:Part("Cyl", Vector3.new(0.1, 0.75, 0.75), at(0, 2.0, 0) * UP, b.Secondary, Enum.Material.Metal)
end

function Shapes.Cube(b)
	b:Part("Block", Vector3.new(1.2, 0.3, 1.2), at(0, 0.15, 0), Color3.fromRGB(40, 40, 50), Enum.Material.Metal)
	local core = at(0, 1.8, 0) * CFrame.Angles(math.rad(35), math.rad(45), 0)
	b:Part("Block", Vector3.new(1.8, 1.8, 1.8), core)
	b:Part("Block", Vector3.new(1.0, 1.0, 1.0), core, b.Secondary, Enum.Material.Neon)
	for _, d in ipairs({ Vector3.new(1, 1, 1), Vector3.new(-1, 1, -1), Vector3.new(1, -1, -1), Vector3.new(-1, -1, 1) }) do
		b:Part("Ball", Vector3.new(0.35, 0.35, 0.35), core * at(d.X * 0.9, d.Y * 0.9, d.Z * 0.9), b.Secondary, Enum.Material.Neon)
	end
end

function Shapes.Pyramid(b)
	local y = 0
	for i = 0, 3 do
		local w = 2.8 - i * 0.65
		b:Part("Block", Vector3.new(w, 0.55, w), at(0, y + 0.275, 0), i % 2 == 0 and b.Primary or b.Secondary)
		y += 0.55
	end
	b:Part("Block", Vector3.new(0.6, 0.6, 0.6), at(0, y + 0.4, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)), b.Secondary, Enum.Material.Neon)
end

function Shapes.Shield(b)
	b:Part("Block", Vector3.new(1.4, 0.3, 0.9), at(0, 0.15, 0), Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
	b:Part("Cyl", Vector3.new(0.3, 2.8, 2.8), at(0, 1.8, 0) * CFrame.Angles(0, math.rad(90), 0))
	b:Part("Cyl", Vector3.new(0.32, 2.4, 2.4), at(0, 1.8, 0.01) * CFrame.Angles(0, math.rad(90), 0), b.Secondary)
	b:Part("Block", Vector3.new(0.35, 2.4, 0.35), at(0, 1.8, 0.05))
	b:Part("Block", Vector3.new(2.4, 0.35, 0.35), at(0, 1.8, 0.05))
	b:Part("Ball", Vector3.new(0.7, 0.7, 0.7), at(0, 1.8, 0.2), b.Secondary, Enum.Material.Neon)
end

function Shapes.Hourglass(b)
	b:Part("Cyl", Vector3.new(0.3, 1.8, 1.8), at(0, 0.15, 0) * UP)
	b:Part("Cyl", Vector3.new(0.3, 1.8, 1.8), at(0, 3.25, 0) * UP)
	for i = 0, 3 do
		local a = math.rad(i * 90 + 45)
		b:Part("Cyl", Vector3.new(3.0, 0.15, 0.15), at(math.cos(a) * 0.75, 1.7, math.sin(a) * 0.75) * UP, b.Secondary, Enum.Material.Metal)
	end
	b:Part("Ball", Vector3.new(1.2, 1.2, 1.2), at(0, 2.45, 0), Color3.fromRGB(220, 240, 255), Enum.Material.Glass)
	b:Part("Ball", Vector3.new(1.2, 1.2, 1.2), at(0, 0.95, 0), Color3.fromRGB(220, 240, 255), Enum.Material.Glass)
	b:Part("Ball", Vector3.new(0.8, 0.8, 0.8), at(0, 0.85, 0), b.Secondary, Enum.Material.Neon)
	b:Part("Cyl", Vector3.new(0.6, 0.12, 0.12), at(0, 1.7, 0) * UP, b.Secondary, Enum.Material.Neon)
end

function Shapes.Heart(b)
	b:Part("Cyl", Vector3.new(0.3, 1.4, 1.4), at(0, 0.15, 0) * UP, b.Secondary, Enum.Material.Metal)
	b:Part("Ball", Vector3.new(1.4, 1.4, 1.4), at(-0.5, 2.5, 0))
	b:Part("Ball", Vector3.new(1.4, 1.4, 1.4), at(0.5, 2.5, 0))
	b:Part("Block", Vector3.new(1.4, 1.4, 1.0), at(0, 1.75, 0) * CFrame.Angles(0, 0, math.rad(45)))
	b:Part("Ball", Vector3.new(0.6, 0.6, 0.6), at(0, 2.2, 0.4), b.Secondary, Enum.Material.Neon)
end

function Shapes.Book(b)
	b:Part("Block", Vector3.new(1.6, 0.3, 1.2), at(0, 0.15, 0), Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
	local cf = at(0, 1.5, 0) * CFrame.Angles(math.rad(-15), 0, 0)
	b:Part("Block", Vector3.new(2.0, 2.6, 0.5), cf)
	b:Part("Block", Vector3.new(1.8, 2.45, 0.52), cf * at(0.08, 0, 0), Color3.fromRGB(250, 245, 225), Enum.Material.SmoothPlastic)
	b:Part("Block", Vector3.new(2.05, 2.65, 0.08), cf * at(0, 0, 0.27))
	b:Part("Block", Vector3.new(0.7, 0.7, 0.1), cf * at(0, 0.2, 0.32) * CFrame.Angles(0, 0, math.rad(45)), b.Secondary, Enum.Material.Neon)
end

function Shapes.Feather(b)
	b:Part("Cyl", Vector3.new(0.3, 1.2, 1.2), at(0, 0.15, 0) * UP, Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
	local cf = at(0, 2.0, 0) * CFrame.Angles(0, 0, math.rad(12))
	b:Part("Cyl", Vector3.new(3.8, 0.12, 0.12), cf * UP, b.Secondary, Enum.Material.SmoothPlastic)
	b:Part("Block", Vector3.new(1.2, 3.4, 0.2), cf * at(0, 0.2, 0), nil, nil, Vector3.new(1, 1, 0.3))
	b:Part("Block", Vector3.new(0.6, 2.4, 0.22), cf * at(0, 0.3, 0), b.Secondary, Enum.Material.Neon, Vector3.new(1, 1, 0.3))
end

TreasureModels.Shapes = Shapes

-- Faces ---------------------------------------------------------------------
-- Where each shape's "face" sits (y, z-front, scale). Shapes that already have
-- eyes (Skull, Idol, Mask) get none. +Z is the front of every model.
local FACE = {
	Gem = { 1.9, 1.05, 0.8 },
	Crown = { 0.75, 1.45, 0.7 },
	Chalice = { 2.3, 1.02, 0.75 },
	CoinStack = { 1.0, 0.82, 0.55 },
	Orb = { 2.1, 1.1, 0.85 },
	Sword = { 3.55, 0.17, 0.4 },
	Chest = { 0.55, 0.92, 0.85 },
	Egg = { 1.6, 0.96, 0.85 },
	Star = { 2.25, 0.3, 0.6 },
	Trophy = { 2.6, 0.92, 0.7 },
	Ring = { 2.85, 0.4, 0.42 },
	Crystal = { 2.0, 0.42, 0.5 },
	Key = { 3.45, 0.25, 0.42 },
	Lamp = { 0.9, 0.76, 0.65 },
	Potion = { 1.05, 0.96, 0.8 },
	Cube = { 1.8, 1.1, 0.7 },
	Pyramid = { 0.85, 1.1, 0.6 },
	Shield = { 1.95, 0.25, 0.55 },
	Hourglass = { 2.45, 0.62, 0.5 },
	Heart = { 2.35, 0.75, 0.8 },
	Book = { 1.6, 0.42, 0.6 },
	Feather = { 2.6, 0.14, 0.4 },
}
TreasureModels.Face = FACE

local EYE_COLOR = Color3.fromRGB(25, 20, 35)
local function addFace(b)
	local f = FACE[b.Def.Shape]
	if not f then
		return
	end
	local y, z, k = f[1], f[2], f[3]
	local face = Instance.new("Folder")
	face.Name = "Face"
	face.Parent = b.Model
	local function facePart(name, shape, size, offset, color, mat, rot)
		local p = b:Part(shape, size, at(offset.X, offset.Y, offset.Z) * (rot or CFrame.identity), color, mat or Enum.Material.SmoothPlastic)
		p.Name = name
		p:SetAttribute("BaseSize", p.Size)
		p.Parent = face
		return p
	end
	for _, side in ipairs({ -1, 1 }) do
		local name = side < 0 and "EyeL" or "EyeR"
		facePart(name, "Ball", Vector3.new(0.3, 0.3, 0.3) * k, Vector3.new(side * 0.3 * k, y + 0.12 * k, z), EYE_COLOR)
		facePart(name .. "Shine", "Ball", Vector3.new(0.1, 0.1, 0.1) * k, Vector3.new(side * 0.3 * k + 0.06 * k, y + 0.19 * k, z + 0.12 * k), Color3.new(1, 1, 1), Enum.Material.Neon)
		facePart("Cheek" .. name, "Ball", Vector3.new(0.16, 0.16, 0.16) * k, Vector3.new(side * 0.5 * k, y - 0.08 * k, z - 0.02), Color3.fromRGB(255, 130, 160), Enum.Material.SmoothPlastic)
	end
	-- smile made of three tilted segments
	facePart("Mouth1", "Block", Vector3.new(0.14, 0.06, 0.06) * k, Vector3.new(-0.12 * k, y - 0.12 * k, z), EYE_COLOR, nil, CFrame.Angles(0, 0, math.rad(-30)))
	facePart("Mouth2", "Block", Vector3.new(0.14, 0.06, 0.06) * k, Vector3.new(0, y - 0.16 * k, z), EYE_COLOR)
	facePart("Mouth3", "Block", Vector3.new(0.14, 0.06, 0.06) * k, Vector3.new(0.12 * k, y - 0.12 * k, z), EYE_COLOR, nil, CFrame.Angles(0, 0, math.rad(30)))
	local o = facePart("MouthO", "Ball", Vector3.new(0.16, 0.16, 0.16) * k, Vector3.new(0, y - 0.15 * k, z), EYE_COLOR)
	o.Transparency = 1
end

-- Effects -------------------------------------------------------------------
local FX = {
	Fire = { Tex = TEX_FIRE, C1 = Color3.fromRGB(255, 170, 40), C2 = Color3.fromRGB(255, 50, 0), Speed = 3, Rise = 4, Size = 0.9, Life = 0.9 },
	Frost = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(200, 245, 255), C2 = Color3.fromRGB(120, 200, 255), Speed = 1, Rise = -1, Size = 0.4, Life = 2 },
	Spark = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(255, 240, 120), C2 = Color3.fromRGB(255, 200, 60), Speed = 3, Rise = 1, Size = 0.35, Life = 1 },
	Void = { Tex = TEX_SMOKE, C1 = Color3.fromRGB(120, 30, 200), C2 = Color3.fromRGB(10, 0, 20), Speed = 0.6, Rise = 1, Size = 1.2, Life = 2.2 },
	Bubbles = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(150, 255, 250), C2 = Color3.fromRGB(80, 180, 255), Speed = 0.8, Rise = 3, Size = 0.5, Life = 2 },
	Leaves = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(140, 255, 120), C2 = Color3.fromRGB(40, 160, 60), Speed = 1.2, Rise = -0.5, Size = 0.45, Life = 2.4 },
	Stars = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(255, 255, 255), C2 = Color3.fromRGB(255, 230, 140), Speed = 2, Rise = 1.5, Size = 0.5, Life = 1.6 },
	Hearts = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(255, 140, 200), C2 = Color3.fromRGB(255, 60, 130), Speed = 1.5, Rise = 2.5, Size = 0.55, Life = 1.6 },
	Lightning = { Tex = TEX_SPARKLE, C1 = Color3.fromRGB(255, 255, 140), C2 = Color3.fromRGB(80, 160, 255), Speed = 8, Rise = 0, Size = 0.3, Life = 0.4 },
	Rainbow = { Tex = TEX_SPARKLE, Rainbow = true, Speed = 2.5, Rise = 2, Size = 0.6, Life = 1.8 },
}
TreasureModels.FX = FX

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 60)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(120, 255, 100)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(80, 200, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(160, 100, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 100, 220)),
})

local function addEmitter(parent: Instance, fx, rate: number, scale: number, name: string)
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.Texture = fx.Tex
	e.Color = fx.Rainbow and RAINBOW or ColorSequence.new(fx.C1, fx.C2)
	e.LightEmission = 0.8
	e.LightInfluence = 0
	e.Rate = rate
	e.Lifetime = NumberRange.new(fx.Life * 0.7, fx.Life)
	e.Speed = NumberRange.new(fx.Speed * 0.5, fx.Speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, fx.Rise, 0)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, fx.Size * scale),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Parent = parent
	return e
end

function TreasureModels.AddEffects(model: Model, def, root: BasePart, scale: number)
	local info = Rarities.Info[def.Rarity]
	local height = 2.2 * scale
	local att = Instance.new("Attachment")
	att.Name = "FxAttachment"
	att.Position = Vector3.new(0, height, 0)
	att.Parent = root

	local fx = FX[def.Fx]
	local rarityRate = info.Particles
	if fx then
		addEmitter(att, fx, math.max(3, rarityRate), scale, "FxEmitter")
	end
	if info.Sparkles and rarityRate > 0 then
		addEmitter(att, {
			Tex = TEX_SPARKLE,
			C1 = info.Glow,
			C2 = info.Color,
			Speed = 1.5,
			Rise = 1,
			Size = 0.35,
			Life = 1.2,
			Rainbow = info.Rainbow,
		}, rarityRate, scale, "RarityEmitter")
	end
	if info.Smoke then
		addEmitter(att, FX.Void, 4, scale * 1.4, "SmokeEmitter")
	end
	if info.Light > 0 then
		local light = Instance.new("PointLight")
		light.Name = "Glow"
		light.Color = def.Secondary
		light.Range = info.Light
		light.Brightness = 1.6
		light.Shadows = false
		light.Parent = att
	end
	if info.Beam then
		local a0 = Instance.new("Attachment")
		a0.Name = "BeamBottom"
		a0.Position = Vector3.new(0, 0.2, 0)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Name = "BeamTop"
		a1.Position = Vector3.new(0, 14 * scale, 0)
		a1.Parent = root
		local beam = Instance.new("Beam")
		beam.Name = "RarityBeam"
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = 2.6 * scale
		beam.Width1 = 0.2 * scale
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Color = info.Rainbow and RAINBOW or ColorSequence.new(info.Glow)
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		})
		beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		beam.TextureSpeed = 0.6
		beam.TextureLength = 3
		beam.Parent = root
	end
	if info.Orbit then
		local moons = Instance.new("Model")
		moons.Name = "Orbit"
		for i = 1, 3 do
			local p = Instance.new("Part")
			p.Name = "Moon"
			p.Shape = Enum.PartType.Ball
			p.Size = Vector3.new(0.5, 0.5, 0.5) * scale
			p.Material = Enum.Material.Neon
			p.Color = Color3.fromHSV(0.5 + i * 0.12, 0.5, 1)
			p.Anchored = false
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = false
			p.Massless = true
			p.CastShadow = false
			local a = i / 3 * math.pi * 2
			p.CFrame = root.CFrame * CFrame.new(math.cos(a) * 2.6 * scale, height, math.sin(a) * 2.6 * scale)
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = p
			w.Parent = p
			p.Parent = moons
		end
		moons.Parent = model
	end
	if info.Halo then
		local halo = Instance.new("Model")
		halo.Name = "Halo"
		local segs = 10
		local r = 1.9 * scale
		for i = 0, segs - 1 do
			local a = (i / segs) * math.pi * 2
			local p = Instance.new("Part")
			p.Name = "HaloSeg"
			p.Size = Vector3.new(0.35, 0.15, 0.35) * scale
			p.Shape = Enum.PartType.Ball
			p.Material = Enum.Material.Neon
			p.Color = info.Glow
			p.Anchored = false
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = false
			p.Massless = true
			p.CastShadow = false
			p.CFrame = root.CFrame * CFrame.new(math.cos(a) * r, height + 0.4 * scale, math.sin(a) * r)
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = p
			w.Parent = p
			p.Parent = halo
		end
		halo.Parent = model
	end
	model:SetAttribute("Rainbow", info.Rainbow)
	model:SetAttribute("Lightning", def.Fx == "Lightning")
end

-- Public API --------------------------------------------------------------
-- opts: { Scale = number?, Effects = boolean?, CFrame = CFrame?, Anchored = boolean? }
function TreasureModels.Build(def, opts)
	opts = opts or {}
	local scale = opts.Scale or 1
	local model = Instance.new("Model")
	model.Name = def.Name

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Massless = true
	root.CastShadow = false
	root.Anchored = true
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root

	local builder = newBuilder(model, root, scale, def)
	local fn = Shapes[def.Shape] or Shapes.Gem
	fn(builder)
	-- Mutation: recolour the body and add a matching aura
	local mut = opts.Mutation and Mutations.Info[opts.Mutation]
	if mut then
		local i = 0
		for _, p in ipairs(model:GetChildren()) do
			if p:IsA("BasePart") and p ~= root then
				i += 1
				if mut.Rainbow then
					p.Color = Color3.fromHSV((i * 0.13) % 1, 0.7, 1)
				elseif p.Material ~= Enum.Material.Neon then
					p.Color = p.Color:Lerp(mut.Color, 0.75)
					p.Material = mat(mut.Material)
					if p.Material == Enum.Material.Glass then
						p.Transparency = 0.2
					end
				end
			end
		end
		local att = Instance.new("Attachment")
		att.Name = "MutationFx"
		att.Position = Vector3.new(0, 1.6 * scale, 0)
		att.Parent = root
		local e = Instance.new("ParticleEmitter")
		e.Texture = TEX_SPARKLE
		e.Color = ColorSequence.new(mut.Color, Color3.new(1, 1, 1))
		e.LightEmission = 1
		e.Rate = 12
		e.Lifetime = NumberRange.new(0.8, 1.4)
		e.Speed = NumberRange.new(1, 2.5)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new(0.45 * scale, 0)
		e.Parent = att
		model:SetAttribute("Mutation", opts.Mutation)
	end
	if opts.Face ~= false then
		addFace(builder)
	end

	if opts.Effects ~= false then
		TreasureModels.AddEffects(model, def, root, scale)
	end

	model:SetAttribute("TreasureId", def.Id)
	model:SetAttribute("Rarity", def.Rarity)
	model:SetAttribute("Personality", def.Personality)

	local cf = opts.CFrame or CFrame.new()
	model:PivotTo(cf)
	model:SetAttribute("Home", cf)
	root.Anchored = opts.Anchored ~= false
	return model
end

-- Approximate height so labels can sit above the model.
function TreasureModels.Height(def, scale: number?): number
	local s = scale or 1
	local tall = { Sword = 4.9, Idol = 3.7, Key = 4.1, Feather = 4.0, Mask = 3.9, Crystal = 3.8, Hourglass = 3.4 }
	return (tall[def.Shape] or 3.1) * s
end

return TreasureModels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">UpgradeData</string><ProtectedString name="Source"><![CDATA[-- UpgradeData.lua
-- Shop catalogue: levelled upgrades and one-time special abilities.

local Config = require(script.Parent.Config)

local UpgradeData = {}

-- Levelled upgrades. Cost(level) is the price to go FROM `level` to `level+1`.
UpgradeData.Upgrades = {
	Speed = {
		Order = 1,
		Name = "Swift Boots",
		Icon = "👟",
		Description = "+2 walk speed per level.",
		MaxLevel = 12,
		Cost = function(level)
			return math.floor(200 * 2.1 ^ level)
		end,
	},
	Carry = {
		Order = 2,
		Name = "Treasure Backpack",
		Icon = "🎒",
		Description = "+1 treasure you can carry at once.",
		MaxLevel = 5,
		Cost = function(level)
			return math.floor(1500 * 6 ^ level)
		end,
	},
	Base = {
		Order = 3,
		Name = "Base Expansion",
		Icon = "🏰",
		Description = ("+%d display platforms and +5%% base income."):format(Config.PlotsPerBaseLevel),
		MaxLevel = Config.MaxBaseLevel - 1,
		Cost = function(level)
			return math.floor(500 * 3.2 ^ level)
		end,
	},
	Protection = {
		Order = 4,
		Name = "Fortress Security",
		Icon = "🛡️",
		Description = "Longer base lock, shorter lock cooldown, slower steals and longer post-robbery lockdown.",
		MaxLevel = 10,
		Cost = function(level)
			return math.floor(800 * 2.6 ^ level)
		end,
	},
	Luck = {
		Order = 6,
		Name = "Four-Leaf Charm",
		Icon = "🍀",
		Description = "+10% luck: better egg hatches and a chance to upgrade treasures you pick up.",
		MaxLevel = 10,
		Cost = function(level)
			return math.floor(2500 * 2.8 ^ level)
		end,
	},
	Security = {
		Order = 7,
		Name = "Security Cameras & Traps",
		Icon = "📷",
		Description = "Cameras warn you about intruders. +7% chance per level to zap thieves escaping with your loot.",
		MaxLevel = 8,
		Cost = function(level)
			return math.floor(3000 * 3 ^ level)
		end,
	},
	Walls = {
		Order = 8,
		Name = "Reinforced Walls",
		Icon = "🧱",
		Description = "Upgrade your wall material (Wood → Diamond). Each tier makes stealing take longer.",
		MaxLevel = 7,
		Cost = function(level)
			return math.floor(1200 * 3.4 ^ level)
		end,
	},
	Floors = {
		Order = 9,
		Name = "Second Floor",
		Icon = "🏢",
		Description = "Build a second floor with stairs and 12 more display stands.",
		MaxLevel = 1,
		Cost = function()
			return 750000
		end,
	},
	Income = {
		Order = 5,
		Name = "Golden Vault",
		Icon = "💰",
		Description = "+10% money from all treasures.",
		MaxLevel = 15,
		Cost = function(level)
			return math.floor(1000 * 2.4 ^ level)
		end,
	},
}

-- One-time abilities.
UpgradeData.Abilities = {
	Dash = {
		Order = 1,
		Name = "Dash",
		Icon = "💨",
		Key = "Q",
		Description = "Burst forward at high speed.",
		Cost = 2500,
		Cooldown = 6,
	},
	SuperJump = {
		Order = 2,
		Name = "Super Jump",
		Icon = "🦘",
		Key = "R",
		Description = "Huge jumps for 8 seconds. Reach secret areas!",
		Cost = 6000,
		Cooldown = 20,
		Duration = 8,
	},
	Cloak = {
		Order = 3,
		Name = "Shadow Cloak",
		Icon = "👻",
		Key = "F",
		Description = "Turn nearly invisible and hide your name for 8 seconds.",
		Cost = 40000,
		Cooldown = 60,
		Duration = 8,
	},
	Magnet = {
		Order = 4,
		Name = "Treasure Magnet",
		Icon = "🧲",
		Key = nil,
		Description = "Passive: automatically grab free world treasures near you.",
		Cost = 120000,
		Cooldown = 0,
		Radius = 18,
	},
}

-- Gear: tools bought with money (kept through rebirth).
UpgradeData.Gear = {
	Bat = {
		Order = 1,
		Name = "Bonk Bat",
		Icon = "🏏",
		Levels = { "Wooden Bonk Hammer", "Iron Bat", "Diamond Bat", "Galaxy Bat" },
		Costs = { 25000, 400000, 6000000 },
		Description = "Bigger bonks: longer reach, longer stun, bigger knockback.",
	},
	SpeedCoil = { Order = 2, Name = "Speed Coil", Icon = "🌀", Cost = 15000, Description = "Hold it to run +6 faster." },
	Grapple = { Order = 3, Name = "Grapple Hook", Icon = "🪝", Cost = 90000, Description = "Click to zip to a spot up to 90 studs away (4s cooldown)." },
	Trap = { Order = 4, Name = "Bear Trap", Icon = "🪤", Cost = 60000, Description = "Place up to 3 traps in your base. Thieves get stuck and drop their loot." },
}

function UpgradeData.BatStats(level: number)
	level = level or 0
	return {
		Name = UpgradeData.Gear.Bat.Levels[level + 1],
		Range = 9 + level * 2,
		Stun = 1.2 + level * 0.4,
		Knock = 60 + level * 20,
		Color = ({ Color3.fromRGB(255, 80, 90), Color3.fromRGB(170, 175, 185), Color3.fromRGB(120, 230, 255), Color3.fromRGB(150, 80, 255) })[level + 1],
	}
end

-- Gem shop: boosts and permanent perks bought with gems.
UpgradeData.GemShop = {
	MoneyBoost = { Order = 1, Name = "2x Money (15 min)", Icon = "💸", Cost = 100, Boost = "Money", Duration = 900, Description = "Double all income for 15 minutes." },
	LuckBoost = { Order = 2, Name = "2x Luck (15 min)", Icon = "🍀", Cost = 80, Boost = "Luck", Duration = 900, Description = "+100% luck for 15 minutes." },
	SpeedBoost = { Order = 3, Name = "Speed Potion (10 min)", Icon = "⚡", Cost = 50, Boost = "Speed", Duration = 600, Description = "+8 walk speed for 10 minutes." },
	AutoCollect = { Order = 4, Name = "Auto Collector", Icon = "🤖", Cost = 400, Permanent = true, Description = "Income goes straight to your wallet. No more collecting!" },
	PetSlot = { Order = 5, Name = "+1 Pet Slot", Icon = "🐾", Cost = 250, Description = "Equip one more pet (max 6)." },
}

-- Base colour palette for personalisation
UpgradeData.BaseColors = {
	Color3.fromRGB(255, 95, 95), Color3.fromRGB(255, 170, 60), Color3.fromRGB(250, 220, 70),
	Color3.fromRGB(100, 220, 110), Color3.fromRGB(70, 200, 255), Color3.fromRGB(120, 120, 255),
	Color3.fromRGB(200, 110, 255), Color3.fromRGB(255, 110, 200), Color3.fromRGB(60, 60, 75),
	Color3.fromRGB(245, 245, 250), Color3.fromRGB(40, 200, 170), Color3.fromRGB(150, 90, 50),
}

-- Wall tiers (index = Walls upgrade level + 1)
UpgradeData.WallTiers = {
	{ Name = "Wood", Material = "WoodPlanks" },
	{ Name = "Brick", Material = "Brick" },
	{ Name = "Stone", Material = "Cobblestone" },
	{ Name = "Slate", Material = "Slate" },
	{ Name = "Steel", Material = "DiamondPlate" },
	{ Name = "Marble", Material = "Marble" },
	{ Name = "Gold", Material = "Foil" },
	{ Name = "Diamond", Material = "Glass" },
}

function UpgradeData.SortedKeys(tbl)
	local keys = {}
	for k in pairs(tbl) do
		table.insert(keys, k)
	end
	table.sort(keys, function(a, b)
		return tbl[a].Order < tbl[b].Order
	end)
	return keys
end

-- Derived stats ------------------------------------------------------------
local function boostActive(data, name)
	return data.Boosts and (data.Boosts[name] or 0) > os.time()
end
UpgradeData.BoostActive = boostActive

function UpgradeData.WalkSpeed(data, petSpeed: number?)
	local rebirthBonus = math.min(Config.Rebirth.MaxSpeedBonus, (data.Rebirths or 0) * Config.Rebirth.SpeedBonusPerRebirth)
	local boost = boostActive(data, "Speed") and 8 or 0
	return Config.BaseWalkSpeed + (data.Upgrades.Speed or 0) * 2 + rebirthBonus + boost + (petSpeed or 0)
end

-- Luck multiplier (1 = normal). eventBonus/petBonus are additive (+0.5 = +50%).
function UpgradeData.Luck(data, petBonus: number?, eventBonus: number?)
	local l = 1 + (data.Upgrades.Luck or 0) * Config.Luck.PerUpgrade
	if boostActive(data, "Luck") then
		l += 1
	end
	return l + (petBonus or 0) + (eventBonus or 0)
end

function UpgradeData.WallTier(data)
	return UpgradeData.WallTiers[math.clamp((data.Upgrades.Walls or 0) + 1, 1, #UpgradeData.WallTiers)]
end

function UpgradeData.PetSlots(data)
	return math.min(Config.Pets.MaxSlots, Config.Pets.StartSlots + (data.ExtraPetSlots or 0))
end

function UpgradeData.CarryCapacity(data)
	return 1 + (data.Upgrades.Carry or 0)
end

function UpgradeData.BaseLevel(data)
	return 1 + (data.Upgrades.Base or 0)
end

function UpgradeData.PlotCount(data)
	local total = Config.PlotColumns * Config.PlotRows
	local ground = math.min(total, Config.StartingPlots + (UpgradeData.BaseLevel(data) - 1) * Config.PlotsPerBaseLevel)
	return ground + ((data.Upgrades.Floors or 0) > 0 and Config.SecondFloorPlots or 0)
end

function UpgradeData.LockDuration(data)
	return Config.Lock.BaseDuration + (data.Upgrades.Protection or 0) * Config.Lock.DurationPerLevel
end

function UpgradeData.LockCooldown(data)
	return math.max(15, Config.Lock.BaseCooldown - (data.Upgrades.Protection or 0) * Config.Lock.CooldownReductionPerLevel)
end

function UpgradeData.StealHold(data)
	return Config.Steal.BaseHoldDuration + (data.Upgrades.Protection or 0) * Config.Steal.HoldPerProtectionLevel + (data.Upgrades.Walls or 0) * Config.Security.WallHoldBonus
end

function UpgradeData.VictimLock(data)
	return Config.Steal.VictimAutoLock + (data.Upgrades.Protection or 0) * Config.Steal.VictimAutoLockPerLevel
end

-- auraBonus: summed Aura of placed treasures. petBonus: summed pet income bonus.
function UpgradeData.IncomeMultiplier(data, auraBonus: number?, petBonus: number?)
	local m = 1 + (auraBonus or 0) + (petBonus or 0)
	m += (data.Rebirths or 0) * Config.Rebirth.IncomeBonusPerRebirth
	m += (data.Upgrades.Income or 0) * 0.10
	m += (UpgradeData.BaseLevel(data) - 1) * 0.05
	if boostActive(data, "Money") then
		m *= 2
	end
	return m
end

return UpgradeData
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Util.lua
-- Small helpers shared by client and server.

local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Util.Abbreviate(n: number): string
	n = tonumber(n) or 0
	local neg = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = (n == math.floor(n)) and tostring(math.floor(n)) or string.format("%.1f", n)
		return (neg and "-" or "") .. s
	end
	local i = 1
	while n >= 1000 and i < #SUFFIXES do
		n /= 1000
		i += 1
	end
	local fmt = n >= 100 and "%.0f" or (n >= 10 and "%.1f" or "%.2f")
	local s = string.format(fmt, n)
	if s:find("%.") then
		s = s:gsub("0+$", "") -- only strip zeros after a decimal point
		s = s:gsub("%.$", "")
	end
	return (neg and "-" or "") .. s .. SUFFIXES[i]
end

function Util.Money(n: number): string
	return "$" .. Util.Abbreviate(n)
end

function Util.Commas(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""))
end

function Util.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local m = math.floor(seconds / 60)
	local s = seconds % 60
	if m >= 60 then
		return string.format("%dh %02dm", math.floor(m / 60), m % 60)
	end
	return string.format("%d:%02d", m, s)
end

function Util.DeepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in pairs(t) do
		c[k] = Util.DeepCopy(v)
	end
	return c
end

-- Fills missing keys in `data` from `template` (recursive).
function Util.Reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = Util.DeepCopy(v)
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
			Util.Reconcile(data[k], v)
		end
	end
	return data
end

local counter = 0
function Util.NewUid(): string
	counter += 1
	return string.format("%x%x%x", os.time(), math.random(0, 0xFFFFFF), counter)
end

return Util
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00000026"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000025"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX0000000F"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Main.server.lua
-- Boots every server service in dependency order: Init() wires references,
-- Start() begins loops and connections.

local servicesFolder = script.Parent:WaitForChild("Services")

local ORDER = {
	"NetService",
	"DataService",
	"MapBuilder",
	"StateService",
	"EconomyService",
	"BaseService",
	"CarryService",
	"TreasureService",
	"StealService",
	"PlayerService",
	"GearService",
	"PetService",
	"AchievementService",
	"WorldService",
	"ShopService",
	"RebirthService",
	"TradeService",
	"LeaderboardService",
	"EventService",
}

local Services = {}
for _, name in ipairs(ORDER) do
	Services[name] = require(servicesFolder:WaitForChild(name))
end

for _, name in ipairs(ORDER) do
	local svc = Services[name]
	if svc.Init then
		svc.Init(Services)
	end
end

for _, name in ipairs(ORDER) do
	local svc = Services[name]
	if svc.Start then
		local ok, err = pcall(svc.Start)
		if not ok then
			warn(("[Boot] %s failed to start: %s"):format(name, tostring(err)))
		end
	end
end

print(("[STEAL A TREASURE] Server ready — %d services online"):format(#ORDER))
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX00000024"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">AchievementService</string><ProtectedString name="Source"><![CDATA[-- AchievementService.lua
-- Checks achievement progress on the server and awards gems.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local AchievementData = require(Shared.AchievementData)
local TreasureData = require(Shared.TreasureData)
local Remotes = require(Shared.Remotes)

local S

local AchievementService = {}

function AchievementService.Progress(data): { [string]: number }
	local discovered, celestial = 0, 0
	for id in pairs(data.Index) do
		local def = TreasureData.Get(id)
		if def and not def.Exclusive then
			discovered += 1
		end
	end
	for _, t in pairs(data.Treasures) do
		local def = TreasureData.Get(t.Id)
		if def and def.Rarity == "Celestial" then
			celestial += 1
		end
	end
	local secrets = 0
	for _ in pairs(data.Secrets) do
		secrets += 1
	end
	local st = data.Stats
	return {
		Collected = st.Collected or 0,
		Steals = st.Steals or 0,
		Defends = st.Defends or 0,
		Trades = st.Trades or 0,
		Hatched = st.Hatched or 0,
		ChestsOpened = st.ChestsOpened or 0,
		Earned = data.TotalEarned or 0,
		Rebirths = data.Rebirths or 0,
		Level = data.Level or 1,
		Discovered = discovered,
		Secrets = secrets,
		Celestial = celestial,
	}
end

function AchievementService.Check(player: Player)
	local data = S.DataService.Get(player)
	if not data then
		return
	end
	local progress = AchievementService.Progress(data)
	local unlocked = false
	for _, a in ipairs(AchievementData.List) do
		if not data.Achievements[a.Id] and (progress[a.Stat] or 0) >= a.Goal then
			data.Achievements[a.Id] = true
			unlocked = true
			S.EconomyService.AddGems(player, a.Gems)
			S.NetService.Notify(player, ("🏆 ACHIEVEMENT: %s %s! +%d 💎"):format(a.Icon, a.Name, a.Gems), "level")
			Remotes.Effect:FireClient(player, "Achievement", a.Id)
		end
	end
	if unlocked then
		S.StateService.MarkFull(player)
	end
end

function AchievementService.Init(services)
	S = services
end

function AchievementService.Start()
	task.spawn(function()
		while true do
			task.wait(3)
			for _, player in ipairs(Players:GetPlayers()) do
				AchievementService.Check(player)
			end
		end
	end)
end

return AchievementService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">BaseService</string><ProtectedString name="Source"><![CDATA[-- BaseService.lua
-- Personal bases: building the 8 base shells, assigning them to players,
-- rendering placed treasures on display platforms, the door barrier lock,
-- alarm lights and the owner sign.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local TreasureModels = require(Shared.TreasureModels)
local UpgradeData = require(Shared.UpgradeData)
local Rarities = require(Shared.Rarities)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local Mutations = require(Shared.Mutations)
local CollectionService = game:GetService("CollectionService")

local S -- services table

local BaseService = {}
BaseService.Bases = {} :: { any }

local BASE_COLORS = {
	Color3.fromRGB(255, 95, 95),
	Color3.fromRGB(255, 170, 60),
	Color3.fromRGB(250, 220, 70),
	Color3.fromRGB(100, 220, 110),
	Color3.fromRGB(70, 200, 255),
	Color3.fromRGB(120, 120, 255),
	Color3.fromRGB(200, 110, 255),
	Color3.fromRGB(255, 110, 200),
}

local function now()
	return workspace:GetServerTimeNow()
end

local function part(parent, size, cf, color, material, props)
	return S.MapBuilder.Part(parent, size, cf, color, material, props)
end

-- Shell -------------------------------------------------------------------------
local GROUND_PLOTS = Config.PlotColumns * Config.PlotRows
local TOTAL_PLOTS = GROUND_PLOTS + Config.SecondFloorPlots
BaseService.TotalPlots = TOTAL_PLOTS

local function plotLocal(index: number): Vector3
	if index > GROUND_PLOTS then
		local j = index - GROUND_PLOTS - 1
		local r2 = math.floor(j / 6)
		local c2 = j % 6
		return Vector3.new((c2 - 2.5) * Config.PlotSpacing, Config.SecondFloorHeight, 10 + r2 * 12)
	end
	local r = math.floor((index - 1) / Config.PlotColumns)
	local c = (index - 1) % Config.PlotColumns
	local x = (c - (Config.PlotColumns - 1) / 2) * Config.PlotSpacing
	local z = 2 + r * Config.PlotSpacing
	return Vector3.new(x, 0, z)
end

local function buildShell(index: number, cf: CFrame, parent: Instance)
	local color = BASE_COLORS[(index - 1) % #BASE_COLORS + 1]
	local half = Config.BaseSize / 2
	local wallH = Config.BaseWallHeight
	local model = Instance.new("Model")
	model.Name = "Base" .. index
	model:SetAttribute("Index", index)
	model:SetAttribute("OwnerId", 0)
	model:SetAttribute("OwnerName", "")
	model:SetAttribute("LockEnd", 0)

	local function L(x, y, z)
		return cf * CFrame.new(x, y, z)
	end

	part(model, Vector3.new(Config.BaseSize, 1, Config.BaseSize), L(0, 0.5, 0), Color3.fromRGB(235, 230, 220), Enum.Material.WoodPlanks, { Name = "Floor" })
	part(model, Vector3.new(Config.BaseSize - 8, 0.2, Config.BaseSize - 30), L(0, 1.05, 12), color:Lerp(Color3.new(1, 1, 1), 0.55), Enum.Material.Fabric, { Name = "Carpet" })

	local walls = Instance.new("Folder")
	walls.Name = "Walls"
	walls.Parent = model
	local wallColor = color:Lerp(Color3.new(1, 1, 1), 0.25)
	part(walls, Vector3.new(2, wallH, Config.BaseSize), L(-half + 1, wallH / 2 + 1, 0), wallColor, Enum.Material.Brick)
	part(walls, Vector3.new(2, wallH, Config.BaseSize), L(half - 1, wallH / 2 + 1, 0), wallColor, Enum.Material.Brick)
	part(walls, Vector3.new(Config.BaseSize, wallH, 2), L(0, wallH / 2 + 1, half - 1), wallColor, Enum.Material.Brick)
	local doorW = 16
	local sideW = (Config.BaseSize - doorW) / 2
	part(walls, Vector3.new(sideW, wallH, 2), L(-(doorW / 2 + sideW / 2), wallH / 2 + 1, -half + 1), wallColor, Enum.Material.Brick)
	part(walls, Vector3.new(sideW, wallH, 2), L(doorW / 2 + sideW / 2, wallH / 2 + 1, -half + 1), wallColor, Enum.Material.Brick)
	part(walls, Vector3.new(doorW, wallH - 14, 2), L(0, wallH - (wallH - 14) / 2 + 1, -half + 1), wallColor, Enum.Material.Brick)
	-- Wall trims
	part(walls, Vector3.new(Config.BaseSize + 1, 1.2, 3), L(0, wallH + 1.6, half - 1), color, Enum.Material.SmoothPlastic)
	part(walls, Vector3.new(Config.BaseSize + 1, 1.2, 3), L(0, wallH + 1.6, -half + 1), color, Enum.Material.SmoothPlastic)
	part(walls, Vector3.new(3, 1.2, Config.BaseSize + 1), L(-half + 1, wallH + 1.6, 0), color, Enum.Material.SmoothPlastic)
	part(walls, Vector3.new(3, 1.2, Config.BaseSize + 1), L(half - 1, wallH + 1.6, 0), color, Enum.Material.SmoothPlastic)
	-- corner towers
	for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		local x, z = c[1] * (half - 1), c[2] * (half - 1)
		part(walls, Vector3.new(6, wallH + 6, 6), L(x, (wallH + 6) / 2 + 1, z), color, Enum.Material.Brick)
		part(walls, Vector3.new(7, 4, 7), L(x, wallH + 9, z), Color3.fromRGB(70, 60, 90), Enum.Material.Slate)
	end

	for _, w in ipairs(walls:GetChildren()) do
		if w.Material == Enum.Material.Brick then
			w:SetAttribute("Paint", w.Color == wallColor and "Wall" or "Tower")
		elseif w.Color == color then
			w:SetAttribute("Paint", "Trim")
		end
	end
	model:FindFirstChild("Carpet"):SetAttribute("Paint", "Carpet")

	-- Second floor (hidden until the Floors upgrade is bought)
	local floorH = Config.SecondFloorHeight
	local f2 = Instance.new("Folder")
	f2.Name = "SecondFloor"
	f2.Parent = model
	local slab = part(f2, Vector3.new(Config.BaseSize - 4, 1, 36), L(0, floorH + 0.5, 16), Color3.fromRGB(235, 225, 210), Enum.Material.WoodPlanks, { Name = "Slab" })
	slab:SetAttribute("Paint", "Floor2")
	local ramp = Instance.new("WedgePart")
	ramp.Name = "Stairs"
	ramp.Anchored = true
	ramp.Size = Vector3.new(8, floorH + 1, 28)
	ramp.CFrame = L(-29.5, (floorH + 1) / 2 + 0.5, -16)
	ramp.Color = Color3.fromRGB(200, 180, 150)
	ramp.Material = Enum.Material.WoodPlanks
	ramp:SetAttribute("Paint", "Floor2")
	ramp.Parent = f2
	local rail = part(f2, Vector3.new(Config.BaseSize - 16, 3, 0.6), L(6, floorH + 2.5, -1.7), color, Enum.Material.Glass, { Name = "Rail", Transparency = 0.4 })
	rail:SetAttribute("Paint", "Floor2")
	for i = 0, 3 do
		local beamPart = part(f2, Vector3.new(1.5, floorH, 1.5), L(-24 + i * 16, floorH / 2 + 1, -1.2), Color3.fromRGB(200, 180, 150), Enum.Material.Wood, { Name = "Support" })
		beamPart:SetAttribute("Paint", "Floor2")
	end

	-- Sliding doors (the client animates them using the base's "Locked" attribute)
	for _, side in ipairs({ -1, 1 }) do
		local door = part(model, Vector3.new(8, 14, 0.8), L(side * (16 / 2 + 4.2), 8, -half + 1), Color3.fromRGB(90, 95, 120), Enum.Material.DiamondPlate, {
			Name = side < 0 and "DoorL" or "DoorR",
			CanCollide = false,
		})
		door:SetAttribute("OpenCF", door.CFrame)
		door:SetAttribute("ClosedCF", L(side * 4, 8, -half + 1))
		CollectionService:AddTag(door, "SlidingDoor")
	end

	-- Security cameras on the front towers
	for _, x in ipairs({ -1, 1 }) do
		local mount = L(x * (half - 1), wallH + 4, -half - 2)
		local cam = Instance.new("Model")
		cam.Name = "SecurityCamera"
		local body = part(cam, Vector3.new(1.4, 1.4, 2.6), mount, Color3.fromRGB(230, 230, 235), Enum.Material.SmoothPlastic, { Name = "CamBody", CanCollide = false })
		part(cam, Vector3.new(0.9, 0.9, 0.3), mount * CFrame.new(0, 0, -1.4), Color3.fromRGB(60, 255, 120), Enum.Material.Neon, { Name = "Lens", CanCollide = false })
		cam.PrimaryPart = body
		cam:SetAttribute("Paint", "Camera")
		cam.Parent = model
		CollectionService:AddTag(cam, "SecurityCam")
	end

	-- Collector pad (step on it to bank your income)
	local pad = part(model, Vector3.new(6, 0.4, 6), L(12, 1.2, -half + 6), Color3.fromRGB(255, 205, 60), Enum.Material.Neon, { Name = "CollectPad", CanCollide = false, CanTouch = true })
	local padBB, padLabel = S.MapBuilder.Billboard(pad, "💰 $0", Color3.fromRGB(255, 230, 120), UDim2.fromOffset(220, 50), 3)
	padBB.MaxDistance = 90
	part(model, Vector3.new(6.6, 0.3, 6.6), L(12, 1.05, -half + 6), Color3.fromRGB(90, 70, 30), Enum.Material.Metal)

	-- Animated decorations: tower banners + floating gem statue
	for _, c in ipairs({ { -1, 1 }, { 1, 1 } }) do
		local pole = part(walls, Vector3.new(0.4, 8, 0.4), L(c[1] * (half - 1), wallH + 15, c[2] * (half - 1)), Color3.fromRGB(240, 240, 240), Enum.Material.Metal)
		local flag = part(walls, Vector3.new(0.15, 2.6, 4), pole.CFrame * CFrame.new(0, 2.6, 2.1), color, Enum.Material.Fabric, { CanCollide = false })
		flag:SetAttribute("Paint", "Trim")
		CollectionService:AddTag(flag, "Flag")
		flag:SetAttribute("SwayAmount", 0.3)
	end
	local statue = part(model, Vector3.new(3, 3, 3), L(0, 9, -half + 8) * CFrame.Angles(math.rad(45), 0, math.rad(45)), color, Enum.Material.Neon, { Name = "Statue", CanCollide = false })
	statue:SetAttribute("Paint", "Trim")
	CollectionService:AddTag(statue, "Spin")
	CollectionService:AddTag(statue, "Bob")
	statue:SetAttribute("BobHeight", 0.8)
	part(model, Vector3.new(3, 5, 3), L(0, 3.5, -half + 8), Color3.fromRGB(245, 245, 250), Enum.Material.Marble)

	-- Door barrier (laser wall)
	local barrier = part(model, Vector3.new(doorW, 14, 1), L(0, 8, -half + 1), Color3.fromRGB(255, 40, 60), Enum.Material.ForceField, {
		Name = "Barrier",
		Transparency = 1,
		CanCollide = false,
	})
	for i = 0, 3 do
		part(model, Vector3.new(doorW, 0.25, 0.25), L(0, 2.5 + i * 3.2, -half + 1), Color3.fromRGB(255, 60, 80), Enum.Material.Neon, {
			Name = "Laser",
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
		})
	end
	-- door frame lights
	for _, x in ipairs({ -doorW / 2 - 0.5, doorW / 2 + 0.5 }) do
		part(model, Vector3.new(1, 14, 2.4), L(x, 8, -half + 1), Color3.fromRGB(60, 255, 140), Enum.Material.Neon, { Name = "DoorLight" })
	end

	-- Lock button
	local button = part(model, Vector3.new(3, 3, 3), L(-12, 2.5, -half + 6), Color3.fromRGB(255, 60, 60), Enum.Material.Neon, { Name = "LockButton" })
	part(model, Vector3.new(4, 1, 4), L(-12, 1.5, -half + 6), Color3.fromRGB(50, 50, 60), Enum.Material.Metal)
	local lockPrompt = Instance.new("ProximityPrompt")
	lockPrompt.Name = "LockPrompt"
	lockPrompt.ActionText = "Lock Base"
	lockPrompt.ObjectText = "🔒 Security"
	lockPrompt.MaxActivationDistance = 10
	lockPrompt.RequiresLineOfSight = false
	lockPrompt:SetAttribute("OwnerOnly", true)
	lockPrompt.Parent = button

	-- Alarm lights + siren sound
	local alarms = Instance.new("Folder")
	alarms.Name = "AlarmLights"
	alarms.Parent = model
	for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		local light = part(alarms, Vector3.new(2.5, 2.5, 2.5), L(c[1] * (half - 1), wallH + 12.5, c[2] * (half - 1)), Color3.fromRGB(90, 90, 100), Enum.Material.Glass, { Name = "Alarm", Shape = Enum.PartType.Ball })
		local pl = Instance.new("PointLight")
		pl.Color = Color3.fromRGB(255, 30, 30)
		pl.Range = 40
		pl.Brightness = 4
		pl.Enabled = false
		pl.Parent = light
	end
	local siren = Instance.new("Sound")
	siren.Name = "Siren"
	siren.SoundId = Config.Sounds.Alarm
	siren.Volume = 1
	siren.PlaybackSpeed = 0.6
	siren.RollOffMaxDistance = 220
	siren.Looped = true
	siren.Parent = model:FindFirstChild("Floor")

	-- Sign above the door
	local signPart = part(model, Vector3.new(26, 7, 1), L(0, wallH + 6, -half - 0.6), Color3.fromRGB(30, 30, 50), Enum.Material.SmoothPlastic, { Name = "Sign" })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = signPart
	-- (the sign's Front face already points at the plaza, where visitors come from)
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(1, 0.6)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.3)
	title.Text = "EMPTY BASE"
	title.Parent = gui
	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromScale(0, 0.6)
	sub.Size = UDim2.fromScale(1, 0.4)
	sub.Font = Enum.Font.GothamBold
	sub.TextScaled = true
	sub.TextColor3 = Color3.fromRGB(255, 230, 120)
	sub.Text = ""
	sub.Parent = gui

	-- Plots
	local plots = Instance.new("Folder")
	plots.Name = "Plots"
	plots.Parent = model
	local plotParts = {}
	for i = 1, TOTAL_PLOTS do
		local lp = plotLocal(i)
		local plot = part(plots, Vector3.new(6, 1.5, 6), L(lp.X, 1.75 + lp.Y, lp.Z), Color3.fromRGB(250, 250, 255), Enum.Material.Marble, { Name = "Plot" .. i })
		plot:SetAttribute("Index", i)
		local rim = part(plots, Vector3.new(6.4, 0.3, 6.4), L(lp.X, 2.4 + lp.Y, lp.Z), color, Enum.Material.Neon, { Name = "Rim" .. i, CanCollide = false })
		rim:SetAttribute("Paint", "Rim")
		local lockBB, lockLabel = S.MapBuilder.Billboard(plot, "🔒", Color3.fromRGB(255, 255, 255), UDim2.fromOffset(40, 40), 2)
		lockBB.Name = "LockedLabel"
		lockBB.MaxDistance = 80
		lockLabel.Text = "🔒"
		-- collect plate: step on it to grab the cash this stand has earned
		local plate = part(plots, Vector3.new(5, 0.35, 1.7), L(lp.X, 1.2 + lp.Y, lp.Z - 3.95), Color3.fromRGB(70, 230, 110), Enum.Material.Neon, { Name = "Plate" .. i, CanCollide = false, CanTouch = true })
		plate:SetAttribute("Plot", i)
		local plateBB, plateLabel = S.MapBuilder.Billboard(plate, "", Color3.fromRGB(140, 255, 150), UDim2.fromOffset(110, 30), 1.4)
		plateBB.MaxDistance = 60
		plotParts[i] = { Plot = plot, Rim = rim, LockBB = lockBB, Plate = plate, PlateLabel = plateLabel }
	end

	local treasures = Instance.new("Folder")
	treasures.Name = "Treasures"
	treasures.Parent = model

	local zone = part(model, Vector3.new(Config.BaseSize - 2, 40, Config.BaseSize - 2), L(0, 20, 0), Color3.new(), nil, {
		Name = "Zone",
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
	})

	model.Parent = parent
	return {
		Index = index,
		Model = model,
		CFrame = cf,
		Color = color,
		Barrier = barrier,
		Button = button,
		LockPrompt = lockPrompt,
		Siren = siren,
		Alarms = alarms,
		Title = title,
		Sub = sub,
		Plots = plotParts,
		Pad = pad,
		PadLabel = padLabel,
		SecondFloor = f2,
		TreasureFolder = treasures,
		Zone = zone,
		PlotModels = {}, -- [plotIndex] = { Uid, Model }
		Owner = nil :: Player?,
		AlarmUntil = 0,
	}
end

-- Personalisation ------------------------------------------------------------
function BaseService.ApplyStyle(base, data)
	local color = data.BaseColor and data.BaseColor > 0 and UpgradeData.BaseColors[data.BaseColor] or base.Color
	local tier = UpgradeData.WallTier(data)
	local floors = (data.Upgrades.Floors or 0) > 0
	local security = data.Upgrades.Security or 0
	local key = ("%s|%s|%s|%d"):format(color:ToHex(), tier.Name, tostring(floors), security)
	if base.StyleKey == key then
		return
	end
	base.StyleKey = key
	local wallMat = (Enum.Material :: any)[tier.Material]
	local wallColor = color:Lerp(Color3.new(1, 1, 1), 0.25)
	if tier.Name == "Gold" then
		wallColor = Color3.fromRGB(255, 205, 70)
	elseif tier.Name == "Diamond" then
		wallColor = Color3.fromRGB(190, 240, 255)
	end
	for _, d in ipairs(base.Model:GetDescendants()) do
		local paint = d:GetAttribute("Paint")
		if paint and d:IsA("BasePart") then
			if paint == "Wall" then
				d.Material = wallMat
				d.Color = wallColor
				d.Transparency = tier.Name == "Diamond" and 0.15 or 0
			elseif paint == "Tower" then
				d.Material = wallMat
				d.Color = color
			elseif paint == "Trim" or paint == "Rim" then
				d.Color = color
			elseif paint == "Carpet" then
				d.Color = color:Lerp(Color3.new(1, 1, 1), 0.55)
			elseif paint == "Floor2" then
				local visible = floors
				d.Transparency = visible and (d.Name == "Rail" and 0.4 or 0) or 1
				d.CanCollide = visible
			end
		elseif paint == "Camera" and d:IsA("Model") then
			for _, cp in ipairs(d:GetDescendants()) do
				if cp:IsA("BasePart") then
					cp.Transparency = security > 0 and 0 or 1
				end
			end
		end
	end
	base.Model:SetAttribute("Security", security)
	base.Model:SetAttribute("Color", color)
end

function BaseService.SetColor(player: Player, index)
	local data = S.DataService.Get(player)
	if not data or typeof(index) ~= "number" then
		return false, "Bad request"
	end
	index = math.floor(index)
	if index < 0 or index > #UpgradeData.BaseColors then
		return false, "Unknown colour"
	end
	data.BaseColor = index
	BaseService.Refresh(player)
	S.StateService.MarkFull(player)
	return true, "Base colour updated! 🎨"
end

-- Collector pad --------------------------------------------------------------
-- Collects everything: the vault (offline income) and every stand's plate.
function BaseService.Collect(player: Player)
	local data = S.DataService.Get(player)
	if not data then
		return
	end
	local amount = math.floor(data.Vault or 0)
	data.Vault = (data.Vault or 0) - amount
	for key, v in pairs(data.PlotCash) do
		local whole = math.floor(v)
		amount += whole
		data.PlotCash[key] = v - whole
	end
	if amount < 1 then
		return
	end
	S.EconomyService.AddMoney(player, amount)
	Remotes.Effect:FireClient(player, "Collect", amount)
	S.StateService.MarkFull(player)
	BaseService.UpdatePlates(player)
end

-- Collects one stand's plate (stepping on it).
function BaseService.CollectPlot(player: Player, plot: number)
	local data = S.DataService.Get(player)
	if not data then
		return
	end
	local key = tostring(plot)
	local amount = math.floor(data.PlotCash[key] or 0)
	if amount < 1 then
		return
	end
	data.PlotCash[key] -= amount
	S.EconomyService.AddMoney(player, amount)
	Remotes.Effect:FireClient(player, "Collect", amount)
	BaseService.UpdatePlates(player)
end

function BaseService.UpdatePlates(player: Player)
	local base = BaseService.Get(player)
	local data = S.DataService.Get(player)
	if not base or not data then
		return
	end
	for i, p in ipairs(base.Plots) do
		local cash = math.floor(data.PlotCash[tostring(i)] or 0)
		p.PlateLabel.Text = cash >= 1 and Util.Money(cash) or ""
		p.Plate.Transparency = (data.AutoCollect or not BaseService.IsPlotUnlocked(data, i)) and 1 or 0
	end
end

-- Queries --------------------------------------------------------------------------
function BaseService.Get(player: Player)
	local session = S.DataService.Session(player)
	if not session or not session.BaseIndex then
		return nil
	end
	return BaseService.Bases[session.BaseIndex]
end

function BaseService.IsInside(base, position: Vector3): boolean
	local rel = base.Zone.CFrame:PointToObjectSpace(position)
	local half = base.Zone.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

function BaseService.BaseAt(position: Vector3)
	for _, base in ipairs(BaseService.Bases) do
		if BaseService.IsInside(base, position) then
			return base
		end
	end
	return nil
end

function BaseService.SpawnCFrame(player: Player): CFrame?
	local base = BaseService.Get(player)
	if not base then
		return nil
	end
	return base.CFrame * CFrame.new(0, 4, -Config.BaseSize / 2 + 12) * CFrame.Angles(0, math.pi, 0)
end

function BaseService.IsLocked(player: Player): boolean
	local session = S.DataService.Session(player)
	return session ~= nil and session.LockEnd > now()
end

-- Plot index (1..unlocked) that holds no treasure, or nil.
function BaseService.FreePlot(player: Player): number?
	local data = S.DataService.Get(player)
	if not data then
		return nil
	end
	local used = {}
	for _, t in pairs(data.Treasures) do
		if t.Plot then
			used[t.Plot] = true
		end
	end
	for _, i in ipairs(BaseService.UnlockedPlots(data)) do
		if not used[i] then
			return i
		end
	end
	return nil
end

-- Ordered list of unlocked plot indices (ground floor first, then 2nd floor).
function BaseService.UnlockedPlots(data): { number }
	local list = {}
	local ground = math.min(GROUND_PLOTS, Config.StartingPlots + (UpgradeData.BaseLevel(data) - 1) * Config.PlotsPerBaseLevel)
	for i = 1, ground do
		table.insert(list, i)
	end
	if (data.Upgrades.Floors or 0) > 0 then
		for i = GROUND_PLOTS + 1, TOTAL_PLOTS do
			table.insert(list, i)
		end
	end
	return list
end

function BaseService.IsPlotUnlocked(data, index: number): boolean
	return table.find(BaseService.UnlockedPlots(data), index) ~= nil
end

function BaseService.CountPlaced(data): number
	local n = 0
	for _, t in pairs(data.Treasures) do
		if t.Plot then
			n += 1
		end
	end
	return n
end

function BaseService.CountStored(data): number
	local n = 0
	for _, t in pairs(data.Treasures) do
		if not t.Plot then
			n += 1
		end
	end
	return n
end

-- Rendering -------------------------------------------------------------------------
local function makeLabel(root: BasePart, def, height: number, mutation: string?)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(180, 54)
	bb.StudsOffset = Vector3.new(0, height + 1.2, 0)
	bb.MaxDistance = 55
	bb.LightInfluence = 0
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromScale(1, 0.4)
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextColor3 = Color3.new(1, 1, 1)
	name.Text = def.Name
	local st = Instance.new("UIStroke")
	st.Thickness = 2
	st.Parent = name
	name.Parent = bb
	local rarity = Instance.new("TextLabel")
	rarity.BackgroundTransparency = 1
	rarity.Position = UDim2.fromScale(0, 0.4)
	rarity.Size = UDim2.fromScale(1, 0.3)
	rarity.Font = Enum.Font.GothamBlack
	rarity.TextScaled = true
	rarity.TextColor3 = Rarities.Color(def.Rarity)
	rarity.Text = def.Rarity:upper() .. (mutation and ("  " .. Mutations.Label(mutation)) or "")
	local st2 = Instance.new("UIStroke")
	st2.Thickness = 2
	st2.Parent = rarity
	rarity.Parent = bb
	local mps = Instance.new("TextLabel")
	mps.BackgroundTransparency = 1
	mps.Position = UDim2.fromScale(0, 0.7)
	mps.Size = UDim2.fromScale(1, 0.3)
	mps.Font = Enum.Font.GothamBold
	mps.TextScaled = true
	mps.TextColor3 = Color3.fromRGB(120, 255, 120)
	mps.Text = Util.Money(def.MPS * Mutations.Multiplier(mutation)) .. "/s"
	local st3 = Instance.new("UIStroke")
	st3.Thickness = 2
	st3.Parent = mps
	mps.Parent = bb
	bb.Parent = root
	return bb
end
BaseService.MakeLabel = makeLabel

local function promptOn(root: BasePart, name: string, action: string, object: string, hold: number, kind: string)
	local p = Instance.new("ProximityPrompt")
	p.Name = name
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = hold
	p.MaxActivationDistance = 10
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = kind == "Steal" and Enum.KeyCode.E or Enum.KeyCode.G
	p:SetAttribute("Kind", kind)
	p.Parent = root
	return p
end

function BaseService.Refresh(player: Player)
	local base = BaseService.Get(player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not base or not data or not session then
		return
	end
	BaseService.ApplyStyle(base, data)
	local groundUnlocked = math.min(GROUND_PLOTS, UpgradeData.PlotCount(data))
	local hasFloor2 = (data.Upgrades.Floors or 0) > 0
	local desired = {}
	for uid, t in pairs(data.Treasures) do
		if t.Plot and not session.Stealing[uid] then
			desired[t.Plot] = uid
		end
	end
	for i, p in ipairs(base.Plots) do
		local onFloor2 = i > GROUND_PLOTS
		local isUnlocked = (onFloor2 and hasFloor2) or (not onFloor2 and i <= groundUnlocked)
		local hidden = onFloor2 and not hasFloor2
		p.Plot.Transparency = hidden and 1 or (isUnlocked and 0 or 0.55)
		p.Plot.CanCollide = not hidden
		p.Rim.Transparency = hidden and 1 or (isUnlocked and 0 or 0.8)
		p.LockBB.Enabled = not isUnlocked and not hidden

		local current = base.PlotModels[i]
		local want = desired[i]
		if current and current.Uid ~= want then
			current.Model:Destroy()
			base.PlotModels[i] = nil
			current = nil
		end
		if want and not current then
			local entry = data.Treasures[want]
			local def = TreasureData.Get(entry.Id)
			if def then
				-- rotate so the treasure's face looks toward the door
				local cf = p.Plot.CFrame * CFrame.new(0, p.Plot.Size.Y / 2, 0) * CFrame.Angles(0, math.pi, 0)
				local model = TreasureModels.Build(def, { CFrame = cf, Scale = 1, Mutation = entry.Mut })
				model:SetAttribute("Uid", want)
				model:SetAttribute("OwnerId", player.UserId)
				-- just bought on the parade: clients animate it walking home
				local arriving = session.Arriving[want]
				if arriving then
					model:SetAttribute("WalkFrom", arriving.From)
					model:SetAttribute("ArriveAt", arriving.At)
				end
				local root = model.PrimaryPart :: BasePart
				makeLabel(root, def, TreasureModels.Height(def), entry.Mut)
				local hold = UpgradeData.StealHold(data)
				local steal = promptOn(root, "StealPrompt", "Steal", def.Name, hold, "Steal")
				local store = promptOn(root, "StorePrompt", "Pick Up", def.Name, 0.3, "Store")
				steal.Triggered:Connect(function(thief)
					S.StealService.TryStart(thief, player, want)
				end)
				store.Triggered:Connect(function(who)
					if who == player then
						S.TreasureService.Store(player, want)
					end
				end)
				model.Parent = base.TreasureFolder
				base.PlotModels[i] = { Uid = want, Model = model }
			end
		end
	end
	BaseService.UpdateSign(player)
end

-- Updates steal hold time on existing prompts (after a protection upgrade).
function BaseService.RefreshPrompts(player: Player)
	local base = BaseService.Get(player)
	local data = S.DataService.Get(player)
	if not base or not data then
		return
	end
	local hold = UpgradeData.StealHold(data)
	for _, pm in pairs(base.PlotModels) do
		local prompt = pm.Model.PrimaryPart and pm.Model.PrimaryPart:FindFirstChild("StealPrompt")
		if prompt then
			prompt.HoldDuration = hold
		end
	end
end

function BaseService.UpdateSign(player: Player)
	local base = BaseService.Get(player)
	local session = S.DataService.Session(player)
	if not base or not session then
		return
	end
	base.Title.Text = player.DisplayName .. "'s Base"
	local lockText = ""
	local remaining = session.LockEnd - now()
	if remaining > 0 then
		lockText = ("  🔒 %ds"):format(math.ceil(remaining))
	end
	base.Sub.Text = ("💰 %s/s%s"):format(Util.Abbreviate(session.MPS or 0), lockText)
	local data = S.DataService.Get(player)
	if data then
		BaseService.UpdatePlates(player)
		base.PadLabel.Text = data.AutoCollect and ("🤖 AUTO • %s/s"):format(Util.Abbreviate(session.MPS or 0)) or ("💰 " .. Util.Money(math.floor(data.Vault or 0)) .. "\nstep to collect")
	end
end

-- Locking ----------------------------------------------------------------------------
local function applyLockVisual(base, locked: boolean)
	base.Barrier.Transparency = locked and 0.35 or 1
	base.Barrier.CanCollide = locked
	for _, c in ipairs(base.Model:GetChildren()) do
		if c.Name == "Laser" then
			c.Transparency = locked and 0 or 1
		elseif c.Name == "DoorLight" then
			c.Color = locked and Color3.fromRGB(255, 50, 60) or Color3.fromRGB(60, 255, 140)
		end
	end
	base.Button.Color = locked and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 60, 60)
	base.Locked = locked
	base.Model:SetAttribute("Locked", locked)
end

-- Moves non-owners standing inside a base out of the door.
local function ejectIntruders(base)
	local owner = base.Owner
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= owner then
			local char = p.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp and BaseService.IsInside(base, hrp.Position) then
				hrp.CFrame = base.CFrame * CFrame.new(math.random(-6, 6), 4, -Config.BaseSize / 2 - 8)
				S.NetService.Notify(p, "The base locked and kicked you out!", "warn")
			end
		end
	end
end

function BaseService.SetLock(player: Player, seconds: number)
	local base = BaseService.Get(player)
	local session = S.DataService.Session(player)
	if not base or not session then
		return
	end
	session.LockEnd = math.max(session.LockEnd, now() + seconds)
	base.Model:SetAttribute("LockEnd", session.LockEnd)
	applyLockVisual(base, true)
	ejectIntruders(base)
	S.StateService.PushStats(player)
end

function BaseService.RequestLock(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session or not session.BaseIndex then
		return false, "No base"
	end
	local t = now()
	if session.LockEnd > t then
		return false, "Your base is already locked"
	end
	if session.LockCooldownEnd > t then
		return false, ("Lock recharging: %ds"):format(math.ceil(session.LockCooldownEnd - t))
	end
	local duration = UpgradeData.LockDuration(data)
	BaseService.SetLock(player, duration)
	session.LockCooldownEnd = session.LockEnd + UpgradeData.LockCooldown(data)
	S.StateService.PushStats(player)
	return true, ("Base locked for %ds!"):format(duration)
end

-- Alarm ----------------------------------------------------------------------------
function BaseService.TriggerAlarm(owner: Player)
	local base = BaseService.Get(owner)
	if not base then
		return
	end
	base.AlarmUntil = os.clock() + 6
	if not base.Siren.IsPlaying then
		base.Siren:Play()
	end
end

-- Assignment -----------------------------------------------------------------------
function BaseService.Assign(player: Player): number?
	for _, base in ipairs(BaseService.Bases) do
		if base.Owner == nil then
			base.Owner = player
			local session = S.DataService.Session(player)
			session.BaseIndex = base.Index
			base.Model:SetAttribute("OwnerId", player.UserId)
			base.Model:SetAttribute("OwnerName", player.DisplayName)
			base.Model:SetAttribute("LockEnd", 0)
			applyLockVisual(base, false)
			player:SetAttribute("BaseIndex", base.Index)
			return base.Index
		end
	end
	return nil
end

function BaseService.Release(player: Player)
	for _, base in ipairs(BaseService.Bases) do
		if base.Owner == player then
			base.Owner = nil
			for i, pm in pairs(base.PlotModels) do
				pm.Model:Destroy()
				base.PlotModels[i] = nil
			end
			base.Model:SetAttribute("OwnerId", 0)
			base.Model:SetAttribute("OwnerName", "")
			base.Model:SetAttribute("LockEnd", 0)
			base.Title.Text = "EMPTY BASE"
			base.Sub.Text = ""
			base.Siren:Stop()
			base.StyleKey = nil
			base.PadLabel.Text = ""
			applyLockVisual(base, false)
			for i, p in ipairs(base.Plots) do
				local f2 = i > GROUND_PLOTS
				p.Plot.Transparency = f2 and 1 or 0.55
				p.Rim.Transparency = f2 and 1 or 0.8
				p.LockBB.Enabled = not f2
			end
			for _, d in ipairs(base.SecondFloor:GetChildren()) do
				d.Transparency = 1
				d.CanCollide = false
			end
		end
	end
end

-- Security: cameras spot intruders, traps zap escaping thieves ---------------------
function BaseService.SecurityTick(base, owner: Player)
	local data = S.DataService.Get(owner)
	local session = S.DataService.Session(owner)
	if not data or not session then
		return
	end
	local level = data.Upgrades.Security or 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= owner then
			local ses = S.DataService.Session(p)
			local char = p.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if ses and hrp then
				local inside = BaseService.IsInside(base, hrp.Position)
				-- camera alerts
				if inside and level > 0 then
					local last = session.CameraAlerts[p] or 0
					if os.clock() - last > Config.Security.CameraAlertCooldown then
						session.CameraAlerts[p] = os.clock()
						base.Model:SetAttribute("CameraAlert", now())
						S.NetService.Notify(owner, ("📷 Security camera spotted %s in your base!"):format(p.DisplayName), "warn")
					end
				end
				-- laser trap on escape
				for _, item in ipairs(table.clone(ses.Carrying)) do
					if item.Source == "Steal" and item.Victim == owner then
						if inside then
							item.WasInside = true
						elseif item.WasInside and not item.TrapRolled then
							item.TrapRolled = true
							local chance = math.min(Config.Security.MaxTrapChance, level * Config.Security.TrapChancePerLevel)
							if level > 0 and math.random() < chance then
								S.CarryService.Remove(p, item)
								S.StealService.Return(item, "trapped")
								Remotes.Effect:FireAllClients("Zap", base.Barrier.Position + Vector3.new(0, 6, 0), hrp.Position)
								Remotes.Effect:FireClient(p, "Knockback", (hrp.Position - base.Barrier.Position).Unit * 50 + Vector3.new(0, 30, 0), 1.5)
								S.NetService.Notify(p, "⚡ ZAPPED by the security laser! The treasure went back.", "error")
								S.NetService.Notify(owner, ("⚡ Your laser trap caught %s!"):format(p.DisplayName), "success")
								data.Stats.Defends += 1
							end
						end
					end
				end
			end
		end
	end
end

function BaseService.Init(services)
	S = services
end

function BaseService.Start()
	local folder = Instance.new("Folder")
	folder.Name = "Bases"
	folder.Parent = workspace
	for i, cf in ipairs(S.MapBuilder.Map.BaseSlots) do
		local base = buildShell(i, cf, folder)
		BaseService.Bases[i] = base
		base.Pad.Touched:Connect(function(hit)
			local who = Players:GetPlayerFromCharacter(hit.Parent)
			if who and who == base.Owner then
				BaseService.Collect(who)
			end
		end)
		for j, p in ipairs(base.Plots) do
			p.Plate.Touched:Connect(function(hit)
				local who = Players:GetPlayerFromCharacter(hit.Parent)
				if who and who == base.Owner then
					BaseService.CollectPlot(who, j)
				end
			end)
		end
		-- hide the second floor until bought
		for _, d in ipairs(base.SecondFloor:GetChildren()) do
			d.Transparency = 1
			d.CanCollide = false
		end
		for j, p in ipairs(base.Plots) do
			if j > GROUND_PLOTS then
				p.Plot.Transparency = 1
				p.Rim.Transparency = 1
				p.LockBB.Enabled = false
			end
		end
		base.LockPrompt.Triggered:Connect(function(who)
			if base.Owner == who then
				local ok, msg = BaseService.RequestLock(who)
				S.NetService.Notify(who, msg or "", ok and "success" or "error")
			end
		end)
	end

	S.NetService.Handle("LockBase", function(player)
		return BaseService.RequestLock(player)
	end)
	S.NetService.Handle("SetBaseColor", BaseService.SetColor)
	S.NetService.Handle("Collect", function(player)
		local base = BaseService.Get(player)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not base or not hrp or not BaseService.IsInside(base, hrp.Position) then
			return false, "Go to the 💰 pad in your base to collect!"
		end
		BaseService.Collect(player)
		return true
	end)

	-- Lock expiry, alarm flashing and sign updates
	task.spawn(function()
		local tick = 0
		while true do
			task.wait(0.25)
			tick += 1
			local t = now()
			for _, base in ipairs(BaseService.Bases) do
				local owner = base.Owner
				if owner then
					local session = S.DataService.Session(owner)
					if session then
						if base.Locked and session.LockEnd <= t then
							applyLockVisual(base, false)
							base.Model:SetAttribute("LockEnd", 0)
							S.StateService.PushStats(owner)
						end
						if tick % 4 == 0 then
							BaseService.UpdateSign(owner)
						end
					end
				end
				local alarming = os.clock() < base.AlarmUntil
				for _, light in ipairs(base.Alarms:GetChildren()) do
					local on = alarming and (tick % 2 == 0)
					light.Color = on and Color3.fromRGB(255, 30, 30) or Color3.fromRGB(90, 90, 100)
					light.Material = on and Enum.Material.Neon or Enum.Material.Glass
					local pl = light:FindFirstChildOfClass("PointLight")
					if pl then
						pl.Enabled = on
					end
				end
				if not alarming and base.Siren.IsPlaying then
					base.Siren:Stop()
				end
				if owner and tick % 2 == 0 then
					BaseService.SecurityTick(base, owner)
				end
			end
		end
	end)
end

return BaseService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">CarryService</string><ProtectedString name="Source"><![CDATA[-- CarryService.lua
-- Carrying treasures above your head: attaching models, the carry pose (arms
-- raised), movement penalty, delivering to your own base and dropping/returning
-- on death, leave or getting bonked.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local TreasureModels = require(Shared.TreasureModels)
local UpgradeData = require(Shared.UpgradeData)

local S

local CarryService = {}

local CARRY_SCALE = 0.75

local function getCarrying(player: Player)
	local session = S.DataService.Session(player)
	return session and session.Carrying or {}
end

function CarryService.Count(player: Player): number
	return #getCarrying(player)
end

function CarryService.Capacity(player: Player): number
	local data = S.DataService.Get(player)
	return data and UpgradeData.CarryCapacity(data) or 1
end

function CarryService.CanCarry(player: Player): boolean
	return CarryService.Count(player) < CarryService.Capacity(player)
end

function CarryService.IsCarryingStolen(player: Player): boolean
	for _, item in ipairs(getCarrying(player)) do
		if item.Source == "Steal" then
			return true
		end
	end
	return false
end

-- Carry pose: the server only publishes how many treasures you hold; every
-- client animates the arms-overhead carry pose procedurally (Emotes controller).
local function setPose(character: Model?, count: number)
	if character then
		character:SetAttribute("Carrying", count)
	end
end

local function restack(player: Player)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local list = getCarrying(player)
	if not hrp then
		return
	end
	for i, item in ipairs(list) do
		local model = item.Model
		if model and model.Parent then
			local root = model.PrimaryPart
			local weld = root:FindFirstChild("CarryWeld")
			if weld then
				weld:Destroy()
			end
			root.CFrame = hrp.CFrame * CFrame.new(0, 3.4 + (i - 1) * 2.8, 0)
			local w = Instance.new("WeldConstraint")
			w.Name = "CarryWeld"
			w.Part0 = hrp
			w.Part1 = root
			w.Parent = root
		end
	end
	setPose(char, #list)
	S.PlayerService.ApplyMovement(player)
end

function CarryService.Add(player: Player, item)
	local def = TreasureData.Get(item.Id)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not def or not hrp then
		return false
	end
	local model = TreasureModels.Build(def, { Scale = CARRY_SCALE, CFrame = hrp.CFrame, Anchored = false, Mutation = item.Mut })
	model.Name = "Carried_" .. def.Id
	model:SetAttribute("Carried", true)
	model.Parent = char
	item.Model = model
	item.Start = os.clock()
	table.insert(getCarrying(player), item)
	restack(player)
	S.StateService.PushStats(player)
	return true
end

function CarryService.Remove(player: Player, item)
	local list = getCarrying(player)
	local idx = table.find(list, item)
	if idx then
		table.remove(list, idx)
	end
	if item.Model then
		item.Model:Destroy()
		item.Model = nil
	end
	if player.Parent then
		restack(player)
		S.StateService.PushStats(player)
	end
end

-- Returns stolen items to their owners. Used when bonked.
function CarryService.DropStolen(player: Player): number
	local dropped = 0
	local list = table.clone(getCarrying(player))
	for _, item in ipairs(list) do
		if item.Source == "Steal" then
			CarryService.Remove(player, item)
			S.StealService.Return(item, "bonked")
			dropped += 1
		end
	end
	return dropped
end

-- Death / leaving: stolen go home, world treasures drop on the ground,
-- purchased ones go to storage so nobody loses money.
function CarryService.DropAll(player: Player, position: Vector3?)
	local list = table.clone(getCarrying(player))
	for _, item in ipairs(list) do
		CarryService.Remove(player, item)
		if item.Source == "Steal" then
			S.StealService.Return(item, "dropped")
		elseif item.Source == "Market" then
			S.TreasureService.Give(player, item.Id, { Silent = true, NoAutoPlace = true, Mutation = item.Mut })
		else
			if position then
				S.TreasureService.DropToWorld(item.Id, position, item.Source)
			end
		end
	end
end

local function deposit(player: Player)
	local list = table.clone(getCarrying(player))
	for _, item in ipairs(list) do
		CarryService.Remove(player, item)
		if item.Source == "Steal" then
			S.StealService.Complete(player, item)
		else
			S.TreasureService.Give(player, item.Id, { Source = item.Source, Mutation = item.Mut })
		end
	end
end

function CarryService.Init(services)
	S = services
end

function CarryService.Start()
	-- Delivery + timeout loop
	task.spawn(function()
		while true do
			task.wait(0.2)
			for _, player in ipairs(Players:GetPlayers()) do
				local session = S.DataService.Session(player)
				if session and #session.Carrying > 0 then
					local char = player.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					local base = S.BaseService.Get(player)
					if hrp and base and S.BaseService.IsInside(base, hrp.Position) then
						deposit(player)
					else
						-- stolen treasure that takes too long goes back home
						for _, item in ipairs(table.clone(session.Carrying)) do
							if item.Source == "Steal" and os.clock() - item.Start > Config.Steal.CarryTimeout then
								CarryService.Remove(player, item)
								S.StealService.Return(item, "timeout")
								S.NetService.Notify(player, "You took too long! The treasure teleported home.", "warn")
							end
						end
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		CarryService.DropAll(player, hrp and hrp.Position or nil)
	end)
end

-- Called by PlayerService when a character dies.
function CarryService.OnDied(player: Player, position: Vector3?)
	CarryService.DropAll(player, position)
end

return CarryService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- DataService.lua
-- Loads, holds and saves player progress with DataStoreService.
--  * UpdateAsync with a session lock so two servers never write the same save
--  * retries with backoff, autosave, save on leave and on shutdown
--  * works in Studio without API access (progress just isn't persisted)
--  * Sessions[player] holds non-saved runtime state (cooldowns, carrying, ...)

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local DataService = {}

local TEMPLATE = {
	Version = Config.DataVersion,
	Money = Config.StartingMoney,
	TotalEarned = 0,
	Rebirths = 0,
	XP = 0,
	Level = 1,
	Gems = Config.Gems.Start,
	Vault = 0, -- offline income waiting on your vault pad
	PlotCash = {}, -- [tostring(plot)] = cash waiting on that stand's collect plate
	Upgrades = { Speed = 0, Carry = 0, Base = 0, Protection = 0, Income = 0, Luck = 0, Security = 0, Walls = 0, Floors = 0 },
	Pets = {}, -- [uid] = { Id = string, Equipped = boolean }
	ExtraPetSlots = 0,
	Gear = { Bat = 0, SpeedCoil = false, Grapple = false, Trap = false },
	AutoCollect = false,
	Boosts = {}, -- [name] = os.time() expiry
	Achievements = {}, -- [id] = true
	BaseColor = 0, -- 0 = slot default, otherwise index into UpgradeData.BaseColors
	Abilities = {},
	Treasures = {}, -- [uid] = { Id = string, Plot = number? }
	Index = {}, -- [treasureId] = true
	Secrets = {}, -- [secretName] = true
	Settings = { Music = true, Sfx = true, LowGfx = false, UIScale = 1, Effects = true, Weather = true, Intro = true },
	Stats = { Steals = 0, Robbed = 0, Collected = 0, Trades = 0, Defends = 0, Hatched = 0, ChestsOpened = 0, EventsJoined = 0 },
	Titles = {},
	Title = "",
	Trail = nil,
	LastOnline = 0,
	FirstJoin = 0,
}
DataService.Template = TEMPLATE

local SESSION_STALE = 30 * 60 -- a lock older than this is considered abandoned

local store: DataStore? = nil
local canSave = true

DataService.Profiles = {} :: { [Player]: any }
DataService.Sessions = {} :: { [Player]: any }
DataService.Loaded = Instance.new("BindableEvent")
DataService.Dirty = {} :: { [Player]: boolean } -- full-state resend pending

local function retry(fn, attempts: number)
	local lastErr
	for i = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		task.wait(math.min(2 ^ i, 8))
	end
	return false, lastErr
end

local function newSession(player: Player)
	return {
		Player = player,
		BaseIndex = nil,
		LockEnd = 0,
		LockCooldownEnd = 0,
		StealCooldownEnd = 0,
		ShieldEnd = workspace:GetServerTimeNow() + Config.Steal.NewPlayerShield,
		VictimCooldowns = {}, -- [victimUserId] = endTime
		Carrying = {}, -- list of carried items (CarryService)
		Stealing = {}, -- [uid] = thief Player   (my treasures being stolen right now)
		AbilityCooldowns = {},
		Cloaked = false,
		SuperJump = false,
		LastBonk = 0,
		Trade = nil,
		MPS = 0,
		JoinTime = os.time(),
		Stamina = Config.Sprint.MaxStamina,
		Sprinting = false,
		CameraAlerts = {}, -- [intruder] = last alert clock
		Arriving = {}, -- [uid] = { From = Vector3, At = serverTime } treasures walking home
		PetBonus = { Money = 0, Luck = 0, Speed = 0, Gems = 0 },
		Aura = 0,
	}
end

function DataService.Get(player: Player)
	return DataService.Profiles[player]
end

function DataService.Session(player: Player)
	return DataService.Sessions[player]
end

function DataService.IsLoaded(player: Player): boolean
	return DataService.Profiles[player] ~= nil
end

function DataService.MarkDirty(player: Player)
	DataService.Dirty[player] = true
end

-- Waits until a player's data is loaded (or they leave). Returns data or nil.
function DataService.WaitFor(player: Player)
	while player.Parent and not DataService.Profiles[player] do
		task.wait(0.1)
	end
	return DataService.Profiles[player]
end

local function key(player: Player): string
	return "Player_" .. player.UserId
end

local function load(player: Player)
	local data
	if store and canSave then
		local attempts = 0
		while true do
			attempts += 1
			local locked = false
			local ok, result = retry(function()
				return (store :: DataStore):UpdateAsync(key(player), function(old)
					old = old or {}
					local lock = old.SessionLock
					if lock and lock.JobId ~= game.JobId and os.time() - (lock.Time or 0) < SESSION_STALE and attempts < 4 then
						locked = true
						return nil -- cancel, someone else still has it
					end
					old.SessionLock = { JobId = game.JobId, Time = os.time() }
					return old
				end)
			end, 4)
			if not ok then
				warn("[Data] load failed for " .. player.Name .. ": " .. tostring(result))
				player:Kick("Could not load your data. Please rejoin in a moment.")
				return nil
			end
			if not locked then
				data = result
				break
			end
			task.wait(6) -- previous server is still saving, wait and retry
		end
	end
	data = data or {}
	Util.Reconcile(data, TEMPLATE)
	data.SessionLock = nil
	if data.FirstJoin == 0 then
		data.FirstJoin = os.time()
	end
	return data
end

local function serialize(data)
	local copy = Util.DeepCopy(data)
	copy.SessionLock = nil
	return copy
end

function DataService.Save(player: Player, release: boolean?)
	local data = DataService.Profiles[player]
	if not data or not store or not canSave then
		return false
	end
	data.LastOnline = os.time()
	local payload = serialize(data)
	local ok, err = retry(function()
		return (store :: DataStore):UpdateAsync(key(player), function(old)
			local lock = old and old.SessionLock
			if lock and lock.JobId ~= game.JobId and os.time() - (lock.Time or 0) < SESSION_STALE then
				return nil -- another server owns this save now; don't overwrite it
			end
			if not release then
				payload.SessionLock = { JobId = game.JobId, Time = os.time() }
			end
			return payload
		end)
	end, 3)
	if not ok then
		warn("[Data] save failed for " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
		-- In Studio, check API access once so we don't spam errors.
		if RunService:IsStudio() then
			local accessOk = pcall(function()
				(store :: DataStore):GetAsync("__probe")
			end)
			if not accessOk then
				canSave = false
				warn("[Data] DataStore unavailable in Studio (enable 'Studio Access to API Services'). Progress won't save.")
			end
		end
	else
		canSave = false
		warn("[Data] DataStoreService unavailable: " .. tostring(result))
	end
end

function DataService.CanSave()
	return canSave and store ~= nil
end

function DataService.Start()
	local function onJoin(player: Player)
		DataService.Sessions[player] = newSession(player)
		local data = load(player)
		if not data or not player.Parent then
			return
		end
		DataService.Profiles[player] = data
		DataService.Loaded:Fire(player)
	end

	Players.PlayerAdded:Connect(onJoin)
	for _, p in ipairs(Players:GetPlayers()) do
		task.defer(onJoin, p) -- defer so every service has connected first
	end

	Players.PlayerRemoving:Connect(function(player)
		-- Other services clean up on PlayerRemoving too; give them a frame.
		task.defer(function()
			if DataService.Profiles[player] then
				DataService.Save(player, true)
			end
			DataService.Profiles[player] = nil
			DataService.Sessions[player] = nil
			DataService.Dirty[player] = nil
		end)
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in pairs(DataService.Profiles) do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(DataService.Profiles) do
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[-- EconomyService.lua
-- Passive income, money/XP helpers, levels, offline earnings and the global
-- income multiplier used by events (Golden Hour).

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local UpgradeData = require(Shared.UpgradeData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)
local Mutations = require(Shared.Mutations)

local S

local EconomyService = {}
EconomyService.EventMultiplier = 1
EconomyService.EventLuck = 0 -- additive luck bonus from the Lucky Treasure event

function EconomyService.AddGems(player: Player, amount: number)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or amount ~= amount or amount == 0 then
		return
	end
	if amount > 0 and session then
		amount = math.floor(amount * (1 + session.PetBonus.Gems) + 0.5)
	end
	data.Gems = math.max(0, math.floor(data.Gems + amount))
	S.StateService.PushStats(player)
end

function EconomyService.Luck(player: Player): number
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data then
		return 1
	end
	return UpgradeData.Luck(data, session and session.PetBonus.Luck or 0, EconomyService.EventLuck)
end

function EconomyService.AddMoney(player: Player, amount: number)
	local data = S.DataService.Get(player)
	if not data or amount ~= amount then -- NaN guard
		return
	end
	data.Money = math.max(0, data.Money + amount)
	if amount > 0 then
		data.TotalEarned += amount
	end
	S.StateService.PushStats(player)
end

function EconomyService.AddXP(player: Player, amount: number)
	local data = S.DataService.Get(player)
	if not data then
		return
	end
	data.XP += amount
	local leveled = false
	while data.XP >= Config.XPForLevel(data.Level) do
		data.XP -= Config.XPForLevel(data.Level)
		data.Level += 1
		leveled = true
		-- level reward
		local reward = 100 * data.Level * data.Level
		data.Money += reward
		data.Gems += data.Level * Config.Gems.PerLevel
		S.NetService.Notify(player, ("⭐ LEVEL %d! +%s  +%d 💎"):format(data.Level, Util.Money(reward), data.Level * Config.Gems.PerLevel), "level")
	end
	if leveled then
		Remotes.Effect:FireClient(player, "LevelUp", data.Level)
		S.PlayerService.Emote(player, "Celebrate", 3)
		S.PlayerService.UpdateOverhead(player)
	end
	S.StateService.PushStats(player)
end

-- Money per second from all placed treasures (not being stolen).
function EconomyService.ComputeMPS(player: Player): number
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return 0
	end
	local total, aura = 0, 0
	local perPlot = {}
	for uid, t in pairs(data.Treasures) do
		if t.Plot and not session.Stealing[uid] and not session.Arriving[uid] then
			local def = TreasureData.Get(t.Id)
			if def then
				local v = def.MPS * Mutations.Multiplier(t.Mut)
				total += v
				perPlot[t.Plot] = v
				aura += def.Aura or 0
			end
		end
	end
	session.Aura = aura
	local mult = UpgradeData.IncomeMultiplier(data, aura, session.PetBonus.Money) * EconomyService.EventMultiplier
	session.PlotIncome = perPlot
	session.IncomeMult = mult
	return total * mult
end

function EconomyService.GrantOffline(player: Player)
	local data = S.DataService.Get(player)
	if not data or (data.LastOnline or 0) <= 0 then
		return
	end
	local away = math.min(os.time() - data.LastOnline, Config.OfflineIncomeMaxSeconds)
	if away < 60 then
		return
	end
	local mps = 0
	for _, t in pairs(data.Treasures) do
		if t.Plot then
			local def = TreasureData.Get(t.Id)
			mps += def and def.MPS * Mutations.Multiplier(t.Mut) or 0
		end
	end
	mps *= UpgradeData.IncomeMultiplier(data)
	local earned = math.floor(mps * away * Config.OfflineIncomeRate)
	if earned > 0 then
		data.Vault = (data.Vault or 0) + earned
		S.NetService.Notify(player, ("💤 Welcome back! Your treasures earned %s while you were away (%s). Collect it at your base!"):format(Util.Money(earned), Util.Time(away)), "discovery")
	end
end

function EconomyService.Init(services)
	S = services
end

function EconomyService.Start()
	task.spawn(function()
		while true do
			task.wait(Config.IncomeTickSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.DataService.Get(player)
				local session = S.DataService.Session(player)
				if data and session then
					local mps = EconomyService.ComputeMPS(player)
					session.MPS = mps
					local gain = mps * Config.IncomeTickSeconds
					if gain > 0 then
						if data.AutoCollect then
							data.Money += gain
						else
							-- each stand fills up its own collect plate
							local m = (session.IncomeMult or 1) * Config.IncomeTickSeconds
							for plot, v in pairs(session.PlotIncome or {}) do
								local key = tostring(plot)
								data.PlotCash[key] = (data.PlotCash[key] or 0) + v * m
							end
						end
						data.TotalEarned += gain
					end
					S.StateService.PushStats(player)
				end
			end
		end
	end)
end

return EconomyService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[-- EventService.lua
-- Timed world events that pull players to special locations:
--   Double Money        - 2x income for everyone, fountain turns gold
--   Meteor Shower       - meteors crash into the Meteor Crater dropping Epic+ loot
--   Golden Treasure Rain- golden coins + free treasures rain on every field
--   Treasure Apocalypse - the sky turns red and high-rarity treasures flood the map
--   Secret Treasure     - a Secret/Divine/Celestial treasure appears in a secret area
--   Lucky Treasure      - everyone's luck is doubled and lucky treasures spawn
--   Divine Descent      - a Mythical+ treasure descends onto the Celestial Shrine

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local Remotes = require(Shared.Remotes)

local S

local EventService = {}
EventService.Current = nil :: string?

local rng = Random.new()

local function setState(name: string?, duration: number)
	EventService.Current = name
	workspace:SetAttribute("Event", name or "")
	workspace:SetAttribute("EventEnd", name and (workspace:GetServerTimeNow() + duration) or 0)
	Remotes.EventState:FireAllClients(name, duration)
end

local function goldenHour()
	local d = Config.Events.GoldenHourDuration
	setState("Double Money", d)
	Remotes.Announce:FireAllClients(("💸 DOUBLE MONEY! All income x%d for %ds!"):format(Config.Events.GoldenHourMultiplier, d), "Legendary")
	S.EconomyService.EventMultiplier = Config.Events.GoldenHourMultiplier
	local water = S.MapBuilder.Map.FountainWater
	local oldColor = water and water.Color
	if water then
		water.Color = Color3.fromRGB(255, 210, 60)
		water.Material = Enum.Material.Neon
	end
	task.wait(d)
	S.EconomyService.EventMultiplier = 1
	if water then
		water.Color = oldColor
		water.Material = Enum.Material.Glass
	end
	setState(nil, 0)
end

local function meteorShower()
	local crater = S.MapBuilder.Map.Crater
	setState("Meteor Shower", 40)
	Remotes.Announce:FireAllClients("☄️ METEOR SHOWER at the Meteor Crater! Epic+ treasures incoming!", "Epic")
	task.wait(4)
	for i = 1, Config.Events.MeteorCount do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(0, crater.Radius - 6)
		local target = crater.Center + Vector3.new(math.cos(a) * r, 0.5, math.sin(a) * r)
		local start = target + Vector3.new(rng:NextNumber(-60, 60), 260, rng:NextNumber(-60, 60))
		local meteor = Instance.new("Part")
		meteor.Shape = Enum.PartType.Ball
		meteor.Size = Vector3.new(7, 7, 7)
		meteor.Material = Enum.Material.CrackedLava
		meteor.Color = Color3.fromRGB(255, 120, 40)
		meteor.Anchored = true
		meteor.CanCollide = false
		meteor.CanQuery = false
		meteor.CFrame = CFrame.new(start)
		local fire = Instance.new("Fire")
		fire.Size = 14
		fire.Heat = 20
		fire.Parent = meteor
		local light = Instance.new("PointLight")
		light.Range = 40
		light.Brightness = 4
		light.Color = Color3.fromRGB(255, 140, 40)
		light.Parent = meteor
		meteor.Parent = workspace
		local tween = TweenService:Create(meteor, TweenInfo.new(2.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(target) })
		tween:Play()
		task.delay(2.2, function()
			local boom = Instance.new("Explosion")
			boom.Position = target
			boom.BlastRadius = 10
			boom.BlastPressure = 0 -- visual only, nobody gets hurt
			boom.DestroyJointRadiusPercent = 0
			boom.Parent = workspace
			Remotes.Effect:FireAllClients("Shake", target, 0.6)
			meteor.Anchored = true
			Debris:AddItem(meteor, 0.2)
			local def = TreasureData.RollFromPool(Config.SpawnPools.Meteor, rng)
			S.TreasureService.SpawnWorld(def, CFrame.new(target), "Event", { Region = "Meteor Crater", Lifetime = 180 })
		end)
		task.wait(rng:NextNumber(1.5, 4))
	end
	task.wait(20)
	setState(nil, 0)
end

local function treasureRain()
	setState("Golden Treasure Rain", 40)
	Remotes.Announce:FireAllClients("🪙 GOLDEN TREASURE RAIN! Coins and treasures are falling on every field!", "Legendary")
	local fields = S.MapBuilder.Map.Fields
	for i = 1, Config.Events.TreasureRainCount do
		local field = fields[rng:NextInteger(1, #fields)]
		S.TreasureService.SpawnInField(field, { Uncommon = 40, Rare = 35, Epic = 18, Legendary = 6, Mythical = 1 })
		for _ = 1, 3 do
			local a = rng:NextNumber(0, math.pi * 2)
			local r = rng:NextNumber(0, field.Radius + 6)
			S.WorldService.SpawnCoin(field.Center + Vector3.new(math.cos(a) * r, 0.5, math.sin(a) * r))
		end
		task.wait(0.8)
	end
	task.wait(15)
	setState(nil, 0)
end

-- Mutation events: everything that spawns has a big chance to mutate
local function mutationEvent(name: string, title: string, text: string, rarity: string)
	local d = 90
	setState(title, d)
	Remotes.Announce:FireAllClients(text, rarity)
	S.TreasureService.EventMutation = name
	task.wait(d)
	S.TreasureService.EventMutation = nil
	setState(nil, 0)
end

local function lavaEvent()
	mutationEvent("Lava", "Lava Eruption", "🌋 LAVA ERUPTION! Treasures are spawning with the LAVA mutation (x2.5)!", "Mythical")
end

local function rainbowEvent()
	mutationEvent("Rainbow", "Rainbow Storm", "🌈 RAINBOW STORM! Rainbow mutations (x2) everywhere!", "Divine")
end

local function apocalypse()
	local d = Config.Events.ApocalypseDuration
	setState("Treasure Apocalypse", d)
	Remotes.Announce:FireAllClients("☠️ TREASURE APOCALYPSE! The sky burns and legendary loot floods the world!", "Secret")
	Remotes.Effect:FireAllClients("GlobalShake", 0.4)
	local fields = S.MapBuilder.Map.Fields
	local t = 0
	while t < d do
		local field = fields[rng:NextInteger(1, #fields)]
		S.TreasureService.SpawnInField(field, Config.SpawnPools.Apocalypse)
		if rng:NextNumber() < 0.4 then
			local crater = S.MapBuilder.Map.Crater
			local def = TreasureData.RollFromPool(Config.SpawnPools.Apocalypse, rng)
			local a = rng:NextNumber(0, math.pi * 2)
			S.TreasureService.SpawnWorld(def, CFrame.new(crater.Center + Vector3.new(math.cos(a) * 20, 0.5, math.sin(a) * 20)), "Event", { Region = "Meteor Crater", Lifetime = 90 })
		end
		task.wait(3)
		t += 3
	end
	setState(nil, 0)
end

local function secretSpawn()
	local secrets = S.MapBuilder.Map.Secrets
	local secret = secrets[rng:NextInteger(1, #secrets)]
	local def = TreasureData.RollFromPool(Config.SpawnPools.SecretSpawn, rng)
	setState("Secret Treasure", 90)
	Remotes.Announce:FireAllClients(("🤫 SECRET TREASURE! A %s treasure appeared somewhere in the %s!"):format(def.Rarity, secret.Name), def.Rarity)
	local spot = secret.Spawns[rng:NextInteger(1, #secret.Spawns)] + Vector3.new(0, 0.5, 0)
	local record = S.TreasureService.SpawnWorld(def, CFrame.new(spot), "Event", { Region = secret.Name, Lifetime = 90 })
	local t = 0
	while t < 90 and S.TreasureService.World[record.Uid] do
		task.wait(1)
		t += 1
	end
	setState(nil, 0)
end

local function luckyEvent()
	local d = Config.Events.LuckyDuration
	setState("Lucky Treasure", d)
	Remotes.Announce:FireAllClients(("🍀 LUCKY TREASURE EVENT! Everyone has x%d luck for %ds!"):format(Config.Events.LuckyMultiplier, d), "Epic")
	S.EconomyService.EventLuck = Config.Events.LuckyMultiplier - 1
	local fields = S.MapBuilder.Map.Fields
	local t = 0
	while t < d do
		local field = fields[rng:NextInteger(1, #fields)]
		S.TreasureService.SpawnInField(field, Config.SpawnPools.Lucky)
		task.wait(10)
		t += 10
	end
	S.EconomyService.EventLuck = 0
	setState(nil, 0)
end

local function divineDescent()
	local altar = S.MapBuilder.Map.ShrineAltar
	setState("Divine Descent", 120)
	Remotes.Announce:FireAllClients("👼 DIVINE DESCENT! A legendary relic is descending on the Celestial Shrine!", "Divine")
	task.wait(6)
	local def = TreasureData.RollFromPool(Config.SpawnPools.Divine, rng)
	local record = S.TreasureService.SpawnWorld(def, altar, "Event", { Region = "Celestial Shrine", Lifetime = 120 })
	Remotes.Announce:FireAllClients(("👼 A %s %s has landed on the shrine! First come, first served!"):format(def.Rarity, def.Name), def.Rarity)
	local t = 0
	while t < 120 and S.TreasureService.World[record.Uid] do
		task.wait(1)
		t += 1
	end
	setState(nil, 0)
end

local EVENTS = {
	{ Fn = goldenHour, Weight = 22 },
	{ Fn = meteorShower, Weight = 20 },
	{ Fn = treasureRain, Weight = 20 },
	{ Fn = luckyEvent, Weight = 16 },
	{ Fn = secretSpawn, Weight = 10 },
	{ Fn = apocalypse, Weight = 6 },
	{ Fn = divineDescent, Weight = 6 },
	{ Fn = lavaEvent, Weight = 10 },
	{ Fn = rainbowEvent, Weight = 10 },
}

function EventService.RunRandom()
	local total = 0
	for _, e in ipairs(EVENTS) do
		total += e.Weight
	end
	local pick = rng:NextNumber() * total
	for _, e in ipairs(EVENTS) do
		if pick <= e.Weight then
			e.Fn()
			return
		end
		pick -= e.Weight
	end
end

function EventService.Init(services)
	S = services
end

function EventService.Start()
	setState(nil, 0)
	-- Studio-only testing helper: trigger any event from the Settings menu
	if game:GetService("RunService"):IsStudio() then
		local byName = {
			DoubleMoney = goldenHour,
			Meteor = meteorShower,
			GoldenRain = treasureRain,
			Lucky = luckyEvent,
			Secret = secretSpawn,
			Apocalypse = apocalypse,
			Divine = divineDescent,
			Lava = lavaEvent,
			Rainbow = rainbowEvent,
		}
		S.NetService.Handle("DebugEvent", function(_, name)
			local fn = byName[name]
			if not fn or EventService.Current then
				return false, "Unknown event or one is already running"
			end
			task.spawn(fn)
			return true, "Started " .. name
		end)
	end
	task.spawn(function()
		while true do
			local wait = rng:NextNumber(Config.Events.IntervalMin, Config.Events.IntervalMax)
			workspace:SetAttribute("NextEvent", workspace:GetServerTimeNow() + wait)
			task.wait(wait)
			local ok, err = pcall(EventService.RunRandom)
			if not ok then
				warn("[Events] " .. tostring(err))
				setState(nil, 0)
				S.EconomyService.EventMultiplier = 1
				S.EconomyService.EventLuck = 0
				S.TreasureService.EventMutation = nil
			end
		end
	end)
end

return EventService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">GearService</string><ProtectedString name="Source"><![CDATA[-- GearService.lua
-- Gear tools bought with money: Speed Coil, Grapple Hook and Bear Traps (the
-- Bonk Bat tiers live in StealService). Every use is validated on the server.

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local UpgradeData = require(Shared.UpgradeData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local GearService = {}

local traps: { [Player]: { BasePart } } = {}
local grappleCd: { [Player]: number } = {}

local function handle(tool: Tool, color: Color3, size: Vector3, material: Enum.Material?)
	local h = Instance.new("Part")
	h.Name = "Handle"
	h.Size = size
	h.Color = color
	h.Material = material or Enum.Material.Neon
	h.CanCollide = false
	h.Massless = true
	h.Parent = tool
	return h
end

local function makeTool(name: string, tip: string): Tool
	local t = Instance.new("Tool")
	t.Name = name
	t.ToolTip = tip
	t.CanBeDropped = false
	return t
end

local function placeTrap(player: Player)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local base = S.BaseService.Get(player)
	if not hrp or not base then
		return
	end
	if not S.BaseService.IsInside(base, hrp.Position) then
		S.NetService.Notify(player, "Place traps inside your own base!", "error")
		return
	end
	traps[player] = traps[player] or {}
	local list = traps[player]
	if #list >= 3 then
		local old = table.remove(list, 1)
		if old then
			old:Destroy()
		end
	end
	local trap = Instance.new("Part")
	trap.Name = "BearTrap"
	trap.Shape = Enum.PartType.Cylinder
	trap.Size = Vector3.new(0.4, 3.4, 3.4)
	trap.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 2.8, 0)) * CFrame.Angles(0, 0, math.rad(90))
	trap.Color = Color3.fromRGB(110, 110, 120)
	trap.Material = Enum.Material.DiamondPlate
	trap.Anchored = true
	trap.CanCollide = false
	trap:SetAttribute("Owner", player.UserId)
	local teeth = Instance.new("Part")
	teeth.Shape = Enum.PartType.Cylinder
	teeth.Size = Vector3.new(0.5, 2, 2)
	teeth.CFrame = trap.CFrame
	teeth.Color = Color3.fromRGB(255, 70, 70)
	teeth.Material = Enum.Material.Neon
	teeth.Anchored = true
	teeth.CanCollide = false
	teeth.CanTouch = false
	teeth.Parent = trap
	local sprung = false
	trap.Touched:Connect(function(hit)
		if sprung then
			return
		end
		local victim = Players:GetPlayerFromCharacter(hit.Parent)
		if not victim or victim == player then
			return
		end
		sprung = true
		local dropped = S.CarryService.DropStolen(victim)
		Remotes.Effect:FireClient(victim, "Knockback", Vector3.new(0, 10, 0), 2.5)
		S.NetService.Notify(victim, "🪤 SNAP! You stepped in a bear trap!", "error")
		if player.Parent then
			S.NetService.Notify(player, ("🪤 %s got caught in your trap!%s"):format(victim.DisplayName, dropped > 0 and " Loot recovered!" or ""), "success")
		end
		teeth.Size = Vector3.new(0.5, 3.2, 3.2)
		Debris:AddItem(trap, 1)
	end)
	trap.Parent = workspace
	table.insert(list, trap)
	S.NetService.Notify(player, ("🪤 Trap placed (%d/3)"):format(#list), "success")
end

function GearService.GiveTools(player: Player)
	local data = S.DataService.Get(player)
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if not data or not backpack then
		return
	end
	local session = S.DataService.Session(player)
	if data.Gear.SpeedCoil and not backpack:FindFirstChild("Speed Coil") then
		local t = makeTool("Speed Coil", "Hold to run faster")
		handle(t, Color3.fromRGB(80, 200, 255), Vector3.new(1, 1, 1))
		t.Equipped:Connect(function()
			if session then
				session.CoilEquipped = true
				S.PlayerService.ApplyMovement(player)
			end
		end)
		t.Unequipped:Connect(function()
			if session then
				session.CoilEquipped = false
				S.PlayerService.ApplyMovement(player)
			end
		end)
		t.Parent = backpack
	end
	if data.Gear.Grapple and not backpack:FindFirstChild("Grapple Hook") then
		local t = makeTool("Grapple Hook", "Click to zip to a spot")
		handle(t, Color3.fromRGB(200, 200, 210), Vector3.new(0.6, 2, 0.6), Enum.Material.Metal)
		t:SetAttribute("Grapple", true) -- the client sends the aim point
		t.Parent = backpack
	end
	if data.Gear.Trap and not backpack:FindFirstChild("Bear Trap") then
		local t = makeTool("Bear Trap", "Click inside your base to place a trap")
		handle(t, Color3.fromRGB(110, 110, 120), Vector3.new(1.4, 0.4, 1.4), Enum.Material.DiamondPlate)
		local cd = 0
		t.Activated:Connect(function()
			if os.clock() - cd > 1 then
				cd = os.clock()
				placeTrap(player)
			end
		end)
		t.Parent = backpack
	end
end

function GearService.Buy(player: Player, key)
	local data = S.DataService.Get(player)
	if not data or typeof(key) ~= "string" then
		return false, "Bad request"
	end
	local item = UpgradeData.Gear[key]
	if not item then
		return false, "Unknown gear"
	end
	local cost
	if key == "Bat" then
		local lvl = data.Gear.Bat or 0
		cost = item.Costs[lvl + 1]
		if not cost then
			return false, "Your bat is maxed!"
		end
	else
		if data.Gear[key] then
			return false, "You already own this"
		end
		cost = item.Cost
	end
	if data.Money < cost then
		return false, ("Need %s more"):format(Util.Money(cost - data.Money))
	end
	data.Money -= cost
	if key == "Bat" then
		data.Gear.Bat = (data.Gear.Bat or 0) + 1
		S.StealService.RefreshHammer(player)
	else
		data.Gear[key] = true
		GearService.GiveTools(player)
	end
	Remotes.Effect:FireClient(player, "Purchase")
	S.StateService.MarkFull(player)
	return true, ("Got %s!"):format(key == "Bat" and UpgradeData.BatStats(data.Gear.Bat).Name or item.Name)
end

function GearService.Grapple(player: Player, target)
	local data = S.DataService.Get(player)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not data or not data.Gear.Grapple or not hrp or typeof(target) ~= "Vector3" then
		return false
	end
	local tool = char:FindFirstChild("Grapple Hook")
	if not tool then
		return false
	end
	if grappleCd[player] and os.clock() - grappleCd[player] < 4 then
		return false
	end
	if (target - hrp.Position).Magnitude > 90 then
		return false, "Too far!"
	end
	grappleCd[player] = os.clock()
	Remotes.Effect:FireClient(player, "Grapple", target)
	return true
end

function GearService.Init(services)
	S = services
end

function GearService.Start()
	S.NetService.Handle("BuyGear", GearService.Buy)
	S.NetService.Handle("Grapple", GearService.Grapple)
	Players.PlayerRemoving:Connect(function(p)
		for _, t in ipairs(traps[p] or {}) do
			t:Destroy()
		end
		traps[p] = nil
		grappleCd[p] = nil
	end)
end

return GearService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[-- LeaderboardService.lua
-- Global leaderboards (OrderedDataStore) for Richest players and Most
-- Rebirths, plus a live server board. Shown in the UI and on the physical
-- board in the marketplace.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local LeaderboardService = {}
LeaderboardService.Cache = { Richest = {}, Rebirths = {}, Server = {} }

local UPDATE_INTERVAL = 120
local MAX_SAFE = 2 ^ 52

local stores = {}
local nameCache: { [number]: string } = {}

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local p = Players:GetPlayerByUserId(userId)
	if p then
		nameCache[userId] = p.DisplayName
		return p.DisplayName
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	nameCache[userId] = ok and name or ("Player" .. userId)
	return nameCache[userId]
end

local function pushScores()
	if not stores.Richest then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local data = S.DataService.Get(player)
		if data then
			local key = tostring(player.UserId)
			pcall(function()
				stores.Richest:SetAsync(key, math.floor(math.min(data.Money, MAX_SAFE)))
			end)
			pcall(function()
				stores.Rebirths:SetAsync(key, data.Rebirths)
			end)
		end
	end
end

local function fetch(store): { any }
	local list = {}
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, 50)
	end)
	if not ok or not pages then
		return list
	end
	local okPage, entries = pcall(function()
		return pages:GetCurrentPage()
	end)
	if not okPage then
		return list
	end
	for rank, entry in ipairs(entries) do
		local userId = tonumber(entry.key)
		if userId then
			table.insert(list, { Rank = rank, UserId = userId, Name = nameFor(userId), Value = entry.value })
		end
	end
	return list
end

local function buildServer()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local data = S.DataService.Get(player)
		local ses = S.DataService.Session(player)
		if data then
			table.insert(list, {
				UserId = player.UserId,
				Name = player.DisplayName,
				Value = data.Money,
				MPS = ses and ses.MPS or 0,
				Rebirths = data.Rebirths,
				Level = data.Level,
			})
		end
	end
	table.sort(list, function(a, b)
		return a.Value > b.Value
	end)
	for i, e in ipairs(list) do
		e.Rank = i
	end
	return list
end

local boardRows: { TextLabel } = {}
local function buildBoard()
	local board = S.MapBuilder.Map.LeaderboardBoard
	if not board then
		return
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = board
	local title = Instance.new("TextLabel")
	title.BackgroundColor3 = Color3.fromRGB(255, 190, 40)
	title.Size = UDim2.fromScale(1, 0.12)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(40, 25, 0)
	title.Text = "🏆 RICHEST PLAYERS (GLOBAL)"
	title.Parent = gui
	for i = 1, 10 do
		local row = Instance.new("TextLabel")
		row.BackgroundTransparency = i % 2 == 0 and 0.85 or 1
		row.BackgroundColor3 = Color3.new(1, 1, 1)
		row.Position = UDim2.fromScale(0.03, 0.13 + (i - 1) * 0.086)
		row.Size = UDim2.fromScale(0.94, 0.08)
		row.Font = Enum.Font.GothamBold
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = i == 1 and Color3.fromRGB(255, 215, 80) or (i == 2 and Color3.fromRGB(220, 220, 235) or (i == 3 and Color3.fromRGB(230, 150, 90) or Color3.new(1, 1, 1)))
		row.Text = ""
		row.Parent = gui
		boardRows[i] = row
	end
end

local function updateBoard()
	local list = LeaderboardService.Cache.Richest
	if #list == 0 then
		list = LeaderboardService.Cache.Server
	end
	for i, row in ipairs(boardRows) do
		local e = list[i]
		row.Text = e and ("  #%d  %s  —  %s"):format(i, e.Name, Util.Money(e.Value)) or ""
	end
end

local function broadcast(target: Player?)
	if target then
		Remotes.Leaderboard:FireClient(target, LeaderboardService.Cache)
	else
		Remotes.Leaderboard:FireAllClients(LeaderboardService.Cache)
	end
end

function LeaderboardService.Init(services)
	S = services
	local ok = pcall(function()
		stores.Richest = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
		stores.Rebirths = DataStoreService:GetOrderedDataStore(Config.RebirthBoardStoreName)
	end)
	if not ok or not S.DataService.CanSave() then
		stores = {}
	end
end

function LeaderboardService.Start()
	buildBoard()
	S.NetService.Handle("GetLeaderboard", function(player)
		LeaderboardService.Cache.Server = buildServer()
		broadcast(player)
		return true
	end)
	-- live server board every 5s
	task.spawn(function()
		while true do
			LeaderboardService.Cache.Server = buildServer()
			updateBoard()
			task.wait(5)
		end
	end)
	-- global boards
	task.spawn(function()
		task.wait(10)
		while true do
			pushScores()
			if stores.Richest then
				LeaderboardService.Cache.Richest = fetch(stores.Richest)
				LeaderboardService.Cache.Rebirths = fetch(stores.Rebirths)
			end
			updateBoard()
			broadcast()
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return LeaderboardService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- MapBuilder.lua
-- Builds the whole world procedurally at server start:
--   central treasure marketplace (stalls, fountain, shop, rebirth altar, sell
--   station, global leaderboard), 8 base slots, treasure fields, decorations,
--   border mountains, 3 secret areas and 2 special event locations.
-- Everything is generated from code so the place file needs no assets.

local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local MapBuilder = {}
MapBuilder.Map = nil

local rng = Random.new(1337)

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, props: { [string]: any }?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end
MapBuilder.Part = part

local function cyl(parent, height, diameter, cf, color, material, props)
	local p = part(parent, Vector3.new(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.rad(90)), color, material, props)
	p.Shape = Enum.PartType.Cylinder
	return p
end
MapBuilder.Cylinder = cyl

local function ball(parent, d, pos, color, material, props)
	local p = part(parent, Vector3.new(d, d, d), CFrame.new(pos), color, material, props)
	p.Shape = Enum.PartType.Ball
	return p
end

local function folder(name: string, parent: Instance)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function billboardText(adornee: BasePart, text: string, color: Color3, size: UDim2?, offset: number?)
	local bb = Instance.new("BillboardGui")
	bb.Size = size or UDim2.fromOffset(260, 60)
	bb.StudsOffset = Vector3.new(0, offset or 4, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 220
	bb.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(20, 20, 40)
	stroke.Parent = label
	label.Parent = bb
	bb.Parent = adornee
	return bb, label
end
MapBuilder.Billboard = billboardText

local function addPrompt(p: BasePart, action: string, object: string, uiName: string)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt:SetAttribute("OpenUI", uiName)
	prompt.Parent = p
	return prompt
end

-- Lighting ------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 14.2
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(90, 90, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 170)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 2200
	Lighting.FogColor = Color3.fromRGB(190, 220, 255)

	local function ensure(className: string, name: string)
		local inst = Lighting:FindFirstChild(name)
		if not inst then
			inst = Instance.new(className)
			inst.Name = name
			inst.Parent = Lighting
		end
		return inst
	end
	local atmo = ensure("Atmosphere", "Atmosphere") :: Atmosphere
	atmo.Density = 0.28
	atmo.Offset = 0.15
	atmo.Color = Color3.fromRGB(200, 225, 255)
	atmo.Decay = Color3.fromRGB(120, 150, 220)
	atmo.Glare = 0.2
	atmo.Haze = 1.2
	local cc = ensure("ColorCorrectionEffect", "GameColor") :: ColorCorrectionEffect
	cc.Saturation = 0.18
	cc.Contrast = 0.06
	cc.Brightness = 0.02
	local bloom = ensure("BloomEffect", "GameBloom") :: BloomEffect
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.6
	local rays = ensure("SunRaysEffect", "GameSunRays") :: SunRaysEffect
	rays.Intensity = 0.06
	rays.Spread = 0.8
	ensure("Sky", "GameSky")
end

-- Pieces ----------------------------------------------------------------------
local TREE_LEAF_COLORS = {
	Color3.fromRGB(80, 200, 90),
	Color3.fromRGB(60, 170, 80),
	Color3.fromRGB(255, 140, 190),
	Color3.fromRGB(255, 170, 60),
	Color3.fromRGB(150, 220, 70),
	Color3.fromRGB(170, 120, 255),
}

local function tree(parent: Instance, pos: Vector3, scale: number, leafColor: Color3?)
	local m = Instance.new("Model")
	m.Name = "Tree"
	local h = 10 * scale
	cyl(m, h, 2.2 * scale, CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(120, 80, 50), Enum.Material.Wood, { CastShadow = true })
	local c = leafColor or TREE_LEAF_COLORS[rng:NextInteger(1, #TREE_LEAF_COLORS)]
	ball(m, 9 * scale, pos + Vector3.new(0, h + 2 * scale, 0), c, Enum.Material.Grass)
	ball(m, 6 * scale, pos + Vector3.new(2.5 * scale, h + 4.5 * scale, 1 * scale), c:Lerp(Color3.new(1, 1, 1), 0.12), Enum.Material.Grass)
	m.Parent = parent
	return m
end

MapBuilder.Tree = tree
MapBuilder.Ball = ball
MapBuilder.Rng = rng

local function rock(parent, pos: Vector3, size: Vector3, color: Color3?)
	return part(parent, size, CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.3, 0.3)), color or Color3.fromRGB(130, 130, 140), Enum.Material.Slate)
end

local function zonePart(parent, name: string, size: Vector3, cf: CFrame)
	local z = part(parent, size, cf, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
		Name = name,
	})
	return z
end

-- Plaza / marketplace ---------------------------------------------------------
local function buildPlaza(root: Instance, map)
	local plaza = folder("Marketplace", root)
	cyl(plaza, 1, 150, CFrame.new(0, 0.5, 0), Color3.fromRGB(240, 232, 215), Enum.Material.Marble)
	cyl(plaza, 1.1, 100, CFrame.new(0, 0.55, 0), Color3.fromRGB(255, 210, 120), Enum.Material.Sandstone)
	cyl(plaza, 1.2, 70, CFrame.new(0, 0.6, 0), Color3.fromRGB(240, 232, 215), Enum.Material.Marble)

	-- Fountain
	local f = folder("Fountain", plaza)
	cyl(f, 3, 26, CFrame.new(0, 2, 0), Color3.fromRGB(220, 220, 230), Enum.Material.Marble)
	local water = cyl(f, 0.6, 23, CFrame.new(0, 3.4, 0), Color3.fromRGB(80, 190, 255), Enum.Material.Glass, { Transparency = 0.25, Name = "Water" })
	cyl(f, 8, 3, CFrame.new(0, 7, 0), Color3.fromRGB(220, 220, 230), Enum.Material.Marble)
	cyl(f, 1.5, 10, CFrame.new(0, 11, 0), Color3.fromRGB(220, 220, 230), Enum.Material.Marble)
	local top = ball(f, 4, Vector3.new(0, 13.5, 0), Color3.fromRGB(255, 215, 80), Enum.Material.Neon, { Name = "FountainGem" })
	local spray = Instance.new("ParticleEmitter")
	spray.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	spray.Color = ColorSequence.new(Color3.fromRGB(180, 235, 255))
	spray.Rate = 30
	spray.Speed = NumberRange.new(10, 14)
	spray.SpreadAngle = Vector2.new(25, 25)
	spray.Acceleration = Vector3.new(0, -25, 0)
	spray.Lifetime = NumberRange.new(1, 1.4)
	spray.Size = NumberSequence.new(0.5, 0.1)
	spray.LightEmission = 0.5
	spray.Parent = top
	local light = Instance.new("PointLight")
	light.Range = 24
	light.Brightness = 2
	light.Color = Color3.fromRGB(255, 220, 120)
	light.Parent = top
	map.FountainWater = water
	map.FountainGem = top

	-- Title sign
	local sign = part(plaza, Vector3.new(1, 1, 1), CFrame.new(0, 26, 0), Color3.new(1, 1, 1), nil, { Transparency = 1, CanCollide = false, CanQuery = false })
	billboardText(sign, "💎 TREASURE MARKET 💎", Color3.fromRGB(255, 220, 80), UDim2.fromOffset(520, 90), 0).MaxDistance = 600

	-- Market stalls
	local stalls = folder("Stalls", plaza)
	map.Stalls = {}
	local stallColors = {
		Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 170, 60), Color3.fromRGB(255, 230, 80),
		Color3.fromRGB(110, 220, 110), Color3.fromRGB(80, 200, 255), Color3.fromRGB(150, 120, 255),
		Color3.fromRGB(255, 120, 210), Color3.fromRGB(80, 230, 200), Color3.fromRGB(255, 140, 100),
		Color3.fromRGB(180, 230, 90),
	}
	for i = 1, Config.Market.Stalls do
		local a = (i - 1) / Config.Market.Stalls * math.pi * 2
		local pos = Vector3.new(math.cos(a) * 44, 1.2, math.sin(a) * 44)
		local cf = CFrame.lookAt(pos, Vector3.new(0, 1.2, 0))
		local m = Instance.new("Model")
		m.Name = "Stall" .. i
		local color = stallColors[(i - 1) % #stallColors + 1]
		part(m, Vector3.new(8, 3, 8), cf * CFrame.new(0, 1.5, 0), Color3.fromRGB(250, 245, 235), Enum.Material.Wood)
		part(m, Vector3.new(8.4, 0.4, 8.4), cf * CFrame.new(0, 3.1, 0), color, Enum.Material.SmoothPlastic)
		for _, o in ipairs({ Vector3.new(-4, 0, -4), Vector3.new(4, 0, -4), Vector3.new(-4, 0, 4), Vector3.new(4, 0, 4) }) do
			part(m, Vector3.new(0.6, 12, 0.6), cf * CFrame.new(o.X, 6, o.Z), Color3.fromRGB(255, 255, 255), Enum.Material.Wood)
		end
		local roof = Instance.new("WedgePart")
		roof.Anchored = true
		roof.Size = Vector3.new(10, 2.5, 5)
		roof.Color = color
		roof.Material = Enum.Material.Fabric
		roof.CFrame = cf * CFrame.new(0, 13.25, 2.5)
		roof.Parent = m
		local roof2 = roof:Clone()
		roof2.CFrame = cf * CFrame.new(0, 13.25, -2.5) * CFrame.Angles(0, math.pi, 0)
		roof2.Parent = m
		m.Parent = stalls
		table.insert(map.Stalls, { Index = i, CFrame = cf * CFrame.new(0, 3.3, 0) })
	end

	-- Buildings: shop, rebirth altar, sell station, leaderboard
	local function station(name: string, angleDeg: number, color: Color3, label: string, action: string, ui: string)
		local a = math.rad(angleDeg)
		local pos = Vector3.new(math.cos(a) * 64, 1.2, math.sin(a) * 64)
		local cf = CFrame.lookAt(pos, Vector3.new(0, 1.2, 0))
		local m = Instance.new("Model")
		m.Name = name
		part(m, Vector3.new(18, 1, 12), cf * CFrame.new(0, 0.5, 0), Color3.fromRGB(60, 60, 80), Enum.Material.Slate)
		local counter = part(m, Vector3.new(14, 4, 3), cf * CFrame.new(0, 3, -2), color, Enum.Material.SmoothPlastic, { Name = "Counter" })
		part(m, Vector3.new(14.2, 0.4, 3.2), cf * CFrame.new(0, 5.1, -2), Color3.fromRGB(255, 255, 255), Enum.Material.Marble)
		part(m, Vector3.new(18, 1, 12), cf * CFrame.new(0, 16, 0), color, Enum.Material.SmoothPlastic)
		for _, x in ipairs({ -8, 8 }) do
			part(m, Vector3.new(1.2, 15, 1.2), cf * CFrame.new(x, 8.5, 5), Color3.fromRGB(255, 255, 255), Enum.Material.Marble)
			part(m, Vector3.new(1.2, 15, 1.2), cf * CFrame.new(x, 8.5, -5), Color3.fromRGB(255, 255, 255), Enum.Material.Marble)
		end
		local glow = part(m, Vector3.new(3, 3, 3), cf * CFrame.new(0, 7, -2) * CFrame.Angles(math.rad(45), 0, math.rad(45)), color, Enum.Material.Neon, { Name = "Glow", CanCollide = false })
		local pl = Instance.new("PointLight")
		pl.Color = color
		pl.Range = 18
		pl.Brightness = 2
		pl.Parent = glow
		addPrompt(counter, action, label, ui)
		local signPart = part(m, Vector3.new(1, 1, 1), cf * CFrame.new(0, 19, 0), Color3.new(), nil, { Transparency = 1, CanCollide = false, CanQuery = false })
		billboardText(signPart, label, color:Lerp(Color3.new(1, 1, 1), 0.3), UDim2.fromOffset(300, 70), 0)
		m.Parent = plaza
		return m, cf
	end
	map.Shop = station("Shop", 22.5, Color3.fromRGB(60, 170, 255), "🛒 UPGRADE SHOP", "Open Shop", "Shop")
	map.RebirthAltar = station("RebirthAltar", 112.5, Color3.fromRGB(255, 80, 170), "🌀 REBIRTH ALTAR", "Rebirth", "Rebirth")
	map.SellStation = station("SellStation", 202.5, Color3.fromRGB(90, 220, 110), "💰 SELL TREASURES", "Sell", "Sell")

	-- Leaderboard board
	local a = math.rad(292.5)
	local pos = Vector3.new(math.cos(a) * 64, 0, math.sin(a) * 64)
	local cf = CFrame.lookAt(pos, Vector3.new(0, 0, 0))
	local lb = Instance.new("Model")
	lb.Name = "GlobalLeaderboard"
	part(lb, Vector3.new(1.5, 26, 1.5), cf * CFrame.new(-11, 13, 0), Color3.fromRGB(255, 200, 60), Enum.Material.Metal)
	part(lb, Vector3.new(1.5, 26, 1.5), cf * CFrame.new(11, 13, 0), Color3.fromRGB(255, 200, 60), Enum.Material.Metal)
	local board = part(lb, Vector3.new(21, 22, 1), cf * CFrame.new(0, 14, 0), Color3.fromRGB(25, 25, 45), Enum.Material.SmoothPlastic, { Name = "Board" })
	addPrompt(board, "View", "🏆 Leaderboard", "Leaderboard")
	lb.Parent = plaza
	map.LeaderboardBoard = board

	-- Trade booth (opens trade menu)
	map.TradeBooth = station("TradeBooth", 157.5, Color3.fromRGB(255, 200, 60), "🤝 TRADING POST", "Trade", "Trade")
	map.IndexBooth = station("IndexBooth", 337.5, Color3.fromRGB(170, 110, 255), "📖 TREASURE INDEX", "View Index", "Index")

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(0, 1.2, 24)
	spawn.Color = Color3.fromRGB(255, 220, 90)
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.4
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = plaza

	-- the plaza is built around the origin, then moved to the parade's start
	local offset = CFrame.new(Config.PlazaCenter)
	for _, d in ipairs(plaza:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = offset * d.CFrame
		end
	end
	for _, st in ipairs(map.Stalls) do
		st.CFrame = offset * st.CFrame
	end
end

-- Fields ---------------------------------------------------------------------
local FLOWER_COLORS = {
	Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 220, 60), Color3.fromRGB(140, 120, 255),
	Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 150, 60), Color3.fromRGB(90, 220, 255),
}

local function buildFields(root: Instance, map)
	local fields = folder("TreasureFields", root)
	map.Fields = {}
	local names = { "Sunny Meadow", "Golden Grove", "Crystal Clearing", "Rainbow Patch", "Mushroom Hollow", "Starlight Glade", "Coral Garden", "Lucky Lawn" }
	for i = 0, 7 do
		local col = Config.BaseColumnsX[i % 4 + 1]
		local side = i < 4 and 1 or -1
		local center = Vector3.new(col, 0, side * 190)
		local m = Instance.new("Model")
		m.Name = names[i + 1]
		local color = FLOWER_COLORS[i % #FLOWER_COLORS + 1]
		cyl(m, 0.4, 48, CFrame.new(center + Vector3.new(0, 0.2, 0)), Color3.fromRGB(120, 220, 100), Enum.Material.Grass)
		cyl(m, 0.5, 44, CFrame.new(center + Vector3.new(0, 0.25, 0)), color:Lerp(Color3.fromRGB(120, 220, 100), 0.75), Enum.Material.Grass)
		for _ = 1, 16 do
			local r = rng:NextNumber(4, 21)
			local t = rng:NextNumber(0, math.pi * 2)
			local p = center + Vector3.new(math.cos(t) * r, 0.9, math.sin(t) * r)
			ball(m, rng:NextNumber(0.8, 1.4), p, FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)], Enum.Material.SmoothPlastic, { CanCollide = false, CastShadow = false })
		end
		local signPost = part(m, Vector3.new(0.6, 6, 0.6), CFrame.new(center + Vector3.new(0, 3, 0) - (center.Unit * 24)), Color3.fromRGB(140, 100, 60), Enum.Material.Wood)
		billboardText(signPost, "✨ " .. names[i + 1], Color3.fromRGB(255, 255, 255), UDim2.fromOffset(240, 50), 4)
		m.Parent = fields
		table.insert(map.Fields, { Name = names[i + 1], Center = center, Radius = 19 })
	end
end

-- Paths ------------------------------------------------------------------------
local function buildPaths(root: Instance)
	local paths = folder("Paths", root)
	local P = Config.Parade
	-- wide stone promenades on both sides of the parade
	for _, side in ipairs({ -1, 1 }) do
		part(paths, Vector3.new(P.EndX - P.StartX + 40, 0.3, 26), CFrame.new(0, 0.15, side * 22), Color3.fromRGB(205, 190, 165), Enum.Material.Cobblestone)
		-- short paths from the promenade to every base door
		for _, x in ipairs(Config.BaseColumnsX) do
			local z0, z1 = side * 34, side * (Config.BaseRowZ - Config.BaseSize / 2)
			part(paths, Vector3.new(14, 0.3, math.abs(z1 - z0) + 2), CFrame.new(x, 0.16, (z0 + z1) / 2), Color3.fromRGB(230, 200, 150), Enum.Material.Sand)
		end
		-- lamp posts
		for x = P.StartX + 20, P.EndX - 20, 40 do
			local p = Vector3.new(x, 0, side * 12)
			part(paths, Vector3.new(0.6, 10, 0.6), CFrame.new(p + Vector3.new(0, 5, 0)), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
			local bulb = ball(paths, 1.8, p + Vector3.new(0, 10.5, 0), Color3.fromRGB(255, 230, 160), Enum.Material.Neon)
			local l = Instance.new("PointLight")
			l.Range = 18
			l.Brightness = 1.2
			l.Color = Color3.fromRGB(255, 220, 150)
			l.Parent = bulb
		end
	end
	-- road from the plaza to the parade start
	local plaza = Config.PlazaCenter
	part(paths, Vector3.new(math.abs(P.StartX - plaza.X) - 60, 0.3, 30), CFrame.new((P.StartX + plaza.X + 60) / 2, 0.15, 0), Color3.fromRGB(230, 200, 150), Enum.Material.Sand)
end

-- Treasure Parade: the red carpet that treasures walk along (buy them as they pass!)
local function buildParade(root: Instance, map)
	local CollectionService = game:GetService("CollectionService")
	local f = folder("TreasureParade", root)
	local P = Config.Parade
	local length = P.EndX - P.StartX
	local mid = (P.StartX + P.EndX) / 2
	part(f, Vector3.new(length + 8, 0.6, P.Width + 4), CFrame.new(mid, 0.3, P.Z), Color3.fromRGB(255, 200, 60), Enum.Material.Foil, { Name = "CarpetTrim" })
	local carpet = part(f, Vector3.new(length + 8, 0.7, P.Width), CFrame.new(mid, 0.35, P.Z), Color3.fromRGB(200, 30, 50), Enum.Material.Fabric, { Name = "Carpet" })
	-- flowing light along the carpet (animated Beam texture)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(-length / 2, 0.4, 0)
	a0.Parent = carpet
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(length / 2, 0.4, 0)
	a1.Parent = carpet
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = P.Width - 2
	beam.Width1 = P.Width - 2
	beam.FaceCamera = false
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Static
	beam.TextureLength = 10
	beam.TextureSpeed = P.Speed / 10
	beam.LightEmission = 0.6
	beam.Transparency = NumberSequence.new(0.55)
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120))
	beam.Parent = carpet
	-- velvet rope posts along both edges
	for x = P.StartX, P.EndX, 12 do
		for _, side in ipairs({ -1, 1 }) do
			local pos = Vector3.new(x, 0, P.Z + side * (P.Width / 2 + 2.5))
			cyl(f, 3.4, 0.5, CFrame.new(pos + Vector3.new(0, 1.7, 0)), Color3.fromRGB(255, 205, 70), Enum.Material.Foil)
			ball(f, 0.8, pos + Vector3.new(0, 3.6, 0), Color3.fromRGB(255, 220, 90), Enum.Material.Foil)
		end
	end
	-- spawn + exit arches (glowing portals)
	for _, info in ipairs({ { P.StartX - 6, Color3.fromRGB(120, 220, 255), "✨ TREASURE PARADE ✨" }, { P.EndX + 6, Color3.fromRGB(255, 120, 200), "👋 BYE BYE!" } }) do
		local x, color = info[1], info[2]
		part(f, Vector3.new(3, 22, 3), CFrame.new(x, 11, P.Z - P.Width / 2 - 3), Color3.fromRGB(250, 245, 235), Enum.Material.Marble)
		part(f, Vector3.new(3, 22, 3), CFrame.new(x, 11, P.Z + P.Width / 2 + 3), Color3.fromRGB(250, 245, 235), Enum.Material.Marble)
		part(f, Vector3.new(4, 3, P.Width + 10), CFrame.new(x, 23, P.Z), color, Enum.Material.SmoothPlastic)
		local disc = part(f, Vector3.new(0.6, 19, P.Width + 2), CFrame.new(x, 10.5, P.Z), color, Enum.Material.ForceField, { CanCollide = false, Transparency = 0.2 })
		CollectionService:AddTag(disc, "Pulse")
		local sp = Instance.new("ParticleEmitter")
		sp.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sp.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
		sp.LightEmission = 1
		sp.Rate = 30
		sp.Speed = NumberRange.new(2, 5)
		sp.SpreadAngle = Vector2.new(180, 180)
		sp.Size = NumberSequence.new(0.8, 0)
		sp.Parent = disc
		local sign = part(f, Vector3.new(1, 1, 1), CFrame.new(x, 28, P.Z), Color3.new(), nil, { Transparency = 1, CanCollide = false, CanQuery = false })
		billboardText(sign, info[3], color:Lerp(Color3.new(1, 1, 1), 0.3), UDim2.fromOffset(360, 70), 0).MaxDistance = 600
	end
	map.Parade = {
		Start = Vector3.new(P.StartX, 0.7, P.Z),
		End = Vector3.new(P.EndX, 0.7, P.Z),
	}
end

-- Decorations & border ---------------------------------------------------------------
local function isClear(pos: Vector3, map): boolean
	local flat = Vector3.new(pos.X, 0, pos.Z)
	-- plaza
	if (flat - Config.PlazaCenter).Magnitude < 100 then
		return false
	end
	-- the whole base district: parade, promenades and both base rows
	local reach = Config.BaseRowZ + Config.BaseSize / 2 + 18
	if math.abs(flat.X) < 290 and math.abs(flat.Z) < reach then
		return false
	end
	-- road from the plaza
	if flat.X < -240 and flat.X > Config.PlazaCenter.X and math.abs(flat.Z) < 25 then
		return false
	end
	for _, f in ipairs(map.Fields) do
		if (flat - f.Center).Magnitude < 30 then
			return false
		end
	end
	for _, c in ipairs(map.KeepClear or {}) do
		if (flat - c.Pos).Magnitude < c.R then
			return false
		end
	end
	return true
end

MapBuilder.IsClear = isClear

local function buildNature(root: Instance, map)
	local nature = folder("Nature", root)
	local placed = 0
	local tries = 0
	while placed < 110 and tries < 2000 do
		tries += 1
		local r = rng:NextNumber(90, 560)
		local t = rng:NextNumber(0, math.pi * 2)
		local pos = Vector3.new(math.cos(t) * r, 0, math.sin(t) * r)
		if isClear(pos, map) then
			local t = tree(nature, pos, rng:NextNumber(0.8, 1.5))
			game:GetService("CollectionService"):AddTag(t, "Tree")
			placed += 1
		end
	end
	for _ = 1, 50 do
		local r = rng:NextNumber(100, 560)
		local t = rng:NextNumber(0, math.pi * 2)
		local pos = Vector3.new(math.cos(t) * r, 0.5, math.sin(t) * r)
		if isClear(pos, map) then
			rock(nature, pos, Vector3.new(rng:NextNumber(3, 7), rng:NextNumber(2, 5), rng:NextNumber(3, 7)))
		end
	end

	-- Border mountains + invisible wall
	local border = folder("Border", root)
	for i = 0, 47 do
		local a = i / 48 * math.pi * 2
		local r = rng:NextNumber(620, 660)
		local h = rng:NextNumber(70, 150)
		local w = rng:NextNumber(90, 130)
		local p = part(border, Vector3.new(w, h, w), CFrame.new(math.cos(a) * r, h / 2 - 10, math.sin(a) * r) * CFrame.Angles(0, a, math.rad(rng:NextNumber(-8, 8))), Color3.fromRGB(110, 150, 95):Lerp(Color3.fromRGB(150, 140, 130), rng:NextNumber()), Enum.Material.Rock)
		p.CastShadow = false
		part(border, Vector3.new(w * 0.6, 8, w * 0.6), p.CFrame * CFrame.new(0, h / 2, 0), Color3.fromRGB(245, 250, 255), Enum.Material.Snow, { CastShadow = false })
	end
	for i = 0, 3 do
		local a = i * math.pi / 2
		part(border, Vector3.new(1400, 400, 4), CFrame.new(math.cos(a) * 690, 200, math.sin(a) * 690) * CFrame.Angles(0, -a + math.pi / 2, 0), Color3.new(), nil, { Transparency = 1, CastShadow = false })
	end
end

-- Secret areas ------------------------------------------------------------------
local function buildSecretCave(root: Instance, map)
	local cave = folder("SecretCave", root)
	local rockColor = Color3.fromRGB(100, 95, 110)
	local z0 = -500 -- front face
	-- hollow cliff: interior x -15..15, y 0..18, z -535..-500
	part(cave, Vector3.new(45, 60, 40), CFrame.new(-37.5, 30, z0 - 20), rockColor, Enum.Material.Rock)
	part(cave, Vector3.new(45, 60, 40), CFrame.new(37.5, 30, z0 - 20), rockColor, Enum.Material.Rock)
	part(cave, Vector3.new(30, 42, 40), CFrame.new(0, 39, z0 - 20), rockColor, Enum.Material.Rock)
	part(cave, Vector3.new(30, 18, 5), CFrame.new(0, 9, z0 - 37.5), rockColor, Enum.Material.Rock)
	part(cave, Vector3.new(30, 1, 35), CFrame.new(0, 0.5, z0 - 17.5), Color3.fromRGB(60, 50, 80), Enum.Material.Slate)
	-- waterfall curtain (walk through it!)
	local fall = part(cave, Vector3.new(32, 34, 1), CFrame.new(0, 17, z0 + 1), Color3.fromRGB(120, 200, 255), Enum.Material.Glass, {
		Transparency = 0.35,
		CanCollide = false,
		CanQuery = false,
		Name = "Waterfall",
	})
	local mist = Instance.new("ParticleEmitter")
	mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
	mist.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255))
	mist.Rate = 15
	mist.Lifetime = NumberRange.new(1.5, 2.5)
	mist.Speed = NumberRange.new(2, 5)
	mist.Size = NumberSequence.new(3, 6)
	mist.Transparency = NumberSequence.new(0.6, 1)
	mist.EmissionDirection = Enum.NormalId.Bottom
	mist.Parent = fall
	cyl(cave, 0.6, 40, CFrame.new(0, 0.3, z0 + 10), Color3.fromRGB(80, 180, 255), Enum.Material.Glass, { Transparency = 0.3, CanCollide = false })
	-- crystals inside
	local crystalColors = { Color3.fromRGB(120, 255, 240), Color3.fromRGB(200, 120, 255), Color3.fromRGB(255, 120, 200) }
	for i = 1, 14 do
		local x = rng:NextNumber(-13, 13)
		local z = rng:NextNumber(z0 - 33, z0 - 4)
		local side = (i % 2 == 0)
		local pos = side and Vector3.new(x > 0 and 14 or -14, rng:NextNumber(2, 14), z) or Vector3.new(x, 1.5, z)
		if math.abs(x) < 6 and not side then
			pos = Vector3.new(x > 0 and 10 or -10, 1.5, z)
		end
		local c = part(cave, Vector3.new(1.2, rng:NextNumber(2.5, 5), 1.2), CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6), rng:NextNumber(-0.5, 0.5)), crystalColors[i % 3 + 1], Enum.Material.Neon, { CanCollide = false })
		if i % 4 == 0 then
			local l = Instance.new("PointLight")
			l.Color = c.Color
			l.Range = 14
			l.Parent = c
		end
	end
	local zone = zonePart(cave, "CaveZone", Vector3.new(30, 18, 35), CFrame.new(0, 9, z0 - 17.5))
	table.insert(map.Secrets, {
		Name = "Crystal Cave",
		Zone = zone,
		Spawns = { Vector3.new(-6, 1, z0 - 28), Vector3.new(6, 1, z0 - 20), Vector3.new(0, 1, z0 - 12) },
	})
	table.insert(map.KeepClear, { Pos = Vector3.new(0, 0, z0 - 10), R = 60 })
end

local function buildSkyIsland(root: Instance, map)
	local sky = folder("SkyIsland", root)
	local center = Vector3.new(330, 0, 330)
	local islandY = 150
	-- parkour spiral
	local steps = 34
	for i = 1, steps do
		local t = i / steps
		local a = t * math.pi * 4
		local y = 4 + t * (islandY - 8)
		local r = 46
		local pos = center + Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
		local hue = (i / steps)
		part(sky, Vector3.new(7, 1.2, 7), CFrame.new(pos), Color3.fromHSV(hue, 0.55, 1), Enum.Material.SmoothPlastic)
	end
	-- island
	cyl(sky, 8, 80, CFrame.new(center + Vector3.new(0, islandY - 4, 0)), Color3.fromRGB(150, 120, 90), Enum.Material.Ground)
	cyl(sky, 1.5, 80, CFrame.new(center + Vector3.new(0, islandY + 0.75, 0)), Color3.fromRGB(110, 230, 110), Enum.Material.Grass)
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		tree(sky, center + Vector3.new(math.cos(a) * 28, islandY + 1.5, math.sin(a) * 28), 0.9, Color3.fromRGB(255, 180, 230))
	end
	-- rock spikes underneath
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		part(sky, Vector3.new(14, 26, 14), CFrame.new(center + Vector3.new(math.cos(a) * 18, islandY - 18, math.sin(a) * 18)) * CFrame.Angles(0, a, math.rad(180)), Color3.fromRGB(140, 110, 80), Enum.Material.Rock)
	end
	local shrine = part(sky, Vector3.new(6, 6, 6), CFrame.new(center + Vector3.new(0, islandY + 6, 0)) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Color3.fromRGB(255, 240, 150), Enum.Material.Neon, { CanCollide = false })
	local l = Instance.new("PointLight")
	l.Range = 30
	l.Brightness = 3
	l.Color = Color3.fromRGB(255, 240, 150)
	l.Parent = shrine
	local zone = zonePart(sky, "SkyZone", Vector3.new(80, 30, 80), CFrame.new(center + Vector3.new(0, islandY + 15, 0)))
	table.insert(map.Secrets, {
		Name = "Sky Island",
		Zone = zone,
		Spawns = {
			center + Vector3.new(12, islandY + 2, 0),
			center + Vector3.new(-12, islandY + 2, 6),
			center + Vector3.new(0, islandY + 2, -14),
		},
	})
	table.insert(map.KeepClear, { Pos = center, R = 60 })
end

local function buildVault(root: Instance, map)
	local vault = folder("HiddenVault", root)
	-- The entrance: a hollow tree with a glowing pad inside
	local treePos = Vector3.new(-330, 0, 330)
	local trunkColor = Color3.fromRGB(110, 75, 45)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		if i ~= 0 then -- one side open = doorway
			part(vault, Vector3.new(4, 16, 2), CFrame.new(treePos + Vector3.new(math.cos(a) * 4.5, 8, math.sin(a) * 4.5)) * CFrame.Angles(0, -a + math.pi / 2, 0), trunkColor, Enum.Material.Wood)
		end
	end
	ball(vault, 22, treePos + Vector3.new(0, 22, 0), Color3.fromRGB(70, 150, 70), Enum.Material.Grass)
	ball(vault, 14, treePos + Vector3.new(6, 28, 3), Color3.fromRGB(90, 170, 80), Enum.Material.Grass)
	local roomCenter = Vector3.new(-330, -80, 330)
	local pad = part(vault, Vector3.new(5, 0.4, 5), CFrame.new(treePos + Vector3.new(0, 0.3, 0)), Color3.fromRGB(120, 255, 160), Enum.Material.Neon, { Name = "VaultEntrance", CanCollide = false, CanTouch = true })
	pad:SetAttribute("TeleportTo", roomCenter + Vector3.new(0, 4, 10))
	-- Vault room
	local gold = Color3.fromRGB(255, 200, 60)
	part(vault, Vector3.new(50, 1, 50), CFrame.new(roomCenter), Color3.fromRGB(60, 45, 30), Enum.Material.Wood)
	part(vault, Vector3.new(50, 1, 50), CFrame.new(roomCenter + Vector3.new(0, 20, 0)), Color3.fromRGB(70, 60, 50), Enum.Material.Brick)
	for _, d in ipairs({ Vector3.new(25, 0, 0), Vector3.new(-25, 0, 0), Vector3.new(0, 0, 25), Vector3.new(0, 0, -25) }) do
		local size = (d.X ~= 0) and Vector3.new(1, 20, 50) or Vector3.new(50, 20, 1)
		part(vault, size, CFrame.new(roomCenter + d + Vector3.new(0, 10, 0)), Color3.fromRGB(80, 65, 50), Enum.Material.Brick)
	end
	for i = 1, 10 do
		local p = roomCenter + Vector3.new(rng:NextNumber(-20, 20), 1.5, rng:NextNumber(-20, -8))
		ball(vault, rng:NextNumber(2, 4), p, gold, Enum.Material.Foil, { CanCollide = false })
	end
	local torchColor = Color3.fromRGB(255, 160, 60)
	for _, x in ipairs({ -20, 20 }) do
		local t = part(vault, Vector3.new(1, 1, 1), CFrame.new(roomCenter + Vector3.new(x, 12, -24)), torchColor, Enum.Material.Neon)
		local fire = Instance.new("Fire")
		fire.Size = 4
		fire.Parent = t
		local l = Instance.new("PointLight")
		l.Range = 30
		l.Color = torchColor
		l.Brightness = 2
		l.Parent = t
	end
	local exitPad = part(vault, Vector3.new(5, 0.4, 5), CFrame.new(roomCenter + Vector3.new(0, 0.7, 20)), Color3.fromRGB(120, 200, 255), Enum.Material.Neon, { Name = "VaultExit", CanCollide = false, CanTouch = true })
	exitPad:SetAttribute("TeleportTo", treePos + Vector3.new(10, 4, 0))
	billboardText(exitPad, "⬆ EXIT", Color3.fromRGB(150, 220, 255), UDim2.fromOffset(160, 40), 3)
	local zone = zonePart(vault, "VaultZone", Vector3.new(48, 18, 48), CFrame.new(roomCenter + Vector3.new(0, 9, 0)))
	table.insert(map.Secrets, {
		Name = "Hidden Vault",
		Zone = zone,
		Spawns = { roomCenter + Vector3.new(-10, 1.5, -12), roomCenter + Vector3.new(10, 1.5, -12), roomCenter + Vector3.new(0, 1.5, -4) },
	})
	map.TeleportPads = { pad, exitPad }
	table.insert(map.KeepClear, { Pos = treePos, R = 25 })
end

-- Event locations ------------------------------------------------------------
local function buildCrater(root: Instance, map)
	local crater = folder("MeteorCrater", root)
	local center = Vector3.new(-380, 0, -300)
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		part(crater, Vector3.new(12, rng:NextNumber(5, 9), 8), CFrame.new(center + Vector3.new(math.cos(a) * 40, 2, math.sin(a) * 40)) * CFrame.Angles(0, -a, math.rad(-20)), Color3.fromRGB(70, 60, 60), Enum.Material.Basalt)
	end
	cyl(crater, 0.6, 76, CFrame.new(center + Vector3.new(0, 0.3, 0)), Color3.fromRGB(60, 50, 50), Enum.Material.Basalt)
	cyl(crater, 0.7, 16, CFrame.new(center + Vector3.new(0, 0.35, 0)), Color3.fromRGB(255, 90, 20), Enum.Material.CrackedLava, { Name = "LavaCore" })
	local sign = part(crater, Vector3.new(1, 1, 1), CFrame.new(center + Vector3.new(0, 18, 0)), Color3.new(), nil, { Transparency = 1, CanCollide = false, CanQuery = false })
	billboardText(sign, "☄️ METEOR CRATER", Color3.fromRGB(255, 140, 60), UDim2.fromOffset(320, 70), 0).MaxDistance = 500
	map.Crater = { Center = center, Radius = 30 }
	table.insert(map.KeepClear, { Pos = center, R = 60 })
end

local function buildShrine(root: Instance, map)
	local shrine = folder("CelestialShrine", root)
	local center = Vector3.new(380, 0, -320)
	local y = 0
	for i = 0, 5 do
		local w = 60 - i * 9
		part(shrine, Vector3.new(w, 5, w), CFrame.new(center + Vector3.new(0, y + 2.5, 0)), (i % 2 == 0) and Color3.fromRGB(240, 235, 220) or Color3.fromRGB(255, 215, 120), Enum.Material.Marble)
		y += 5
	end
	-- stairs on the front (facing map centre)
	local toCenter = (-center).Unit
	for i = 0, 29 do
		local p = center + toCenter * (32 - i * 0.9) + Vector3.new(0, i + 0.5, 0)
		part(shrine, Vector3.new(10, 1, 1.6), CFrame.lookAt(p, p + toCenter), Color3.fromRGB(250, 245, 235), Enum.Material.Marble)
	end
	local altar = part(shrine, Vector3.new(8, 2, 8), CFrame.new(center + Vector3.new(0, y + 1, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.Marble)
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		local pillar = part(shrine, Vector3.new(1.5, 12, 1.5), CFrame.new(center + Vector3.new(math.cos(a) * 7, y + 6, math.sin(a) * 7)), Color3.fromRGB(255, 230, 150), Enum.Material.Marble)
		ball(shrine, 2, pillar.Position + Vector3.new(0, 7, 0), Color3.fromRGB(255, 250, 200), Enum.Material.Neon)
	end
	local sign = part(shrine, Vector3.new(1, 1, 1), CFrame.new(center + Vector3.new(0, y + 20, 0)), Color3.new(), nil, { Transparency = 1, CanCollide = false, CanQuery = false })
	billboardText(sign, "🌟 CELESTIAL SHRINE", Color3.fromRGB(255, 240, 160), UDim2.fromOffset(340, 70), 0).MaxDistance = 500
	map.ShrineAltar = altar.CFrame * CFrame.new(0, 1, 0)
	table.insert(map.KeepClear, { Pos = center, R = 60 })
end

function MapBuilder.Build()
	local root = workspace:FindFirstChild("Map")
	if root then
		root:Destroy()
	end
	root = folder("Map", workspace)
	setupLighting()

	local map = {
		Root = root,
		Secrets = {},
		KeepClear = {},
	}

	-- Ground: real smooth terrain grass (animated grass blades with GlobalWind)
	local terrain = workspace.Terrain
	terrain:Clear()
	terrain:FillBlock(CFrame.new(0, -4, 0), Vector3.new(1400, 8, 1400), Enum.Material.Grass)
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(105, 200, 90))
	terrain:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(240, 220, 160))
	pcall(function()
		terrain.Decoration = true
	end)
	terrain.WaterColor = Color3.fromRGB(40, 170, 220)
	terrain.WaterWaveSize = 0.3
	terrain.WaterWaveSpeed = 12
	terrain.WaterReflectance = 0.6
	terrain.WaterTransparency = 0.5
	workspace.GlobalWind = Vector3.new(8, 0, 4)
	-- Kill floor far below for anyone who glitches out
	part(root, Vector3.new(2000, 2, 2000), CFrame.new(0, -200, 0), Color3.new(), nil, { Name = "KillFloor", Transparency = 1, CanCollide = false, CanTouch = true })

	buildPlaza(root, map)
	buildFields(root, map)
	buildPaths(root)
	buildParade(root, map)
	buildSecretCave(root, map)
	buildSkyIsland(root, map)
	buildVault(root, map)
	buildCrater(root, map)
	buildShrine(root, map)
	local Details = require(script.Parent.MapDetails)
	Details.BuildBefore(root, map, MapBuilder)
	buildNature(root, map)
	Details.BuildAfter(root, map, MapBuilder)

	-- Base slot transforms (BaseService builds the bases themselves)
	map.BaseSlots = {}
	for i = 1, Config.MaxBases do
		local col = Config.BaseColumnsX[(i - 1) % 4 + 1]
		local side = i <= 4 and 1 or -1
		local pos = Vector3.new(col, 0, side * Config.BaseRowZ)
		-- each base's door faces the parade
		map.BaseSlots[i] = CFrame.lookAt(pos, Vector3.new(col, 0, 0))
	end

	MapBuilder.Map = map
	return map
end

function MapBuilder.Init()
	MapBuilder.Build()
end

function MapBuilder.Start()
	local map = MapBuilder.Map
	-- Teleport pads (hidden vault)
	for _, pad in ipairs(map.TeleportPads) do
		local debounce = {}
		pad.Touched:Connect(function(hit)
			local char = hit.Parent
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hum or not hrp then
				return
			end
			if debounce[char] and os.clock() - debounce[char] < 2 then
				return
			end
			debounce[char] = os.clock()
			local target = pad:GetAttribute("TeleportTo")
			if typeof(target) == "Vector3" then
				(hrp :: BasePart).CFrame = CFrame.new(target)
			end
		end)
	end
	-- Kill floor
	local kill = map.Root:FindFirstChild("KillFloor")
	if kill then
		kill.Touched:Connect(function(hit)
			local hum = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.Health = 0
			end
		end)
	end
end

return MapBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">MapDetails</string><ProtectedString name="Source"><![CDATA[-- MapDetails.lua
-- Extra world detail built on top of MapBuilder: terrain lake with a dock and
-- lighthouse, rolling hills, pine forests, windmill farm, pet & gem shops,
-- animated portals, market flags, chest spawn spots and CollectionService
-- tags that the client animates (Spin, Bob, Pulse, Flag, Lamp, Tree).

local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PLAZA = Config.PlazaCenter

local MapDetails = {}

local function tag(inst: Instance, name: string, attrs: { [string]: any }?)
	CollectionService:AddTag(inst, name)
	if attrs then
		for k, v in pairs(attrs) do
			inst:SetAttribute(k, v)
		end
	end
	return inst
end
MapDetails.Tag = tag

local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Lake -----------------------------------------------------------------------
local LAKE = Vector3.new(450, 0, 40)
local function buildLake(root, map, M)
	local terrain = workspace.Terrain
	local lake = folder("Lake", root)
	terrain:FillCylinder(CFrame.new(LAKE + Vector3.new(0, -4, 0)), 8, 64, Enum.Material.Sand)
	terrain:FillCylinder(CFrame.new(LAKE + Vector3.new(0, -5.5, 0)), 10, 55, Enum.Material.Water)
	terrain:FillCylinder(CFrame.new(LAKE + Vector3.new(0, 1, 0)), 3, 55, Enum.Material.Air)
	-- small island with a palm
	terrain:FillBall(LAKE + Vector3.new(15, -4, 10), 9, Enum.Material.Sand)
	M.Tree(lake, LAKE + Vector3.new(15, 4, 10), 0.8, Color3.fromRGB(70, 190, 80))
	-- dock
	local wood = Color3.fromRGB(150, 105, 65)
	local dockStart = LAKE + Vector3.new(-62, 0.6, 0)
	M.Part(lake, Vector3.new(26, 0.6, 7), CFrame.new(dockStart + Vector3.new(13, 0, 0)), wood, Enum.Material.WoodPlanks)
	for i = 0, 3 do
		M.Part(lake, Vector3.new(0.8, 4, 0.8), CFrame.new(dockStart + Vector3.new(i * 8, -1.8, 3.2)), wood, Enum.Material.Wood)
		M.Part(lake, Vector3.new(0.8, 4, 0.8), CFrame.new(dockStart + Vector3.new(i * 8, -1.8, -3.2)), wood, Enum.Material.Wood)
	end
	-- lighthouse on the far shore
	local lh = LAKE + Vector3.new(58, 0, -24)
	for i = 0, 5 do
		M.Cylinder(lake, 5, 10 - i * 0.8, CFrame.new(lh + Vector3.new(0, 2.5 + i * 5, 0)), (i % 2 == 0) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(230, 60, 60), Enum.Material.SmoothPlastic)
	end
	M.Cylinder(lake, 4, 5.5, CFrame.new(lh + Vector3.new(0, 32, 0)), Color3.fromRGB(255, 240, 160), Enum.Material.Glass, { Transparency = 0.3 })
	local lamp = M.Part(lake, Vector3.new(1.5, 1.5, 6), CFrame.new(lh + Vector3.new(0, 32, 0)), Color3.fromRGB(255, 250, 200), Enum.Material.Neon, { CanCollide = false, Name = "LighthouseLamp" })
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Front
	spot.Range = 60
	spot.Angle = 35
	spot.Brightness = 6
	spot.Color = Color3.fromRGB(255, 245, 200)
	spot.Parent = lamp
	tag(lamp, "Spin", { SpinSpeed = 0.9 })
	tag(lamp, "Lamp")
	M.Cylinder(lake, 1, 7, CFrame.new(lh + Vector3.new(0, 34.5, 0)), Color3.fromRGB(230, 60, 60), Enum.Material.SmoothPlastic)
	table.insert(map.KeepClear, { Pos = LAKE, R = 80 })
	table.insert(map.ChestSpots, LAKE + Vector3.new(-70, 0.5, 18))
end

-- Hills ------------------------------------------------------------------------
local function buildHills(map, M)
	local terrain = workspace.Terrain
	local rng = M.Rng
	local placed = 0
	for _ = 1, 200 do
		if placed >= 14 then
			break
		end
		local r = rng:NextNumber(320, 560)
		local a = rng:NextNumber(0, math.pi * 2)
		local pos = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		if M.IsClear(pos, map) then
			local radius = rng:NextNumber(18, 34)
			terrain:FillBall(pos - Vector3.new(0, radius * 0.6, 0), radius, Enum.Material.Grass)
			table.insert(map.KeepClear, { Pos = pos, R = radius + 6 })
			placed += 1
		end
	end
end

-- Buildings ------------------------------------------------------------------------
local function shopBuilding(root, M, angleDeg: number, name: string, label: string, color: Color3, ui: string, action: string)
	local a = math.rad(angleDeg)
	local pos = PLAZA + Vector3.new(math.cos(a) * 64, 1.2, math.sin(a) * 64)
	local cf = CFrame.lookAt(pos, PLAZA + Vector3.new(0, 1.2, 0))
	local m = Instance.new("Model")
	m.Name = name
	local white = Color3.fromRGB(250, 248, 240)
	M.Part(m, Vector3.new(20, 1, 16), cf * CFrame.new(0, 0, 0), Color3.fromRGB(70, 70, 90), Enum.Material.Slate)
	M.Part(m, Vector3.new(18, 12, 1), cf * CFrame.new(0, 6.5, 7), white, Enum.Material.SmoothPlastic)
	M.Part(m, Vector3.new(1, 12, 14), cf * CFrame.new(-8.5, 6.5, 0), white, Enum.Material.SmoothPlastic)
	M.Part(m, Vector3.new(1, 12, 14), cf * CFrame.new(8.5, 6.5, 0), white, Enum.Material.SmoothPlastic)
	-- striped awning roof
	for i = 0, 5 do
		local w = Instance.new("WedgePart")
		w.Anchored = true
		w.Size = Vector3.new(3, 3, 16)
		w.Color = (i % 2 == 0) and color or white
		w.Material = Enum.Material.Fabric
		w.CFrame = cf * CFrame.new(-7.5 + i * 3, 14, 0) * CFrame.Angles(0, math.rad(90), 0)
		w.Parent = m
	end
	M.Part(m, Vector3.new(19, 1, 16), cf * CFrame.new(0, 12.5, 0), color, Enum.Material.SmoothPlastic)
	local counter = M.Part(m, Vector3.new(14, 3.5, 3), cf * CFrame.new(0, 2.25, -4), color, Enum.Material.Wood, { Name = "Counter" })
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = label
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("OpenUI", ui)
	prompt.Parent = counter
	-- display eggs / gems on shelves (they bob)
	for i = -1, 1 do
		local item = M.Ball(m, 2.2, (cf * CFrame.new(i * 4.5, 6, 4)).Position, color:Lerp(Color3.new(1, 1, 1), 0.3), Enum.Material.Neon, { CanCollide = false })
		tag(item, "Bob", { BobHeight = 0.6, BobSpeed = 1.5 + i * 0.3 })
		tag(item, "Spin", { SpinSpeed = 0.8 })
	end
	local signPart = M.Part(m, Vector3.new(1, 1, 1), cf * CFrame.new(0, 18, 0), Color3.new(), nil, { Transparency = 1, CanCollide = false, CanQuery = false })
	M.Billboard(signPart, label, color:Lerp(Color3.new(1, 1, 1), 0.3), UDim2.fromOffset(300, 70), 0)
	m.Parent = root
	return m
end

local function windmill(root, M, pos: Vector3, color: Color3)
	local m = Instance.new("Model")
	m.Name = "Windmill"
	for i = 0, 4 do
		M.Cylinder(m, 5, 9 - i, CFrame.new(pos + Vector3.new(0, 2.5 + i * 5, 0)), Color3.fromRGB(245, 240, 225), Enum.Material.Brick)
	end
	local roof = M.Part(m, Vector3.new(6, 4, 6), CFrame.new(pos + Vector3.new(0, 27, 0)) * CFrame.Angles(0, math.rad(45), 0), color, Enum.Material.Slate)
	roof.Name = "Roof"
	local toCenter = (-pos).Unit
	local hub = CFrame.lookAt(pos + Vector3.new(0, 24, 0) + toCenter * 3.5, pos + Vector3.new(0, 24, 0) + toCenter * 10)
	local blades = Instance.new("Model")
	blades.Name = "Blades"
	local hubPart = M.Part(blades, Vector3.new(1.6, 1.6, 1.6), hub, Color3.fromRGB(90, 70, 50), Enum.Material.Wood)
	for i = 0, 3 do
		local b = M.Part(blades, Vector3.new(1.8, 11, 0.3), hub * CFrame.Angles(0, 0, i * math.pi / 2) * CFrame.new(0, 6, 0), Color3.fromRGB(255, 255, 255), Enum.Material.Fabric)
		b.CanCollide = false
	end
	blades.PrimaryPart = hubPart
	blades.Parent = m
	tag(blades, "Spin", { SpinSpeed = 1.2, SpinAxis = "Z" })
	m.Parent = root
	-- crop rows
	for r = 0, 4 do
		local rowPos = pos + toCenter * 14 + Vector3.new(-toCenter.Z, 0, toCenter.X) * (r - 2) * 4
		local crop = M.Part(root, Vector3.new(2, 1.2, 18), CFrame.lookAt(rowPos + Vector3.new(0, 0.6, 0), rowPos + toCenter * 10 + Vector3.new(0, 0.6, 0)), (r % 2 == 0) and Color3.fromRGB(240, 200, 60) or Color3.fromRGB(120, 200, 70), Enum.Material.Grass, { CanCollide = false })
		tag(crop, "Flag", { SwayAmount = 0.04 })
	end
end

-- Portals --------------------------------------------------------------------
local function portal(root, M, cf: CFrame, color: Color3, label: string, target: Vector3, requires: string?)
	local m = Instance.new("Model")
	m.Name = "Portal"
	M.Part(m, Vector3.new(16, 1, 6), cf * CFrame.new(0, 0.5, 0), Color3.fromRGB(60, 55, 80), Enum.Material.Slate)
	local ring = Instance.new("Model")
	ring.Name = "Ring"
	local center = cf * CFrame.new(0, 8, 0)
	local segs = 16
	local hub = M.Part(ring, Vector3.new(1, 1, 1), center, color, Enum.Material.Neon, { Transparency = 1, CanCollide = false })
	for i = 0, segs - 1 do
		local a = i / segs * math.pi * 2
		local seg = M.Part(ring, Vector3.new(2.4, 1.2, 1.2), center * CFrame.Angles(0, 0, a) * CFrame.new(0, 6.5, 0), (i % 2 == 0) and color or color:Lerp(Color3.new(1, 1, 1), 0.5), Enum.Material.Neon)
		seg.CanCollide = true
	end
	ring.PrimaryPart = hub
	ring.Parent = m
	tag(ring, "Spin", { SpinSpeed = 0.6, SpinAxis = "Z" })
	local disc = M.Part(m, Vector3.new(0.4, 12, 12), center * CFrame.Angles(0, math.rad(90), 0), color, Enum.Material.ForceField, {
		Name = "PortalDisc",
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
		CanTouch = true,
		Transparency = 0.15,
	})
	disc:SetAttribute("PortalTo", target)
	if requires then
		disc:SetAttribute("RequiresSecret", requires)
	end
	tag(disc, "Pulse", { PulseSpeed = 2 })
	tag(disc, "Portal")
	local swirl = Instance.new("ParticleEmitter")
	swirl.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	swirl.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	swirl.LightEmission = 1
	swirl.Rate = 25
	swirl.Lifetime = NumberRange.new(1, 1.6)
	swirl.Speed = NumberRange.new(1, 3)
	swirl.RotSpeed = NumberRange.new(-200, 200)
	swirl.SpreadAngle = Vector2.new(180, 180)
	swirl.Size = NumberSequence.new(0.6, 0)
	swirl.Parent = disc
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 20
	light.Brightness = 2
	light.Parent = disc
	local signPart = M.Part(m, Vector3.new(1, 1, 1), cf * CFrame.new(0, 17, 0), Color3.new(), nil, { Transparency = 1, CanCollide = false, CanQuery = false })
	M.Billboard(signPart, label, color:Lerp(Color3.new(1, 1, 1), 0.4), UDim2.fromOffset(260, 50), 0)
	m.Parent = root
	return disc
end

local function buildPortals(root, map, M)
	local portals = folder("Portals", root)
	local function plazaCF(angleDeg)
		local a = math.rad(angleDeg)
		local pos = PLAZA + Vector3.new(math.cos(a) * 96, 0, math.sin(a) * 96)
		return CFrame.lookAt(pos, PLAZA), pos
	end
	local home = PLAZA + Vector3.new(0, 4, 30)
	local sky = Vector3.new(330, 156, 330)
	local crater = map.Crater.Center + (-map.Crater.Center).Unit * 50 + Vector3.new(0, 4, 0)
	local shrine = Vector3.new(380, 0, -320) + (-Vector3.new(380, 0, -320)).Unit * 42 + Vector3.new(0, 4, 0)
	local cf1, p1 = plazaCF(67.5)
	portal(portals, M, cf1, Color3.fromRGB(120, 220, 255), "🌀 Sky Island (discover it first!)", sky, "Sky Island")
	local cf2, p2 = plazaCF(157.5 + 22.5 / 2)
	portal(portals, M, cf2, Color3.fromRGB(255, 110, 50), "☄️ Meteor Crater", crater)
	local cf3, p3 = plazaCF(337.5 - 22.5 / 2)
	portal(portals, M, cf3, Color3.fromRGB(255, 230, 120), "🌟 Celestial Shrine", shrine)
	-- return portals
	local function back(pos: Vector3, color)
		local cf = CFrame.lookAt(pos, pos + (Vector3.new(0, pos.Y, 0) - pos))
		portal(portals, M, cf, color, "🏠 Back to Market", home)
	end
	back(Vector3.new(330, 151.5, 330) + Vector3.new(-22, 0, -22), Color3.fromRGB(120, 220, 255))
	back(map.Crater.Center + (-map.Crater.Center).Unit * 62, Color3.fromRGB(255, 110, 50))
	back(Vector3.new(380, 0, -320) + (-Vector3.new(380, 0, -320)).Unit * 55 + Vector3.new(12, 0, 12), Color3.fromRGB(255, 230, 120))
	for _, p in ipairs({ p1, p2, p3 }) do
		table.insert(map.KeepClear, { Pos = p, R = 14 })
	end
end

-- Pine forests ----------------------------------------------------------------
local function pine(parent, M, pos: Vector3, scale: number)
	local m = Instance.new("Model")
	m.Name = "Tree"
	M.Cylinder(m, 6 * scale, 1.6 * scale, CFrame.new(pos + Vector3.new(0, 3 * scale, 0)), Color3.fromRGB(110, 75, 45), Enum.Material.Wood)
	local green = Color3.fromRGB(40, 130, 70):Lerp(Color3.fromRGB(70, 170, 90), M.Rng:NextNumber())
	for i = 0, 2 do
		local w = (9 - i * 2.5) * scale
		M.Cylinder(m, 3 * scale, w, CFrame.new(pos + Vector3.new(0, (6 + i * 3.2) * scale, 0)), green, Enum.Material.Grass)
	end
	M.Ball(m, 2 * scale, pos + Vector3.new(0, 15.2 * scale, 0), green, Enum.Material.Grass)
	m.Parent = parent
	tag(m, "Tree")
	return m
end

local FORESTS = {
	{ Name = "Whispering Woods", Center = Vector3.new(-520, 0, -200), R = 75 },
	{ Name = "Pinecrest Forest", Center = Vector3.new(100, 0, 480), R = 70 },
	{ Name = "Shadow Grove", Center = Vector3.new(-200, 0, -450), R = 65 },
}

local function buildForests(root, map, M)
	local f = folder("Forests", root)
	local rng = M.Rng
	for _, forest in ipairs(FORESTS) do
		local placed = 0
		for _ = 1, 260 do
			if placed >= 38 then
				break
			end
			local r = math.sqrt(rng:NextNumber()) * forest.R
			local a = rng:NextNumber(0, math.pi * 2)
			local pos = forest.Center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			if M.IsClear(pos, map) then
				if rng:NextNumber() < 0.65 then
					pine(f, M, pos, rng:NextNumber(0.9, 1.6))
				else
					tag(M.Tree(f, pos, rng:NextNumber(0.9, 1.4)), "Tree")
				end
				placed += 1
			end
		end
		-- glowing mushrooms
		for _ = 1, 10 do
			local r = rng:NextNumber(0, forest.R)
			local a = rng:NextNumber(0, math.pi * 2)
			local pos = forest.Center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			M.Cylinder(f, 1.2, 0.5, CFrame.new(pos + Vector3.new(0, 0.6, 0)), Color3.fromRGB(240, 235, 220), Enum.Material.SmoothPlastic, { CanCollide = false })
			local cap = M.Ball(f, 1.6, pos + Vector3.new(0, 1.3, 0), Color3.fromHSV(rng:NextNumber(), 0.6, 1), Enum.Material.Neon, { CanCollide = false })
			tag(cap, "Pulse", { PulseSpeed = rng:NextNumber(0.6, 1.4) })
		end
		local sign = M.Part(f, Vector3.new(0.6, 6, 0.6), CFrame.new(forest.Center + (-forest.Center).Unit * (forest.R + 4) + Vector3.new(0, 3, 0)), Color3.fromRGB(140, 100, 60), Enum.Material.Wood)
		M.Billboard(sign, "🌲 " .. forest.Name, Color3.fromRGB(200, 255, 200), UDim2.fromOffset(240, 50), 4)
		for _ = 1, 3 do
			local a = rng:NextNumber(0, math.pi * 2)
			table.insert(map.ChestSpots, forest.Center + Vector3.new(math.cos(a), 0, math.sin(a)) * rng:NextNumber(10, forest.R * 0.8) + Vector3.new(0, 0.5, 0))
		end
	end
end

-- Market flags & tagging existing objects -------------------------------------
local function decorate(root, map, M)
	local plaza = root:FindFirstChild("Marketplace")
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2 + 0.13
		local pos = PLAZA + Vector3.new(math.cos(a) * 74, 0, math.sin(a) * 74)
		M.Part(plaza, Vector3.new(0.5, 16, 0.5), CFrame.new(pos + Vector3.new(0, 8, 0)), Color3.fromRGB(240, 240, 240), Enum.Material.Metal)
		local flag = M.Part(plaza, Vector3.new(0.15, 3, 5), CFrame.new(pos + Vector3.new(0, 14.5, 2.6)), Color3.fromHSV(i / 12, 0.7, 1), Enum.Material.Fabric, { CanCollide = false })
		tag(flag, "Flag", { SwayAmount = 0.25 })
	end
	if map.FountainGem then
		tag(map.FountainGem, "Spin", { SpinSpeed = 1 })
		tag(map.FountainGem, "Bob", { BobHeight = 0.8, BobSpeed = 1 })
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Name == "Glow" then
				tag(d, "Spin", { SpinSpeed = 1.5 })
			elseif d.Parent and d.Parent.Name == "Paths" and d.Material == Enum.Material.Neon then
				tag(d, "Lamp")
			elseif d.Parent and d.Parent.Name == "SecretCave" and d.Material == Enum.Material.Neon then
				tag(d, "Pulse", { PulseSpeed = 1 })
			elseif d.Name == "Waterfall" then
				local a0 = Instance.new("Attachment")
				a0.Position = Vector3.new(0, d.Size.Y / 2, 0)
				a0.Parent = d
				local a1 = Instance.new("Attachment")
				a1.Position = Vector3.new(0, -d.Size.Y / 2, 0)
				a1.Parent = d
				local beam = Instance.new("Beam")
				beam.Attachment0 = a0
				beam.Attachment1 = a1
				beam.Width0 = d.Size.X
				beam.Width1 = d.Size.X
				beam.Texture = "rbxasset://textures/particles/smoke_main.dds"
				beam.TextureSpeed = 2.5
				beam.TextureLength = 6
				beam.Color = ColorSequence.new(Color3.fromRGB(200, 235, 255))
				beam.Transparency = NumberSequence.new(0.4)
				beam.LightEmission = 0.4
				beam.Parent = d
			end
		end
	end
	-- Clouds that drift with GlobalWind
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.7
	clouds.Color = Color3.fromRGB(255, 255, 255)
	clouds.Parent = workspace.Terrain
end

function MapDetails.BuildBefore(root, map, M)
	map.ChestSpots = map.ChestSpots or {}
	for _, f in ipairs(map.Fields) do
		table.insert(map.ChestSpots, f.Center + (f.Center.Unit * 24) + Vector3.new(0, 0.5, 0))
	end
	for _, secret in ipairs(map.Secrets) do
		table.insert(map.ChestSpots, secret.Spawns[1] + Vector3.new(3, 0, 3))
	end
	buildLake(root, map, M)
	buildHills(map, M)
	shopBuilding(root:FindFirstChild("Marketplace"), M, 67.5, "PetShop", "🐾 PET EGGS", Color3.fromRGB(255, 150, 80), "Pets", "Hatch Eggs")
	shopBuilding(root:FindFirstChild("Marketplace"), M, 247.5, "GemShop", "💎 GEM SHOP", Color3.fromRGB(80, 200, 255), "GemShop", "Open Gem Shop")
	windmill(root, M, Vector3.new(-430, 0, 160), Color3.fromRGB(200, 70, 60))
	windmill(root, M, Vector3.new(250, 0, -470), Color3.fromRGB(70, 110, 200))
	table.insert(map.KeepClear, { Pos = Vector3.new(-430, 0, 160), R = 34 })
	table.insert(map.KeepClear, { Pos = Vector3.new(250, 0, -470), R = 34 })
	buildPortals(root, map, M)
	for _, forest in ipairs(FORESTS) do
		-- reserve forest areas so random trees don't crowd them; forests add their own
		table.insert(map.KeepClear, { Pos = forest.Center, R = forest.R * 0.4 })
	end
end

function MapDetails.BuildAfter(root, map, M)
	-- forests ignore their own reservations
	local reserved = {}
	for i = #map.KeepClear, 1, -1 do
		for _, forest in ipairs(FORESTS) do
			if map.KeepClear[i].Pos == forest.Center then
				table.insert(reserved, table.remove(map.KeepClear, i))
				break
			end
		end
	end
	buildForests(root, map, M)
	decorate(root, map, M)
end

return MapDetails
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">NetService</string><ProtectedString name="Source"><![CDATA[-- NetService.lua
-- Single entry point for all client requests. Every request is rate limited,
-- type checked by its handler and wrapped in pcall so a bad request can never
-- break the server. Handlers return (ok: boolean, message: string?, extra: any?).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local NetService = {}
NetService.Handlers = {} :: { [string]: (Player, ...any) -> (boolean, string?, any?) }

local buckets: { [Player]: { Start: number, Count: number } } = {}

local function allowed(player: Player): boolean
	local now = os.clock()
	local b = buckets[player]
	if not b or now - b.Start > Config.RateLimit.Window then
		buckets[player] = { Start = now, Count = 1 }
		return true
	end
	b.Count += 1
	return b.Count <= Config.RateLimit.MaxRequests
end

function NetService.Handle(action: string, fn)
	assert(NetService.Handlers[action] == nil, "Duplicate handler " .. action)
	NetService.Handlers[action] = fn
end

function NetService.Notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function NetService.Init() end

function NetService.Start()
	Remotes.Action.OnServerInvoke = function(player: Player, action: any, ...)
		if typeof(action) ~= "string" then
			return { ok = false, msg = "Bad request" }
		end
		if not allowed(player) then
			return { ok = false, msg = "Slow down!" }
		end
		local handler = NetService.Handlers[action]
		if not handler then
			return { ok = false, msg = "Unknown action" }
		end
		local success, ok, msg, extra = pcall(handler, player, ...)
		if not success then
			warn(("[Net] %s failed for %s: %s"):format(action, player.Name, tostring(ok)))
			return { ok = false, msg = "Something went wrong" }
		end
		return { ok = ok == true, msg = msg, data = extra }
	end
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		buckets[p] = nil
	end)
end

return NetService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">PetService</string><ProtectedString name="Source"><![CDATA[-- PetService.lua
-- Pets: hatching eggs (server-side rolls with luck), equipping, deleting and
-- applying pet bonuses (income, luck, speed, gems). Equipped pets are
-- published as a player attribute; every client renders and animates the
-- followers locally, so pets cost no network traffic while moving.

local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PetData = require(Shared.PetData)
local UpgradeData = require(Shared.UpgradeData)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local PetService = {}

local rng = Random.new()

local function count(t): number
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

local function equippedList(data): { string }
	local list = {}
	for uid, pet in pairs(data.Pets) do
		if pet.Equipped then
			table.insert(list, uid)
		end
	end
	table.sort(list)
	return list
end

-- Recomputes bonuses and publishes the equipped pets for client rendering.
function PetService.Refresh(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return
	end
	local bonus = { Money = 0, Luck = 0, Speed = 0, Gems = 0 }
	local ids = {}
	local slots = UpgradeData.PetSlots(data)
	local equipped = equippedList(data)
	for i, uid in ipairs(equipped) do
		local pet = data.Pets[uid]
		local def = PetData.Get(pet.Id)
		if i > slots or not def then
			pet.Equipped = false
		else
			bonus[def.BonusType] += def.Bonus
			table.insert(ids, def.Id)
		end
	end
	session.PetBonus = bonus
	player:SetAttribute("Pets", HttpService:JSONEncode(ids))
	S.PlayerService.ApplyMovement(player)
	S.StateService.MarkFull(player)
end

function PetService.Hatch(player: Player, eggKey)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session or typeof(eggKey) ~= "string" then
		return false, "Bad request"
	end
	local egg = PetData.Eggs[eggKey]
	if not egg then
		return false, "Unknown egg"
	end
	if count(data.Pets) >= Config.Pets.MaxOwned then
		return false, "Your pet inventory is full! Delete some pets."
	end
	if egg.Currency == "Gems" then
		if data.Gems < egg.Cost then
			return false, ("Need %d more 💎"):format(egg.Cost - data.Gems)
		end
		data.Gems -= egg.Cost
	else
		if data.Money < egg.Cost then
			return false, ("Need %s more"):format(Util.Money(egg.Cost - data.Money))
		end
		data.Money -= egg.Cost
	end
	local def = PetData.Roll(eggKey, S.EconomyService.Luck(player), rng)
	local uid = Util.NewUid()
	while data.Pets[uid] do
		uid = Util.NewUid()
	end
	data.Pets[uid] = { Id = def.Id, Equipped = false }
	data.Stats.Hatched = (data.Stats.Hatched or 0) + 1
	-- auto-equip into a free slot
	if #equippedList(data) < UpgradeData.PetSlots(data) then
		data.Pets[uid].Equipped = true
	end
	PetService.Refresh(player)
	S.StateService.PushStats(player)
	if Rarities.Rank(def.Rarity) >= 6 then
		Remotes.Announce:FireAllClients(("🥚 %s hatched a %s %s!"):format(player.DisplayName, def.Rarity, def.Name), def.Rarity)
	end
	return true, nil, { PetId = def.Id, Uid = uid }
end

function PetService.SetEquipped(player: Player, uid, equip)
	local data = S.DataService.Get(player)
	if not data or typeof(uid) ~= "string" or not data.Pets[uid] then
		return false, "Unknown pet"
	end
	local session = S.DataService.Session(player)
	if session and session.Trade and table.find(session.Trade.MyPets or {}, uid) then
		return false, "That pet is in a trade"
	end
	if equip == true and not data.Pets[uid].Equipped then
		if #equippedList(data) >= UpgradeData.PetSlots(data) then
			return false, ("All %d pet slots are full"):format(UpgradeData.PetSlots(data))
		end
	end
	data.Pets[uid].Equipped = equip == true
	PetService.Refresh(player)
	return true
end

function PetService.EquipBest(player: Player)
	local data = S.DataService.Get(player)
	if not data then
		return false
	end
	local list = {}
	for uid, pet in pairs(data.Pets) do
		pet.Equipped = false
		local def = PetData.Get(pet.Id)
		if def then
			local score = def.BonusType == "Speed" and def.Bonus * 0.02 or def.Bonus
			if def.BonusType == "Money" then
				score *= 1.5
			end
			table.insert(list, { uid, score })
		end
	end
	table.sort(list, function(a, b)
		return a[2] > b[2]
	end)
	local session = S.DataService.Session(player)
	local inTrade = session and session.Trade and session.Trade.MyPets or {}
	local n = 0
	for _, e in ipairs(list) do
		if n >= UpgradeData.PetSlots(data) then
			break
		end
		if not table.find(inTrade, e[1]) then
			data.Pets[e[1]].Equipped = true
			n += 1
		end
	end
	PetService.Refresh(player)
	return true, "Equipped your best pets!"
end

function PetService.Delete(player: Player, uid)
	local data = S.DataService.Get(player)
	if not data or typeof(uid) ~= "string" or not data.Pets[uid] then
		return false, "Unknown pet"
	end
	local session = S.DataService.Session(player)
	if session and session.Trade and table.find(session.Trade.MyPets or {}, uid) then
		return false, "That pet is in a trade"
	end
	local def = PetData.Get(data.Pets[uid].Id)
	data.Pets[uid] = nil
	local refund = def and math.max(1, Rarities.Rank(def.Rarity) * 2) or 1
	S.EconomyService.AddGems(player, refund)
	PetService.Refresh(player)
	return true, ("Released pet (+%d 💎)"):format(refund)
end

function PetService.Init(services)
	S = services
end

function PetService.Start()
	S.NetService.Handle("HatchEgg", PetService.Hatch)
	S.NetService.Handle("EquipPet", function(player, uid)
		return PetService.SetEquipped(player, uid, true)
	end)
	S.NetService.Handle("UnequipPet", function(player, uid)
		return PetService.SetEquipped(player, uid, false)
	end)
	S.NetService.Handle("EquipBestPets", PetService.EquipBest)
	S.NetService.Handle("DeletePet", PetService.Delete)
	S.DataService.Loaded.Event:Connect(function(player)
		task.defer(PetService.Refresh, player)
	end)
end

return PetService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source"><![CDATA[-- PlayerService.lua
-- Player lifecycle: leaderstats, base assignment, character setup (spawn at
-- base, movement stats, Bonk Hammer, overhead name tag, rebirth trail),
-- death handling and the settings / title remotes.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local UpgradeData = require(Shared.UpgradeData)

local S

local PlayerService = {}

function PlayerService.ApplyMovement(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not session or not hum then
		return
	end
	local speed = UpgradeData.WalkSpeed(data, session.PetBonus and session.PetBonus.Speed or 0)
	if #session.Carrying > 0 then
		speed *= S.CarryService.IsCarryingStolen(player) and 0.85 or 0.95
	end
	if session.CoilEquipped then
		speed += 6
	end
	if session.Sprinting and session.Stamina > 0 then
		speed *= Config.Sprint.Multiplier
	end
	hum.WalkSpeed = speed
	hum.UseJumpPower = true
	hum.JumpPower = session.SuperJump and 115 or Config.BaseJumpPower
end

-- Emotes: the server sets an attribute, every client animates it procedurally.
local EMOTES = { Dance = 6, Wave = 3, Cheer = 3, Victory = 5, Celebrate = 3, Flex = 3 }
function PlayerService.Emote(player: Player, name: string, duration: number?)
	local char = player.Character
	if not char or not EMOTES[name] then
		return
	end
	char:SetAttribute("Emote", name)
	char:SetAttribute("EmoteEnd", workspace:GetServerTimeNow() + (duration or EMOTES[name]))
end

function PlayerService.UpdateOverhead(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not data or not head then
		return
	end
	local bb = head:FindFirstChild("Overhead")
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "Overhead"
		bb.Size = UDim2.fromOffset(200, 64)
		bb.StudsOffset = Vector3.new(0, 2.6, 0)
		bb.MaxDistance = 90
		bb.LightInfluence = 0
		local title = Instance.new("TextLabel")
		title.Name = "Title"
		title.BackgroundTransparency = 1
		title.Size = UDim2.fromScale(1, 0.3)
		title.Font = Enum.Font.GothamBlack
		title.TextScaled = true
		title.TextColor3 = Color3.fromRGB(255, 200, 80)
		local s1 = Instance.new("UIStroke")
		s1.Thickness = 2
		s1.Parent = title
		title.Parent = bb
		local name = Instance.new("TextLabel")
		name.Name = "PlayerName"
		name.BackgroundTransparency = 1
		name.Position = UDim2.fromScale(0, 0.3)
		name.Size = UDim2.fromScale(1, 0.4)
		name.Font = Enum.Font.FredokaOne
		name.TextScaled = true
		name.TextColor3 = Color3.new(1, 1, 1)
		local s2 = Instance.new("UIStroke")
		s2.Thickness = 2
		s2.Parent = name
		name.Parent = bb
		local info = Instance.new("TextLabel")
		info.Name = "Info"
		info.BackgroundTransparency = 1
		info.Position = UDim2.fromScale(0, 0.7)
		info.Size = UDim2.fromScale(1, 0.3)
		info.Font = Enum.Font.GothamBold
		info.TextScaled = true
		info.TextColor3 = Color3.fromRGB(150, 230, 255)
		local s3 = Instance.new("UIStroke")
		s3.Thickness = 2
		s3.Parent = info
		info.Parent = bb
		bb.Parent = head
	end
	bb.Title.Text = data.Title ~= "" and ("« " .. data.Title .. " »") or ""
	bb.PlayerName.Text = player.DisplayName
	bb.Info.Text = ("⭐ Lv.%d   🌀 %d"):format(data.Level, data.Rebirths)
	bb.Enabled = not (session and session.Cloaked)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
end

function PlayerService.ApplyTrail(player: Player)
	local data = S.DataService.Get(player)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not data or not hrp then
		return
	end
	local old = hrp:FindFirstChild("RebirthTrail")
	if old then
		old:Destroy()
	end
	if not data.Trail or data.Trail == "" then
		return
	end
	local ok, color = pcall(Color3.fromHex, data.Trail)
	if not ok then
		return
	end
	local a0 = hrp:FindFirstChild("TrailA0") or Instance.new("Attachment")
	a0.Name = "TrailA0"
	a0.Position = Vector3.new(0, 0.8, 0)
	a0.Parent = hrp
	local a1 = hrp:FindFirstChild("TrailA1") or Instance.new("Attachment")
	a1.Name = "TrailA1"
	a1.Position = Vector3.new(0, -0.8, 0)
	a1.Parent = hrp
	local trail = Instance.new("Trail")
	trail.Name = "RebirthTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.6
	trail.LightEmission = 0.8
	trail.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Parent = hrp
end

local function setupCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	local hrp = char:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not hum or not hrp then
		return
	end
	local session = S.DataService.Session(player)
	if session then
		session.Cloaked = false
		session.SuperJump = false
		session.Sprinting = false
	end
	task.defer(function()
		local cf = S.BaseService.SpawnCFrame(player)
		if cf and hrp.Parent then
			hrp.CFrame = cf
		end
	end)
	PlayerService.ApplyMovement(player)
	PlayerService.UpdateOverhead(player)
	PlayerService.ApplyTrail(player)
	S.StealService.GiveHammer(player)
	S.GearService.GiveTools(player)
	hum.Died:Connect(function()
		S.CarryService.OnDied(player, hrp.Position)
	end)
end

local function onLoaded(player: Player)
	-- NOTE: BindableEvents copy tables, so always use the live profile table.
	local data = S.DataService.Get(player)
	if not player.Parent or not data then
		return
	end
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local money = Instance.new("StringValue")
	money.Name = "Money"
	money.Parent = ls
	local rb = Instance.new("IntValue")
	rb.Name = "Rebirths"
	rb.Parent = ls
	local lvl = Instance.new("IntValue")
	lvl.Name = "Level"
	lvl.Parent = ls
	ls.Parent = player

	local index = S.BaseService.Assign(player)
	if not index then
		player:Kick("This server is full (all bases taken). Please join another server!")
		return
	end
	-- treasures on now-locked plots (data from older versions) go to storage
	for _, t in pairs(data.Treasures) do
		if t.Plot and not S.BaseService.IsPlotUnlocked(data, t.Plot) then
			t.Plot = nil
		end
	end
	S.BaseService.Refresh(player)
	S.EconomyService.GrantOffline(player)
	S.StateService.MarkFull(player)
	player:SetAttribute("Loaded", true)

	player.CharacterAdded:Connect(function(char)
		setupCharacter(player, char)
	end)
	if player.Character then
		task.spawn(setupCharacter, player, player.Character)
	end
	if not S.DataService.CanSave() then
		task.delay(4, function()
			S.NetService.Notify(player, "⚠️ Saving is off in this session (Studio without API access).", "warn")
		end)
	end
end

function PlayerService.Init(services)
	S = services
	Players.CharacterAutoLoads = true
end

function PlayerService.Start()
	S.DataService.Loaded.Event:Connect(onLoaded)
	Players.PlayerRemoving:Connect(function(player)
		S.BaseService.Release(player)
	end)

	S.NetService.Handle("UpdateSettings", function(player, settings)
		local data = S.DataService.Get(player)
		if not data or typeof(settings) ~= "table" then
			return false, "Bad request"
		end
		for _, key in ipairs({ "Music", "Sfx", "LowGfx", "Effects", "Weather", "Intro" }) do
			if typeof(settings[key]) == "boolean" then
				data.Settings[key] = settings[key]
			end
		end
		if typeof(settings.UIScale) == "number" then
			data.Settings.UIScale = math.clamp(settings.UIScale, 0.6, 1.4)
		end
		S.StateService.MarkFull(player)
		return true
	end)

	local emoteCooldown = {}
	S.NetService.Handle("Emote", function(player, name)
		if typeof(name) ~= "string" or not EMOTES[name] then
			return false, "Unknown emote"
		end
		if emoteCooldown[player] and os.clock() - emoteCooldown[player] < 1 then
			return false
		end
		emoteCooldown[player] = os.clock()
		PlayerService.Emote(player, name)
		return true
	end)
	S.NetService.Handle("Sprint", function(player, on)
		local session = S.DataService.Session(player)
		if not session then
			return false
		end
		on = on == true
		if on and session.Stamina < Config.Sprint.MinToStart then
			return false, "Out of stamina!"
		end
		session.Sprinting = on
		if player.Character then
			player.Character:SetAttribute("Sprinting", on)
		end
		PlayerService.ApplyMovement(player)
		return true
	end)
	S.NetService.Handle("SetStealing", function(player, on)
		local char = player.Character
		if char then
			char:SetAttribute("Stealing", on == true)
		end
		return true
	end)
	-- stamina simulation
	task.spawn(function()
		local dt = 0.2
		while true do
			task.wait(dt)
			for _, p in ipairs(Players:GetPlayers()) do
				local ses = S.DataService.Session(p)
				local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
				if ses and hum then
					local moving = hum.MoveDirection.Magnitude > 0.1
					if ses.Sprinting and moving then
						ses.Stamina = math.max(0, ses.Stamina - Config.Sprint.Drain * dt)
						if ses.Stamina <= 0 then
							ses.Sprinting = false
							p.Character:SetAttribute("Sprinting", false)
							PlayerService.ApplyMovement(p)
						end
					elseif not ses.Sprinting then
						ses.Stamina = math.min(Config.Sprint.MaxStamina, ses.Stamina + Config.Sprint.Regen * dt)
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		emoteCooldown[p] = nil
	end)

	S.NetService.Handle("SetTitle", function(player, title)
		local data = S.DataService.Get(player)
		if not data or typeof(title) ~= "string" then
			return false, "Bad request"
		end
		if title ~= "" and not table.find(data.Titles, title) then
			return false, "You haven't unlocked that title"
		end
		data.Title = title
		PlayerService.UpdateOverhead(player)
		S.StateService.MarkFull(player)
		return true, title == "" and "Title removed" or ("Title set: " .. title)
	end)
end

return PlayerService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">RebirthService</string><ProtectedString name="Source"><![CDATA[-- RebirthService.lua
-- Rebirth: trade your money, treasures and upgrades for a permanent income
-- and speed bonus, plus exclusive treasures, titles and trails at milestones.
-- Abilities, the treasure index, secrets, titles and exclusive treasures are kept.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local RebirthService = {}

function RebirthService.Rebirth(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return false, "Not ready"
	end
	local cost = Config.RebirthCost(data.Rebirths)
	if data.Money < cost then
		return false, ("You need %s to rebirth"):format(Util.Money(cost))
	end
	if #session.Carrying > 0 then
		return false, "Deliver what you're carrying first"
	end
	local req = Config.RebirthRequirement(data.Rebirths)
	local have = 0
	for _, t in pairs(data.Treasures) do
		local d = TreasureData.Get(t.Id)
		if d and not d.Exclusive and require(Shared.Rarities).Rank(d.Rarity) >= require(Shared.Rarities).Rank(req.Rarity) then
			have += 1
		end
	end
	if have < req.Count then
		return false, ("Rebirth %d needs %d %s+ treasure%s (you have %d)"):format(data.Rebirths + 1, req.Count, req.Rarity, req.Count > 1 and "s" or "", have)
	end
	if session.Trade then
		return false, "Finish your trade first"
	end
	if next(session.Stealing) then
		return false, "Someone is robbing you! Deal with them first"
	end

	-- keep exclusive treasures only
	local kept = {}
	for uid, t in pairs(data.Treasures) do
		local def = TreasureData.Get(t.Id)
		if def and def.Exclusive then
			kept[uid] = { Id = t.Id, Plot = nil }
		end
	end
	data.Treasures = kept
	data.Rebirths += 1
	data.Money = Config.StartingMoney + data.Rebirths * Config.Rebirth.StartingMoneyPerRebirth
	for k in pairs(data.Upgrades) do
		data.Upgrades[k] = 0
	end

	-- milestone rewards
	local reward = Config.RebirthRewards[data.Rebirths]
	local rewardText = ""
	if reward then
		if reward.Title and not table.find(data.Titles, reward.Title) then
			table.insert(data.Titles, reward.Title)
			data.Title = reward.Title
		end
		if reward.Trail then
			data.Trail = reward.Trail:ToHex()
		end
		if reward.Treasure then
			local def = TreasureData.ByName[reward.Treasure]
			if def then
				local uid = Util.NewUid()
				data.Treasures[uid] = { Id = def.Id, Plot = nil }
				data.Index[def.Id] = true
				rewardText = (" Exclusive reward: %s!"):format(def.Name)
			end
		end
	end
	-- re-place exclusives on the (now smaller) base
	for _, t in pairs(data.Treasures) do
		t.Plot = S.BaseService.FreePlot(player)
	end

	S.BaseService.Refresh(player)
	S.PlayerService.ApplyMovement(player)
	S.PlayerService.UpdateOverhead(player)
	S.PlayerService.ApplyTrail(player)
	data.Gems += Config.Gems.Rebirth
	data.Vault = 0
	data.PlotCash = {}
	S.PlayerService.Emote(player, "Victory", 5)
	S.StateService.MarkFull(player)
	task.spawn(S.DataService.Save, player, false)
	Remotes.Effect:FireClient(player, "Rebirth", data.Rebirths)
	Remotes.Announce:FireAllClients(("🌀 %s reached Rebirth %d!"):format(player.DisplayName, data.Rebirths), "Mythical")
	return true, ("REBIRTH %d! +%d%% income forever, +%d 💎.%s"):format(data.Rebirths, math.floor(data.Rebirths * Config.Rebirth.IncomeBonusPerRebirth * 100), Config.Gems.Rebirth, rewardText)
end

function RebirthService.Init(services)
	S = services
end

function RebirthService.Start()
	S.NetService.Handle("Rebirth", function(player)
		local ok, msg = RebirthService.Rebirth(player)
		return ok, msg
	end)
end

return RebirthService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- ShopService.lua
-- Upgrade shop + special abilities (purchase and server-validated use).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local UpgradeData = require(Shared.UpgradeData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)
local Config = require(Shared.Config)

local S

local ShopService = {}

local function now()
	return workspace:GetServerTimeNow()
end

function ShopService.BuyUpgrade(player: Player, key: string)
	local data = S.DataService.Get(player)
	if not data or typeof(key) ~= "string" then
		return false, "Bad request"
	end
	local up = UpgradeData.Upgrades[key]
	if not up then
		return false, "Unknown upgrade"
	end
	local level = data.Upgrades[key] or 0
	if level >= up.MaxLevel then
		return false, "Already maxed!"
	end
	local cost = up.Cost(level)
	if data.Money < cost then
		return false, ("Need %s more"):format(Util.Money(cost - data.Money))
	end
	data.Money -= cost
	data.Upgrades[key] = level + 1

	if key == "Speed" then
		S.PlayerService.ApplyMovement(player)
	elseif key == "Base" then
		S.BaseService.Refresh(player)
	elseif key == "Protection" or key == "Walls" then
		S.BaseService.RefreshPrompts(player)
		S.BaseService.Refresh(player)
	elseif key == "Security" or key == "Floors" then
		S.BaseService.Refresh(player)
	end
	Remotes.Effect:FireClient(player, "Purchase")
	S.StateService.MarkFull(player)
	return true, ("%s upgraded to level %d!"):format(up.Name, level + 1)
end

function ShopService.BuyGemItem(player: Player, key)
	local data = S.DataService.Get(player)
	if not data or typeof(key) ~= "string" then
		return false, "Bad request"
	end
	local item = UpgradeData.GemShop[key]
	if not item then
		return false, "Unknown item"
	end
	local cost = item.Cost
	if key == "PetSlot" then
		if UpgradeData.PetSlots(data) >= Config.Pets.MaxSlots then
			return false, "Max pet slots reached!"
		end
		cost = item.Cost * (data.ExtraPetSlots + 1)
	elseif key == "AutoCollect" and data.AutoCollect then
		return false, "You already own the Auto Collector"
	end
	if data.Gems < cost then
		return false, ("Need %d more 💎"):format(cost - data.Gems)
	end
	data.Gems -= cost
	if item.Boost then
		data.Boosts[item.Boost] = math.max(os.time(), data.Boosts[item.Boost] or 0) + item.Duration
		if item.Boost == "Speed" then
			S.PlayerService.ApplyMovement(player)
			task.delay(item.Duration + 1, function()
				if player.Parent then
					S.PlayerService.ApplyMovement(player)
				end
			end)
		end
	elseif key == "AutoCollect" then
		data.AutoCollect = true
		S.BaseService.Collect(player)
	elseif key == "PetSlot" then
		data.ExtraPetSlots += 1
		S.PetService.Refresh(player)
	end
	Remotes.Effect:FireClient(player, "Purchase")
	S.StateService.MarkFull(player)
	return true, ("Bought %s!"):format(item.Name)
end

function ShopService.BuyAbility(player: Player, key: string)
	local data = S.DataService.Get(player)
	if not data or typeof(key) ~= "string" then
		return false, "Bad request"
	end
	local ab = UpgradeData.Abilities[key]
	if not ab then
		return false, "Unknown ability"
	end
	if data.Abilities[key] then
		return false, "You already own this"
	end
	if data.Money < ab.Cost then
		return false, ("Need %s more"):format(Util.Money(ab.Cost - data.Money))
	end
	data.Money -= ab.Cost
	data.Abilities[key] = true
	Remotes.Effect:FireClient(player, "Purchase")
	S.StateService.MarkFull(player)
	local hint = ab.Key and (" Press " .. ab.Key .. " or tap its button to use it.") or ""
	return true, ("Unlocked %s!%s"):format(ab.Name, hint)
end

local function setCloak(player: Player, on: boolean)
	local session = S.DataService.Session(player)
	local char = player.Character
	if not session or not char then
		return
	end
	session.Cloaked = on
	for _, d in ipairs(char:GetDescendants()) do
		local owner = d:FindFirstAncestorWhichIsA("Model")
		local isCarried = owner ~= nil and owner:GetAttribute("Carried") == true
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and not isCarried then
			if on then
				if d:GetAttribute("CloakOrig") == nil then
					d:SetAttribute("CloakOrig", d.Transparency)
				end
				d.Transparency = 0.92
			else
				local orig = d:GetAttribute("CloakOrig")
				if orig ~= nil then
					d.Transparency = orig
					d:SetAttribute("CloakOrig", nil)
				end
			end
		elseif d:IsA("Decal") and d.Name == "face" then
			d.Transparency = on and 1 or 0
		end
	end
	S.PlayerService.UpdateOverhead(player)
end

function ShopService.UseAbility(player: Player, key: string)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session or typeof(key) ~= "string" then
		return false, "Bad request"
	end
	local ab = UpgradeData.Abilities[key]
	if not ab or not ab.Key then
		return false, "Not usable"
	end
	if not data.Abilities[key] then
		return false, ("Buy %s in the shop first!"):format(ab.Name)
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return false, "You're not alive"
	end
	local t = now()
	local cd = session.AbilityCooldowns[key] or 0
	if cd > t then
		return false, ("%s ready in %ds"):format(ab.Name, math.ceil(cd - t))
	end
	session.AbilityCooldowns[key] = t + ab.Cooldown

	if key == "Dash" then
		Remotes.Effect:FireClient(player, "Dash")
	elseif key == "SuperJump" then
		session.SuperJump = true
		S.PlayerService.ApplyMovement(player)
		Remotes.Effect:FireClient(player, "SuperJump", ab.Duration)
		task.delay(ab.Duration, function()
			if session.SuperJump then
				session.SuperJump = false
				S.PlayerService.ApplyMovement(player)
			end
		end)
	elseif key == "Cloak" then
		setCloak(player, true)
		Remotes.Effect:FireClient(player, "Cloak", ab.Duration)
		task.delay(ab.Duration, function()
			if player.Parent and player.Character == char then
				setCloak(player, false)
			end
		end)
	end
	S.StateService.PushStats(player)
	return true
end

function ShopService.Init(services)
	S = services
end

function ShopService.Start()
	S.NetService.Handle("BuyUpgrade", ShopService.BuyUpgrade)
	S.NetService.Handle("BuyAbility", ShopService.BuyAbility)
	S.NetService.Handle("UseAbility", ShopService.UseAbility)
	S.NetService.Handle("BuyGemItem", ShopService.BuyGemItem)
end

return ShopService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">StateService</string><ProtectedString name="Source"><![CDATA[-- StateService.lua
-- Replicates player state to its owning client. Two channels:
--   FullState: everything (inventory, upgrades, settings ...) when it changes
--   Stats:     small, frequent payload (money, mps, timers, carrying)
-- Both are debounced so bursts of changes collapse into a single send.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local UpgradeData = require(Shared.UpgradeData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local function uncollected(data): number
	local total = data.Vault or 0
	for _, v in pairs(data.PlotCash or {}) do
		total += v
	end
	return total
end

local S

local StateService = {}

local fullPending: { [Player]: boolean } = {}
local statsPending: { [Player]: boolean } = {}

function StateService.MarkFull(player: Player)
	fullPending[player] = true
	statsPending[player] = true
end

function StateService.PushStats(player: Player)
	statsPending[player] = true
end

local function buildFull(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return nil
	end
	local treasures = {}
	local tradeOffer = session.Trade and session.Trade.MyOffer or {}
	for uid, t in pairs(data.Treasures) do
		table.insert(treasures, {
			Uid = uid,
			Id = t.Id,
			Plot = t.Plot,
			Mut = t.Mut,
			Stealing = session.Stealing[uid] ~= nil,
			InTrade = table.find(tradeOffer, uid) ~= nil,
		})
	end
	local pets = {}
	for uid, pet in pairs(data.Pets) do
		table.insert(pets, { Uid = uid, Id = pet.Id, Equipped = pet.Equipped, InTrade = session.Trade ~= nil and table.find(session.Trade.MyPets or {}, uid) ~= nil })
	end
	local achievements = {}
	for id in pairs(data.Achievements) do
		table.insert(achievements, id)
	end
	local index = {}
	for id in pairs(data.Index) do
		table.insert(index, id)
	end
	local secrets = {}
	for name in pairs(data.Secrets) do
		table.insert(secrets, name)
	end
	return {
		Money = data.Money,
		Gems = data.Gems,
		Vault = uncollected(data),
		Pets = pets,
		PetSlots = UpgradeData.PetSlots(data),
		Achievements = achievements,
		AchievementProgress = S.AchievementService.Progress(data),
		Boosts = data.Boosts,
		AutoCollect = data.AutoCollect,
		BaseColor = data.BaseColor,
		ExtraPetSlots = data.ExtraPetSlots,
		PetBonus = session.PetBonus,
		Aura = session.Aura,
		Luck = S.EconomyService.Luck(player),
		TotalEarned = data.TotalEarned,
		Rebirths = data.Rebirths,
		Level = data.Level,
		XP = data.XP,
		XPNext = Config.XPForLevel(data.Level),
		Upgrades = data.Upgrades,
		Abilities = data.Abilities,
		Treasures = treasures,
		Index = index,
		Secrets = secrets,
		Settings = data.Settings,
		Stats = data.Stats,
		Title = data.Title,
		Titles = data.Titles,
		PlotCount = UpgradeData.PlotCount(data),
		CarryCap = UpgradeData.CarryCapacity(data),
		MaxStorage = Config.MaxStorage,
		BaseIndex = session.BaseIndex,
		Multiplier = UpgradeData.IncomeMultiplier(data, session.Aura, session.PetBonus.Money),
		RebirthCost = Config.RebirthCost(data.Rebirths),
		RebirthReq = Config.RebirthRequirement(data.Rebirths),
		Gear = data.Gear,
		LockDuration = UpgradeData.LockDuration(data),
		CanSave = S.DataService.CanSave(),
	}
end

local function buildStats(player: Player)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return nil
	end
	local carrying = {}
	for _, item in ipairs(session.Carrying) do
		table.insert(carrying, { Id = item.Id, Source = item.Source, Victim = item.Victim and item.Victim.DisplayName or nil })
	end
	return {
		Money = data.Money,
		Gems = data.Gems,
		Vault = uncollected(data),
		Stamina = session.Stamina,
		MaxStamina = Config.Sprint.MaxStamina,
		Luck = S.EconomyService.Luck(player),
		Boosts = data.Boosts,
		ServerTime = os.time(),
		MPS = session.MPS,
		Level = data.Level,
		XP = data.XP,
		XPNext = Config.XPForLevel(data.Level),
		Rebirths = data.Rebirths,
		Carrying = carrying,
		CarryCap = UpgradeData.CarryCapacity(data),
		LockEnd = session.LockEnd,
		LockCooldownEnd = session.LockCooldownEnd,
		StealCooldownEnd = session.StealCooldownEnd,
		ShieldEnd = session.ShieldEnd,
		AbilityCooldowns = session.AbilityCooldowns,
		EventMultiplier = S.EconomyService.EventMultiplier,
	}
end

local function updateLeaderstats(player: Player)
	local data = S.DataService.Get(player)
	local ls = player:FindFirstChild("leaderstats")
	if not data or not ls then
		return
	end
	local money = ls:FindFirstChild("Money")
	if money then
		money.Value = Util.Money(data.Money)
	end
	local rb = ls:FindFirstChild("Rebirths")
	if rb then
		rb.Value = data.Rebirths
	end
	local lvl = ls:FindFirstChild("Level")
	if lvl then
		lvl.Value = data.Level
	end
end

function StateService.SendFullNow(player: Player)
	local snap = buildFull(player)
	if snap then
		Remotes.FullState:FireClient(player, snap)
	end
end

function StateService.Init(services)
	S = services
end

function StateService.Start()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		for player in pairs(fullPending) do
			fullPending[player] = nil
			if player.Parent then
				StateService.SendFullNow(player)
			end
		end
		for player in pairs(statsPending) do
			statsPending[player] = nil
			if player.Parent then
				local snap = buildStats(player)
				if snap then
					Remotes.Stats:FireClient(player, snap)
				end
				updateLeaderstats(player)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		fullPending[p] = nil
		statsPending[p] = nil
	end)
	S.NetService.Handle("RequestState", function(player)
		StateService.MarkFull(player)
		return true
	end)
end

return StateService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">StealService</string><ProtectedString name="Source"><![CDATA[-- StealService.lua
-- Server-authoritative stealing:
--   validation (locks, shields, cooldowns, distance, capacity, ownership),
--   alarms, delivery, returning treasure, post-robbery lockdown and the
--   Bonk Hammer that lets defenders knock stolen loot out of a thief's hands.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local UpgradeData = require(Shared.UpgradeData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local StealService = {}

local function now()
	return workspace:GetServerTimeNow()
end

local function hrpOf(player: Player): BasePart?
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Returns (ok, reason)
function StealService.CanSteal(thief: Player, owner: Player, uid: string)
	if thief == owner then
		return false, "That's your own treasure!"
	end
	local tData, oData = S.DataService.Get(thief), S.DataService.Get(owner)
	local tSes, oSes = S.DataService.Session(thief), S.DataService.Session(owner)
	if not (tData and oData and tSes and oSes) then
		return false, "Not ready"
	end
	local t = now()
	local entry = oData.Treasures[uid]
	if not entry or not entry.Plot then
		return false, "That treasure is gone"
	end
	if oSes.Stealing[uid] then
		return false, "Someone is already stealing that!"
	end
	if oSes.Arriving[uid] then
		return false, "It's still walking home — wait for it to reach its stand!"
	end
	if oSes.LockEnd > t then
		return false, "This base is locked! 🔒"
	end
	if oSes.ShieldEnd > t then
		return false, ("%s just arrived and is shielded (%ds)"):format(owner.DisplayName, math.ceil(oSes.ShieldEnd - t))
	end
	if tSes.StealCooldownEnd > t then
		return false, ("Steal cooldown: %ds"):format(math.ceil(tSes.StealCooldownEnd - t))
	end
	local victimCd = tSes.VictimCooldowns[owner.UserId]
	if victimCd and victimCd > t then
		return false, ("You robbed %s recently. Wait %ds"):format(owner.DisplayName, math.ceil(victimCd - t))
	end
	if tSes.Trade then
		return false, "Finish your trade first"
	end
	if not S.CarryService.CanCarry(thief) then
		return false, "Your hands are full! Upgrade your backpack."
	end
	if S.TreasureService.IsFull(thief, S.CarryService.Count(thief) + 1) then
		return false, "Your base and storage are full!"
	end
	-- physical validation: thief must be alive and next to the treasure
	local hrp = hrpOf(thief)
	local base = S.BaseService.Get(owner)
	if not hrp or not base then
		return false, "Not ready"
	end
	local pm = base.PlotModels[entry.Plot]
	if not pm or pm.Uid ~= uid then
		return false, "That treasure is gone"
	end
	local dist = (pm.Model:GetPivot().Position - hrp.Position).Magnitude
	if dist > Config.Steal.MaxPromptDistance + 4 then
		return false, "Too far away"
	end
	return true
end

function StealService.TryStart(thief: Player, owner: Player, uid: string)
	local ok, reason = StealService.CanSteal(thief, owner, uid)
	if not ok then
		S.NetService.Notify(thief, reason or "Can't steal that", "error")
		return false
	end
	local oData = S.DataService.Get(owner)
	local oSes = S.DataService.Session(owner)
	local entry = oData.Treasures[uid]
	local def = TreasureData.Get(entry.Id)
	oSes.Stealing[uid] = thief
	-- stealing ends your own new-player shield
	S.DataService.Session(thief).ShieldEnd = 0
	S.BaseService.Refresh(owner)
	S.CarryService.Add(thief, {
		Id = entry.Id,
		Mut = entry.Mut,
		Source = "Steal",
		Victim = owner,
		VictimUid = uid,
	})
	S.BaseService.TriggerAlarm(owner)
	Remotes.Alarm:FireClient(owner, thief.DisplayName, def and def.Name or "a treasure")
	S.NetService.Notify(thief, ("You grabbed %s! Run back to your base!"):format(def and def.Name or "it"), "success")
	S.StateService.PushStats(owner)
	return true
end

-- Stolen treasure goes back to its owner's plot.
function StealService.Return(item, reason: string?)
	local owner = item.Victim
	if not owner or not owner.Parent then
		return
	end
	local oSes = S.DataService.Session(owner)
	if oSes then
		oSes.Stealing[item.VictimUid] = nil
	end
	S.BaseService.Refresh(owner)
	if reason == "bonked" then
		S.NetService.Notify(owner, "Your treasure was recovered! 🛡️", "success")
	elseif reason == "trapped" then
		-- notification sent by the security system
	elseif reason == "timeout" or reason == "dropped" then
		S.NetService.Notify(owner, "Your stolen treasure returned home.", "info")
	end
	S.StateService.MarkFull(owner)
end

-- Thief made it home: transfer ownership.
function StealService.Complete(thief: Player, item)
	local owner = item.Victim
	local def = TreasureData.Get(item.Id)
	local oData = owner and owner.Parent and S.DataService.Get(owner)
	local oSes = owner and S.DataService.Session(owner)
	if not oData or not oSes or not oData.Treasures[item.VictimUid] then
		S.NetService.Notify(thief, "The owner left — the treasure vanished back to them.", "warn")
		return
	end
	-- validate the treasure is still the same item
	if oData.Treasures[item.VictimUid].Id ~= item.Id then
		oSes.Stealing[item.VictimUid] = nil
		return
	end
	oData.Treasures[item.VictimUid] = nil
	oSes.Stealing[item.VictimUid] = nil
	oData.Stats.Robbed += 1

	local tSes = S.DataService.Session(thief)
	local tData = S.DataService.Get(thief)
	local t = now()
	if tSes then
		tSes.StealCooldownEnd = t + Config.Steal.ThiefCooldown
		tSes.VictimCooldowns[owner.UserId] = t + Config.Steal.SameVictimCooldown
	end
	if tData then
		tData.Stats.Steals += 1
	end

	S.TreasureService.Give(thief, item.Id, { Source = "Steal", Mutation = item.Mut })
	S.EconomyService.AddXP(thief, Config.XP.Steal)
	S.PlayerService.Emote(thief, "Victory", 4)

	-- victim's base locks down for a while (fair cooldown)
	S.BaseService.SetLock(owner, UpgradeData.VictimLock(oData))
	S.BaseService.Refresh(owner)
	S.StateService.MarkFull(owner)

	local name = def and def.Name or "a treasure"
	S.NetService.Notify(owner, ("%s stole your %s! Base auto-locked."):format(thief.DisplayName, name), "error")
	S.NetService.Notify(thief, ("Heist complete! +%s %s"):format(name, def and ("(" .. Util.Money(def.MPS) .. "/s)") or ""), "success")
	if def and (def.Rarity == "Mythical" or def.Rarity == "Secret" or def.Rarity == "Divine") then
		Remotes.Announce:FireAllClients(("🚨 %s stole a %s %s from %s!"):format(thief.DisplayName, def.Rarity, name, owner.DisplayName), def.Rarity)
	end
end

-- If the owner leaves while being robbed, cancel all of those thefts.
local function onOwnerLeaving(owner: Player)
	for _, p in ipairs(Players:GetPlayers()) do
		local ses = S.DataService.Session(p)
		if ses and p ~= owner then
			for _, item in ipairs(table.clone(ses.Carrying)) do
				if item.Source == "Steal" and item.Victim == owner then
					S.CarryService.Remove(p, item)
					S.NetService.Notify(p, owner.DisplayName .. " left — the treasure returned to them.", "warn")
				end
			end
		end
	end
end

-- Bonk Hammer ---------------------------------------------------------------------
local function makeHammer(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Bonk Hammer"
	tool:SetAttribute("Bat", true)
	tool.ToolTip = "Bonk thieves to recover stolen treasure!"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.GripPos = Vector3.new(0, -1.2, 0)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 3, 0.4)
	handle.Color = Color3.fromRGB(140, 90, 50)
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.6, 1.2, 1.2)
	head.Color = Color3.fromRGB(255, 80, 90)
	head.Material = Enum.Material.SmoothPlastic
	head.CanCollide = false
	head.Massless = true
	head.CFrame = handle.CFrame * CFrame.new(0, 1.6, 0)
	head.Parent = tool
	local stripe = Instance.new("Part")
	stripe.Name = "Stripe"
	stripe.Size = Vector3.new(1.65, 0.3, 1.25)
	stripe.Color = Color3.fromRGB(255, 230, 80)
	stripe.Material = Enum.Material.Neon
	stripe.CanCollide = false
	stripe.Massless = true
	stripe.CFrame = head.CFrame
	stripe.Parent = tool
	for _, p in ipairs({ head, stripe }) do
		local w = Instance.new("WeldConstraint")
		w.Part0 = handle
		w.Part1 = p
		w.Parent = p
	end
	local sound = Instance.new("Sound")
	sound.Name = "Swing"
	sound.SoundId = Config.Sounds.Swing
	sound.Volume = 0.6
	sound.Parent = handle
	local hit = Instance.new("Sound")
	hit.Name = "Hit"
	hit.SoundId = Config.Sounds.Bonk
	hit.Volume = 0.9
	hit.Parent = handle
	return tool
end

local hammerTemplate: Tool

local function onSwing(player: Player, tool: Tool)
	local session = S.DataService.Session(player)
	local hrp = hrpOf(player)
	if not session or not hrp then
		return
	end
	local t = os.clock()
	if t - session.LastBonk < Config.Steal.BonkCooldown then
		return
	end
	session.LastBonk = t
	local handle = tool:FindFirstChild("Handle")
	if handle then
		local swing = handle:FindFirstChild("Swing")
		if swing then
			swing:Play()
		end
	end
	-- swing "animation": tilt the grip forward then back
	tool.Grip = CFrame.new(0, -1.2, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	task.delay(0.25, function()
		if tool.Parent then
			tool.Grip = CFrame.new(0, -1.2, 0)
		end
	end)
	-- bat tier stats
	local pdata = S.DataService.Get(player)
	local bat = UpgradeData.BatStats(pdata and pdata.Gear and pdata.Gear.Bat or 0)
	-- find a target in front of us
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local ohrp = hrpOf(other)
			if ohrp then
				local offset = ohrp.Position - hrp.Position
				local dist = offset.Magnitude
				if dist <= bat.Range and (dist < 3 or hrp.CFrame.LookVector:Dot(offset.Unit) > 0.2) then
					local hitSound = handle and handle:FindFirstChild("Hit")
					if hitSound then
						hitSound:Play()
					end
					local recovered = 0
					if S.CarryService.IsCarryingStolen(other) then
						recovered = S.CarryService.DropStolen(other)
					end
					Remotes.Effect:FireClient(other, "Knockback", (offset.Unit + Vector3.new(0, 0.6, 0)) * bat.Knock, bat.Stun)
					Remotes.Effect:FireClient(player, "BonkHit", ohrp.Position)
					if recovered > 0 then
						local data = S.DataService.Get(player)
						if data then
							data.Stats.Defends += 1
						end
						S.EconomyService.AddXP(player, Config.XP.Defend)
						S.NetService.Notify(player, ("BONK! %s dropped the loot!"):format(other.DisplayName), "success")
						S.NetService.Notify(other, ("%s bonked you! The treasure went home."):format(player.DisplayName), "error")
					end
					break
				end
			end
		end
	end
end

function StealService.GiveHammer(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if not backpack then
		return
	end
	for _, t in ipairs(backpack:GetChildren()) do
		if t:GetAttribute("Bat") then
			return
		end
	end
	if player.Character and player.Character:FindFirstChildWhichIsA("Tool") and player.Character:FindFirstChildWhichIsA("Tool"):GetAttribute("Bat") then
		return
	end
	local tool = hammerTemplate:Clone()
	local data = S.DataService.Get(player)
	local stats = UpgradeData.BatStats(data and data.Gear and data.Gear.Bat or 0)
	tool.Name = stats.Name
	local head = tool:FindFirstChild("Head")
	if head then
		head.Color = stats.Color
		if (data and data.Gear and data.Gear.Bat or 0) >= 2 then
			head.Material = Enum.Material.Neon
		end
	end
	tool.Activated:Connect(function()
		onSwing(player, tool)
	end)
	tool.Parent = backpack
end

-- Replace the bat after a tier upgrade
function StealService.RefreshHammer(player: Player)
	for _, holder in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character }) do
		if holder then
			for _, t in ipairs(holder:GetChildren()) do
				if t:IsA("Tool") and t:GetAttribute("Bat") then
					t:Destroy()
				end
			end
		end
	end
	StealService.GiveHammer(player)
end

function StealService.Init(services)
	S = services
	hammerTemplate = makeHammer()
end

function StealService.Start()
	Players.PlayerRemoving:Connect(onOwnerLeaving)
end

return StealService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">TradeService</string><ProtectedString name="Source"><![CDATA[-- TradeService.lua
-- Player-to-player trading, fully server validated:
--   request -> accept -> both sides set offers (treasures + money) -> both
--   ready -> 3 second confirm countdown (any change cancels ready) -> atomic
--   swap with re-validation, then both saves are written immediately.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local TradeService = {}

local pending: { [Player]: { [Player]: number } } = {} -- pending[target][from] = expiry
local nextId = 0

local function now()
	return workspace:GetServerTimeNow()
end

local function view(trade, player: Player)
	local other = trade.A == player and trade.B or trade.A
	local function side(p)
		local items = {}
		local data = S.DataService.Get(p)
		for _, uid in ipairs(trade.Offers[p].Uids) do
			local t = data and data.Treasures[uid]
			if t then
				table.insert(items, { Uid = uid, Id = t.Id, Mut = t.Mut })
			end
		end
		local pets = {}
		for _, uid in ipairs(trade.Offers[p].Pets) do
			local pet = data and data.Pets[uid]
			if pet then
				table.insert(pets, { Uid = uid, Id = pet.Id })
			end
		end
		return { Items = items, Pets = pets, Money = trade.Offers[p].Money, Ready = trade.Ready[p] }
	end
	return {
		Id = trade.Id,
		Partner = { Name = other.DisplayName, UserId = other.UserId },
		Mine = side(player),
		Theirs = side(other),
		Status = trade.Status,
		CountdownEnd = trade.CountdownEnd,
	}
end

local function broadcast(trade)
	for _, p in ipairs({ trade.A, trade.B }) do
		if p.Parent then
			Remotes.TradeUpdate:FireClient(p, view(trade, p))
		end
	end
end

local function close(trade, reason: string?)
	if trade.Status == "Closed" then
		return
	end
	trade.Status = "Closed"
	for _, p in ipairs({ trade.A, trade.B }) do
		local ses = S.DataService.Session(p)
		if ses and ses.Trade and ses.Trade.Ref == trade then
			ses.Trade = nil
		end
		if p.Parent then
			Remotes.TradeUpdate:FireClient(p, false, reason)
			S.StateService.MarkFull(p)
		end
	end
end

local function tradeOf(player: Player)
	local ses = S.DataService.Session(player)
	return ses and ses.Trade and ses.Trade.Ref
end

local function unready(trade)
	trade.Ready[trade.A] = false
	trade.Ready[trade.B] = false
	trade.Status = "Open"
	trade.CountdownEnd = 0
end

-- Validates that `player` can give their current offer and receive the other.
local function validateSide(trade, giver: Player, receiver: Player)
	local gData, rData = S.DataService.Get(giver), S.DataService.Get(receiver)
	local gSes = S.DataService.Session(giver)
	if not gData or not rData or not gSes then
		return false, "A player left"
	end
	local offer = trade.Offers[giver]
	for _, uid in ipairs(offer.Uids) do
		local entry = gData.Treasures[uid]
		if not entry then
			return false, "An offered treasure no longer exists"
		end
		if gSes.Stealing[uid] then
			return false, "An offered treasure is being stolen!"
		end
	end
	for _, uid in ipairs(offer.Pets) do
		if not gData.Pets[uid] then
			return false, "An offered pet no longer exists"
		end
	end
	local petCount = 0
	for _ in pairs(rData.Pets) do
		petCount += 1
	end
	if petCount - #trade.Offers[receiver].Pets + #offer.Pets > Config.Pets.MaxOwned then
		return false, receiver.DisplayName .. " has too many pets"
	end
	if gData.Money < offer.Money then
		return false, giver.DisplayName .. " doesn't have enough money"
	end
	local recvOffer = trade.Offers[receiver]
	local newCount = S.TreasureService.Count(rData) - #recvOffer.Uids + #offer.Uids
	if newCount > S.TreasureService.Capacity(rData) then
		return false, receiver.DisplayName .. " doesn't have enough room"
	end
	return true
end

local function execute(trade)
	local ok, err = validateSide(trade, trade.A, trade.B)
	if ok then
		ok, err = validateSide(trade, trade.B, trade.A)
	end
	if not ok then
		unready(trade)
		broadcast(trade)
		for _, p in ipairs({ trade.A, trade.B }) do
			S.NetService.Notify(p, "Trade failed: " .. tostring(err), "error")
		end
		return
	end
	local aData, bData = S.DataService.Get(trade.A), S.DataService.Get(trade.B)
	-- remove from both first, then add (so capacity checks above hold)
	local moving = { [trade.A] = {}, [trade.B] = {} }
	local movingPets = { [trade.A] = {}, [trade.B] = {} }
	for _, pair in ipairs({ { trade.A, aData }, { trade.B, bData } }) do
		local p, data = pair[1], pair[2]
		for _, uid in ipairs(trade.Offers[p].Uids) do
			table.insert(moving[p], { Id = data.Treasures[uid].Id, Mut = data.Treasures[uid].Mut })
			data.Treasures[uid] = nil
		end
		for _, uid in ipairs(trade.Offers[p].Pets) do
			table.insert(movingPets[p], data.Pets[uid].Id)
			data.Pets[uid] = nil
		end
		data.Money -= trade.Offers[p].Money
	end
	local function receive(p: Player, data, ids, money, petIds)
		for _, id in ipairs(petIds) do
			local uid = Util.NewUid()
			while data.Pets[uid] do
				uid = Util.NewUid()
			end
			data.Pets[uid] = { Id = id, Equipped = false }
		end
		for _, item in ipairs(ids) do
			local uid = Util.NewUid()
			while data.Treasures[uid] do
				uid = Util.NewUid()
			end
			data.Treasures[uid] = { Id = item.Id, Plot = nil, Mut = item.Mut }
			data.Index[item.Id] = true
		end
		data.Money += money
		data.Stats.Trades += 1
	end
	receive(trade.A, aData, moving[trade.B], trade.Offers[trade.B].Money, movingPets[trade.B])
	receive(trade.B, bData, moving[trade.A], trade.Offers[trade.A].Money, movingPets[trade.A])

	for _, p in ipairs({ trade.A, trade.B }) do
		S.BaseService.Refresh(p)
		S.PetService.Refresh(p)
		task.spawn(S.DataService.Save, p, false)
		S.NetService.Notify(p, "🤝 Trade complete! New treasures are in your storage.", "success")
		Remotes.Effect:FireClient(p, "Confetti")
	end
	close(trade, "Trade complete!")
end

local function start(a: Player, b: Player)
	nextId += 1
	local trade = {
		Id = nextId,
		A = a,
		B = b,
		Offers = { [a] = { Uids = {}, Money = 0, Pets = {} }, [b] = { Uids = {}, Money = 0, Pets = {} } },
		Ready = { [a] = false, [b] = false },
		Status = "Open",
		CountdownEnd = 0,
	}
	S.DataService.Session(a).Trade = { Ref = trade, MyOffer = trade.Offers[a].Uids, MyPets = trade.Offers[a].Pets }
	S.DataService.Session(b).Trade = { Ref = trade, MyOffer = trade.Offers[b].Uids, MyPets = trade.Offers[b].Pets }
	broadcast(trade)
end

-- Handlers ----------------------------------------------------------------------
local function busy(p: Player): string?
	local ses = S.DataService.Session(p)
	if not ses then
		return "not loaded"
	end
	if ses.Trade then
		return "already trading"
	end
	if #ses.Carrying > 0 then
		return "carrying treasure"
	end
	return nil
end

local function onRequest(player: Player, targetUserId)
	if typeof(targetUserId) ~= "number" then
		return false, "Bad request"
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or target == player then
		return false, "Player not found"
	end
	local b1 = busy(player)
	if b1 then
		return false, "You are " .. b1
	end
	local b2 = busy(target)
	if b2 then
		return false, target.DisplayName .. " is " .. b2
	end
	-- if they already asked us, just start
	if pending[player] and pending[player][target] and pending[player][target] > now() then
		pending[player][target] = nil
		start(target, player)
		return true, "Trade started!"
	end
	pending[target] = pending[target] or {}
	if pending[target][player] and pending[target][player] > now() then
		return false, "Request already sent"
	end
	pending[target][player] = now() + Config.Trade.RequestTimeout
	Remotes.TradeRequest:FireClient(target, player.UserId, player.DisplayName, Config.Trade.RequestTimeout)
	return true, "Trade request sent to " .. target.DisplayName
end

local function onRespond(player: Player, fromUserId, accept)
	if typeof(fromUserId) ~= "number" then
		return false, "Bad request"
	end
	local from = Players:GetPlayerByUserId(fromUserId)
	local list = pending[player]
	if not from or not list or not list[from] or list[from] < now() then
		return false, "That request expired"
	end
	list[from] = nil
	if not accept then
		S.NetService.Notify(from, player.DisplayName .. " declined your trade.", "warn")
		return true
	end
	local b1, b2 = busy(player), busy(from)
	if b1 or b2 then
		return false, "Someone is busy right now"
	end
	start(from, player)
	return true
end

local function onOffer(player: Player, uids, money, petUids)
	local trade = tradeOf(player)
	if not trade or trade.Status == "Closed" then
		return false, "No active trade"
	end
	if typeof(uids) ~= "table" then
		return false, "Bad request"
	end
	local data = S.DataService.Get(player)
	local ses = S.DataService.Session(player)
	local clean = {}
	local seen = {}
	for _, uid in ipairs(uids) do
		if typeof(uid) == "string" and not seen[uid] and data.Treasures[uid] and not ses.Stealing[uid] then
			seen[uid] = true
			table.insert(clean, uid)
			if #clean >= Config.Trade.MaxItems then
				break
			end
		end
	end
	local cleanPets = {}
	local petsChanged = false
	if typeof(petUids) == "table" then
		for _, uid in ipairs(petUids) do
			if typeof(uid) == "string" and not seen[uid] and data.Pets[uid] then
				seen[uid] = true
				table.insert(cleanPets, uid)
				if data.Pets[uid].Equipped then
					data.Pets[uid].Equipped = false -- offered pets stop following
					petsChanged = true
				end
				if #cleanPets >= Config.Trade.MaxItems then
					break
				end
			end
		end
	end
	trade.Offers[player].Pets = cleanPets
	ses.Trade.MyPets = cleanPets
	if petsChanged then
		S.PetService.Refresh(player)
	end
	local m = (typeof(money) == "number" and money == money) and math.floor(math.clamp(money, 0, data.Money)) or 0
	trade.Offers[player].Uids = clean
	trade.Offers[player].Money = m
	ses.Trade.MyOffer = clean
	-- offered treasures leave their platforms so they can't earn/be stolen mid-trade
	for _, uid in ipairs(clean) do
		data.Treasures[uid].Plot = nil
	end
	S.BaseService.Refresh(player)
	unready(trade)
	broadcast(trade)
	S.StateService.MarkFull(player)
	return true
end

local function onReady(player: Player, ready)
	local trade = tradeOf(player)
	if not trade or trade.Status == "Closed" then
		return false, "No active trade"
	end
	trade.Ready[player] = ready == true
	if trade.Ready[trade.A] and trade.Ready[trade.B] then
		trade.Status = "Confirming"
		trade.CountdownEnd = now() + Config.Trade.ConfirmCountdown
		local myToken = {}
		trade.Token = myToken
		task.delay(Config.Trade.ConfirmCountdown, function()
			if trade.Token == myToken and trade.Status == "Confirming" and trade.Ready[trade.A] and trade.Ready[trade.B] then
				execute(trade)
			end
		end)
	else
		trade.Status = "Open"
		trade.CountdownEnd = 0
	end
	broadcast(trade)
	return true
end

local function onCancel(player: Player)
	local trade = tradeOf(player)
	if not trade then
		return false, "No active trade"
	end
	close(trade, player.DisplayName .. " cancelled the trade.")
	return true
end

function TradeService.Init(services)
	S = services
end

function TradeService.Start()
	S.NetService.Handle("TradeRequest", onRequest)
	S.NetService.Handle("TradeRespond", onRespond)
	S.NetService.Handle("TradeOffer", onOffer)
	S.NetService.Handle("TradeReady", onReady)
	S.NetService.Handle("TradeCancel", onCancel)
	Players.PlayerRemoving:Connect(function(player)
		local trade = tradeOf(player)
		if trade then
			close(trade, player.DisplayName .. " left the game.")
		end
		pending[player] = nil
		for _, list in pairs(pending) do
			list[player] = nil
		end
	end)
end

return TradeService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">TreasureService</string><ProtectedString name="Source"><![CDATA[-- TreasureService.lua
-- Treasure ownership + the world economy:
--   * free treasures spawning in fields / secret areas / events
--   * the central marketplace stalls (buy with money, carry home)
--   * giving, placing, storing and selling owned treasures
--   * secret-area discovery rewards and the Treasure Magnet ability

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local TreasureModels = require(Shared.TreasureModels)
local UpgradeData = require(Shared.UpgradeData)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)
local Motion = require(Shared.Motion)
local Mutations = require(Shared.Mutations)

local S

local TreasureService = {}
TreasureService.EventMutation = nil -- set by events (e.g. "Lava", "Rainbow")
TreasureService.World = {} :: { [string]: any }

local rng = Random.new()
local worldFolder: Folder
local marketSign: TextLabel?
local nextRestock = 0

local function now()
	return workspace:GetServerTimeNow()
end

local function hrpOf(player: Player): BasePart?
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Ownership ---------------------------------------------------------------------
function TreasureService.Count(data): number
	local n = 0
	for _ in pairs(data.Treasures) do
		n += 1
	end
	return n
end

function TreasureService.Capacity(data): number
	return UpgradeData.PlotCount(data) + Config.MaxStorage
end

function TreasureService.IsFull(player: Player, extra: number?): boolean
	local data = S.DataService.Get(player)
	if not data then
		return true
	end
	return TreasureService.Count(data) + (extra or 0) > TreasureService.Capacity(data)
end

-- Adds a treasure to a player. opts: { Source, Silent, NoAutoPlace }
function TreasureService.Give(player: Player, id: string, opts)
	opts = opts or {}
	local data = S.DataService.Get(player)
	local def = TreasureData.Get(id)
	if not data or not def then
		return nil
	end
	if TreasureService.Count(data) >= TreasureService.Capacity(data) then
		local value = math.floor(def.Value * Config.SellMultiplier)
		S.EconomyService.AddMoney(player, value)
		S.NetService.Notify(player, ("No room! %s was auto-sold for %s"):format(def.Name, Util.Money(value)), "warn")
		return nil
	end
	local uid = Util.NewUid()
	while data.Treasures[uid] do
		uid = Util.NewUid()
	end
	local plot = (not opts.NoAutoPlace) and S.BaseService.FreePlot(player) or nil
	data.Treasures[uid] = { Id = id, Plot = plot, Mut = opts.Mutation }
	-- bought on the parade: the treasure walks itself home to its stand
	local session = S.DataService.Session(player)
	if plot and opts.WalkFrom and session then
		local base = S.BaseService.Get(player)
		local target = base and base.Plots[plot] and base.Plots[plot].Plot.Position or opts.WalkFrom
		local walkTime = math.clamp((target - opts.WalkFrom).Magnitude / 14, 2, 14)
		session.Arriving[uid] = { From = opts.WalkFrom, At = now() + walkTime }
		task.delay(walkTime, function()
			if session.Arriving[uid] then
				session.Arriving[uid] = nil
				S.StateService.MarkFull(player)
			end
		end)
	end
	data.Stats.Collected += 1

	-- discovery bonus
	if not data.Index[id] then
		data.Index[id] = true
		local bonus = math.floor(def.MPS * 10 * Config.DiscoveryBonusMultiplier)
		S.EconomyService.AddMoney(player, bonus)
		local gems = Config.Gems.DiscoveryByRank[Rarities.Rank(def.Rarity)]
		if gems then
			S.EconomyService.AddGems(player, gems)
		end
		if Rarities.Rank(def.Rarity) >= 5 then
			Remotes.Effect:FireClient(player, "Discovery", def.Id)
		end
		if not opts.Silent then
			S.NetService.Notify(player, ("📖 NEW DISCOVERY: %s! +%s"):format(def.Name, Util.Money(bonus)), "discovery")
		end
	elseif not opts.Silent then
		local mutText = opts.Mutation and (" " .. Mutations.Label(opts.Mutation)) or ""
		S.NetService.Notify(player, ("+ %s (%s)%s%s"):format(def.Name, def.Rarity, mutText, plot and "" or " → storage"), "success")
	end
	local xp = (opts.Source == "Market" or opts.Source == "Parade") and Config.XP.Buy or Config.XP.Collect
	if opts.Source ~= "Steal" and opts.Source ~= "Trade" and opts.Source ~= "Rebirth" then
		S.EconomyService.AddXP(player, xp)
	end
	Remotes.Effect:FireClient(player, "Deposit", def.Rarity)
	if Rarities.Rank(def.Rarity) >= 5 and opts.Source ~= "Trade" then
		S.PlayerService.Emote(player, "Celebrate", 3)
	end
	S.BaseService.Refresh(player)
	S.StateService.MarkFull(player)
	return uid
end

function TreasureService.Store(player: Player, uid: string)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return false, "Not ready"
	end
	local entry = data.Treasures[uid]
	if typeof(uid) ~= "string" or not entry then
		return false, "Unknown treasure"
	end
	if not entry.Plot then
		return false, "Already in storage"
	end
	if session.Stealing[uid] then
		return false, "It's being stolen!"
	end
	if S.BaseService.CountStored(data) >= Config.MaxStorage then
		return false, "Storage is full"
	end
	entry.Plot = nil
	S.BaseService.Refresh(player)
	S.StateService.MarkFull(player)
	return true, "Moved to storage"
end

function TreasureService.Place(player: Player, uid: string, plot: number?)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return false, "Not ready"
	end
	if typeof(uid) ~= "string" then
		return false, "Bad request"
	end
	local entry = data.Treasures[uid]
	if not entry then
		return false, "Unknown treasure"
	end
	if session.Trade and table.find(session.Trade.MyOffer or {}, uid) then
		return false, "That treasure is in a trade"
	end
	local target = nil
	if typeof(plot) == "number" then
		plot = math.floor(plot)
		if not S.BaseService.IsPlotUnlocked(data, plot) then
			return false, "That platform is locked"
		end
		for _, t in pairs(data.Treasures) do
			if t.Plot == plot then
				return false, "That platform is taken"
			end
		end
		target = plot
	else
		target = S.BaseService.FreePlot(player)
	end
	if not target then
		return false, "No free platforms! Expand your base."
	end
	if entry.Plot then
		return false, "Already placed"
	end
	entry.Plot = target
	S.BaseService.Refresh(player)
	S.StateService.MarkFull(player)
	return true, "Placed on platform " .. target
end

local function sellOne(player: Player, data, session, uid: string): number?
	local entry = data.Treasures[uid]
	if not entry or session.Stealing[uid] then
		return nil
	end
	if session.Trade and table.find(session.Trade.MyOffer or {}, uid) then
		return nil
	end
	local def = TreasureData.Get(entry.Id)
	local value = def and math.floor(def.Value * Mutations.Multiplier(entry.Mut) * Config.SellMultiplier) or 0
	data.Treasures[uid] = nil
	return value
end

function TreasureService.Sell(player: Player, uid: string)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session or typeof(uid) ~= "string" then
		return false, "Bad request"
	end
	local value = sellOne(player, data, session, uid)
	if not value then
		return false, "Can't sell that right now"
	end
	S.EconomyService.AddMoney(player, value)
	S.EconomyService.AddXP(player, Config.XP.Sell)
	S.BaseService.Refresh(player)
	S.StateService.MarkFull(player)
	Remotes.Effect:FireClient(player, "Sell", value)
	return true, "Sold for " .. Util.Money(value)
end

-- Sells everything in storage (optionally only up to a rarity rank).
function TreasureService.SellStorage(player: Player, maxRank: number?)
	local data = S.DataService.Get(player)
	local session = S.DataService.Session(player)
	if not data or not session then
		return false, "Not ready"
	end
	local cap = typeof(maxRank) == "number" and maxRank or 99
	local total, count = 0, 0
	for uid, entry in pairs(table.clone(data.Treasures)) do
		local def = TreasureData.Get(entry.Id)
		if not entry.Plot and def and Rarities.Rank(def.Rarity) <= cap and not def.Exclusive then
			local v = sellOne(player, data, session, uid)
			if v then
				total += v
				count += 1
			end
		end
	end
	if count == 0 then
		return false, "Nothing to sell in storage"
	end
	S.EconomyService.AddMoney(player, total)
	S.StateService.MarkFull(player)
	Remotes.Effect:FireClient(player, "Sell", total)
	return true, ("Sold %d treasures for %s"):format(count, Util.Money(total))
end

-- World treasures --------------------------------------------------------------
local KIND_TEXT = {
	Field = { "Grab", 0.4 },
	Secret = { "Grab", 0.6 },
	Event = { "Grab", 0.8 },
	Market = { "Buy", 0.3 },
}

local function groundAt(pos: Vector3): Vector3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = { worldFolder }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	local result = workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -80, 0), params)
	return result and result.Position or pos
end

-- Current server-side position of a world treasure (accounts for wandering).
function TreasureService.WorldPosition(record): Vector3
	if record.Parade then
		local p = record.Parade
		return p.From + p.Dir * (p.Speed * (now() - p.Start))
	end
	if record.Seed then
		return Motion.Position(record.Home, record.Seed, now(), Config.World.WanderRadius)
	end
	return record.Home.Position
end

function TreasureService.RemoveWorld(uid: string, animate: boolean?)
	local w = TreasureService.World[uid]
	if w then
		TreasureService.World[uid] = nil
		if w.Model then
			if animate then
				-- clients play a shrink-and-sparkle disappear animation
				w.Model:SetAttribute("Despawning", true)
				local prompt = w.Model.PrimaryPart and w.Model.PrimaryPart:FindFirstChild("GrabPrompt")
				if prompt then
					prompt.Enabled = false
				end
				local m = w.Model
				task.delay(0.6, function()
					m:Destroy()
				end)
			else
				w.Model:Destroy()
			end
		end
	end
end

local tryPickup -- forward

function TreasureService.SpawnWorld(def, cf: CFrame, kind: string, extra)
	local uid = Util.NewUid()
	local scale = (kind == "Market" or kind == "Parade") and 1.15 or 1
	local mutation = extra and extra.Mutation
	local model = TreasureModels.Build(def, { CFrame = cf, Scale = scale, Mutation = mutation })
	model:SetAttribute("WorldUid", uid)
	model:SetAttribute("Kind", kind)
	if extra and extra.Parade then
		model:SetAttribute("ParadeStart", extra.Parade.Start)
		model:SetAttribute("ParadeFrom", extra.Parade.From)
		model:SetAttribute("ParadeDir", extra.Parade.Dir)
		model:SetAttribute("ParadeSpeed", extra.Parade.Speed)
	end
	local root = model.PrimaryPart :: BasePart
	local label = S.BaseService.MakeLabel(root, def, TreasureModels.Height(def, scale), mutation)
	label.MaxDistance = 90
	local price = extra and extra.Price
	if price then
		model:SetAttribute("Price", price)
		local priceLabel = Instance.new("TextLabel")
		priceLabel.Name = "Price"
		priceLabel.BackgroundColor3 = Color3.fromRGB(30, 160, 60)
		priceLabel.Position = UDim2.new(0.15, 0, -0.45, 0)
		priceLabel.Size = UDim2.fromScale(0.7, 0.4)
		priceLabel.Font = Enum.Font.FredokaOne
		priceLabel.TextScaled = true
		priceLabel.TextColor3 = Color3.new(1, 1, 1)
		priceLabel.Text = Util.Money(price)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.3, 0)
		corner.Parent = priceLabel
		priceLabel.Parent = label
		label.Size = UDim2.fromOffset(180, 54)
		label.StudsOffset += Vector3.new(0, 1.2, 0)
	end
	local text = KIND_TEXT[kind] or KIND_TEXT.Field
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GrabPrompt"
	prompt.ActionText = price and ("Buy " .. Util.Money(price)) or text[1]
	prompt.ObjectText = def.Name .. " (" .. def.Rarity .. ")"
	prompt.HoldDuration = text[2]
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Kind", kind)
	prompt.Parent = root
	-- Field treasures roam around (walk / run / jump / dance) on a deterministic
	-- path every client renders identically; the server validates against it.
	local wander = kind == "Field" and not (extra and extra.NoWander)
	local seed = rng:NextInteger(1, 1000000)
	if wander then
		model:SetAttribute("WanderSeed", seed)
		model:SetAttribute("WanderRadius", Config.World.WanderRadius)
	end
	model:SetAttribute("SpawnTime", now())
	local record = {
		Uid = uid,
		Id = def.Id,
		Kind = kind,
		Model = model,
		Home = cf,
		Seed = wander and seed or nil,
		Mutation = mutation,
		Parade = extra and extra.Parade,
		Spawned = os.clock(),
		Price = price,
		Region = extra and extra.Region,
		Lifetime = extra and extra.Lifetime or Config.Spawns.Lifetime,
	}
	TreasureService.World[uid] = record
	prompt.Triggered:Connect(function(player)
		tryPickup(player, uid)
	end)
	model.Parent = worldFolder
	if Rarities.Info[def.Rarity].Announce and kind ~= "Event" then
		local where = (kind == "Market" or kind == "Parade") and "the Treasure Parade" or (extra and extra.Region) or "the world"
		Remotes.Announce:FireAllClients(("✨ A %s %s appeared in %s!"):format(def.Rarity, def.Name, tostring(where)), def.Rarity)
	end
	return record
end

function TreasureService.DropToWorld(id: string, position: Vector3, kind: string?)
	local def = TreasureData.Get(id)
	if not def then
		return
	end
	local ground = groundAt(position)
	TreasureService.SpawnWorld(def, CFrame.new(ground), kind == "Market" and "Field" or (kind or "Field"), { Lifetime = 60, Region = "Dropped" })
end

tryPickup = function(player: Player, uid: string)
	local record = TreasureService.World[uid]
	local session = S.DataService.Session(player)
	local data = S.DataService.Get(player)
	if not record or not session or not data then
		return false
	end
	local hrp = hrpOf(player)
	if not hrp then
		return false
	end
	if (TreasureService.WorldPosition(record) - hrp.Position).Magnitude > Config.Spawns.PickupDistance + 5 then
		return false
	end
	if session.Trade then
		S.NetService.Notify(player, "Finish your trade first", "error")
		return false
	end
	if not record.Price and not S.CarryService.CanCarry(player) then
		S.NetService.Notify(player, "Your hands are full! Bring your treasure home first.", "error")
		return false
	end
	if TreasureService.IsFull(player, S.CarryService.Count(player) + 1) then
		S.NetService.Notify(player, "Your base & storage are full! Sell or expand.", "error")
		return false
	end
	if record.Price then
		if data.Money < record.Price then
			S.NetService.Notify(player, ("You need %s more!"):format(Util.Money(record.Price - data.Money)), "error")
			return false
		end
		data.Money -= record.Price
		-- Bought! It walks itself to your base (no carrying needed).
		local from = TreasureService.WorldPosition(record)
		TreasureService.RemoveWorld(uid, false)
		S.TreasureService.Give(player, record.Id, { Source = "Parade", Mutation = record.Mutation, WalkFrom = from })
		Remotes.Effect:FireClient(player, "Purchase")
		S.NetService.Notify(player, "🛒 Purchased! It's walking to your base.", "success")
		S.StateService.PushStats(player)
		return true
	end
	TreasureService.RemoveWorld(uid, true)
	-- Luck: chance to upgrade a free treasure by one rarity tier
	local id = record.Id
	if not record.Price then
		local luck = S.EconomyService.Luck(player)
		local chance = math.min(Config.Luck.MaxUpgradeChance, (luck - 1) * Config.Luck.UpgradeChancePerLuck)
		if chance > 0 and rng:NextNumber() < chance then
			local def = TreasureData.Get(id)
			local nextRarity = Rarities.Order[Rarities.Rank(def.Rarity) + 1]
			if nextRarity then
				id = TreasureData.RandomOfRarity(nextRarity, rng).Id
				S.NetService.Notify(player, ("🍀 LUCKY! It turned into a %s!"):format(nextRarity), "discovery")
			end
		end
	end
	S.CarryService.Add(player, { Id = id, Source = record.Kind, Mut = record.Mutation })
	Remotes.Effect:FireClient(player, "Pickup", TreasureData.Get(id).Rarity)
	S.StateService.PushStats(player)
	return true
end
TreasureService.TryPickup = tryPickup

local function countKind(kind: string, region): number
	local n = 0
	for _, w in pairs(TreasureService.World) do
		if w.Kind == kind and w.Region == region then
			n += 1
		end
	end
	return n
end

local function spawnInField(field, pool)
	local r = rng:NextNumber(0, field.Radius)
	local a = rng:NextNumber(0, math.pi * 2)
	local pos = field.Center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
	local ground = groundAt(pos)
	local def = TreasureData.RollFromPool(pool or Config.SpawnPools.Field, rng)
	local mutation = Mutations.Roll(rng, 1 + S.EconomyService.EventLuck, TreasureService.EventMutation)
	return TreasureService.SpawnWorld(def, CFrame.new(ground) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), "Field", { Region = field.Name, Mutation = mutation })
end
TreasureService.SpawnInField = spawnInField

local function restockMarket()
	-- clear old stock
	for uid, w in pairs(TreasureService.World) do
		if w.Kind == "Market" then
			TreasureService.RemoveWorld(uid, true)
		end
	end
	for _, stall in ipairs(S.MapBuilder.Map.Stalls) do
		local def = TreasureData.RollFromPool(Config.SpawnPools.Market, rng)
		local price = math.floor(def.Value * Config.Market.PriceMultiplier)
		TreasureService.SpawnWorld(def, stall.CFrame * CFrame.Angles(0, math.pi, 0), "Market", { Price = price, Region = "Stall" .. stall.Index, Lifetime = math.huge })
	end
	nextRestock = now() + Config.Market.RestockSeconds
	workspace:SetAttribute("MarketRestock", nextRestock)
end

-- Remote handlers ------------------------------------------------------------------
function TreasureService.Init(services)
	S = services
end

function TreasureService.Start()
	worldFolder = Instance.new("Folder")
	worldFolder.Name = "WorldTreasures"
	worldFolder.Parent = workspace

	local gem = S.MapBuilder.Map.FountainGem
	if gem then
		local _, label = S.MapBuilder.Billboard(gem, "", Color3.fromRGB(255, 255, 255), UDim2.fromOffset(300, 50), 9)
		marketSign = label
	end

	S.NetService.Handle("Store", function(player, uid)
		return TreasureService.Store(player, uid)
	end)
	S.NetService.Handle("Place", function(player, uid, plot)
		return TreasureService.Place(player, uid, plot)
	end)
	S.NetService.Handle("Sell", function(player, uid)
		return TreasureService.Sell(player, uid)
	end)
	S.NetService.Handle("SellStorage", function(player, maxRank)
		return TreasureService.SellStorage(player, maxRank)
	end)
	S.NetService.Handle("PlaceAll", function(player)
		local data = S.DataService.Get(player)
		if not data then
			return false, "Not ready"
		end
		local placed = 0
		for uid, entry in pairs(data.Treasures) do
			if not entry.Plot then
				local plot = S.BaseService.FreePlot(player)
				if not plot then
					break
				end
				entry.Plot = plot
				placed += 1
			end
		end
		S.BaseService.Refresh(player)
		S.StateService.MarkFull(player)
		return placed > 0, placed > 0 and ("Placed %d treasures"):format(placed) or "No free platforms"
	end)

	restockMarket()

	-- Treasure Parade: a new treasure walks onto the carpet every few seconds
	task.spawn(function()
		local parade = S.MapBuilder.Map.Parade
		local P = Config.Parade
		local dir = (parade.End - parade.Start).Unit
		local lifetime = (parade.End - parade.Start).Magnitude / P.Speed
		while true do
			local luck = 1 + S.EconomyService.EventLuck
			local pool = Config.SpawnPools.Market
			if S.EconomyService.EventLuck > 0 then
				pool = Config.SpawnPools.Lucky
			end
			local def = TreasureData.RollFromPool(pool, rng)
			local mutation = Mutations.Roll(rng, luck, TreasureService.EventMutation)
			local price = math.floor(def.Value * Mutations.Multiplier(mutation) * Config.Market.PriceMultiplier)
			local start = now()
			TreasureService.SpawnWorld(def, CFrame.lookAt(parade.Start, parade.Start + dir), "Parade", {
				Price = price,
				Mutation = mutation,
				Region = "Parade",
				Lifetime = lifetime,
				Parade = { Start = start, From = parade.Start, Dir = dir, Speed = P.Speed },
			})
			task.wait(P.Interval)
		end
	end)

	-- spawn + cleanup loop
	task.spawn(function()
		local fieldTimer, secretTimer = 0, 0
		while true do
			task.wait(1)
			fieldTimer += 1
			secretTimer += 1
			if fieldTimer >= Config.Spawns.FieldInterval then
				fieldTimer = 0
				for _, field in ipairs(S.MapBuilder.Map.Fields) do
					if countKind("Field", field.Name) < Config.Spawns.MaxPerField and rng:NextNumber() < 0.6 then
						spawnInField(field)
					end
				end
			end
			if secretTimer >= Config.Spawns.SecretInterval then
				secretTimer = 0
				for _, secret in ipairs(S.MapBuilder.Map.Secrets) do
					if countKind("Secret", secret.Name) < Config.Spawns.MaxPerSecret then
						local spot = secret.Spawns[rng:NextInteger(1, #secret.Spawns)]
						local def = TreasureData.RollFromPool(Config.SpawnPools.Secret, rng)
						TreasureService.SpawnWorld(def, CFrame.new(spot) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), "Secret", { Region = secret.Name })
					end
				end
			end
			-- despawn expired
			local t = os.clock()
			for uid, w in pairs(TreasureService.World) do
				if w.Kind ~= "Market" and t - w.Spawned > w.Lifetime then
					-- parade treasures that reach the exit arch disappear
					TreasureService.RemoveWorld(uid, true)
				end
			end
			-- market restock
			local remaining = nextRestock - now()
			if remaining <= 0 then
				restockMarket()
				remaining = Config.Market.RestockSeconds
			end
			if marketSign then
				marketSign.Text = "🛒 Buy treasures on the Treasure Parade →"
			end
		end
	end)

	-- secret discovery + treasure magnet
	task.spawn(function()
		local tickN = 0
		while true do
			task.wait(0.5)
			tickN += 1
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.DataService.Get(player)
				local hrp = hrpOf(player)
				if data and hrp then
					if tickN % 2 == 0 then
						for _, secret in ipairs(S.MapBuilder.Map.Secrets) do
							if not data.Secrets[secret.Name] then
								local rel = secret.Zone.CFrame:PointToObjectSpace(hrp.Position)
								local half = secret.Zone.Size / 2
								if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z then
									data.Secrets[secret.Name] = true
									local reward = 2500 * (1 + data.Rebirths)
									S.EconomyService.AddMoney(player, reward)
									S.EconomyService.AddXP(player, 100)
									S.EconomyService.AddGems(player, Config.Gems.SecretFound)
									S.NetService.Notify(player, ("🗺️ SECRET FOUND: %s! +%s"):format(secret.Name, Util.Money(reward)), "discovery")
									Remotes.Effect:FireClient(player, "Confetti")
									S.StateService.MarkFull(player)
								end
							end
						end
					end
					if data.Abilities.Magnet then
						local radius = 18
						for uid, w in pairs(TreasureService.World) do
							if w.Kind ~= "Market" and w.Kind ~= "Parade" and w.Model then
								if (TreasureService.WorldPosition(w) - hrp.Position).Magnitude <= radius then
									if not S.CarryService.CanCarry(player) then
										break
									end
									-- magnet: grab it from range (validated with the magnet radius)
									w.Seed = nil
									w.Home = CFrame.new(hrp.Position)
									tryPickup(player, uid)
								end
							end
						end
					end
				end
			end
		end
	end)
end

return TreasureService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">WorldService</string><ProtectedString name="Source"><![CDATA[-- WorldService.lua
-- Living world systems:
--   * day/night cycle (server publishes the clock; clients render it smoothly)
--   * weather (Clear, Cloudy, Rain, Storm, Fog) + wind
--   * treasure chests that spawn around the map and open with an animation
--   * animated portals (server-validated teleports)
--   * golden coins used by events (touch to collect)

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TreasureData = require(Shared.TreasureData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local S

local WorldService = {}

local rng = Random.new()
local chests: { [Model]: { Spot: Vector3, Opened: boolean } } = {}
local chestFolder: Folder
local coinFolder: Folder

local function now()
	return workspace:GetServerTimeNow()
end

local function hrpOf(player: Player): BasePart?
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Weather -----------------------------------------------------------------------
local WIND = {
	Clear = Vector3.new(6, 0, 3),
	Cloudy = Vector3.new(10, 0, 5),
	Rain = Vector3.new(16, 0, 8),
	Storm = Vector3.new(30, 0, 18),
	Fog = Vector3.new(3, 0, 1),
}

function WorldService.SetWeather(name: string)
	workspace:SetAttribute("Weather", name)
	workspace.GlobalWind = WIND[name] or WIND.Clear
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		clouds.Cover = (name == "Clear" and 0.45) or (name == "Fog" and 0.75) or (name == "Cloudy" and 0.75) or 0.9
		clouds.Density = (name == "Storm" or name == "Rain") and 0.95 or 0.7
		clouds.Color = (name == "Storm" or name == "Rain") and Color3.fromRGB(150, 155, 170) or Color3.fromRGB(255, 255, 255)
	end
end

local function weatherLoop()
	WorldService.SetWeather("Clear")
	while true do
		task.wait(rng:NextNumber(Config.World.WeatherMin, Config.World.WeatherMax))
		local total = 0
		for _, w in pairs(Config.World.Weather) do
			total += w
		end
		local pick = rng:NextNumber() * total
		for name, w in pairs(Config.World.Weather) do
			pick -= w
			if pick <= 0 then
				WorldService.SetWeather(name)
				if name == "Storm" then
					Remotes.Announce:FireAllClients("⛈️ A storm is rolling in!", "Rare")
				elseif name == "Rain" then
					Remotes.Notify:FireAllClients("🌧️ It started raining.", "info")
				end
				break
			end
		end
	end
end

-- Chests -----------------------------------------------------------------------
local function buildChest(cf: CFrame): Model
	local P = S.MapBuilder.Part
	local m = Instance.new("Model")
	m.Name = "TreasureChest"
	local wood = Color3.fromRGB(140, 85, 40)
	local gold = Color3.fromRGB(255, 205, 60)
	local base = P(m, Vector3.new(4, 2.4, 2.8), cf * CFrame.new(0, 1.2, 0), wood, Enum.Material.Wood, { Name = "Base" })
	P(m, Vector3.new(4.1, 0.4, 2.9), cf * CFrame.new(0, 2.3, 0), gold, Enum.Material.Metal)
	for _, x in ipairs({ -1.5, 1.5 }) do
		P(m, Vector3.new(0.35, 2.45, 2.9), cf * CFrame.new(x, 1.2, 0), gold, Enum.Material.Metal)
	end
	P(m, Vector3.new(3.4, 0.3, 2.2), cf * CFrame.new(0, 2.45, 0), Color3.fromRGB(255, 220, 90), Enum.Material.Neon, { Name = "Treasure", CanCollide = false })
	-- lid (hinged at the back edge; the client rotates it open)
	local lid = Instance.new("Model")
	lid.Name = "Lid"
	local hinge = P(lid, Vector3.new(4, 0.2, 0.2), cf * CFrame.new(0, 2.5, -1.4), gold, Enum.Material.Metal, { Name = "Hinge", CanCollide = false })
	P(lid, Vector3.new(4, 0.8, 2.8), cf * CFrame.new(0, 2.9, 0), wood, Enum.Material.Wood, { CanCollide = false })
	P(lid, Vector3.new(4.1, 0.3, 2.9), cf * CFrame.new(0, 3.2, 0), gold, Enum.Material.Metal, { CanCollide = false })
	P(lid, Vector3.new(0.6, 0.7, 0.2), cf * CFrame.new(0, 2.6, 1.45), gold, Enum.Material.Metal, { CanCollide = false })
	lid.PrimaryPart = hinge
	lid.Parent = m
	local glow = Instance.new("PointLight")
	glow.Color = gold
	glow.Range = 12
	glow.Brightness = 1.5
	glow.Parent = base
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(gold)
	sparkle.Rate = 6
	sparkle.LightEmission = 1
	sparkle.Speed = NumberRange.new(1, 2)
	sparkle.Size = NumberSequence.new(0.4, 0)
	sparkle.Parent = base
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open"
	prompt.ObjectText = "🧰 Treasure Chest"
	prompt.HoldDuration = 1
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	m.PrimaryPart = base
	return m
end

local function openChest(player: Player, chest: Model)
	local info = chests[chest]
	local hrp = hrpOf(player)
	local data = S.DataService.Get(player)
	if not info or info.Opened or not hrp or not data then
		return
	end
	if (chest:GetPivot().Position - hrp.Position).Magnitude > 16 then
		return
	end
	info.Opened = true
	chest:SetAttribute("Opened", true) -- clients play the lid animation
	data.Stats.ChestsOpened += 1
	local session = S.DataService.Session(player)
	local mps = session and session.MPS or 0
	local gems = rng:NextInteger(5, 20)
	local money = math.floor(math.max(500, mps * 45) * rng:NextNumber(0.8, 1.4))
	S.EconomyService.AddGems(player, gems)
	S.EconomyService.AddMoney(player, money)
	local text = ("🧰 Chest opened! +%s  +%d 💎"):format(Util.Money(money), gems)
	if rng:NextNumber() < 0.2 then
		local def = TreasureData.RollFromPool({ Rare = 50, Epic = 35, Legendary = 12, Mythical = 3 }, rng)
		S.TreasureService.Give(player, def.Id, { Source = "Chest" })
		text ..= (" and a %s %s!"):format(def.Rarity, def.Name)
	end
	S.NetService.Notify(player, text, "discovery")
	Remotes.Effect:FireClient(player, "ChestOpen", chest:GetPivot().Position)
	S.PlayerService.Emote(player, "Celebrate", 2.5)
	task.delay(3.5, function()
		chests[chest] = nil
		chest:SetAttribute("Despawning", true)
		task.wait(0.6)
		chest:Destroy()
	end)
end

local function spawnChest()
	local spots = S.MapBuilder.Map.ChestSpots
	if #spots == 0 then
		return
	end
	local count = 0
	local used = {}
	for _, info in pairs(chests) do
		count += 1
		used[info.Spot] = true
	end
	if count >= Config.World.MaxChests then
		return
	end
	for _ = 1, 10 do
		local spot = spots[rng:NextInteger(1, #spots)]
		if not used[spot] then
			local cf = CFrame.new(spot) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
			local chest = buildChest(cf)
			chests[chest] = { Spot = spot, Opened = false }
			local prompt = chest.PrimaryPart:FindFirstChildOfClass("ProximityPrompt")
			prompt.Triggered:Connect(function(player)
				openChest(player, chest)
			end)
			chest.Parent = chestFolder
			return
		end
	end
end

-- Coins ---------------------------------------------------------------------------
function WorldService.SpawnCoin(position: Vector3)
	local coin = Instance.new("Part")
	coin.Name = "GoldCoin"
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.4, 2.2, 2.2)
	coin.Color = Color3.fromRGB(255, 205, 50)
	coin.Material = Enum.Material.Foil
	coin.Anchored = true
	coin.CanCollide = false
	coin.CanTouch = true
	coin.CFrame = CFrame.new(position + Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, 0)
	local l = Instance.new("PointLight")
	l.Color = coin.Color
	l.Range = 6
	l.Parent = coin
	CollectionService:AddTag(coin, "Spin")
	coin:SetAttribute("SpinSpeed", 3)
	CollectionService:AddTag(coin, "Bob")
	coin:SetAttribute("BobHeight", 0.5)
	local taken = false
	coin.Touched:Connect(function(hit)
		if taken then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player then
			return
		end
		local hrp = hrpOf(player)
		if not hrp or (hrp.Position - coin.Position).Magnitude > 10 then
			return
		end
		taken = true
		local session = S.DataService.Session(player)
		local value = math.floor(math.max(50, (session and session.MPS or 0) * Config.Events.CoinValueSeconds))
		S.EconomyService.AddMoney(player, value)
		Remotes.Effect:FireClient(player, "Coin", value)
		coin:Destroy()
	end)
	coin.Parent = coinFolder
	Debris:AddItem(coin, 60)
	return coin
end

-- Portals ------------------------------------------------------------------------
local function hookPortals()
	for _, disc in ipairs(CollectionService:GetTagged("Portal")) do
		local cooldown = {}
		disc.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			local hrp = player and hrpOf(player)
			if not player or not hrp then
				return
			end
			if cooldown[player] and os.clock() - cooldown[player] < 3 then
				return
			end
			cooldown[player] = os.clock()
			local data = S.DataService.Get(player)
			local need = disc:GetAttribute("RequiresSecret")
			if need and data and not data.Secrets[need] then
				S.NetService.Notify(player, ("🔒 Discover %s on foot first to unlock this portal!"):format(need), "warn")
				return
			end
			if S.DataService.Session(player) and #S.DataService.Session(player).Carrying > 0 then
				S.NetService.Notify(player, "You can't use portals while carrying treasure!", "error")
				return
			end
			local target = disc:GetAttribute("PortalTo")
			if typeof(target) == "Vector3" then
				Remotes.Effect:FireClient(player, "Portal")
				hrp.CFrame = CFrame.new(target)
			end
		end)
	end
end

function WorldService.Init(services)
	S = services
end

function WorldService.Start()
	chestFolder = Instance.new("Folder")
	chestFolder.Name = "Chests"
	chestFolder.Parent = workspace
	coinFolder = Instance.new("Folder")
	coinFolder.Name = "Coins"
	coinFolder.Parent = workspace

	-- day/night clock: clients compute ClockTime from these attributes
	workspace:SetAttribute("DayLength", Config.World.DayLength)
	workspace:SetAttribute("DayStart", now() - Config.World.DayLength * 0.3)

	task.spawn(weatherLoop)
	hookPortals()
	task.spawn(function()
		for _ = 1, 3 do
			spawnChest()
		end
		while true do
			task.wait(Config.World.ChestInterval)
			spawnChest()
		end
	end)
end

return WorldService
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX00000045"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000044"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000043"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX00000031"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">Ambience</string><ProtectedString name="Source"><![CDATA[-- Ambience.lua
-- Client-side environment animation and atmosphere:
--   * smooth day/night cycle (server clock), night lamps, stars
--   * weather: clouds, rain, storms with lightning + thunder, fog
--   * event sky tints (Apocalypse red, Double Money gold, Lucky green ...)
--   * CollectionService animations: Spin, Bob, Pulse, Flag, Tree sway,
--     sliding base doors, sweeping security cameras, opening chests

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local State = require(script.Parent.State)
local Sound = require(script.Parent.Sound)

local Ambience = {}
Ambience.LowGfx = false
Ambience.WeatherEnabled = true

local anims: { [Instance]: any } = {}
local trees: { any } = {}
local pulses: { [BasePart]: any } = {}
local lamps: { BasePart } = {}
local cams: { any } = {}
local rainPart: Part?
local rainEmitter: ParticleEmitter?
local nextLightning = 0
local flashUntil = 0

-- Generic tag animation (Spin / Bob / Flag can stack on one object) ---------
local function register(inst: Instance)
	if anims[inst] then
		return
	end
	local base
	if inst:IsA("Model") then
		if not inst.PrimaryPart then
			return
		end
		base = inst:GetPivot()
	elseif inst:IsA("BasePart") then
		base = inst.CFrame
	else
		return
	end
	anims[inst] = { Base = base, Phase = math.random() * 10 }
end

local function unregister(inst)
	anims[inst] = nil
end

local function animateTagged(t: number, camPos: Vector3)
	for inst, a in pairs(anims) do
		if not inst.Parent then
			anims[inst] = nil
		elseif (a.Base.Position - camPos).Magnitude < 260 then
			local cf = a.Base
			if CollectionService:HasTag(inst, "Bob") then
				local h = inst:GetAttribute("BobHeight") or 0.5
				local sp = inst:GetAttribute("BobSpeed") or 1.2
				cf = cf + Vector3.new(0, math.sin(t * sp + a.Phase) * h, 0)
			end
			if CollectionService:HasTag(inst, "Spin") then
				local sp = inst:GetAttribute("SpinSpeed") or 1
				local axis = inst:GetAttribute("SpinAxis") or "Y"
				local ang = (t * sp) % (math.pi * 2)
				if axis == "Z" then
					cf = cf * CFrame.Angles(0, 0, ang)
				elseif axis == "X" then
					cf = cf * CFrame.Angles(ang, 0, 0)
				else
					cf = cf * CFrame.Angles(0, ang, 0)
				end
			end
			if CollectionService:HasTag(inst, "Flag") then
				local amt = inst:GetAttribute("SwayAmount") or 0.2
				local wind = workspace.GlobalWind.Magnitude / 10
				cf = cf * CFrame.Angles(0, math.sin(t * 3 + a.Phase) * amt * wind, math.sin(t * 2.3 + a.Phase) * amt * 0.3)
			end
			if inst:IsA("Model") then
				inst:PivotTo(cf)
			else
				(inst :: BasePart).CFrame = cf
			end
		end
	end
end

-- Trees sway in the wind --------------------------------------------------------
local function registerTree(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local trunk, leaves = nil, {}
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") then
			if p.Material == Enum.Material.Wood and not trunk then
				trunk = p
			else
				table.insert(leaves, p)
			end
		end
	end
	if not trunk or #leaves == 0 then
		return
	end
	local pivot = CFrame.new(trunk.Position - Vector3.new(0, trunk.Size.X / 2, 0))
	local bases = {}
	for i, l in ipairs(leaves) do
		bases[i] = pivot:Inverse() * l.CFrame
	end
	table.insert(trees, { Pivot = pivot, Leaves = leaves, Bases = bases, Phase = math.random() * 10 })
end

local function swayTrees(t: number, camPos: Vector3)
	local wind = workspace.GlobalWind
	local strength = math.clamp(wind.Magnitude / 12, 0.3, 3)
	local parts, cfs = {}, {}
	for _, tr in ipairs(trees) do
		if (tr.Pivot.Position - camPos).Magnitude < 170 and tr.Leaves[1].Parent then
			local a = 0.025 * strength
			local rot = CFrame.Angles(math.sin(t * 1.3 + tr.Phase) * a, 0, math.cos(t * 1.1 + tr.Phase) * a)
			for i, leaf in ipairs(tr.Leaves) do
				table.insert(parts, leaf)
				table.insert(cfs, tr.Pivot * rot * tr.Bases[i])
			end
		end
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Pulse (glowing lights) ---------------------------------------------------------
local function registerPulse(p: Instance)
	if p:IsA("BasePart") then
		pulses[p] = { Base = p.Transparency, Phase = math.random() * 10 }
	end
end

-- Day / night ----------------------------------------------------------------------
local DAY_AMBIENT = Color3.fromRGB(90, 90, 110)
local NIGHT_AMBIENT = Color3.fromRGB(40, 45, 80)
local DAY_OUT = Color3.fromRGB(150, 150, 170)
local NIGHT_OUT = Color3.fromRGB(60, 70, 120)

local EVENT_TINT = {
	["Treasure Apocalypse"] = Color3.fromRGB(255, 140, 130),
	["Double Money"] = Color3.fromRGB(255, 235, 170),
	["Lucky Treasure"] = Color3.fromRGB(190, 255, 190),
	["Secret Treasure"] = Color3.fromRGB(210, 180, 255),
	["Golden Treasure Rain"] = Color3.fromRGB(255, 240, 190),
	["Meteor Shower"] = Color3.fromRGB(255, 210, 180),
	["Divine Descent"] = Color3.fromRGB(255, 255, 230),
}

local function updateSky(dt: number)
	local start = workspace:GetAttribute("DayStart")
	local length = workspace:GetAttribute("DayLength")
	local clock = Lighting.ClockTime
	if typeof(start) == "number" and typeof(length) == "number" and length > 0 then
		clock = (6 + ((State.Now() - start) / length) * 24) % 24
		Lighting.ClockTime = clock
	end
	-- daylight factor: 1 at noon, 0 at night
	local day = math.clamp(math.sin((clock - 6) / 12 * math.pi) * 1.6, 0, 1)
	local weather = Ambience.WeatherEnabled and (workspace:GetAttribute("Weather") or "Clear") or "Clear"
	local gloom = (weather == "Storm" and 0.5) or (weather == "Rain" and 0.3) or (weather == "Cloudy" and 0.15) or 0
	Lighting.Brightness = os.clock() < flashUntil and 8 or (0.6 + day * 2.2) * (1 - gloom * 0.6)
	Lighting.Ambient = NIGHT_AMBIENT:Lerp(DAY_AMBIENT, day)
	Lighting.OutdoorAmbient = NIGHT_OUT:Lerp(DAY_OUT, day)
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		local targetDensity = (weather == "Fog" and 0.6) or (weather == "Storm" and 0.45) or (weather == "Rain" and 0.38) or 0.28
		atmo.Density += (targetDensity - atmo.Density) * math.min(1, dt * 0.5)
	end
	local cc = Lighting:FindFirstChild("GameColor")
	if cc and cc:IsA("ColorCorrectionEffect") then
		local tint = EVENT_TINT[workspace:GetAttribute("Event") or ""] or Color3.new(1, 1, 1)
		cc.TintColor = cc.TintColor:Lerp(tint, math.min(1, dt * 1.5))
	end
	-- night lamps
	local night = day < 0.3
	for _, lamp in ipairs(lamps) do
		if lamp.Parent then
			local light = lamp:FindFirstChildWhichIsA("Light")
			if light then
				light.Enabled = night or lamp.Name == "LighthouseLamp"
				if light:IsA("PointLight") then
					light.Brightness = night and 2.5 or 1
				end
			end
			lamp.Material = night and Enum.Material.Neon or Enum.Material.Glass
		end
	end
	-- rain
	if rainPart and rainEmitter then
		local cam = workspace.CurrentCamera
		if cam then
			rainPart.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, 45, 0))
		end
		local rate = (weather == "Storm" and 900) or (weather == "Rain" and 450) or 0
		if Ambience.LowGfx then
			rate *= 0.3
		end
		rainEmitter.Rate = rate
		rainEmitter.Acceleration = Vector3.new(workspace.GlobalWind.X, 0, workspace.GlobalWind.Z)
	end
	-- lightning
	if weather == "Storm" and os.clock() > nextLightning then
		nextLightning = os.clock() + 4 + math.random() * 7
		flashUntil = os.clock() + 0.09
		task.delay(0.2, function()
			flashUntil = os.clock() + 0.06 -- double flash
		end)
		task.delay(0.6 + math.random(), function()
			Sound.Play("Thunder", 0.7, 0.5)
		end)
	end
end

-- Base doors, cameras, chests -------------------------------------------------------
local function hookDoor(door: Instance)
	if not door:IsA("BasePart") then
		return
	end
	local base = door.Parent
	local function apply()
		local closed = base and base:GetAttribute("Locked") == true
		local target = closed and door:GetAttribute("ClosedCF") or door:GetAttribute("OpenCF")
		if typeof(target) == "CFrame" then
			TweenService:Create(door, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = target }):Play()
		end
	end
	if base then
		base:GetAttributeChangedSignal("Locked"):Connect(apply)
	end
	apply()
end

local function hookCamera(cam: Instance)
	if cam:IsA("Model") and cam.PrimaryPart then
		table.insert(cams, { Model = cam, Base = cam:GetPivot(), Phase = math.random() * 6, Lens = cam:FindFirstChild("Lens") })
	end
end

local function hookChest(chest: Instance)
	if not chest:IsA("Model") then
		return
	end
	local function open()
		local lid = chest:FindFirstChild("Lid")
		if not lid or not lid.PrimaryPart then
			return
		end
		local start = lid:GetPivot()
		Sound.Play("ChestOpen", 0.8)
		local value = Instance.new("NumberValue")
		value.Changed:Connect(function(v)
			if lid.Parent then
				lid:PivotTo(start * CFrame.Angles(math.rad(-v), 0, 0))
			end
		end)
		TweenService:Create(value, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = 115 }):Play()
		local base = chest.PrimaryPart
		local burst = base and base:FindFirstChildOfClass("ParticleEmitter")
		if burst then
			burst.Rate = 0
			burst:Emit(60)
		end
	end
	if chest:GetAttribute("Opened") then
		open()
	else
		chest:GetAttributeChangedSignal("Opened"):Connect(open)
	end
	chest:GetAttributeChangedSignal("Despawning"):Connect(function()
		local s = 1
		task.spawn(function()
			while s > 0.05 and chest.Parent do
				s -= 0.1
				pcall(function()
					chest:ScaleTo(math.max(0.05, s))
				end)
				task.wait(0.03)
			end
		end)
	end)
end

local function updateCams(t: number)
	local now = State.Now()
	for _, c in ipairs(cams) do
		if c.Model.Parent then
			c.Model:PivotTo(c.Base * CFrame.Angles(0, math.sin(t * 0.8 + c.Phase) * 0.7, 0))
			local base = c.Model.Parent
			local alert = base:GetAttribute("CameraAlert") or 0
			if c.Lens then
				c.Lens.Color = (now - alert < 5) and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(60, 255, 120)
			end
		end
	end
end

local function watchTag(tagName: string, fn)
	for _, inst in ipairs(CollectionService:GetTagged(tagName)) do
		task.spawn(fn, inst)
	end
	CollectionService:GetInstanceAddedSignal(tagName):Connect(fn)
end

function Ambience.SetSettings(settings)
	Ambience.LowGfx = settings.LowGfx == true
	Ambience.WeatherEnabled = settings.Weather ~= false
end

function Ambience.Start()
	for _, tagName in ipairs({ "Spin", "Bob", "Flag" }) do
		watchTag(tagName, register)
		CollectionService:GetInstanceRemovedSignal(tagName):Connect(unregister)
	end
	watchTag("Tree", registerTree)
	watchTag("Pulse", registerPulse)
	watchTag("Lamp", function(p)
		if p:IsA("BasePart") then
			table.insert(lamps, p)
		end
	end)
	watchTag("SlidingDoor", hookDoor)
	watchTag("SecurityCam", hookCamera)
	task.spawn(function()
		local chests = workspace:WaitForChild("Chests", 30)
		if chests then
			for _, c in ipairs(chests:GetChildren()) do
				hookChest(c)
			end
			chests.ChildAdded:Connect(hookChest)
		end
	end)

	-- rain emitter that follows the camera
	rainPart = Instance.new("Part")
	rainPart.Name = "RainEmitter"
	rainPart.Anchored = true
	rainPart.CanCollide = false
	rainPart.CanQuery = false
	rainPart.CanTouch = false
	rainPart.Transparency = 1
	rainPart.Size = Vector3.new(170, 1, 170)
	rainPart.Parent = workspace
	rainEmitter = Instance.new("ParticleEmitter")
	rainEmitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	rainEmitter.Color = ColorSequence.new(Color3.fromRGB(190, 220, 255))
	rainEmitter.LightEmission = 0.3
	rainEmitter.Transparency = NumberSequence.new(0.35)
	rainEmitter.Size = NumberSequence.new(0.18)
	rainEmitter.Squash = NumberSequence.new(-3)
	rainEmitter.EmissionDirection = Enum.NormalId.Bottom
	rainEmitter.Speed = NumberRange.new(80, 95)
	rainEmitter.Lifetime = NumberRange.new(0.8, 1)
	rainEmitter.SpreadAngle = Vector2.new(4, 4)
	rainEmitter.Rate = 0
	rainEmitter.Parent = rainPart

	local pulseAcc = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.zero
		updateSky(dt)
		animateTagged(t, camPos)
		updateCams(t)
		if not Ambience.LowGfx then
			swayTrees(t, camPos)
		end
		pulseAcc += dt
		if pulseAcc > 0.05 then
			pulseAcc = 0
			for p, info in pairs(pulses) do
				if not p.Parent then
					pulses[p] = nil
				else
					local sp = p:GetAttribute("PulseSpeed") or 1
					p.Transparency = math.clamp(info.Base + (math.sin(t * sp * 2 + info.Phase) + 1) * 0.15, 0, 0.9)
				end
			end
		end
	end)
end

return Ambience
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">Cinematic</string><ProtectedString name="Source"><![CDATA[-- Cinematic.lua
-- Cinematic intro flyover (letterbox, title card, depth of field) shown when
-- you join, plus camera effects (sprint FOV, portal warp).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local Lib = require(script.Parent.Parent.UI.Lib)

local Cinematic = {}
Cinematic.Playing = false

local player = Players.LocalPlayer

local function lerpCF(a: CFrame, b: CFrame, t: number)
	return a:Lerp(b, t * t * (3 - 2 * t))
end

function Cinematic.PlayIntro(gui: ScreenGui)
	if Cinematic.Playing then
		return
	end
	Cinematic.Playing = true
	local cam = workspace.CurrentCamera
	local T = Lib.Theme
	local top = Lib.new("Frame", { Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.new(), BorderSizePixel = 0, ZIndex = 80, Parent = gui })
	local bottom = Lib.new("Frame", { Size = UDim2.new(1, 0, 0, 0), Position = UDim2.fromScale(0, 1), AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = Color3.new(), BorderSizePixel = 0, ZIndex = 80, Parent = gui })
	TweenService:Create(top, TweenInfo.new(0.6), { Size = UDim2.new(1, 0, 0.11, 0) }):Play()
	TweenService:Create(bottom, TweenInfo.new(0.6), { Size = UDim2.new(1, 0, 0.11, 0) }):Play()
	local title = Lib.label({
		Size = UDim2.fromScale(0.8, 0.16),
		Position = UDim2.fromScale(0.5, 0.3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = T.Title,
		Text = "💎 STEAL A TREASURE 💎",
		TextColor3 = T.Accent,
		TextTransparency = 1,
		ZIndex = 81,
		Parent = gui,
		MaxText = 90,
	})
	Lib.textStroke(4).Parent = title
	local sub = Lib.label({
		Size = UDim2.fromScale(0.7, 0.05),
		Position = UDim2.fromScale(0.5, 0.41),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "Collect. Steal. Become the richest!",
		TextTransparency = 1,
		ZIndex = 81,
		Parent = gui,
		MaxText = 30,
	})
	local skip = Lib.button({
		Text = "Skip ⏭",
		Color = T.Panel2,
		Size = UDim2.fromOffset(120, 40),
		Position = UDim2.new(1, -20, 1, -20),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 82,
		Parent = gui,
	})
	local dof = Instance.new("DepthOfFieldEffect")
	dof.FarIntensity = 0.4
	dof.FocusDistance = 60
	dof.InFocusRadius = 40
	dof.NearIntensity = 0.2
	dof.Parent = Lighting

	local skipped = false
	skip.Activated:Connect(function()
		skipped = true
	end)
	cam.CameraType = Enum.CameraType.Scriptable
	local baseIndex = player:GetAttribute("BaseIndex")
	local baseModel = baseIndex and workspace:FindFirstChild("Bases") and workspace.Bases:FindFirstChild("Base" .. baseIndex)
	local basePos = baseModel and baseModel:GetPivot().Position or Vector3.new(0, 0, 200)
	local shots = {
		{ CFrame.lookAt(Vector3.new(-220, 140, -220), Vector3.new(0, 10, 0)), CFrame.lookAt(Vector3.new(220, 120, -200), Vector3.new(0, 10, 0)), 3.5 },
		{ CFrame.lookAt(Vector3.new(60, 30, 80), Vector3.new(0, 8, 0)), CFrame.lookAt(Vector3.new(-60, 22, 60), Vector3.new(0, 8, 0)), 3 },
		{ CFrame.lookAt(basePos + Vector3.new(0, 90, 0) - basePos.Unit * 120, basePos), CFrame.lookAt(basePos + Vector3.new(0, 30, 0) - basePos.Unit * 60, basePos), 3 },
	}
	TweenService:Create(title, TweenInfo.new(1), { TextTransparency = 0 }):Play()
	TweenService:Create(sub, TweenInfo.new(1.5), { TextTransparency = 0 }):Play()
	for _, shot in ipairs(shots) do
		local start = os.clock()
		while os.clock() - start < shot[3] and not skipped do
			cam.CFrame = lerpCF(shot[1], shot[2], (os.clock() - start) / shot[3])
			RunService.RenderStepped:Wait()
		end
		if skipped then
			break
		end
	end
	TweenService:Create(title, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
	TweenService:Create(sub, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
	TweenService:Create(top, TweenInfo.new(0.5), { Size = UDim2.new(1, 0, 0, 0) }):Play()
	TweenService:Create(bottom, TweenInfo.new(0.5), { Size = UDim2.new(1, 0, 0, 0) }):Play()
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = 95
	TweenService:Create(cam, TweenInfo.new(1, Enum.EasingStyle.Quad), { FieldOfView = 70 }):Play()
	TweenService:Create(dof, TweenInfo.new(1), { FarIntensity = 0, NearIntensity = 0 }):Play()
	skip:Destroy()
	task.delay(1.2, function()
		title:Destroy()
		sub:Destroy()
		top:Destroy()
		bottom:Destroy()
		dof:Destroy()
	end)
	Cinematic.Playing = false
end

-- Smoothly widen FOV while sprinting
function Cinematic.Start()
	RunService.RenderStepped:Connect(function(dt)
		if Cinematic.Playing then
			return
		end
		local char = player.Character
		local cam = workspace.CurrentCamera
		if not char or not cam then
			return
		end
		local target = char:GetAttribute("Sprinting") and 80 or 70
		if math.abs(cam.FieldOfView - target) > 0.2 and math.abs(cam.FieldOfView - 70) < 12 then
			cam.FieldOfView += (target - cam.FieldOfView) * math.min(1, dt * 5)
		end
	end)
end

return Cinematic
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">Emotes</string><ProtectedString name="Source"><![CDATA[-- Emotes.lua
-- Procedural character animation layered on top of Roblox's default walk /
-- run / jump animations, for every player on every client:
--   carrying (arms overhead), stealing (crouch + reach), sprinting (lean),
--   celebrate, cheer, wave, dance, victory spin and flex.
-- The server only sets character attributes (Carrying, Stealing, Sprinting,
-- Emote + EmoteEnd); each client animates locally, so it's smooth everywhere.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local State = require(script.Parent.State)

local Emotes = {}

local originals = setmetatable({}, { __mode = "k" }) :: { [Motor6D]: CFrame }
local active = setmetatable({}, { __mode = "k" }) :: { [Model]: boolean }

local R15 = {
	RS = { "RightUpperArm", "RightShoulder" },
	LS = { "LeftUpperArm", "LeftShoulder" },
	RH = { "RightUpperLeg", "RightHip" },
	LH = { "LeftUpperLeg", "LeftHip" },
	Waist = { "UpperTorso", "Waist" },
	Neck = { "Head", "Neck" },
	Root = { "LowerTorso", "Root" },
}
local R6 = {
	RS = { "Torso", "Right Shoulder" },
	LS = { "Torso", "Left Shoulder" },
	RH = { "Torso", "Right Hip" },
	LH = { "Torso", "Left Hip" },
	Neck = { "Torso", "Neck" },
	Root = { "HumanoidRootPart", "RootJoint" },
}

local function joints(char: Model)
	local map = char:FindFirstChild("UpperTorso") and R15 or R6
	local out = {}
	for key, path in pairs(map) do
		local holder = char:FindFirstChild(path[1])
		local j = holder and holder:FindFirstChild(path[2])
		if j and j:IsA("Motor6D") then
			if not originals[j] then
				originals[j] = j.C0
			end
			out[key] = j
		end
	end
	return out, map == R15
end

local rad = math.rad

-- Returns a table of joint -> rotation (and Root may include translation)
local function pose(char: Model, t: number, isR15: boolean)
	local p = {}
	local now = State.Now()
	local emote = char:GetAttribute("Emote")
	local emoteEnd = char:GetAttribute("EmoteEnd") or 0
	if emote and now > emoteEnd then
		emote = nil
	end
	local carrying = (char:GetAttribute("Carrying") or 0) > 0
	local stealing = char:GetAttribute("Stealing") == true
	local sprinting = char:GetAttribute("Sprinting") == true

	-- helpers: raise arm forward (X) or sideways (Z). R6 joints use Z for both.
	local function armForward(key, deg)
		if isR15 then
			p[key] = (p[key] or CFrame.identity) * CFrame.Angles(rad(deg), 0, 0)
		else
			local sign = key == "RS" and 1 or -1
			p[key] = (p[key] or CFrame.identity) * CFrame.Angles(0, 0, rad(deg) * sign)
		end
	end
	local function armSide(key, deg)
		if isR15 then
			local sign = key == "RS" and 1 or -1
			p[key] = (p[key] or CFrame.identity) * CFrame.Angles(0, 0, rad(deg) * sign)
		else
			armForward(key, deg)
		end
	end

	if emote == "Dance" then
		armSide("RS", 70 + 45 * math.sin(t * 8))
		armSide("LS", 70 + 45 * math.sin(t * 8 + math.pi))
		p.Root = CFrame.new(0, math.abs(math.sin(t * 8)) * 0.35, 0) * CFrame.Angles(0, math.sin(t * 4) * 0.5, math.sin(t * 8) * 0.08)
		p.RH = CFrame.Angles(math.sin(t * 8) * 0.4, 0, 0)
		p.LH = CFrame.Angles(-math.sin(t * 8) * 0.4, 0, 0)
		p.Neck = CFrame.Angles(0, 0, math.sin(t * 8) * 0.2)
	elseif emote == "Wave" then
		armSide("RS", 150 + 20 * math.sin(t * 10))
	elseif emote == "Cheer" or emote == "Celebrate" then
		armForward("RS", 165 + 15 * math.sin(t * 12))
		armForward("LS", 165 + 15 * math.sin(t * 12 + 1))
		p.Root = CFrame.new(0, math.abs(math.sin(t * 7)) * 0.9, 0)
		p.Neck = CFrame.Angles(rad(-15), 0, 0)
	elseif emote == "Victory" then
		armSide("RS", 150)
		armSide("LS", 150)
		p.Root = CFrame.new(0, math.abs(math.sin(t * 6)) * 0.6, 0) * CFrame.Angles(0, t * 7, 0)
	elseif emote == "Flex" then
		armSide("RS", 90 + 10 * math.sin(t * 6))
		armSide("LS", 90 + 10 * math.sin(t * 6))
		p.Root = CFrame.new(0, -0.3 + math.abs(math.sin(t * 3)) * 0.2, 0)
	end

	if stealing then
		p.RS, p.LS = nil, nil
		armForward("RS", 80 + 10 * math.sin(t * 14))
		armForward("LS", 80 + 10 * math.sin(t * 14 + 2))
		p.Waist = CFrame.Angles(rad(-25), 0, 0)
		p.Root = CFrame.new(0, -0.5, 0)
	end
	if carrying then
		-- arms locked overhead holding the loot (overrides emote arms)
		p.RS, p.LS = nil, nil
		armForward("RS", 165)
		armForward("LS", 165)
		if isR15 then
			p.RS = p.RS * CFrame.Angles(0, 0, rad(-12))
			p.LS = p.LS * CFrame.Angles(0, 0, rad(12))
		end
	end
	if sprinting and not emote and not stealing then
		p.Waist = (p.Waist or CFrame.identity) * CFrame.Angles(rad(-14), 0, 0)
		p.Neck = (p.Neck or CFrame.identity) * CFrame.Angles(rad(10), 0, 0)
	end
	return p, (emote ~= nil or carrying or stealing or sprinting)
end

local function animateCharacter(char: Model, t: number)
	local js, isR15 = joints(char)
	local p, any = pose(char, t, isR15)
	if not any and not active[char] then
		return
	end
	active[char] = any or nil
	for key, joint in pairs(js) do
		local base = originals[joint]
		local off = p[key]
		if off and not (key == "Root" and not isR15) then
			-- (R6 RootJoint uses a rotated frame, so whole-body moves are R15 only)
			joint.C0 = base * off
		else
			joint.C0 = base
		end
	end
end

function Emotes.Start()
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.zero
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp and (player == Players.LocalPlayer or (hrp.Position - camPos).Magnitude < 180) then
				animateCharacter(char, t)
			end
		end
	end)
end

return Emotes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">Input</string><ProtectedString name="Source"><![CDATA[-- Input.lua
-- Keyboard / gamepad bindings for abilities and menus. Touch players use the
-- on-screen HUD buttons, which call the same actions.

local ContextActionService = game:GetService("ContextActionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local UpgradeData = require(Shared.UpgradeData)
local State = require(script.Parent.State)

local Input = {}

function Input.Init(windows, hud)
	-- Sprint: hold Shift (PC) or toggle with L3 (gamepad); mobile uses the HUD button
	ContextActionService:BindAction("Sprint", function(_, inputState, input)
		if input.KeyCode == Enum.KeyCode.ButtonL3 then
			if inputState == Enum.UserInputState.Begin then
				hud.SetSprint(not (game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:GetAttribute("Sprinting")))
			end
		elseif inputState == Enum.UserInputState.Begin then
			hud.SetSprint(true)
		elseif inputState == Enum.UserInputState.End then
			hud.SetSprint(false)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	ContextActionService:BindAction("Emotes", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			hud.ToggleEmotes()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.T, Enum.KeyCode.ButtonX)
	for key, ab in pairs(UpgradeData.Abilities) do
		if ab.Key then
			ContextActionService:BindAction("Ability_" .. key, function(_, inputState)
				if inputState == Enum.UserInputState.Begin then
					if State.Full and State.Full.Abilities[key] then
						State.Request("UseAbility", key)
					end
				end
				return Enum.ContextActionResult.Pass
			end, false, Enum.KeyCode[ab.Key])
		end
	end
	local menuKeys = {
		{ Enum.KeyCode.B, "Inventory" },
		{ Enum.KeyCode.N, "Index" },
		{ Enum.KeyCode.M, "Shop" },
		{ Enum.KeyCode.L, "LockBase" },
		{ Enum.KeyCode.P, "Pets" },
		{ Enum.KeyCode.DPadUp, "Inventory" },
		{ Enum.KeyCode.DPadLeft, "Pets" },
		{ Enum.KeyCode.DPadRight, "Shop" },
		{ Enum.KeyCode.DPadDown, "Leaderboard" },
		{ Enum.KeyCode.ButtonSelect, "Settings" },
	}
	for i, mk in ipairs(menuKeys) do
		ContextActionService:BindAction("Menu_" .. i, function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				if mk[2] == "LockBase" then
					State.Request("LockBase")
				else
					windows.Toggle(mk[2])
				end
			end
			return Enum.ContextActionResult.Pass
		end, false, mk[1])
	end
	ContextActionService:BindAction("CloseMenu", function(_, inputState)
		if inputState == Enum.UserInputState.Begin and windows.Current then
			windows.Close()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.ButtonB)
end

return Input
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">Music</string><ProtectedString name="Source"><![CDATA[-- Music.lua
-- Background music. If Config.Sounds.Music is set, that track loops.
-- Otherwise a built-in procedural sequencer plays a cheerful soundtrack
-- (melody + bass + arpeggio) using a single short note sample pitched with
-- PlaybackSpeed, so the game has music without uploading audio. The mood
-- changes at night and during events.

local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Music = {}
Music.Enabled = true

local pool: { Sound } = {}
local bassPool: { Sound } = {}
local poolIndex, bassIndex = 1, 1

-- semitone offsets from C; nil = rest
local MELODIES = {
	Day = {
		{ 0, 4, 7, 12, 11, 7, 4, nil, 2, 5, 9, 12, 9, 5, 2, nil },
		{ 7, 9, 7, 4, 0, 2, 4, nil, 5, 7, 5, 2, -1, 2, 7, nil },
		{ 12, 11, 9, 7, 9, 7, 4, 2, 4, 7, 9, 12, 14, 12, 9, nil },
	},
	Night = {
		{ 0, nil, 3, nil, 7, nil, 10, nil, 8, nil, 7, nil, 3, nil, 2, nil },
		{ 7, nil, 5, nil, 3, nil, 2, nil, 0, nil, 3, nil, 7, nil, nil, nil },
	},
	Event = {
		{ 0, 0, 12, 0, 10, 0, 7, 8, 0, 0, 12, 0, 15, 14, 12, 10 },
		{ 0, 3, 7, 10, 12, 10, 7, 3, 5, 8, 12, 15, 17, 15, 12, 8 },
	},
}
local CHORDS = { 0, -3, -7, -5 } -- C, Am, F, G (root offsets)

local function makeSound(id: string, vol: number)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol
	s.Parent = SoundService
	return s
end

local function play(list, idx, semitone: number, octave: number, vol: number)
	local s = list[idx]
	s.PlaybackSpeed = 2 ^ ((semitone + octave * 12) / 12)
	s.Volume = vol
	s.TimePosition = 0
	s:Play()
end

function Music.SetEnabled(on: boolean)
	Music.Enabled = on
	if Music.Track then
		if on then
			Music.Track:Resume()
		else
			Music.Track:Pause()
		end
	end
end

function Music.Start()
	if Config.Sounds.Music ~= "" then
		Music.Track = makeSound(Config.Sounds.Music, 0.3)
		Music.Track.Looped = true
		Music.Track:Play()
		return
	end
	for i = 1, 6 do
		pool[i] = makeSound(Config.Sounds.MusicNote, 0.1)
	end
	for i = 1, 3 do
		bassPool[i] = makeSound(Config.Sounds.MusicBass, 0.12)
	end
	task.spawn(function()
		local bar = 0
		while true do
			local event = (workspace:GetAttribute("Event") or "") ~= ""
			local clock = Lighting.ClockTime
			local night = clock > 20 or clock < 5.5
			local mood = event and "Event" or (night and "Night" or "Day")
			local set = MELODIES[mood]
			local melody = set[(bar % #set) + 1]
			local bpm = event and 150 or (night and 80 or 118)
			local step = 60 / bpm / 2 -- eighth notes
			local chord = CHORDS[(bar % #CHORDS) + 1]
			for i, note in ipairs(melody) do
				if Music.Enabled then
					if note then
						play(pool, poolIndex, note, 0, mood == "Night" and 0.06 or 0.08)
						poolIndex = poolIndex % #pool + 1
					end
					if (i - 1) % 4 == 0 then
						play(bassPool, bassIndex, chord, -1, 0.14)
						bassIndex = bassIndex % #bassPool + 1
					end
					if mood ~= "Night" and (i % 2 == 0) then
						play(pool, poolIndex, chord + ({ 0, 4, 7, 12 })[(i / 2) % 4 + 1], 1, 0.025)
						poolIndex = poolIndex % #pool + 1
					end
				end
				task.wait(step)
			end
			bar += 1
		end
	end)
end

return Music
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">PetFollower</string><ProtectedString name="Source"><![CDATA[-- PetFollower.lua
-- Renders and animates every player's equipped pets locally.
-- Walkers trot with swinging legs and hop when their owner jumps; flyers bob
-- in the air flapping their wings; idle pets breathe, wag tails and look at
-- their owner. Parts are moved with workspace:BulkMoveTo (no physics).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PetData = require(Shared.PetData)
local PetModels = require(Shared.PetModels)

local PetFollower = {}
PetFollower.LowGfx = false

local folder: Folder
local owners: { [Player]: { any } } = {}

local SLOTS = {
	Vector3.new(-4, 0, 4),
	Vector3.new(4, 0, 4),
	Vector3.new(0, 0, 7),
	Vector3.new(-7, 0, 7.5),
	Vector3.new(7, 0, 7.5),
	Vector3.new(0, 0, 10.5),
}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function clear(player: Player)
	for _, pet in ipairs(owners[player] or {}) do
		pet.Model:Destroy()
	end
	owners[player] = nil
end

local function build(player: Player)
	clear(player)
	local raw = player:GetAttribute("Pets")
	if typeof(raw) ~= "string" or raw == "" then
		return
	end
	local ok, ids = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok or typeof(ids) ~= "table" then
		return
	end
	local list = {}
	for i, id in ipairs(ids) do
		local def = PetData.Get(id)
		if def and i <= #SLOTS then
			local model, parts = PetModels.Build(def, 0.8)
			model.Parent = folder
			local partList, offsets = {}, {}
			for _, e in ipairs(parts) do
				table.insert(partList, e.Part)
				table.insert(offsets, e)
			end
			table.insert(list, {
				Def = def,
				Model = model,
				Parts = partList,
				Entries = offsets,
				Slot = SLOTS[i],
				Pos = nil,
				Yaw = 0,
				GroundY = 0,
				NextRay = 0,
				Phase = math.random() * 10,
				JumpStart = -10,
			})
		end
	end
	owners[player] = list
end

local function hook(player: Player)
	player:GetAttributeChangedSignal("Pets"):Connect(function()
		build(player)
	end)
	build(player)
end

local function animatePet(pet, hrp: BasePart, dt: number, t: number, ownerJumping: boolean)
	local sp = PetData.Species[pet.Def.Species] or {}
	local target = (hrp.CFrame * CFrame.new(pet.Slot)).Position
	if not pet.Pos or (pet.Pos - target).Magnitude > 70 then
		pet.Pos = target
	end
	local clock = os.clock()
	if clock > pet.NextRay then
		pet.NextRay = clock + 0.2
		local result = workspace:Raycast(target + Vector3.new(0, 8, 0), Vector3.new(0, -40, 0), rayParams)
		pet.GroundY = result and result.Position.Y or (hrp.Position.Y - 3)
	end
	local flat = Vector3.new(target.X, 0, target.Z)
	local cur = Vector3.new(pet.Pos.X, 0, pet.Pos.Z)
	local newFlat = cur:Lerp(flat, 1 - math.exp(-dt * 6))
	local vel = (newFlat - cur) / math.max(dt, 1e-3)
	local speed = vel.Magnitude
	local moving = speed > 1.5
	if moving then
		local dir = vel.Unit
		pet.Yaw = math.atan2(-dir.X, -dir.Z)
	else
		local look = hrp.CFrame.LookVector
		local desired = math.atan2(-look.X, -look.Z)
		pet.Yaw = pet.Yaw + (desired - pet.Yaw) * math.min(1, dt * 3)
	end
	local y
	if pet.Def.Flies then
		y = hrp.Position.Y + 1.5 + math.sin(t * 2.5 + pet.Phase) * 0.6
	else
		y = pet.GroundY
		if ownerJumping and clock - pet.JumpStart > 0.6 then
			pet.JumpStart = clock
		end
		local j = clock - pet.JumpStart
		if j < 0.5 then
			y += math.sin(j / 0.5 * math.pi) * 3
		elseif moving then
			local hop = sp.Hops and 1.2 or 0.45
			y += math.abs(math.sin(t * (sp.Hops and 9 or 14) + pet.Phase)) * hop * math.min(1, speed / 12)
		else
			y += math.sin(t * 2 + pet.Phase) * 0.05
		end
	end
	pet.Pos = Vector3.new(newFlat.X, y, newFlat.Z)
	local rootCF = CFrame.new(pet.Pos) * CFrame.Angles(0, pet.Yaw + math.pi, 0)
	if moving and not pet.Def.Flies then
		rootCF *= CFrame.Angles(0, 0, math.sin(t * 14 + pet.Phase) * 0.08)
	end
	if PetFollower.LowGfx then
		pet.Model:PivotTo(rootCF)
		return
	end
	local cframes = table.create(#pet.Entries)
	local swing = moving and math.sin(t * 14 + pet.Phase) * 0.7 or 0
	local flap = math.sin(t * (pet.Def.Flies and 16 or 6) + pet.Phase) * (pet.Def.Flies and 0.7 or 0.15)
	local wag = math.sin(t * (moving and 10 or 5) + pet.Phase) * 0.5
	for i, e in ipairs(pet.Entries) do
		local role = e.Role
		local off = e.Offset
		if role == "LegA" then
			off = off * CFrame.Angles(swing, 0, 0)
		elseif role == "LegB" then
			off = off * CFrame.Angles(-swing, 0, 0)
		elseif role == "WingL" then
			off = CFrame.new(-0.7, 1.5, 0) * CFrame.Angles(0, 0, flap) * CFrame.new(-0.7, 1.5, 0):Inverse() * off
		elseif role == "WingR" then
			off = CFrame.new(0.7, 1.5, 0) * CFrame.Angles(0, 0, -flap) * CFrame.new(0.7, 1.5, 0):Inverse() * off
		elseif role == "Tail" then
			off = off * CFrame.Angles(0, wag, 0)
		elseif role == "Ear" then
			off = off * CFrame.Angles(0, 0, math.sin(t * 3 + pet.Phase) * 0.08)
		elseif role == "Head" then
			off = CFrame.Angles(math.sin(t * 2 + pet.Phase) * 0.05, 0, 0) * off
		elseif role == "Tentacle" then
			off = off * CFrame.Angles(math.sin(t * 6 + i) * 0.3, 0, 0)
		end
		cframes[i] = rootCF * off
	end
	workspace:BulkMoveTo(pet.Parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

function PetFollower.Start()
	folder = Instance.new("Folder")
	folder.Name = "ClientPets"
	folder.Parent = workspace
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	Players.PlayerAdded:Connect(hook)
	Players.PlayerRemoving:Connect(clear)
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		local exclude = { folder }
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then
				table.insert(exclude, p.Character)
			end
		end
		rayParams.FilterDescendantsInstances = exclude
		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.zero
		for player, list in pairs(owners) do
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hrp and hum then
				local near = (hrp.Position - camPos).Magnitude < 220
				local jumping = hum.FloorMaterial == Enum.Material.Air and hrp.AssemblyLinearVelocity.Y > 4
				for _, pet in ipairs(list) do
					pet.Model.Parent = near and folder or nil
					if near then
						animatePet(pet, hrp, dt, t, jumping)
					end
				end
			end
		end
	end)
end

return PetFollower
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">Sound</string><ProtectedString name="Source"><![CDATA[-- Sound.lua
-- Plays UI / gameplay sound effects locally and handles background music,
-- respecting the player's settings.

local SoundService = game:GetService("SoundService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Sound = {}
Sound.SfxEnabled = true
Sound.MusicEnabled = true

local cache: { [string]: Sound } = {}
local music: Sound? = nil

local PITCH = {
	Pickup = 1.2,
	Deposit = 1.5,
	Purchase = 1.0,
	Error = 0.6,
	Legendary = 0.8,
	Event = 0.7,
	LevelUp = 1.0,
	Hover = 1.3,
}

local function get(name: string): Sound?
	local id = Config.Sounds[name]
	if not id or id == "" then
		return nil
	end
	local s = cache[name]
	if not s then
		s = Instance.new("Sound")
		s.Name = "Sfx_" .. name
		s.SoundId = id
		s.Volume = 0.55
		s.PlaybackSpeed = PITCH[name] or 1
		s.Parent = SoundService
		cache[name] = s
	end
	return s
end

function Sound.Play(name: string, volume: number?, pitch: number?)
	if not Sound.SfxEnabled then
		return
	end
	local s = get(name)
	if not s then
		return
	end
	if volume then
		s.Volume = volume
	end
	if pitch then
		s.PlaybackSpeed = pitch
	end
	SoundService:PlayLocalSound(s)
end

function Sound.SetSettings(settings)
	Sound.SfxEnabled = settings.Sfx ~= false
	Sound.MusicEnabled = settings.Music ~= false
	if music then
		if Sound.MusicEnabled and not music.IsPlaying then
			music:Play()
		elseif not Sound.MusicEnabled and music.IsPlaying then
			music:Pause()
		end
	end
end

function Sound.Init()
	if Config.Sounds.Music ~= "" then
		music = Instance.new("Sound")
		music.Name = "Music"
		music.SoundId = Config.Sounds.Music
		music.Looped = true
		music.Volume = 0.25
		music.Parent = SoundService
		music:Play()
	end
end

return Sound
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- State.lua
-- Client mirror of the server state + a request helper.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local State = {}
State.Full = nil
State.Stats = nil
State.Leaderboard = nil
State.FullChanged = Instance.new("BindableEvent")
State.StatsChanged = Instance.new("BindableEvent")
State.LeaderboardChanged = Instance.new("BindableEvent")

local notifier -- set by Notifications to show request messages

function State.SetNotifier(fn)
	notifier = fn
end

function State.Now(): number
	return workspace:GetServerTimeNow()
end

-- Sends an action to the server. Shows the returned message as a toast
-- unless `silent` is true. Returns ok, msg, data.
function State.Request(action: string, ...)
	local ok, result = pcall(function(...)
		return Remotes.Action:InvokeServer(action, ...)
	end, ...)
	if not ok or typeof(result) ~= "table" then
		if notifier then
			notifier("Connection problem, try again", "error")
		end
		return false, "Connection problem"
	end
	if result.msg and result.msg ~= "" and notifier then
		notifier(result.msg, result.ok and "success" or "error")
	end
	return result.ok, result.msg, result.data
end

-- Silent variant
function State.Ask(action: string, ...)
	local ok, result = pcall(function(...)
		return Remotes.Action:InvokeServer(action, ...)
	end, ...)
	if not ok or typeof(result) ~= "table" then
		return false
	end
	return result.ok, result.msg, result.data
end

function State.Init()
	Remotes.FullState.OnClientEvent:Connect(function(snap)
		State.Full = snap
		State.FullChanged:Fire(snap)
	end)
	Remotes.Stats.OnClientEvent:Connect(function(stats)
		State.Stats = stats
		if State.Full then
			State.Full.Money = stats.Money
			State.Full.Gems = stats.Gems
			State.Full.Vault = stats.Vault
			State.Full.Level = stats.Level
			State.Full.XP = stats.XP
			State.Full.XPNext = stats.XPNext
		end
		State.StatsChanged:Fire(stats)
	end)
	Remotes.Leaderboard.OnClientEvent:Connect(function(board)
		State.Leaderboard = board
		State.LeaderboardChanged:Fire(board)
	end)
	task.spawn(function()
		-- ask for a fresh state in case we missed the first send
		while not State.Full do
			State.Ask("RequestState")
			task.wait(2)
		end
	end)
end

return State
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">TreasureAnimator</string><ProtectedString name="Source"><![CDATA[-- TreasureAnimator.lua
-- Brings treasure "characters" to life, entirely on the client:
--   * personality idles: Hop, Dance, Float, Spin, Wiggle, Bounce
--   * roaming field treasures: walk / run / jump / dance on the shared
--     deterministic path (Motion), facing where they move
--   * faces: blinking, happy / surprised / sleepy / excited expressions
--   * special "power" animation for Legendary+ (spin-jump burst)
--   * spawn (pop-in) and disappear (shrink + spin) animations
--   * rainbow halos, lightning flicker, Celestial orbiting moons
-- The server never moves treasures, so this costs no network traffic.

local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rarities = require(Shared.Rarities)
local Motion = require(Shared.Motion)
local State = require(script.Parent.State)

local TreasureAnimator = {}
TreasureAnimator.LowGfx = false
TreasureAnimator.Effects = true

local ANIM_DISTANCE = 150
local tracked: { [Model]: any } = {}
local carried: { [Model]: boolean } = {}

local function faceParts(model: Model)
	local face = model:FindFirstChild("Face")
	if not face then
		return nil
	end
	return {
		EyeL = face:FindFirstChild("EyeL"),
		EyeR = face:FindFirstChild("EyeR"),
		MouthO = face:FindFirstChild("MouthO"),
		Smile = { face:FindFirstChild("Mouth1"), face:FindFirstChild("Mouth2"), face:FindFirstChild("Mouth3") },
	}
end

-- Expressions: "Happy", "Surprised", "Sleepy", "Excited", "Blink"
local function setExpression(info, expr: string)
	local f = info.Face
	if not f or info.Expr == expr then
		return
	end
	info.Expr = expr
	local eyeScale = Vector3.new(1, 1, 1)
	if expr == "Surprised" or expr == "Excited" then
		eyeScale = Vector3.new(1.3, 1.3, 1.3)
	elseif expr == "Sleepy" then
		eyeScale = Vector3.new(1.1, 0.25, 1)
	elseif expr == "Blink" then
		eyeScale = Vector3.new(1.1, 0.12, 1)
	end
	for _, eye in ipairs({ f.EyeL, f.EyeR }) do
		if eye then
			local base = eye:GetAttribute("BaseSize")
			if base then
				eye.Size = base * eyeScale
			end
		end
	end
	local open = expr == "Surprised"
	if f.MouthO then
		f.MouthO.Transparency = open and 0 or 1
	end
	for _, m in ipairs(f.Smile) do
		if m then
			m.Transparency = open and 1 or 0
		end
	end
end

function TreasureAnimator.ApplyQuality(model: Instance)
	local showFx = TreasureAnimator.Effects and not TreasureAnimator.LowGfx
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("PointLight") then
			d.Enabled = showFx
		end
	end
end

function TreasureAnimator.Track(model: Model)
	if tracked[model] then
		return
	end
	if model:GetAttribute("Carried") then
		carried[model] = true
		local info = { Face = faceParts(model) }
		setExpression(info, "Surprised")
		return
	end
	local root = model:FindFirstChild("Root")
	if not root or not root:IsA("BasePart") then
		return
	end
	local rank = Rarities.Rank(model:GetAttribute("Rarity") or "Common")
	local info = {
		Root = root,
		Rank = rank,
		Personality = model:GetAttribute("Personality") or "Float",
		Phase = math.random() * 10,
		Seed = model:GetAttribute("WanderSeed"),
		Radius = model:GetAttribute("WanderRadius") or 7,
		Face = faceParts(model),
		NextBlink = os.clock() + math.random() * 4,
		NextPower = os.clock() + 4 + math.random() * 8,
		PowerStart = 0,
		Scale = 1,
		Halo = model:FindFirstChild("Halo"),
		Orbit = model:FindFirstChild("Orbit"),
		Rainbow = model:GetAttribute("Rainbow"),
		ParadeStart = model:GetAttribute("ParadeStart"),
		ParadeFrom = model:GetAttribute("ParadeFrom"),
		ParadeDir = model:GetAttribute("ParadeDir"),
		ParadeSpeed = model:GetAttribute("ParadeSpeed"),
		WalkFrom = model:GetAttribute("WalkFrom"),
		ArriveAt = model:GetAttribute("ArriveAt"),
		Lightning = model:GetAttribute("Lightning"),
	}
	-- spawn animation if it just appeared
	local spawnTime = model:GetAttribute("SpawnTime")
	if spawnTime and State.Now() - spawnTime < 1.5 then
		info.SpawnStart = os.clock()
		pcall(function()
			model:ScaleTo(0.05)
		end)
		info.Scale = 0.05
	end
	tracked[model] = info
	TreasureAnimator.ApplyQuality(model)
	model:GetAttributeChangedSignal("Despawning"):Connect(function()
		info.DespawnStart = os.clock()
	end)
end

local function setScale(model: Model, info, s: number)
	if math.abs(info.Scale - s) > 0.005 then
		info.Scale = s
		pcall(function()
			model:ScaleTo(math.max(0.02, s))
		end)
	end
end

local function backOut(t: number): number
	local c1, c3 = 1.70158, 2.70158
	return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end

local function isNight(): boolean
	local c = Lighting.ClockTime
	return c > 20.5 or c < 5.5
end

local function idleOffset(personality: string, t: number): (number, CFrame)
	if personality == "Hop" then
		return math.abs(math.sin(t * 3)) * 0.8, CFrame.identity
	elseif personality == "Dance" then
		return 0.2 + math.abs(math.sin(t * 4)) * 0.2, CFrame.Angles(0, math.sin(t * 2) * 0.8, math.sin(t * 4) * 0.25)
	elseif personality == "Spin" then
		return 0.4 + math.sin(t * 2) * 0.2, CFrame.Angles(0, t * 3, 0)
	elseif personality == "Wiggle" then
		return 0.3, CFrame.Angles(0, math.sin(t * 6) * 0.45, math.sin(t * 3) * 0.1)
	elseif personality == "Bounce" then
		return math.abs(math.sin(t * 4.5)) * 0.45, CFrame.Angles(math.sin(t * 9) * 0.06, 0, 0)
	end
	-- Float
	return 0.5 + math.sin(t * 1.5) * 0.45, CFrame.Angles(0, t * 0.7, 0)
end

local function animateOne(model: Model, info, t: number, now: number, camPos: Vector3, night: boolean)
	local home = model:GetAttribute("Home")
	if typeof(home) ~= "CFrame" or not info.Root.Anchored then
		return
	end
	local pos = home.Position
	local state = "Idle"
	local yaw = 0
	-- Treasure Parade: walk along the carpet (same formula the server validates)
	if info.ParadeStart and typeof(info.ParadeFrom) == "Vector3" then
		local dir = info.ParadeDir
		pos = info.ParadeFrom + dir * (info.ParadeSpeed * (now - info.ParadeStart))
		yaw = math.atan2(dir.X, dir.Z)
		local walk = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
			* CFrame.new(0, math.abs(math.sin(t * 8 + info.Phase)) * 0.35, 0)
			* CFrame.Angles(0, 0, math.sin(t * 8 + info.Phase) * 0.15)
		info.Root.CFrame = walk
		setExpression(info, "Happy")
		return
	end
	-- just bought: walk from the parade to its stand
	if typeof(info.WalkFrom) == "Vector3" and info.ArriveAt and now < info.ArriveAt then
		local total = math.clamp((home.Position - info.WalkFrom).Magnitude / 14, 2, 14)
		local f = math.clamp(1 - (info.ArriveAt - now) / total, 0, 1)
		local p = info.WalkFrom:Lerp(home.Position, f)
		local d = home.Position - info.WalkFrom
		local y = math.atan2(d.X, d.Z)
		info.Root.CFrame = CFrame.new(p) * CFrame.Angles(0, y, 0)
			* CFrame.new(0, math.abs(math.sin(t * 10 + info.Phase)) * 0.5, 0)
			* CFrame.Angles(0, 0, math.sin(t * 10 + info.Phase) * 0.2)
		setExpression(info, "Excited")
		return
	end
	if info.Seed then
		local offset
		offset, state, yaw = Motion.Sample(info.Seed, now, info.Radius)
		pos += offset
	end
	if (pos - camPos).Magnitude > ANIM_DISTANCE and not info.Seed then
		return
	end
	local lowGfx = TreasureAnimator.LowGfx
	local cf
	if info.Seed then
		local facing = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
		if lowGfx then
			cf = facing
		elseif state == "Walk" then
			cf = facing * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, math.sin(t * 10 + info.Phase) * 0.18)
		elseif state == "Run" then
			cf = facing * CFrame.Angles(-0.25, 0, math.sin(t * 18 + info.Phase) * 0.22)
		elseif state == "Jump" then
			cf = facing * CFrame.Angles(0, t * 4, 0)
		elseif state == "Dance" then
			cf = facing * CFrame.new(0, math.abs(math.sin(t * 5)) * 0.3, 0) * CFrame.Angles(0, math.sin(t * 3) * 1.2, math.sin(t * 6) * 0.3)
		else
			local h, rot = idleOffset(info.Personality, t + info.Phase)
			cf = facing * CFrame.new(0, h, 0) * rot
		end
		setExpression(info, (state == "Run" or state == "Jump") and "Surprised" or (state == "Dance" and "Excited" or "Happy"))
	else
		if lowGfx then
			return
		end
		local h, rot = idleOffset(info.Personality, t + info.Phase)
		cf = CFrame.new(pos) * home.Rotation * CFrame.new(0, h, 0) * rot
		-- special power animation for Legendary+
		if info.Rank >= 5 then
			local clock = os.clock()
			if clock > info.NextPower then
				info.PowerStart = clock
				info.NextPower = clock + 7 + math.random() * 6
			end
			local p = clock - info.PowerStart
			if p < 1 then
				cf = cf * CFrame.new(0, math.sin(p * math.pi) * 2.2, 0) * CFrame.Angles(0, p * math.pi * 2, 0)
				setExpression(info, "Excited")
			elseif night and info.Rank < 7 then
				setExpression(info, "Sleepy")
			else
				setExpression(info, "Happy")
			end
		else
			setExpression(info, night and "Sleepy" or "Happy")
		end
	end
	info.Root.CFrame = cf

	-- blinking
	local clock = os.clock()
	if info.Face and info.Expr ~= "Sleepy" then
		if clock > info.NextBlink then
			info.BlinkEnd = clock + 0.12
			info.NextBlink = clock + 2.5 + math.random() * 3
			info.PrevExpr = info.Expr
			setExpression(info, "Blink")
		elseif info.BlinkEnd and clock > info.BlinkEnd then
			info.BlinkEnd = nil
			setExpression(info, info.PrevExpr or "Happy")
		end
	end
	-- spawn pop-in
	if info.SpawnStart then
		local k = math.clamp((clock - info.SpawnStart) / 0.55, 0, 1)
		setScale(model, info, math.max(0.05, backOut(k)))
		if k >= 1 then
			info.SpawnStart = nil
			setScale(model, info, 1)
		end
	end
	-- disappear
	if info.DespawnStart then
		local k = math.clamp((clock - info.DespawnStart) / 0.5, 0, 1)
		setScale(model, info, 1 - k * 0.95)
		info.Root.CFrame = cf * CFrame.new(0, k * 2, 0) * CFrame.Angles(0, k * 12, 0)
	end
	-- rainbow / lightning extras
	if info.Rainbow and info.Halo then
		local c = Color3.fromHSV((t * 0.25 + info.Phase) % 1, 0.7, 1)
		for _, seg in ipairs(info.Halo:GetChildren()) do
			(seg :: BasePart).Color = c
		end
	end
	if info.Lightning then
		local att = info.Root:FindFirstChild("FxAttachment")
		local glow = att and att:FindFirstChild("Glow")
		if glow then
			glow.Brightness = (math.random() < 0.08) and 6 or 1.6
		end
	end
end

function TreasureAnimator.Start()
	RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local camPos = cam.CFrame.Position
		local t = os.clock()
		local now = State.Now()
		local night = isNight()
		for model, info in pairs(tracked) do
			if not model.Parent then
				tracked[model] = nil
			else
				animateOne(model, info, t, now, camPos, night)
			end
		end
		for model in pairs(carried) do
			if not model.Parent then
				carried[model] = nil
			end
		end
	end)
end

function TreasureAnimator.SetQuality(lowGfx: boolean, effects: boolean)
	TreasureAnimator.LowGfx = lowGfx
	TreasureAnimator.Effects = effects
	for model in pairs(tracked) do
		TreasureAnimator.ApplyQuality(model)
	end
end

function TreasureAnimator.Untrack(model: Model)
	tracked[model] = nil
	carried[model] = nil
end

return TreasureAnimator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">WorldFX</string><ProtectedString name="Source"><![CDATA[-- WorldFX.lua
-- Client-side world logic and polish:
--   * treasure idle animation (spin + bob), rainbow / lightning flicker
--   * performance mode (turns off particles, beams and lights locally)
--   * shows only the relevant prompts (Steal on others, Pick Up on yours)
--   * lets the owner walk through their own locked barrier
--   * guide beam to your base while carrying
--   * dash, knockback, camera shake, FOV punch effects
--   * opening menus from world prompts (shop, rebirth altar, ...)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Rarities = require(Shared.Rarities)
local State = require(script.Parent.State)
local Util = require(Shared.Util)
local Sound = require(script.Parent.Sound)

local player = Players.LocalPlayer

local WorldFX = {}
WorldFX.LowGfx = false
WorldFX.Effects = true

local Windows, Notifications -- injected

local TreasureAnimator = require(script.Parent.TreasureAnimator)

local function applyAllQuality()
	TreasureAnimator.SetQuality(WorldFX.LowGfx, WorldFX.Effects)
	Lighting.GlobalShadows = not WorldFX.LowGfx
	local bloom = Lighting:FindFirstChild("GameBloom")
	if bloom then
		bloom.Enabled = not WorldFX.LowGfx
	end
	local rays = Lighting:FindFirstChild("GameSunRays")
	if rays then
		rays.Enabled = not WorldFX.LowGfx
	end
end

function WorldFX.SetSettings(settings)
	local low = settings.LowGfx == true
	local fx = settings.Effects ~= false
	if low ~= WorldFX.LowGfx or fx ~= WorldFX.Effects then
		WorldFX.LowGfx = low
		WorldFX.Effects = fx
		applyAllQuality()
	end
end

-- Prompts ---------------------------------------------------------------------
local function myBaseIndex(): number?
	return player:GetAttribute("BaseIndex")
end

local function updatePrompt(prompt: ProximityPrompt)
	local kind = prompt:GetAttribute("Kind")
	if kind == "Steal" or kind == "Store" then
		local model = prompt:FindFirstAncestorWhichIsA("Model")
		local owner = model and model:GetAttribute("OwnerId")
		local mine = owner == player.UserId
		prompt.Enabled = (kind == "Store") == mine
	elseif prompt:GetAttribute("OwnerOnly") then
		local base = prompt:FindFirstAncestor("Bases") and prompt.Parent and prompt.Parent.Parent
		local owner = base and base:GetAttribute("OwnerId")
		prompt.Enabled = owner == player.UserId
	end
end

local function watchDescendant(d: Instance)
	if d:IsA("ProximityPrompt") then
		updatePrompt(d)
	elseif d:IsA("Model") and d:GetAttribute("TreasureId") then
		TreasureAnimator.Track(d)
	end
end

-- Barrier: the owner may always pass through their own laser wall.
local function hookBarrier(base: Instance)
	local barrier = base:FindFirstChild("Barrier")
	if not barrier then
		return
	end
	local function apply()
		if base:GetAttribute("OwnerId") == player.UserId then
			barrier.CanCollide = false
		end
	end
	barrier:GetPropertyChangedSignal("CanCollide"):Connect(apply)
	base:GetAttributeChangedSignal("OwnerId"):Connect(function()
		apply()
		local lockPrompt = base:FindFirstChild("LockButton") and base.LockButton:FindFirstChild("LockPrompt")
		if lockPrompt then
			updatePrompt(lockPrompt)
		end
	end)
	apply()
end

-- Guide beam while carrying -----------------------------------------------------
local guide = {}
local function updateGuide(stats)
	local carrying = stats and #stats.Carrying > 0
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local bases = workspace:FindFirstChild("Bases")
	local base = bases and myBaseIndex() and bases:FindFirstChild("Base" .. myBaseIndex())
	if not carrying or not hrp or not base then
		if guide.Beam then
			guide.Beam.Enabled = false
		end
		return
	end
	if not guide.Target or not guide.Target.Parent then
		local floor = base:FindFirstChild("Floor")
		if not floor then
			return
		end
		local p = Instance.new("Part")
		p.Name = "GuideTarget"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = Vector3.new(1, 1, 1)
		p.CFrame = floor.CFrame * CFrame.new(0, 4, 0)
		p.Parent = workspace
		guide.Target = p
		guide.A1 = Instance.new("Attachment")
		guide.A1.Parent = p
	end
	if not guide.A0 or guide.A0.Parent ~= hrp then
		guide.A0 = Instance.new("Attachment")
		guide.A0.Position = Vector3.new(0, -2.5, 0)
		guide.A0.Parent = hrp
		if guide.Beam then
			guide.Beam:Destroy()
		end
		local beam = Instance.new("Beam")
		beam.Attachment0 = guide.A0
		beam.Attachment1 = guide.A1
		beam.Width0 = 1.4
		beam.Width1 = 1.4
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 220, 80))
		beam.Transparency = NumberSequence.new(0.3)
		beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		beam.TextureMode = Enum.TextureMode.Static
		beam.TextureLength = 4
		beam.TextureSpeed = 2
		beam.Parent = hrp
		guide.Beam = beam
	end
	local floor = base:FindFirstChild("Floor")
	if floor then
		guide.Target.CFrame = floor.CFrame * CFrame.new(0, 4, 0)
	end
	local stolen = false
	for _, item in ipairs(stats.Carrying) do
		stolen = stolen or item.Source == "Steal"
	end
	guide.Beam.Color = ColorSequence.new(stolen and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 220, 80))
	guide.Beam.Enabled = true
end

-- Effects -------------------------------------------------------------------------
local function fovPunch(amount: number, duration: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local base = 70
	cam.FieldOfView = base + amount
	TweenService:Create(cam, TweenInfo.new(duration, Enum.EasingStyle.Quad), { FieldOfView = base }):Play()
end

local shakeUntil, shakeAmount = 0, 0
local function shake(amount: number, duration: number)
	shakeAmount = amount
	shakeUntil = os.clock() + duration
end

local function onEffect(kind: string, a, b)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if kind == "Dash" and hrp then
		local look = hrp.CFrame.LookVector
		hrp.AssemblyLinearVelocity = Vector3.new(look.X * 110, 18, look.Z * 110)
		fovPunch(18, 0.5)
		Sound.Play("Dash", 0.6)
	elseif kind == "SuperJump" then
		Sound.Play("Jump", 0.6)
		Notifications.Toast("🦘 Super Jump active!", "info")
	elseif kind == "Cloak" then
		Notifications.Toast("👻 You are cloaked!", "info")
	elseif kind == "Knockback" and hrp and hum then
		hrp.AssemblyLinearVelocity = a
		hum.PlatformStand = true
		shake(0.6, 0.4)
		Sound.Play("Bonk", 0.8)
		task.delay(b or 1, function()
			if hum.Parent then
				hum.PlatformStand = false
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
	elseif kind == "BonkHit" then
		shake(0.25, 0.2)
	elseif kind == "Shake" and hrp and typeof(a) == "Vector3" then
		local d = (hrp.Position - a).Magnitude
		if d < 160 then
			shake((b or 0.5) * (1 - d / 160), 0.6)
		end
	elseif kind == "Pickup" then
		Sound.Play("Pickup", 0.6)
		if Rarities.Rank(a or "Common") >= 5 then
			Sound.Play("Legendary", 0.8)
			fovPunch(8, 0.6)
		end
	elseif kind == "Deposit" then
		Sound.Play("Deposit", 0.7)
		if Rarities.Rank(a or "Common") >= 5 then
			Notifications.Confetti()
		end
	elseif kind == "Sell" or kind == "Purchase" then
		Sound.Play("Purchase", 0.6)
	elseif kind == "LevelUp" then
		Sound.Play("LevelUp", 0.7)
		Notifications.Splash(("LEVEL %d!"):format(a or 0), "Keep collecting treasures!", Color3.fromRGB(255, 220, 80))
	elseif kind == "Rebirth" then
		Sound.Play("Rebirth", 0.8)
		Notifications.Splash(("REBIRTH %d"):format(a or 0), "Permanent income bonus unlocked!", Color3.fromRGB(255, 110, 200))
		fovPunch(25, 1.2)
	elseif kind == "Confetti" then
		Notifications.Confetti()
		Sound.Play("Legendary", 0.6)
	elseif kind == "Grapple" and hrp and typeof(a) == "Vector3" then
		local dir = a - hrp.Position
		hrp.AssemblyLinearVelocity = dir.Unit * math.clamp(dir.Magnitude * 2.2, 60, 160) + Vector3.new(0, 18, 0)
		local rope = Instance.new("Part")
		rope.Anchored = true
		rope.CanCollide = false
		rope.CanQuery = false
		rope.Material = Enum.Material.Neon
		rope.Color = Color3.fromRGB(230, 230, 240)
		rope.Size = Vector3.new(0.2, 0.2, dir.Magnitude)
		rope.CFrame = CFrame.lookAt(hrp.Position + dir / 2, a)
		rope.Parent = workspace
		TweenService:Create(rope, TweenInfo.new(0.5), { Transparency = 1 }):Play()
		game:GetService("Debris"):AddItem(rope, 0.6)
		Sound.Play("Dash", 0.7, 1.3)
		fovPunch(15, 0.6)
	elseif kind == "GlobalShake" then
		shake(a or 0.4, 1.2)
	elseif kind == "ChestOpen" then
		Notifications.Confetti()
	elseif kind == "Coin" then
		Sound.Play("Collect", 0.5, 1.4)
		Notifications.MoneyPop("+" .. Util.Money(a or 0), Color3.fromRGB(255, 220, 80))
	elseif kind == "Collect" then
		Sound.Play("Collect", 0.8)
		Notifications.MoneyPop("💰 +" .. Util.Money(a or 0), Color3.fromRGB(120, 255, 120))
		fovPunch(6, 0.4)
	elseif kind == "Discovery" then
		Sound.Play("Discovery", 0.8)
		Notifications.DiscoveryCard(a)
	elseif kind == "Achievement" then
		Sound.Play("LevelUp", 0.7)
		Notifications.Confetti()
	elseif kind == "Portal" then
		Sound.Play("Portal", 0.8)
		fovPunch(30, 0.8)
		Notifications.Flash(Color3.fromRGB(180, 140, 255))
	elseif kind == "Zap" and typeof(a) == "Vector3" and typeof(b) == "Vector3" then
		local p0 = Instance.new("Part")
		p0.Anchored = true
		p0.CanCollide = false
		p0.CanQuery = false
		p0.Material = Enum.Material.Neon
		p0.Color = Color3.fromRGB(255, 60, 60)
		local len = (b - a).Magnitude
		p0.Size = Vector3.new(0.4, 0.4, len)
		p0.CFrame = CFrame.lookAt((a + b) / 2, b)
		p0.Parent = workspace
		Sound.Play("Bonk", 0.8, 1.5)
		TweenService:Create(p0, TweenInfo.new(0.4), { Transparency = 1, Size = Vector3.new(0.05, 0.05, len) }):Play()
		game:GetService("Debris"):AddItem(p0, 0.5)
	end
end

function WorldFX.Init(windows, notifications)
	Windows = windows
	Notifications = notifications
end

function WorldFX.Start()
	-- track everything that exists and appears later
	for _, d in ipairs(workspace:GetDescendants()) do
		watchDescendant(d)
	end
	workspace.DescendantAdded:Connect(watchDescendant)
	workspace.DescendantRemoving:Connect(function(d)
		if d:IsA("Model") and d:GetAttribute("TreasureId") then
			TreasureAnimator.Untrack(d)
		end
	end)
	TreasureAnimator.Start()
	-- stealing pose: tell the server while we hold a Steal prompt
	ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
		if prompt:GetAttribute("Kind") == "Steal" then
			State.Ask("SetStealing", true)
			Sound.Play("Steal", 0.5)
		end
	end)
	ProximityPromptService.PromptButtonHoldEnded:Connect(function(prompt)
		if prompt:GetAttribute("Kind") == "Steal" then
			State.Ask("SetStealing", false)
		end
	end)

	local function hookBases()
		local bases = workspace:WaitForChild("Bases", 30)
		if not bases then
			return
		end
		for _, b in ipairs(bases:GetChildren()) do
			hookBarrier(b)
		end
		bases.ChildAdded:Connect(hookBarrier)
	end
	task.spawn(hookBases)

	player:GetAttributeChangedSignal("BaseIndex"):Connect(function()
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				updatePrompt(d)
			end
		end
	end)

	-- world prompts that open menus
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who ~= player then
			return
		end
		if prompt:GetAttribute("Kind") == "Steal" then
			State.Ask("SetStealing", false)
		end
		local ui = prompt:GetAttribute("OpenUI")
		if ui == "Sell" then
			Windows.Open("Inventory", "Sell")
		elseif ui == "Pets" then
			Windows.Open("Pets", "Eggs")
		elseif ui then
			Windows.Open(ui)
		end
	end)

	RunService.RenderStepped:Connect(function()
		if os.clock() < shakeUntil then
			local cam = workspace.CurrentCamera
			local s = shakeAmount
			cam.CFrame = cam.CFrame * CFrame.Angles(math.rad((math.random() - 0.5) * s * 4), math.rad((math.random() - 0.5) * s * 4), 0)
		end
	end)

	Remotes.Effect.OnClientEvent:Connect(onEffect)
	Remotes.Alarm.OnClientEvent:Connect(function(thief, treasure)
		Notifications.Alarm(thief, treasure)
		shake(0.3, 0.5)
	end)
	Remotes.Announce.OnClientEvent:Connect(function(text, rarity)
		Notifications.Banner(text, rarity)
	end)
	Remotes.Notify.OnClientEvent:Connect(function(text, kind)
		Notifications.Toast(text, kind)
	end)
	State.StatsChanged.Event:Connect(updateGuide)
	-- Grapple Hook: the tool asks the server to zip us to where we clicked
	local function hookTool(tool: Instance)
		if tool:IsA("Tool") and tool:GetAttribute("Grapple") and not tool:GetAttribute("Hooked") then
			tool:SetAttribute("Hooked", true)
			tool.Activated:Connect(function()
				local mouse = player:GetMouse()
				local target = mouse.Hit and mouse.Hit.Position
				if target then
					State.Request("Grapple", target)
				end
			end)
		end
	end
	local function watchContainer(c: Instance?)
		if not c then
			return
		end
		for _, t in ipairs(c:GetChildren()) do
			hookTool(t)
		end
		c.ChildAdded:Connect(hookTool)
	end
	watchContainer(player:FindFirstChildOfClass("Backpack"))
	player.ChildAdded:Connect(function(c)
		if c:IsA("Backpack") then
			watchContainer(c)
		end
	end)
	player.CharacterAdded:Connect(function()
		guide.A0 = nil
		if guide.Beam then
			guide.Beam:Destroy()
			guide.Beam = nil
		end
	end)
end

return WorldFX
]]></ProtectedString></Properties></Item>
</Item>
<Item class="LocalScript" referent="RBX00000032"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Main.client.lua
-- Client bootstrap: builds the interface, starts controllers and applies
-- player settings (UI scale for PC/mobile, sound, graphics).

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")

local State = require(Controllers.State)
local Sound = require(Controllers.Sound)
local WorldFX = require(Controllers.WorldFX)
local Input = require(Controllers.Input)
local Emotes = require(Controllers.Emotes)
local PetFollower = require(Controllers.PetFollower)
local Ambience = require(Controllers.Ambience)
local Music = require(Controllers.Music)
local Cinematic = require(Controllers.Cinematic)

local Lib = require(UI.Lib)
local Windows = require(UI.Windows)
local Notifications = require(UI.Notifications)
local HUD = require(UI.HUD)

local gui = Lib.new("ScreenGui", {
	Name = "StealATreasureUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = false,
	Parent = player:WaitForChild("PlayerGui"),
})
local uiScale = Lib.new("UIScale", { Parent = gui })

-- Responsive scaling: designed for 1280x720, scaled for phones/tablets/4K
local userScale = 1
local function rescale()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local vp = cam.ViewportSize
	local base = math.min(vp.X / 1280, vp.Y / 720)
	uiScale.Scale = math.clamp(base, 0.62, 1.5) * userScale
end
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
end)

State.Init()
Sound.Init()
Notifications.Init(gui)
State.SetNotifier(Notifications.Toast)
Windows.Init(gui)
HUD.Init(gui)

Windows.Register("Inventory", require(UI.InventoryWindow), { Title = "Inventory", Icon = "🎒", Color = Lib.Theme.Blue })
Windows.Register("Index", require(UI.IndexWindow), { Title = "Treasure Index", Icon = "📖", Color = Lib.Theme.Purple })
Windows.Register("Shop", require(UI.ShopWindow), { Title = "Upgrades & Abilities", Icon = "🛒", Color = Lib.Theme.Green })
Windows.Register("GemShop", require(UI.GemShopWindow), { Title = "Gem Shop & Base Style", Icon = "💎", Color = Lib.Theme.Blue })
Windows.Register("Pets", require(UI.PetsWindow), { Title = "Pets", Icon = "🐾", Color = Lib.Theme.Orange })
Windows.Register("Achievements", require(UI.AchievementsWindow), { Title = "Achievements", Icon = "🎖️", Color = Lib.Theme.Accent })
Windows.Register("Rebirth", require(UI.RebirthWindow), { Title = "Rebirth", Icon = "🌀", Color = Lib.Theme.Pink })
Windows.Register("Leaderboard", require(UI.LeaderboardWindow), { Title = "Leaderboards", Icon = "🏆", Color = Lib.Theme.Accent })
Windows.Register("Settings", require(UI.SettingsWindow), { Title = "Settings", Icon = "⚙️", Color = Lib.Theme.Panel2, Size = UDim2.fromScale(0.6, 0.8), MaxSize = Vector2.new(700, 620) })
Windows.Register("Trade", require(UI.TradeWindow), { Title = "Trading", Icon = "🤝", Color = Lib.Theme.Orange })

WorldFX.Init(Windows, Notifications)
WorldFX.Start()
Emotes.Start()
PetFollower.Start()
Ambience.Start()
Music.Start()
Cinematic.Start()
Input.Init(Windows, HUD)

local function applySettings(full)
	local s = full.Settings or {}
	userScale = s.UIScale or 1
	rescale()
	Sound.SetSettings(s)
	WorldFX.SetSettings(s)
	Ambience.SetSettings(s)
	Music.SetEnabled(s.Music ~= false)
	PetFollower.LowGfx = s.LowGfx == true
end
State.FullChanged.Event:Connect(applySettings)
if State.Full then
	applySettings(State.Full)
end

-- Cinematic intro on the first state (once per join)
local introDone = false
State.FullChanged.Event:Connect(function(full)
	if introDone then
		return
	end
	introDone = true
	if (full.Settings or {}).Intro ~= false then
		task.wait(1)
		Cinematic.PlayIntro(gui)
	end
end)

-- Welcome
task.delay(2, function()
	Notifications.Banner("💎 Welcome to STEAL A TREASURE! 💎", "Legendary")
	Notifications.Toast("Grab treasures in the fields or buy them at the market, then bring them home!", "info")
end)
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX00000042"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">AchievementsWindow</string><ProtectedString name="Source"><![CDATA[-- AchievementsWindow.lua
-- Achievement list with progress bars and gem rewards.

local Lib = require(script.Parent.Lib)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local AchievementData = require(Shared.AchievementData)
local Util = require(Shared.Util)

local T = Lib.Theme

local Achievements = {}

local list: ScrollingFrame
local header: TextLabel
local isOpen = false

local function refresh()
	if not isOpen or not State.Full then
		return
	end
	Lib.clear(list)
	local done = {}
	for _, id in ipairs(State.Full.Achievements or {}) do
		done[id] = true
	end
	local progress = State.Full.AchievementProgress or {}
	local count = 0
	for _, a in ipairs(AchievementData.List) do
		local unlocked = done[a.Id] == true
		if unlocked then
			count += 1
		end
		local row = Lib.panel({ Size = UDim2.new(1, -8, 0, 62), BackgroundColor3 = unlocked and T.Green:Lerp(T.Panel, 0.6) or T.Panel, LayoutOrder = (unlocked and 1000 or 0) + a.Order, Parent = list })
		Lib.label({ Size = UDim2.fromOffset(54, 54), Position = UDim2.fromOffset(6, 4), Text = a.Icon, MaxText = 34, Parent = row })
		local n = Lib.label({ Size = UDim2.new(0.55, -70, 0, 26), Position = UDim2.fromOffset(66, 4), Text = a.Name, Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = row })
		Lib.textStroke(1.5).Parent = n
		local value = progress[a.Stat] or 0
		local goalText = a.Goal >= 1000 and Util.Abbreviate(a.Goal) or tostring(a.Goal)
		local valueText = value >= 1000 and Util.Abbreviate(value) or tostring(math.floor(value))
		local _, set = Lib.bar({ Size = UDim2.new(0.55, -70, 0, 20), Position = UDim2.fromOffset(66, 34), Color = unlocked and T.Green or T.Blue, Parent = row })
		set(math.min(1, value / a.Goal), unlocked and "COMPLETE ✅" or (valueText .. " / " .. goalText))
		local r = Lib.label({ Size = UDim2.new(0.45, -16, 1, -12), Position = UDim2.new(0.55, 0, 0, 6), Text = ("+%d 💎"):format(a.Gems), Font = T.Title, TextColor3 = T.Blue:Lerp(Color3.new(1, 1, 1), 0.3), TextXAlignment = Enum.TextXAlignment.Right, MaxText = 22, Parent = row })
		Lib.textStroke(1.5).Parent = r
	end
	header.Text = ("🏆 %d / %d achievements unlocked"):format(count, #AchievementData.List)
end

function Achievements.Build(content: Frame)
	header = Lib.label({ Size = UDim2.new(1, 0, 0, 30), Text = "", Font = T.Title, TextColor3 = T.Accent, MaxText = 22, Parent = content })
	Lib.textStroke(1.5).Parent = header
	list = Lib.scroll({ Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 1, -36), Parent = content })
	Lib.list(Enum.FillDirection.Vertical, 6).Parent = list
	Lib.padding(4).Parent = list
	State.FullChanged.Event:Connect(refresh)
end

function Achievements.OnOpen()
	isOpen = true
	refresh()
end

function Achievements.OnClose()
	isOpen = false
end

return Achievements
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">GemShopWindow</string><ProtectedString name="Source"><![CDATA[-- GemShopWindow.lua
-- Gem shop (boosts, Auto Collector, pet slots), active boost timers and base
-- personalisation (12 colours).

local Lib = require(script.Parent.Lib)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local UpgradeData = require(Shared.UpgradeData)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local GemShop = {}

local isOpen = false
local rows = {}
local boostLabel: TextLabel
local gemsLabel: TextLabel
local swatches = {}

local function refresh()
	if not isOpen or not State.Full then
		return
	end
	local full = State.Full
	gemsLabel.Text = ("💎 %s gems"):format(Util.Commas(full.Gems or 0))
	for key, b in pairs(rows) do
		local item = UpgradeData.GemShop[key]
		local cost = item.Cost
		if key == "PetSlot" then
			cost = item.Cost * ((full.ExtraPetSlots or 0) + 1)
		end
		if key == "AutoCollect" and full.AutoCollect then
			b.Text = "OWNED"
			Lib.setButtonColor(b, T.Panel2)
		elseif key == "PetSlot" and (full.PetSlots or 3) >= 6 then
			b.Text = "MAXED"
			Lib.setButtonColor(b, T.Panel2)
		else
			b.Text = "💎 " .. cost
			Lib.setButtonColor(b, (full.Gems or 0) >= cost and T.Blue or T.Red)
		end
	end
	local active = {}
	local nowT = (State.Stats and State.Stats.ServerTime) or os.time()
	for name, expiry in pairs(full.Boosts or {}) do
		if expiry > nowT then
			table.insert(active, ("%s %s"):format(name, Util.Time(expiry - nowT)))
		end
	end
	boostLabel.Text = #active > 0 and ("⏳ Active boosts: " .. table.concat(active, "   ")) or "No active boosts"
	for i, s in ipairs(swatches) do
		local stroke = s:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = (full.BaseColor == i) and T.Accent or Color3.new(0, 0, 0)
			stroke.Thickness = (full.BaseColor == i) and 4 or 2
		end
	end
end

function GemShop.Build(content: Frame)
	local scroll = Lib.scroll({ Size = UDim2.fromScale(1, 1), Parent = content })
	Lib.list(Enum.FillDirection.Vertical, 8).Parent = scroll
	Lib.padding(4).Parent = scroll
	gemsLabel = Lib.label({ Size = UDim2.new(1, 0, 0, 32), Text = "", Font = T.Title, TextColor3 = T.Blue:Lerp(Color3.new(1, 1, 1), 0.3), LayoutOrder = 0, MaxText = 26, Parent = scroll })
	Lib.textStroke(2).Parent = gemsLabel
	boostLabel = Lib.label({ Size = UDim2.new(1, 0, 0, 22), Text = "", TextColor3 = T.Green, LayoutOrder = 1, MaxText = 15, Parent = scroll })
	for i, key in ipairs(UpgradeData.SortedKeys(UpgradeData.GemShop)) do
		local item = UpgradeData.GemShop[key]
		local row = Lib.panel({ Size = UDim2.new(1, -8, 0, 72), LayoutOrder = 10 + i, Parent = scroll })
		Lib.stroke(T.Blue, 2).Parent = row
		Lib.label({ Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(8, 8), Text = item.Icon, MaxText = 36, Parent = row })
		local t = Lib.label({ Size = UDim2.new(1, -240, 0, 26), Position = UDim2.fromOffset(72, 8), Text = item.Name, Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = row })
		Lib.textStroke(1.5).Parent = t
		Lib.label({ Size = UDim2.new(1, -240, 0, 30), Position = UDim2.fromOffset(72, 36), Text = item.Description, TextColor3 = T.SubText, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 14, Parent = row })
		rows[key] = Lib.button({ Text = "", Color = T.Blue, Size = UDim2.fromOffset(140, 48), Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = row, OnClick = function()
			State.Request("BuyGemItem", key)
		end })
	end
	local h = Lib.label({ Size = UDim2.new(1, 0, 0, 30), Text = "🎨 PERSONALIZE YOUR BASE (free)", Font = T.Title, TextColor3 = T.Pink, LayoutOrder = 50, MaxText = 22, Parent = scroll })
	Lib.textStroke(2).Parent = h
	local palette = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 110), LayoutOrder = 51, Parent = scroll }, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(48, 48), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	for i, color in ipairs(UpgradeData.BaseColors) do
		local sw = new("TextButton", { BackgroundColor3 = color, Text = "", LayoutOrder = i, Parent = palette }, { Lib.corner(24), Lib.stroke(Color3.new(0, 0, 0), 2) })
		sw.Activated:Connect(function()
			State.Request("SetBaseColor", i)
		end)
		swatches[i] = sw
	end
	Lib.label({ Size = UDim2.new(1, 0, 0, 20), Text = "Wall materials, cameras, traps and a second floor are in 🛒 Upgrades.", TextColor3 = T.SubText, LayoutOrder = 52, MaxText = 14, Parent = scroll })
	State.FullChanged.Event:Connect(refresh)
	State.StatsChanged.Event:Connect(refresh)
end

function GemShop.OnOpen()
	isOpen = true
	refresh()
end

function GemShop.OnClose()
	isOpen = false
end

return GemShop
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- HUD.lua
-- Always-on interface: money counter, income, level bar, menu buttons,
-- carrying status, base lock button, cooldown chips, ability buttons (also
-- the mobile controls), world event timer and incoming trade requests.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Lib = require(script.Parent.Lib)
local Windows = require(script.Parent.Windows)
local Notifications = require(script.Parent.Notifications)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TreasureData = require(Shared.TreasureData)
local UpgradeData = require(Shared.UpgradeData)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local HUD = {}

local gui: ScreenGui
local moneyLabel: TextLabel
local mpsLabel: TextLabel
local levelSet
local levelLabel: TextLabel
local rebirthLabel: TextLabel
local carryLabel: TextLabel
local lockButton: TextButton
local chips: Frame
local chipLabels = {}
local abilityButtons = {}
local eventFrame: Frame
local eventLabel: TextLabel
local gemsLabel: TextLabel
local vaultButton: TextButton
local staminaSet
local sprintButton: TextButton
local emotePanel: Frame
local sprinting = false
local displayedMoney = 0
local targetMoney = 0
local lastMoney = nil

function HUD.Gui()
	return gui
end

local function menuButton(parent, order, icon, text, color, window)
	local b = Lib.button({
		Text = "",
		Color = color,
		Size = UDim2.fromOffset(64, 64),
		LayoutOrder = order,
		Radius = 16,
		Parent = parent,
		OnClick = function()
			Windows.Toggle(window)
		end,
	})
	Lib.label({ Size = UDim2.new(1, 0, 0.68, 0), Text = icon, MaxText = 32, Parent = b })
	local l = Lib.label({ Size = UDim2.new(1, 4, 0.32, 0), Position = UDim2.new(0, -2, 0.66, 0), Text = text, Font = T.Title, MaxText = 13, Parent = b })
	Lib.textStroke(1.5).Parent = l
	return b
end

local function chip(name: string, color: Color3)
	local c = Lib.panel({ Size = UDim2.fromOffset(150, 30), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.15, Visible = false, Parent = chips })
	Lib.stroke(color, 2).Parent = c
	local l = Lib.label({ Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), Text = "", TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.4), MaxText = 15, Parent = c })
	Lib.textStroke(1).Parent = l
	chipLabels[name] = { Frame = c, Label = l }
end

local function setChip(name: string, text: string?)
	local c = chipLabels[name]
	c.Frame.Visible = text ~= nil
	if text then
		c.Label.Text = text
	end
end

local function buildTop()
	local top = Lib.panel({
		Name = "MoneyPanel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(300, 74),
		BackgroundColor3 = T.Bg,
		BackgroundTransparency = 0.1,
		Radius = 16,
		Parent = gui,
	})
	Lib.stroke(T.Accent, 3).Parent = top
	moneyLabel = Lib.label({ Size = UDim2.new(1, -16, 0, 44), Position = UDim2.fromOffset(8, 4), Text = "$0", Font = T.Title, TextColor3 = T.Accent, MaxText = 40, Parent = top })
	Lib.textStroke(2.5).Parent = moneyLabel
	mpsLabel = Lib.label({ Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 48), Text = "+$0/s", TextColor3 = T.Green, MaxText = 18, Parent = top })
	Lib.textStroke(1.5).Parent = mpsLabel

	-- gems + vault (collect) under the money panel
	local gems = Lib.panel({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(0.5, -158, 0, 8), Size = UDim2.fromOffset(120, 36), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.1, Radius = 12, Parent = gui })
	Lib.stroke(T.Blue, 2.5).Parent = gems
	gemsLabel = Lib.label({ Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), Text = "💎 0", Font = T.Title, TextColor3 = T.Blue:Lerp(Color3.new(1, 1, 1), 0.4), MaxText = 22, Parent = gems })
	Lib.textStroke(1.5).Parent = gemsLabel
	vaultButton = Lib.button({
		Text = "💰 Vault $0",
		Color = T.Accent,
		Size = UDim2.fromOffset(150, 36),
		Position = UDim2.new(0.5, 158, 0, 8),
		AnchorPoint = Vector2.new(0, 0),
		MaxText = 18,
		Parent = gui,
		OnClick = function()
			State.Request("Collect")
		end,
	})

	local lvl = Lib.panel({ Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(230, 56), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.1, Radius = 14, Parent = gui })
	Lib.stroke(T.Blue, 2.5).Parent = lvl
	levelLabel = Lib.label({ Size = UDim2.new(0.6, 0, 0, 24), Position = UDim2.fromOffset(10, 3), Text = "⭐ Level 1", Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = lvl })
	Lib.textStroke(1.5).Parent = levelLabel
	rebirthLabel = Lib.label({ Size = UDim2.new(0.4, -10, 0, 24), Position = UDim2.new(0.6, 0, 0, 3), Text = "🌀 0", Font = T.Title, TextColor3 = T.Pink, TextXAlignment = Enum.TextXAlignment.Right, MaxText = 20, Parent = lvl })
	Lib.textStroke(1.5).Parent = rebirthLabel
	local _, setter = Lib.bar({ Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 30), Color = T.Blue, Parent = lvl })
	levelSet = setter

	eventFrame = Lib.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 88),
		Size = UDim2.fromOffset(320, 36),
		BackgroundColor3 = T.Bg,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = gui,
	})
	Lib.stroke(T.Pink, 2.5).Parent = eventFrame
	eventLabel = Lib.label({ Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), Text = "", Font = T.Title, TextColor3 = T.Pink:Lerp(Color3.new(1, 1, 1), 0.4), MaxText = 18, Parent = eventFrame })
	Lib.textStroke(1.5).Parent = eventLabel
end

local function buildMenu()
	local menu = new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(140, 370),
		Parent = gui,
	}, {
		new("UIGridLayout", {
			CellSize = UDim2.fromOffset(64, 64),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			FillDirectionMaxCells = 2,
		}),
	})
	menuButton(menu, 1, "🎒", "Items", T.Blue, "Inventory")
	menuButton(menu, 2, "🐾", "Pets", T.Orange, "Pets")
	menuButton(menu, 3, "📖", "Index", T.Purple, "Index")
	menuButton(menu, 4, "🛒", "Upgrade", T.Green, "Shop")
	menuButton(menu, 5, "💎", "Gems", T.Blue, "GemShop")
	menuButton(menu, 6, "🌀", "Rebirth", T.Pink, "Rebirth")
	menuButton(menu, 7, "🏆", "Top", T.Accent, "Leaderboard")
	menuButton(menu, 8, "🤝", "Trade", T.Orange, "Trade")
	menuButton(menu, 9, "🎖️", "Awards", T.Accent, "Achievements")
	menuButton(menu, 10, "⚙️", "Settings", T.Panel2, "Settings")
end

local function buildBottom()
	local bottom = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(520, 120),
		Parent = gui,
	})
	carryLabel = Lib.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -54),
		Size = UDim2.new(1, 0, 0, 28),
		Text = "",
		Font = T.Title,
		TextColor3 = T.Accent,
		MaxText = 20,
		Parent = bottom,
	})
	Lib.textStroke(2).Parent = carryLabel
	lockButton = Lib.button({
		Text = "🔒 LOCK BASE",
		Color = T.Red,
		Size = UDim2.fromOffset(190, 46),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Parent = bottom,
		OnClick = function()
			State.Request("LockBase")
		end,
	})
	chips = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -86),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = bottom,
	}, { Lib.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	chip("Shield", T.Blue)
	chip("Steal", T.Orange)
	chip("Locked", T.Green)
	chip("Gold", T.Accent)
	chip("Boost", T.Green)
	chip("Luck", T.Green)
	-- stamina bar
	local _, setter = Lib.bar({ Size = UDim2.fromOffset(190, 12), Position = UDim2.new(0.5, 0, 1, -50), AnchorPoint = Vector2.new(0.5, 1), Color = T.Green, Parent = bottom })
	staminaSet = setter
end

function HUD.SetSprint(on: boolean)
	if sprinting == on then
		return
	end
	sprinting = on
	if sprintButton then
		Lib.setButtonColor(sprintButton, on and T.Green or T.Panel2)
	end
	State.Ask("Sprint", on)
end

local EMOTES = { { "Dance", "💃" }, { "Wave", "👋" }, { "Cheer", "🙌" }, { "Flex", "💪" }, { "Victory", "🏆" } }
function HUD.ToggleEmotes()
	emotePanel.Visible = not emotePanel.Visible
end

local function buildActions()
	-- sprint + emote buttons (bottom-left on PC, above the thumbstick on mobile)
	local touch = UserInputService.TouchEnabled
	local holder = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = touch and Vector2.new(1, 0.5) or Vector2.new(0, 1),
		Position = touch and UDim2.new(1, -12, 0.38, 0) or UDim2.new(0, 12, 1, -12),
		Size = touch and UDim2.fromOffset(70, 136) or UDim2.fromOffset(150, 70),
		Parent = gui,
	}, { Lib.list(touch and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom) })
	sprintButton = Lib.button({ Text = touch and "🏃 Sprint" or "🏃 [Shift]", Color = T.Panel2, Size = UDim2.fromOffset(70, 60), Radius = 30, MaxText = 14, Parent = holder, OnClick = function()
		HUD.SetSprint(not sprinting)
	end })
	Lib.button({ Text = touch and "😀 Emote" or "😀 [T]", Color = T.Pink, Size = UDim2.fromOffset(70, 60), Radius = 30, MaxText = 14, Parent = holder, OnClick = HUD.ToggleEmotes })
	emotePanel = Lib.panel({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -170),
		Size = UDim2.fromOffset(360, 70),
		BackgroundColor3 = T.Bg,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = gui,
	})
	Lib.stroke(T.Pink, 2.5).Parent = emotePanel
	Lib.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center).Parent = emotePanel
	for i, e in ipairs(EMOTES) do
		Lib.button({ Text = e[2] .. " " .. e[1], Color = T.Panel2, Size = UDim2.fromOffset(64, 54), LayoutOrder = i, MaxText = 13, Parent = emotePanel, OnClick = function()
			State.Request("Emote", e[1])
			emotePanel.Visible = false
		end })
	end
end

local function buildAbilities()
	local holder = new("Frame", {
		Name = "Abilities",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, UserInputService.TouchEnabled and -190 or -24),
		Size = UDim2.fromOffset(76, 260),
		Parent = gui,
	}, { Lib.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom) })
	for i, key in ipairs(UpgradeData.SortedKeys(UpgradeData.Abilities)) do
		local ab = UpgradeData.Abilities[key]
		if ab.Key then
			local b = Lib.button({
				Text = "",
				Color = T.Purple,
				Size = UDim2.fromOffset(70, 70),
				LayoutOrder = i,
				Radius = 35,
				Visible = false,
				Parent = holder,
				OnClick = function()
					State.Request("UseAbility", key)
				end,
			})
			Lib.label({ Size = UDim2.new(1, 0, 0.62, 0), Position = UDim2.fromScale(0, 0.06), Text = ab.Icon, MaxText = 30, Parent = b })
			local keyLabel = Lib.label({ Size = UDim2.new(1, 0, 0.3, 0), Position = UDim2.fromScale(0, 0.64), Text = UserInputService.TouchEnabled and ab.Name or ("[" .. ab.Key .. "]"), Font = T.Title, MaxText = 13, Parent = b })
			Lib.textStroke(1.5).Parent = keyLabel
			local cd = new("TextLabel", {
				Name = "Cooldown",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0.45,
				Font = T.Title,
				TextScaled = true,
				TextColor3 = Color3.new(1, 1, 1),
				Text = "",
				Visible = false,
				ZIndex = 5,
				Parent = b,
			}, { Lib.corner(35) })
			abilityButtons[key] = { Button = b, Cooldown = cd }
		end
	end
end

local function tradePopup(fromUserId: number, fromName: string, timeout: number)
	local popup = Lib.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 140),
		Size = UDim2.fromOffset(340, 120),
		BackgroundColor3 = T.Bg,
		ZIndex = 20,
		Parent = gui,
	})
	Lib.stroke(T.Orange, 3).Parent = popup
	local l = Lib.label({ Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 8), Text = ("🤝 %s wants to trade!"):format(fromName), Font = T.Title, ZIndex = 21, MaxText = 22, Parent = popup })
	Lib.textStroke(1.5).Parent = l
	local function respond(accept)
		popup:Destroy()
		State.Request("TradeRespond", fromUserId, accept)
	end
	Lib.button({ Text = "Accept", Color = T.Green, Size = UDim2.fromOffset(140, 44), Position = UDim2.new(0.5, -6, 1, -12), AnchorPoint = Vector2.new(1, 1), ZIndex = 22, Parent = popup, OnClick = function()
		respond(true)
	end })
	Lib.button({ Text = "Decline", Color = T.Red, Size = UDim2.fromOffset(140, 44), Position = UDim2.new(0.5, 6, 1, -12), AnchorPoint = Vector2.new(0, 1), ZIndex = 22, Parent = popup, OnClick = function()
		respond(false)
	end })
	task.delay(timeout, function()
		if popup.Parent then
			popup:Destroy()
		end
	end)
end

local function onStats(stats)
	targetMoney = stats.Money
	if lastMoney and stats.Money - lastMoney > 0 and stats.Money - lastMoney > (stats.MPS or 0) * 1.5 then
		Notifications.MoneyPop("+" .. Util.Money(stats.Money - lastMoney))
		-- bounce the money panel on big gains
		local panel = gui:FindFirstChild("MoneyPanel")
		if panel then
			local sc = panel:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = panel })
			sc.Scale = 1.12
			TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
	end
	lastMoney = stats.Money
	local mult = (stats.EventMultiplier or 1) > 1 and ("  🌟x" .. stats.EventMultiplier) or ""
	mpsLabel.Text = ("+%s/s%s"):format(Util.Money(stats.MPS or 0), mult)
	gemsLabel.Text = "💎 " .. Util.Abbreviate(stats.Gems or 0)
	local full = State.Full
	if full and full.AutoCollect then
		vaultButton.Text = "🤖 Auto Collect"
		Lib.setButtonColor(vaultButton, T.Panel2)
	else
		vaultButton.Text = "💰 Collect " .. Util.Money(math.floor(stats.Vault or 0))
		Lib.setButtonColor(vaultButton, (stats.Vault or 0) >= 1 and T.Accent or T.Panel2)
	end
	staminaSet((stats.Stamina or 0) / (stats.MaxStamina or 100), "⚡ Stamina")
	if sprinting and (stats.Stamina or 0) <= 0 then
		sprinting = false
		Lib.setButtonColor(sprintButton, T.Panel2)
	end
	levelLabel.Text = ("⭐ Level %d"):format(stats.Level)
	rebirthLabel.Text = ("🌀 %d"):format(stats.Rebirths or 0)
	levelSet(stats.XP / math.max(1, stats.XPNext), ("%s / %s XP"):format(Util.Abbreviate(stats.XP), Util.Abbreviate(stats.XPNext)))
	if #stats.Carrying > 0 then
		local names = {}
		local stolen = false
		for _, item in ipairs(stats.Carrying) do
			local def = TreasureData.Get(item.Id)
			table.insert(names, def and def.Name or "?")
			stolen = stolen or item.Source == "Steal"
		end
		carryLabel.Text = ("%s %s (%d/%d) — bring it to your base!"):format(stolen and "🏃‍♂️💨" or "📦", table.concat(names, ", "), #stats.Carrying, stats.CarryCap)
		carryLabel.TextColor3 = stolen and T.Red:Lerp(Color3.new(1, 1, 1), 0.3) or T.Accent
	else
		carryLabel.Text = ""
	end
end

local function tick()
	local stats = State.Stats
	local now = State.Now()
	if stats then
		local shield = stats.ShieldEnd - now
		setChip("Shield", shield > 0 and ("🛡️ New player shield %ds"):format(math.ceil(shield)) or nil)
		local steal = stats.StealCooldownEnd - now
		setChip("Steal", steal > 0 and ("🦹 Steal ready in %ds"):format(math.ceil(steal)) or nil)
		local lock = stats.LockEnd - now
		setChip("Locked", lock > 0 and ("🔒 Base locked %ds"):format(math.ceil(lock)) or nil)
		local gold = (stats.EventMultiplier or 1) > 1
		setChip("Gold", gold and "💸 DOUBLE MONEY" or nil)
		local active = {}
		local t0 = stats.ServerTime or os.time()
		for name, expiry in pairs(stats.Boosts or {}) do
			if expiry > t0 then
				table.insert(active, name)
			end
		end
		setChip("Boost", #active > 0 and ("⏳ Boost: " .. table.concat(active, ", ")) or nil)
		local luck = stats.Luck or 1
		setChip("Luck", luck > 1.001 and ("🍀 Luck x%.1f"):format(luck) or nil)
		local cooldown = stats.LockCooldownEnd - now
		if lock > 0 then
			lockButton.Text = ("🔒 LOCKED %ds"):format(math.ceil(lock))
			Lib.setButtonColor(lockButton, T.Green)
		elseif cooldown > 0 then
			lockButton.Text = ("⏳ LOCK IN %ds"):format(math.ceil(cooldown))
			Lib.setButtonColor(lockButton, T.Panel2)
		else
			lockButton.Text = "🔒 LOCK BASE"
			Lib.setButtonColor(lockButton, T.Red)
		end
		for key, ab in pairs(abilityButtons) do
			local cdEnd = stats.AbilityCooldowns and stats.AbilityCooldowns[key] or 0
			local left = cdEnd - now
			ab.Cooldown.Visible = left > 0
			ab.Cooldown.Text = left > 0 and tostring(math.ceil(left)) or ""
		end
	end
	local full = State.Full
	if full then
		for key, ab in pairs(abilityButtons) do
			ab.Button.Visible = full.Abilities[key] == true
		end
	end
	local eventName = workspace:GetAttribute("Event")
	if eventName and eventName ~= "" then
		local left = (workspace:GetAttribute("EventEnd") or 0) - now
		eventFrame.Visible = true
		eventLabel.Text = ("🎉 %s — %s"):format(eventName, Util.Time(left))
	else
		local nextEvent = (workspace:GetAttribute("NextEvent") or 0) - now
		eventFrame.Visible = nextEvent > 0 and nextEvent < 60
		eventLabel.Text = ("⏰ Next event in %ds"):format(math.ceil(nextEvent))
	end
end

function HUD.Init(parentGui: ScreenGui)
	gui = parentGui
	buildTop()
	buildMenu()
	buildBottom()
	buildAbilities()
	buildActions()
	State.StatsChanged.Event:Connect(onStats)
	State.FullChanged.Event:Connect(function(full)
		targetMoney = full.Money
	end)
	Remotes.TradeRequest.OnClientEvent:Connect(tradePopup)
	-- smooth money counter
	game:GetService("RunService").RenderStepped:Connect(function(dt)
		if displayedMoney ~= targetMoney then
			local diff = targetMoney - displayedMoney
			if math.abs(diff) < 1 then
				displayedMoney = targetMoney
			else
				displayedMoney += diff * math.min(1, dt * 8)
			end
			moneyLabel.Text = Util.Money(math.floor(displayedMoney))
		end
	end)
	task.spawn(function()
		while true do
			tick()
			task.wait(0.25)
		end
	end)
end

return HUD
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">IndexWindow</string><ProtectedString name="Source"><![CDATA[-- IndexWindow.lua
-- The Treasure Index: every treasure in the game, discovered or not,
-- filterable by rarity, with completion progress and 3D previews.

local Lib = require(script.Parent.Lib)
local Preview = require(script.Parent.Preview)
local Inventory = require(script.Parent.InventoryWindow)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TreasureData = require(Shared.TreasureData)
local Rarities = require(Shared.Rarities)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local Index = {}

local filter = "All"
local grid: ScrollingFrame
local progressSet
local filterButtons = {}
local detailName: TextLabel
local detailInfo: TextLabel
local viewport: ViewportFrame
local cleanup = function() end
local isOpen = false

local function discovered(): { [string]: boolean }
	local set = {}
	if State.Full then
		for _, id in ipairs(State.Full.Index) do
			set[id] = true
		end
	end
	return set
end

local function selectDef(def, known: boolean)
	cleanup()
	if known then
		cleanup = Preview.Show(viewport, def)
		detailName.Text = def.Name
		detailName.TextColor3 = Rarities.Color(def.Rarity)
		detailInfo.Text = ("%s%s\n💰 %s/s\n💎 %s\n✨ %s effect"):format(
			def.Rarity,
			def.Exclusive and " • Rebirth Exclusive" or "",
			Util.Money(def.MPS),
			Util.Money(def.Value),
			def.Fx == "None" and "Classic" or def.Fx
		)
	else
		cleanup = function() end
		viewport:ClearAllChildren()
		detailName.Text = "???"
		detailName.TextColor3 = Rarities.Color(def.Rarity)
		detailInfo.Text = def.Rarity .. "\nNot discovered yet.\n" .. (def.Exclusive and "Unlocked through rebirth." or "Find, buy or steal it!")
	end
end

local function refresh()
	if not isOpen then
		return
	end
	Lib.clear(grid)
	local known = discovered()
	local found, total = 0, 0
	for _, def in ipairs(TreasureData.List) do
		if not def.Exclusive then
			total += 1
			if known[def.Id] then
				found += 1
			end
		end
	end
	progressSet(found / total, ("📖 %d / %d discovered"):format(found, total))
	for _, def in ipairs(TreasureData.List) do
		if filter == "All" or def.Rarity == filter then
			local isKnown = known[def.Id] == true
			local card = Inventory.Card(def, { Order = def.Order, Hidden = not isKnown, Sub = isKnown and (Util.Money(def.MPS) .. "/s") or def.Rarity })
			card.Activated:Connect(function()
				selectDef(def, isKnown)
			end)
			card.Parent = grid
		end
	end
	for name, b in pairs(filterButtons) do
		Lib.setButtonColor(b, name == filter and (name == "All" and T.Accent or Rarities.Color(name)) or T.Panel2)
	end
end

function Index.Build(content: Frame)
	local _, setter = Lib.bar({ Size = UDim2.new(1, 0, 0, 26), Color = T.Purple, Parent = content })
	progressSet = setter
	local filters = Lib.scroll({
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 40),
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollBarThickness = 3,
		Parent = content,
	})
	Lib.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center).Parent = filters
	local names = { "All" }
	for _, r in ipairs(Rarities.Order) do
		table.insert(names, r)
	end
	for i, name in ipairs(names) do
		filterButtons[name] = Lib.button({
			Text = name,
			Color = T.Panel2,
			Size = UDim2.fromOffset(92, 32),
			LayoutOrder = i,
			MaxText = 16,
			Parent = filters,
			OnClick = function()
				filter = name
				refresh()
			end,
		})
	end
	grid = Lib.scroll({ Position = UDim2.fromOffset(0, 78), Size = UDim2.new(0.68, -8, 1, -78), Parent = content })
	Lib.grid(UDim2.fromOffset(96, 112), 8).Parent = grid
	Lib.padding(4).Parent = grid
	local panel = Lib.panel({ Position = UDim2.new(0.68, 0, 0, 78), Size = UDim2.new(0.32, 0, 1, -78), Parent = content })
	Lib.padding(10).Parent = panel
	viewport = new("ViewportFrame", { Size = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = T.Panel2, Parent = panel }, { Lib.corner(12) })
	detailName = Lib.label({ Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0.52, 0), Font = T.Title, Text = "Pick a treasure", MaxText = 22, Parent = panel })
	Lib.textStroke(1.5).Parent = detailName
	detailInfo = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0.48, -36),
		Position = UDim2.new(0, 0, 0.52, 34),
		Font = T.Body,
		TextSize = 15,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = T.SubText,
		Text = "",
		Parent = panel,
	})
	State.FullChanged.Event:Connect(refresh)
end

function Index.OnOpen()
	isOpen = true
	refresh()
end

function Index.OnClose()
	isOpen = false
	cleanup()
	cleanup = function() end
end

return Index
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">InventoryWindow</string><ProtectedString name="Source"><![CDATA[-- InventoryWindow.lua
-- Your treasures: placed on platforms or in storage. Place, store and sell,
-- with a rotating 3D preview of the selected treasure.

local Lib = require(script.Parent.Lib)
local Preview = require(script.Parent.Preview)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TreasureData = require(Shared.TreasureData)
local Rarities = require(Shared.Rarities)
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Mutations = require(Shared.Mutations)

local T = Lib.Theme
local new = Lib.new

local Inventory = {}

local tab = "All"
local selectedUid: string? = nil
local grid: ScrollingFrame
local tabButtons = {}
local countLabel: TextLabel
local detail = {}
local cleanupPreview = function() end
local isOpen = false

function Inventory.Card(def, opts)
	local color = Rarities.Color(def.Rarity)
	local mut = opts.Mut and Mutations.Info[opts.Mut]
	local card = new("TextButton", {
		Name = def.Id,
		BackgroundColor3 = color,
		AutoButtonColor = true,
		Text = "",
		LayoutOrder = opts.Order or 0,
	}, {
		Lib.corner(12),
		Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(110, 110, 130), 90),
		Lib.stroke(opts.Selected and T.Accent or (mut and mut.Color or color:Lerp(Color3.new(0, 0, 0), 0.4)), (opts.Selected or mut) and 4 or 2),
	})
	if mut then
		local tag = Lib.label({ Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -28, 0, 2), Text = mut.Icon, MaxText = 20, Parent = card })
		tag.ZIndex = 3
	end
	local icon = Lib.label({
		Size = UDim2.new(1, 0, 0.5, 0),
		Position = UDim2.fromScale(0, 0.04),
		Text = opts.Hidden and "❓" or def.Icon,
		Font = T.Title,
		MaxText = 44,
		Parent = card,
	})
	icon.TextTransparency = opts.Hidden and 0.3 or 0
	local name = Lib.label({
		Size = UDim2.new(1, -8, 0.22, 0),
		Position = UDim2.new(0, 4, 0.54, 0),
		Text = opts.Hidden and "???" or def.Name,
		Font = T.Title,
		MaxText = 15,
		Parent = card,
	})
	Lib.textStroke(1.5).Parent = name
	local sub = Lib.label({
		Size = UDim2.new(1, -8, 0.18, 0),
		Position = UDim2.new(0, 4, 0.78, 0),
		Text = opts.Sub or (Util.Money(def.MPS * Mutations.Multiplier(opts.Mut)) .. "/s"),
		TextColor3 = Color3.fromRGB(190, 255, 190),
		MaxText = 13,
		Parent = card,
	})
	Lib.textStroke(1.5).Parent = sub
	if opts.Badge then
		local badge = Lib.label({
			Size = UDim2.fromOffset(22, 22),
			Position = UDim2.fromOffset(4, 4),
			Text = opts.Badge,
			MaxText = 18,
			Parent = card,
		})
		badge.ZIndex = 3
	end
	return card
end

local function entries()
	local full = State.Full
	if not full then
		return {}
	end
	local list = {}
	for _, t in ipairs(full.Treasures) do
		local def = TreasureData.Get(t.Id)
		if def then
			local placed = t.Plot ~= nil
			if tab == "All" or (tab == "Placed" and placed) or (tab == "Storage" and not placed) then
				table.insert(list, { Entry = t, Def = def })
			end
		end
	end
	table.sort(list, function(a, b)
		if a.Def.MPS ~= b.Def.MPS then
			return a.Def.MPS > b.Def.MPS
		end
		return a.Entry.Uid < b.Entry.Uid
	end)
	return list
end

local function findEntry(uid: string?)
	if not uid or not State.Full then
		return nil
	end
	for _, t in ipairs(State.Full.Treasures) do
		if t.Uid == uid then
			return t
		end
	end
	return nil
end

local function refreshDetail()
	local t = findEntry(selectedUid)
	cleanupPreview()
	if not t then
		detail.Name.Text = "Select a treasure"
		detail.Rarity.Text = ""
		detail.Info.Text = "Tap a card to see it in 3D and manage it."
		detail.Place.Visible = false
		detail.Store.Visible = false
		detail.Sell.Visible = false
		cleanupPreview = function() end
		return
	end
	local def = TreasureData.Get(t.Id)
	cleanupPreview = Preview.Show(detail.Viewport, def)
	detail.Name.Text = def.Name
	detail.Rarity.Text = def.Rarity:upper() .. (def.Exclusive and " • EXCLUSIVE" or "") .. (t.Mut and ("  " .. Mutations.Label(t.Mut)) or "")
	detail.Rarity.TextColor3 = Rarities.Color(def.Rarity)
	local status = t.Stealing and "🚨 BEING STOLEN!" or (t.InTrade and "🤝 In trade" or (t.Plot and ("📍 Platform " .. t.Plot) or "📦 In storage"))
	local m = Mutations.Multiplier(t.Mut)
	detail.Info.Text = ("💰 %s/s\n💎 Value %s\n🏷️ Sells for %s\n%s"):format(
		Util.Money(def.MPS * m),
		Util.Money(def.Value * m),
		Util.Money(math.floor(def.Value * m * Config.SellMultiplier)),
		status
	)
	detail.Place.Visible = t.Plot == nil and not t.InTrade
	detail.Store.Visible = t.Plot ~= nil and not t.Stealing
	detail.Sell.Visible = not t.Stealing and not t.InTrade
end

local function refresh()
	if not isOpen then
		return
	end
	Lib.clear(grid)
	local full = State.Full
	if not full then
		return
	end
	local placed, stored = 0, 0
	for _, t in ipairs(full.Treasures) do
		if t.Plot then
			placed += 1
		else
			stored += 1
		end
	end
	countLabel.Text = ("📍 %d/%d platforms   📦 %d/%d storage"):format(placed, full.PlotCount, stored, full.MaxStorage)
	for i, e in ipairs(entries()) do
		local badge = e.Entry.Stealing and "🚨" or (e.Entry.Plot and "📍" or nil)
		local card = Inventory.Card(e.Def, { Order = i, Selected = e.Entry.Uid == selectedUid, Badge = badge, Mut = e.Entry.Mut })
		card.Activated:Connect(function()
			selectedUid = e.Entry.Uid
			refresh()
		end)
		card.Parent = grid
	end
	for name, b in pairs(tabButtons) do
		Lib.setButtonColor(b, name == tab and T.Accent or T.Panel2)
	end
	refreshDetail()
end

function Inventory.Build(content: Frame)
	-- top bar
	local top = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Parent = content }, {
		Lib.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center),
	})
	for i, name in ipairs({ "All", "Placed", "Storage" }) do
		tabButtons[name] = Lib.button({
			Text = name,
			Color = T.Panel2,
			Size = UDim2.fromOffset(90, 34),
			LayoutOrder = i,
			Parent = top,
			OnClick = function()
				tab = name
				refresh()
			end,
		})
	end
	Lib.button({
		Text = "📍 Place All",
		Color = T.Green,
		Size = UDim2.fromOffset(120, 34),
		LayoutOrder = 10,
		Parent = top,
		OnClick = function()
			State.Request("PlaceAll")
		end,
	})
	Lib.button({
		Text = "💰 Sell Storage ≤ Rare",
		Color = T.Orange,
		Size = UDim2.fromOffset(170, 34),
		LayoutOrder = 11,
		Parent = top,
		OnClick = function()
			State.Request("SellStorage", 3)
		end,
	})
	countLabel = Lib.label({
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 44),
		Text = "",
		TextColor3 = T.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 16,
		Parent = content,
	})

	grid = Lib.scroll({
		Position = UDim2.fromOffset(0, 70),
		Size = UDim2.new(0.64, -8, 1, -70),
		Parent = content,
	})
	Lib.grid(UDim2.fromOffset(104, 118), 8).Parent = grid
	Lib.padding(4).Parent = grid

	local panel = Lib.panel({
		Position = UDim2.new(0.64, 0, 0, 70),
		Size = UDim2.new(0.36, 0, 1, -70),
		BackgroundColor3 = T.Panel,
		Parent = content,
	})
	Lib.padding(10).Parent = panel
	detail.Viewport = new("ViewportFrame", {
		Size = UDim2.new(1, 0, 0.42, 0),
		BackgroundColor3 = T.Panel2,
		Parent = panel,
	}, { Lib.corner(12) })
	detail.Name = Lib.label({ Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0.43, 0), Font = T.Title, MaxText = 24, Parent = panel })
	detail.Rarity = Lib.label({ Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0.43, 30), Font = T.Title, MaxText = 18, Parent = panel })
	Lib.textStroke(1.5).Parent = detail.Rarity
	detail.Info = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0.3, -50),
		Position = UDim2.new(0, 0, 0.43, 52),
		Font = T.Body,
		TextSize = 15,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = T.SubText,
		Text = "",
		Parent = panel,
	})
	local buttons = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.new(0, 0, 1, -40),
		Parent = panel,
	}, { Lib.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center) })
	detail.Place = Lib.button({ Text = "Place", Color = T.Green, Size = UDim2.new(0.32, 0, 1, 0), Parent = buttons, OnClick = function()
		if selectedUid then
			State.Request("Place", selectedUid)
		end
	end })
	detail.Store = Lib.button({ Text = "Store", Color = T.Blue, Size = UDim2.new(0.32, 0, 1, 0), Parent = buttons, OnClick = function()
		if selectedUid then
			State.Request("Store", selectedUid)
		end
	end })
	detail.Sell = Lib.button({ Text = "Sell", Color = T.Red, Size = UDim2.new(0.32, 0, 1, 0), Parent = buttons, OnClick = function()
		if selectedUid then
			local ok = State.Request("Sell", selectedUid)
			if ok then
				selectedUid = nil
			end
		end
	end })

	State.FullChanged.Event:Connect(refresh)
end

function Inventory.OnOpen(arg)
	isOpen = true
	if arg == "Sell" then
		tab = "Storage"
	end
	refresh()
end

function Inventory.OnClose()
	isOpen = false
	cleanupPreview()
	cleanupPreview = function() end
end

return Inventory
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">LeaderboardWindow</string><ProtectedString name="Source"><![CDATA[-- LeaderboardWindow.lua
-- Server board (live) and global boards (Richest, Rebirths).

local Players = game:GetService("Players")

local Lib = require(script.Parent.Lib)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local Board = {}

local tab = "Server"
local list: ScrollingFrame
local tabs = {}
local isOpen = false

local MEDAL = { "🥇", "🥈", "🥉" }

local function refresh()
	if not isOpen then
		return
	end
	Lib.clear(list)
	for name, b in pairs(tabs) do
		Lib.setButtonColor(b, name == tab and T.Accent or T.Panel2)
	end
	local board = State.Leaderboard
	local entries = board and board[tab] or {}
	if #entries == 0 then
		Lib.label({
			Size = UDim2.new(1, 0, 0, 40),
			Text = tab == "Server" and "Loading..." or "Global boards update every 2 minutes (requires a published game with DataStores).",
			TextColor3 = T.SubText,
			MaxText = 16,
			Parent = list,
		})
		return
	end
	for i, e in ipairs(entries) do
		local isMe = e.UserId == Players.LocalPlayer.UserId
		local row = Lib.panel({
			Size = UDim2.new(1, -8, 0, 48),
			BackgroundColor3 = isMe and T.Accent:Lerp(T.Panel, 0.6) or (i % 2 == 0 and T.Panel or T.Panel2),
			LayoutOrder = i,
			Parent = list,
		})
		Lib.label({ Size = UDim2.fromOffset(60, 40), Position = UDim2.fromOffset(6, 4), Text = MEDAL[i] or ("#" .. i), Font = T.Title, MaxText = 24, Parent = row })
		new("ImageLabel", {
			Size = UDim2.fromOffset(38, 38),
			Position = UDim2.fromOffset(70, 5),
			BackgroundColor3 = T.Bg,
			Image = ("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48"):format(e.UserId),
			Parent = row,
		}, { Lib.corner(19) })
		local name = Lib.label({ Size = UDim2.new(0.5, -120, 1, -8), Position = UDim2.fromOffset(116, 4), Text = e.Name, Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = row })
		Lib.textStroke(1.5).Parent = name
		local valueText
		if tab == "Rebirths" then
			valueText = ("🌀 %s"):format(Util.Commas(e.Value))
		elseif tab == "Server" then
			valueText = ("%s  •  %s/s  •  🌀%d"):format(Util.Money(e.Value), Util.Abbreviate(e.MPS or 0), e.Rebirths or 0)
		else
			valueText = Util.Money(e.Value)
		end
		local v = Lib.label({ Size = UDim2.new(0.5, -10, 1, -8), Position = UDim2.new(0.5, 0, 0, 4), Text = valueText, TextColor3 = T.Green, TextXAlignment = Enum.TextXAlignment.Right, MaxText = 18, Parent = row })
		Lib.textStroke(1.5).Parent = v
	end
end

function Board.Build(content: Frame)
	local top = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Parent = content }, {
		Lib.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center),
	})
	for i, info in ipairs({ { "Server", "🖥️ This Server" }, { "Richest", "🌍 Richest" }, { "Rebirths", "🌍 Rebirths" } }) do
		tabs[info[1]] = Lib.button({
			Text = info[2],
			Color = T.Panel2,
			Size = UDim2.fromOffset(150, 34),
			LayoutOrder = i,
			Parent = top,
			OnClick = function()
				tab = info[1]
				refresh()
			end,
		})
	end
	list = Lib.scroll({ Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 1, -48), Parent = content })
	Lib.list(Enum.FillDirection.Vertical, 6).Parent = list
	Lib.padding(4).Parent = list
	State.LeaderboardChanged.Event:Connect(refresh)
end

function Board.OnOpen()
	isOpen = true
	refresh()
	State.Ask("GetLeaderboard")
end

function Board.OnClose()
	isOpen = false
end

return Board
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">Lib</string><ProtectedString name="Source"><![CDATA[-- Lib.lua
-- Tiny declarative UI helper + theme used by every window.

local TweenService = game:GetService("TweenService")

local Lib = {}

Lib.Theme = {
	Bg = Color3.fromRGB(22, 24, 44),
	Panel = Color3.fromRGB(34, 37, 66),
	Panel2 = Color3.fromRGB(46, 50, 88),
	Stroke = Color3.fromRGB(255, 255, 255),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(190, 195, 230),
	Accent = Color3.fromRGB(255, 196, 50),
	Green = Color3.fromRGB(70, 210, 100),
	Red = Color3.fromRGB(240, 70, 80),
	Blue = Color3.fromRGB(70, 160, 255),
	Purple = Color3.fromRGB(160, 90, 255),
	Pink = Color3.fromRGB(255, 100, 190),
	Orange = Color3.fromRGB(255, 140, 50),
	Title = Enum.Font.FredokaOne,
	Body = Enum.Font.GothamBold,
	Light = Enum.Font.Gotham,
}
local T = Lib.Theme

-- Lib.new("Frame", { Size = ..., Parent = ... }, { children })
function Lib.new(className: string, props: { [string]: any }?, children: { Instance }?)
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
local new = Lib.new

function Lib.corner(r: number?)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 12) })
end

function Lib.stroke(color: Color3?, thickness: number?, transparency: number?)
	return new("UIStroke", {
		Color = color or Color3.fromRGB(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Lib.textStroke(thickness: number?)
	return new("UIStroke", { Color = Color3.fromRGB(15, 15, 30), Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

function Lib.gradient(c1: Color3, c2: Color3, rotation: number?)
	return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rotation or 90 })
end

function Lib.padding(px: number)
	local u = UDim.new(0, px)
	return new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Lib.list(direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?)
	return new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Lib.grid(cell: UDim2, padding: number?)
	return new("UIGridLayout", {
		CellSize = cell,
		CellPadding = UDim2.fromOffset(padding or 8, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	})
end

function Lib.label(props)
	local p = {
		BackgroundTransparency = 1,
		Font = T.Body,
		TextColor3 = T.Text,
		TextScaled = true,
		Text = "",
	}
	for k, v in pairs(props) do
		if k ~= "MaxText" then
			p[k] = v
		end
	end
	local l = new("TextLabel", p)
	if props.TextScaled ~= false then
		new("UITextSizeConstraint", { MaxTextSize = props.MaxText or 28, MinTextSize = 8, Parent = l })
	end
	return l
end

-- Animated button. props.Color, props.OnClick, props.Text ...
local Sound -- lazily required (avoid cyclic requires)
function Lib.button(props)
	local color = props.Color or T.Blue
	local b = new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(140, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Text = props.Text or "",
		Font = props.Font or T.Title,
		TextColor3 = props.TextColor or T.Text,
		TextScaled = true,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, {
		Lib.corner(props.Radius or 10),
		Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190), 90),
		Lib.stroke(color:Lerp(Color3.new(0, 0, 0), 0.45), 2.5),
		new("UITextSizeConstraint", { MaxTextSize = props.MaxText or 24, MinTextSize = 8 }),
		new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }),
		Lib.textStroke(1.5),
	})
	local scale = new("UIScale", { Parent = b })
	b.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.06 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.94 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)
	if props.OnClick then
		b.Activated:Connect(function()
			Sound = Sound or require(script.Parent.Parent.Controllers.Sound)
			Sound.Play("Click")
			props.OnClick(b)
		end)
	end
	return b
end

function Lib.setButtonColor(b: GuiObject, color: Color3)
	b.BackgroundColor3 = color
	for _, s in ipairs(b:GetChildren()) do
		if s:IsA("UIStroke") and s.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then
			s.Color = color:Lerp(Color3.new(0, 0, 0), 0.45)
		end
	end
end

function Lib.panel(props)
	local p = {
		BackgroundColor3 = T.Panel,
		BorderSizePixel = 0,
	}
	for k, v in pairs(props) do
		if k ~= "Radius" then
			p[k] = v
		end
	end
	local f = new("Frame", p)
	Lib.corner(props.Radius or 12).Parent = f
	return f
end

function Lib.scroll(props)
	local p = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = T.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}
	for k, v in pairs(props) do
		p[k] = v
	end
	return new("ScrollingFrame", p)
end

function Lib.clear(container: Instance)
	for _, c in ipairs(container:GetChildren()) do
		if not c:IsA("UIGridStyleLayout") and not c:IsA("UIPadding") and not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
end

-- Progress bar; returns frame and a setter(fraction)
function Lib.bar(props)
	local bg = Lib.panel({
		Name = props.Name or "Bar",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = Color3.fromRGB(15, 15, 30),
		Radius = 8,
		Parent = props.Parent,
		LayoutOrder = props.LayoutOrder or 0,
	})
	Lib.stroke(Color3.fromRGB(0, 0, 0), 2).Parent = bg
	local fill = Lib.panel({ Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = props.Color or T.Accent, Radius = 8, Parent = bg })
	Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)).Parent = fill
	local text = Lib.label({ Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 3, Parent = bg, MaxText = 18 })
	Lib.textStroke(1.5).Parent = text
	return bg, function(f: number, t: string?)
		f = math.clamp(f, 0, 1)
		TweenService:Create(fill, TweenInfo.new(0.25), { Size = UDim2.fromScale(f, 1) }):Play()
		if t then
			text.Text = t
		end
	end
end

return Lib
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">Notifications</string><ProtectedString name="Source"><![CDATA[-- Notifications.lua
-- Toasts, big announcement banners, the robbery alarm overlay, level-up /
-- rebirth splashes and confetti.

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Lib = require(script.Parent.Lib)
local Sound = require(script.Parent.Parent.Controllers.Sound)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rarities = require(Shared.Rarities)

local T = Lib.Theme
local new = Lib.new

local Notifications = {}

local gui: ScreenGui
local toastHolder: Frame
local bannerHolder: Frame
local alarmFrame: Frame
local alarmText: TextLabel

local KIND_COLORS = {
	info = T.Blue,
	success = T.Green,
	error = T.Red,
	warn = T.Orange,
	discovery = T.Purple,
	level = T.Accent,
}

function Notifications.Toast(text: string, kind: string?)
	kind = kind or "info"
	local color = KIND_COLORS[kind] or T.Blue
	local toast = Lib.panel({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Bg,
		BackgroundTransparency = 0.1,
		Parent = toastHolder,
	})
	Lib.stroke(color, 2.5).Parent = toast
	Lib.padding(8).Parent = toast
	local bar = Lib.panel({ Size = UDim2.new(0, 5, 1, 0), BackgroundColor3 = color, Radius = 3, Parent = toast })
	bar.Position = UDim2.fromOffset(-4, 0)
	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 0),
		Position = UDim2.fromOffset(8, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = T.Body,
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = T.Text,
		Text = text,
		Parent = toast,
	})
	local scale = new("UIScale", { Scale = 0.6, Parent = toast })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	if kind == "error" then
		Sound.Play("Error", 0.4)
	elseif kind == "discovery" or kind == "level" then
		Sound.Play("Legendary", 0.6)
	end
	task.delay(4, function()
		if toast.Parent then
			TweenService:Create(toast, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			task.wait(0.3)
			toast:Destroy()
		end
	end)
	-- keep at most 5
	local toasts = {}
	for _, c in ipairs(toastHolder:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(toasts, c)
		end
	end
	if #toasts > 5 then
		toasts[1]:Destroy()
	end
end

function Notifications.Banner(text: string, rarity: string?)
	local color = rarity and Rarities.Color(rarity) or T.Accent
	if rarity == "Secret" then
		color = Color3.fromRGB(130, 255, 230)
	end
	local banner = Lib.panel({
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = T.Bg,
		BackgroundTransparency = 0.05,
		Parent = bannerHolder,
	})
	Lib.stroke(color, 3).Parent = banner
	Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 170), 90).Parent = banner
	local label = Lib.label({
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromOffset(10, 4),
		Font = T.Title,
		Text = text,
		TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.35),
		Parent = banner,
		MaxText = 26,
	})
	Lib.textStroke(2).Parent = label
	local scale = new("UIScale", { Scale = 0.3, Parent = banner })
	TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	Sound.Play(rarity and Rarities.Rank(rarity) >= 5 and "Legendary" or "Event", 0.6)
	Debris:AddItem(banner, 6)
	local count = 0
	for _, c in ipairs(bannerHolder:GetChildren()) do
		if c:IsA("Frame") then
			count += 1
		end
	end
	if count > 3 then
		for _, c in ipairs(bannerHolder:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
				break
			end
		end
	end
end

function Notifications.Alarm(thief: string, treasure: string)
	alarmText.Text = ("🚨 %s IS STEALING YOUR %s! 🚨\nBonk them with your hammer!"):format(thief:upper(), treasure:upper())
	alarmFrame.Visible = true
	task.spawn(function()
		for i = 1, 8 do
			alarmFrame.BackgroundTransparency = (i % 2 == 0) and 0.55 or 0.8
			if i % 2 == 1 then
				Sound.Play("Alarm", 0.8, 0.6)
			end
			task.wait(0.35)
		end
		alarmFrame.Visible = false
	end)
end

function Notifications.Splash(title: string, subtitle: string, color: Color3)
	local frame = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
		ZIndex = 50,
	})
	local t = Lib.label({
		Size = UDim2.fromScale(0.8, 0.14),
		Position = UDim2.fromScale(0.5, 0.38),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = T.Title,
		Text = title,
		TextColor3 = color,
		ZIndex = 51,
		Parent = frame,
		MaxText = 80,
	})
	Lib.textStroke(4).Parent = t
	local s = Lib.label({
		Size = UDim2.fromScale(0.7, 0.06),
		Position = UDim2.fromScale(0.5, 0.48),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = T.Body,
		Text = subtitle,
		ZIndex = 51,
		Parent = frame,
		MaxText = 32,
	})
	Lib.textStroke(2).Parent = s
	local scale = new("UIScale", { Scale = 0.2, Parent = frame })
	TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(2.2, function()
		TweenService:Create(t, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		TweenService:Create(s, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		task.wait(0.6)
		frame:Destroy()
	end)
	Notifications.Confetti()
end

-- Big "NEW DISCOVERY" card with a rotating 3D preview of the treasure.
function Notifications.DiscoveryCard(treasureId: string)
	local TreasureData = require(Shared.TreasureData)
	local Preview = require(script.Parent.Preview)
	local def = TreasureData.Get(treasureId)
	if not def then
		return
	end
	local color = Rarities.Color(def.Rarity)
	local card = Lib.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(300, 340),
		BackgroundColor3 = T.Bg,
		ZIndex = 55,
		Radius = 20,
		Parent = gui,
	})
	Lib.stroke(color, 4).Parent = card
	local glow = new("ImageLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1.6, 1.6),
		Position = UDim2.fromScale(0.5, 0.42),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Image = "rbxasset://textures/particles/sparkles_main.dds",
		ImageColor3 = color,
		ImageTransparency = 0.3,
		ZIndex = 54,
		Parent = card,
	})
	local head = Lib.label({ Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Text = "✨ NEW DISCOVERY! ✨", Font = T.Title, TextColor3 = T.Accent, ZIndex = 56, Parent = card, MaxText = 26 })
	Lib.textStroke(2).Parent = head
	local vp = new("ViewportFrame", { Size = UDim2.new(1, -30, 0, 200), Position = UDim2.fromOffset(15, 46), BackgroundColor3 = T.Panel, ZIndex = 56, Parent = card }, { Lib.corner(14) })
	local cleanup = Preview.Show(vp, def)
	local name = Lib.label({ Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 252), Text = def.Name, Font = T.Title, ZIndex = 56, Parent = card, MaxText = 28 })
	Lib.textStroke(2).Parent = name
	local rar = Lib.label({ Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 288), Text = def.Rarity:upper() .. (def.Ability and ("  •  " .. def.Ability) or ""), Font = T.Title, TextColor3 = color, ZIndex = 56, Parent = card, MaxText = 20 })
	Lib.textStroke(2).Parent = rar
	local scale = new("UIScale", { Scale = 0.2, Parent = card })
	TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local spin = TweenService:Create(glow, TweenInfo.new(4, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), { Rotation = 360 })
	spin:Play()
	Notifications.Confetti()
	task.delay(3.5, function()
		TweenService:Create(scale, TweenInfo.new(0.3), { Scale = 0 }):Play()
		task.wait(0.35)
		spin:Cancel()
		cleanup()
		card:Destroy()
	end)
end

function Notifications.Flash(color: Color3)
	local f = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BackgroundTransparency = 0.2, ZIndex = 70, Parent = gui })
	TweenService:Create(f, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	Debris:AddItem(f, 0.7)
end

function Notifications.Confetti()
	local colors = { T.Accent, T.Pink, T.Blue, T.Green, T.Purple, T.Orange }
	for _ = 1, 40 do
		local piece = new("Frame", {
			Size = UDim2.fromOffset(math.random(8, 14), math.random(12, 20)),
			Position = UDim2.new(math.random(), 0, -0.05, 0),
			BackgroundColor3 = colors[math.random(1, #colors)],
			BorderSizePixel = 0,
			Rotation = math.random(0, 360),
			ZIndex = 60,
			Parent = gui,
		})
		local dur = math.random(15, 30) / 10
		TweenService:Create(piece, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.3, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-360, 360),
		}):Play()
		Debris:AddItem(piece, dur)
	end
end

-- Floating "+$123" near the money counter
function Notifications.MoneyPop(text: string, color: Color3?)
	local l = Lib.label({
		Size = UDim2.fromOffset(220, 36),
		Position = UDim2.new(0.5, math.random(-60, 60), 0, 92),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = T.Title,
		Text = text,
		TextColor3 = color or T.Green,
		ZIndex = 40,
		Parent = gui,
		MaxText = 30,
	})
	Lib.textStroke(2).Parent = l
	TweenService:Create(l, TweenInfo.new(1.2, Enum.EasingStyle.Quad), { Position = l.Position + UDim2.fromOffset(0, 50), TextTransparency = 1 }):Play()
	Debris:AddItem(l, 1.3)
end

function Notifications.Init(parentGui: ScreenGui)
	gui = parentGui
	toastHolder = new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 8),
		Size = UDim2.fromOffset(300, 400),
		Parent = gui,
	}, { Lib.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Top) })
	bannerHolder = new("Frame", {
		Name = "Banners",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 132),
		Size = UDim2.fromOffset(640, 200),
		Parent = gui,
	}, {
		Lib.list(Enum.FillDirection.Vertical, 6),
		new("UISizeConstraint", { MaxSize = Vector2.new(640, 200) }),
	})
	bannerHolder.Size = UDim2.new(0.9, 0, 0, 200)
	alarmFrame = new("Frame", {
		Name = "Alarm",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 0, 20),
		BackgroundTransparency = 0.7,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})
	alarmText = Lib.label({
		Size = UDim2.fromScale(0.85, 0.16),
		Position = UDim2.fromScale(0.5, 0.25),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = T.Title,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 31,
		Parent = alarmFrame,
		MaxText = 48,
	})
	Lib.textStroke(3).Parent = alarmText
end

return Notifications
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">PetsWindow</string><ProtectedString name="Source"><![CDATA[-- PetsWindow.lua
-- Pet inventory (equip / unequip / release / equip best, 3D preview) and the
-- egg shop with odds and an animated hatching sequence.

local TweenService = game:GetService("TweenService")

local Lib = require(script.Parent.Lib)
local Preview = require(script.Parent.Preview)
local Notifications = require(script.Parent.Notifications)
local State = require(script.Parent.Parent.Controllers.State)
local Sound = require(script.Parent.Parent.Controllers.Sound)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PetData = require(Shared.PetData)
local Rarities = require(Shared.Rarities)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local Pets = {}

local tab = "Pets"
local isOpen = false
local gui: ScreenGui
local petsPage: Frame
local eggsPage: Frame
local grid: ScrollingFrame
local tabButtons = {}
local slotsLabel: TextLabel
local bonusLabel: TextLabel
local selected: string? = nil
local detail = {}
local cleanup = function() end
local confirmDelete = 0
local hatching = false

function Pets.Card(def, opts)
	local color = Rarities.Color(def.Rarity)
	local card = new("TextButton", {
		BackgroundColor3 = color,
		AutoButtonColor = true,
		Text = "",
		LayoutOrder = opts.Order or 0,
	}, {
		Lib.corner(12),
		Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(110, 110, 130), 90),
		Lib.stroke(opts.Selected and T.Accent or color:Lerp(Color3.new(0, 0, 0), 0.4), opts.Selected and 4 or 2),
	})
	Lib.label({ Size = UDim2.new(1, 0, 0.48, 0), Position = UDim2.fromScale(0, 0.04), Text = PetData.Icons[def.Species] or "🐾", MaxText = 42, Parent = card })
	local n = Lib.label({ Size = UDim2.new(1, -8, 0.22, 0), Position = UDim2.new(0, 4, 0.52, 0), Text = def.Name, Font = T.Title, MaxText = 14, Parent = card })
	Lib.textStroke(1.5).Parent = n
	local b = Lib.label({ Size = UDim2.new(1, -8, 0.2, 0), Position = UDim2.new(0, 4, 0.76, 0), Text = opts.Sub or PetData.BonusText(def), TextColor3 = Color3.fromRGB(200, 255, 200), MaxText = 12, Parent = card })
	Lib.textStroke(1.5).Parent = b
	if opts.Badge then
		Lib.label({ Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(4, 4), Text = opts.Badge, MaxText = 18, Parent = card })
	end
	return card
end

local function findPet(uid)
	for _, p in ipairs(State.Full and State.Full.Pets or {}) do
		if p.Uid == uid then
			return p
		end
	end
	return nil
end

local function refreshDetail()
	cleanup()
	cleanup = function() end
	local pet = findPet(selected)
	if not pet then
		detail.Name.Text = "Select a pet"
		detail.Info.Text = "Hatch eggs at the 🐾 Pet Shop or in the Eggs tab!"
		detail.Equip.Visible = false
		detail.Delete.Visible = false
		detail.Viewport:ClearAllChildren()
		return
	end
	local def = PetData.Get(pet.Id)
	cleanup = Preview.ShowPet(detail.Viewport, def)
	detail.Name.Text = def.Name
	detail.Name.TextColor3 = Rarities.Color(def.Rarity)
	detail.Info.Text = ("%s %s\n%s\n%s"):format(def.Rarity, def.Flies and "• Flying" or "• Walking", PetData.BonusText(def), pet.InTrade and "🤝 In a trade" or (pet.Equipped and "✅ Equipped" or ""))
	detail.Equip.Visible = not pet.InTrade
	detail.Equip.Text = pet.Equipped and "Unequip" or "Equip"
	Lib.setButtonColor(detail.Equip, pet.Equipped and T.Orange or T.Green)
	detail.Delete.Visible = not pet.InTrade
	detail.Delete.Text = os.clock() < confirmDelete and "Confirm?" or "Release"
end

local function refreshPets()
	Lib.clear(grid)
	local full = State.Full
	if not full then
		return
	end
	local list = {}
	local equipped = 0
	for _, p in ipairs(full.Pets) do
		local def = PetData.Get(p.Id)
		if def then
			table.insert(list, { Pet = p, Def = def })
			if p.Equipped then
				equipped += 1
			end
		end
	end
	table.sort(list, function(a, b)
		if a.Pet.Equipped ~= b.Pet.Equipped then
			return a.Pet.Equipped
		end
		local ra, rb = Rarities.Rank(a.Def.Rarity), Rarities.Rank(b.Def.Rarity)
		if ra ~= rb then
			return ra > rb
		end
		return a.Pet.Uid < b.Pet.Uid
	end)
	slotsLabel.Text = ("🐾 %d pets • Equipped %d/%d"):format(#list, equipped, full.PetSlots)
	local pb = full.PetBonus or {}
	bonusLabel.Text = ("Bonus: +%d%% income • +%d%% luck • +%d speed • +%d%% gems"):format(
		math.floor((pb.Money or 0) * 100 + 0.5),
		math.floor((pb.Luck or 0) * 100 + 0.5),
		pb.Speed or 0,
		math.floor((pb.Gems or 0) * 100 + 0.5)
	)
	for i, e in ipairs(list) do
		local card = Pets.Card(e.Def, { Order = i, Selected = e.Pet.Uid == selected, Badge = e.Pet.Equipped and "✅" or (e.Pet.InTrade and "🤝" or nil) })
		card.Activated:Connect(function()
			selected = e.Pet.Uid
			confirmDelete = 0
			refreshPets()
		end)
		card.Parent = grid
	end
	refreshDetail()
end

local function refresh()
	if not isOpen then
		return
	end
	petsPage.Visible = tab == "Pets"
	eggsPage.Visible = tab == "Eggs"
	for name, b in pairs(tabButtons) do
		Lib.setButtonColor(b, name == tab and T.Orange or T.Panel2)
	end
	if tab == "Pets" then
		refreshPets()
	end
end

-- Hatching animation ------------------------------------------------------------
local function playHatch(eggKey: string, petId: string)
	local egg = PetData.Eggs[eggKey]
	local def = PetData.Get(petId)
	local overlay = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, ZIndex = 60, Parent = gui })
	local eggLabel = Lib.label({
		Size = UDim2.fromOffset(220, 220),
		Position = UDim2.fromScale(0.5, 0.45),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "🥚",
		TextColor3 = egg.Color,
		ZIndex = 61,
		Parent = overlay,
		MaxText = 200,
	})
	local tint = new("Frame", {
		Size = UDim2.fromOffset(170, 210),
		Position = UDim2.fromScale(0.5, 0.47),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = egg.Color,
		BackgroundTransparency = 0.55,
		ZIndex = 60,
		Parent = overlay,
	}, { new("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	-- shake, faster and faster
	for i = 1, 14 do
		local amp = 4 + i * 1.5
		eggLabel.Rotation = (i % 2 == 0) and amp or -amp
		tint.Rotation = eggLabel.Rotation
		if i % 3 == 0 then
			Sound.Play("Hatch", 0.6, 0.8 + i * 0.05)
		end
		task.wait(0.14 - i * 0.006)
	end
	Notifications.Flash(Color3.new(1, 1, 1))
	Sound.Play(Rarities.Rank(def.Rarity) >= 5 and "Discovery" or "Purchase", 0.9)
	eggLabel:Destroy()
	tint:Destroy()
	local color = Rarities.Color(def.Rarity)
	local card = Lib.panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.47), Size = UDim2.fromOffset(320, 380), BackgroundColor3 = T.Bg, ZIndex = 62, Radius = 20, Parent = overlay })
	Lib.stroke(color, 4).Parent = card
	local vp = new("ViewportFrame", { Size = UDim2.new(1, -30, 0, 220), Position = UDim2.fromOffset(15, 15), BackgroundColor3 = T.Panel, ZIndex = 63, Parent = card }, { Lib.corner(14) })
	local stop = Preview.ShowPet(vp, def)
	local n = Lib.label({ Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 240), Text = def.Name, Font = T.Title, ZIndex = 63, Parent = card, MaxText = 30 })
	Lib.textStroke(2).Parent = n
	local r = Lib.label({ Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 276), Text = def.Rarity:upper() .. " • " .. PetData.BonusText(def), Font = T.Title, TextColor3 = color, ZIndex = 63, Parent = card, MaxText = 20 })
	Lib.textStroke(2).Parent = r
	local scale = new("UIScale", { Scale = 0.2, Parent = card })
	TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	Notifications.Confetti()
	local done = false
	Lib.button({ Text = "Awesome! 🎉", Color = T.Green, Size = UDim2.new(1, -40, 0, 46), Position = UDim2.new(0, 20, 1, -58), ZIndex = 64, Parent = card, OnClick = function()
		done = true
	end })
	local start = os.clock()
	while not done and os.clock() - start < 6 do
		task.wait(0.1)
	end
	stop()
	overlay:Destroy()
	hatching = false
end

local function buildEggs()
	local scroll = Lib.scroll({ Size = UDim2.fromScale(1, 1), Parent = eggsPage })
	Lib.grid(UDim2.fromOffset(200, 300), 12).Parent = scroll
	Lib.padding(6).Parent = scroll
	local keys = {}
	for k in pairs(PetData.Eggs) do
		table.insert(keys, k)
	end
	table.sort(keys, function(a, b)
		return PetData.Eggs[a].Order < PetData.Eggs[b].Order
	end)
	for _, key in ipairs(keys) do
		local egg = PetData.Eggs[key]
		local card = Lib.panel({ BackgroundColor3 = T.Panel, LayoutOrder = egg.Order, Parent = scroll })
		Lib.stroke(egg.Color, 3).Parent = card
		local icon = Lib.label({ Size = UDim2.new(1, 0, 0, 80), Position = UDim2.fromOffset(0, 6), Text = "🥚", TextColor3 = egg.Color, MaxText = 70, Parent = card })
		local bob = TweenService:Create(icon, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = UDim2.fromOffset(0, 0), Rotation = 6 })
		bob:Play()
		local t = Lib.label({ Size = UDim2.new(1, -10, 0, 28), Position = UDim2.fromOffset(5, 88), Text = egg.Name, Font = T.Title, MaxText = 22, Parent = card })
		Lib.textStroke(1.5).Parent = t
		-- odds
		local total = 0
		for _, w in pairs(egg.Weights) do
			total += w
		end
		local lines = {}
		for _, r in ipairs(Rarities.Order) do
			local w = egg.Weights[r]
			if w then
				table.insert(lines, ("%s %.1f%%"):format(r, w / total * 100))
			end
		end
		new("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -16, 0, 110),
			Position = UDim2.fromOffset(8, 118),
			Font = T.Body,
			TextSize = 13,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = T.SubText,
			Text = table.concat(lines, "\n") .. "\n🍀 Luck boosts rare odds",
			Parent = card,
		})
		local price = egg.Currency == "Gems" and ("💎 " .. egg.Cost) or Util.Money(egg.Cost)
		Lib.button({
			Text = "Hatch " .. price,
			Color = egg.Currency == "Gems" and T.Blue or T.Green,
			Size = UDim2.new(1, -20, 0, 44),
			Position = UDim2.new(0, 10, 1, -52),
			Parent = card,
			OnClick = function()
				if hatching then
					return
				end
				hatching = true
				local ok, _, data = State.Request("HatchEgg", key) -- failures show a toast
				if ok and data then
					playHatch(key, data.PetId)
				else
					hatching = false
				end
			end,
		})
	end
end

function Pets.Build(content: Frame)
	gui = content:FindFirstAncestorOfClass("ScreenGui")
	local top = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Parent = content }, {
		Lib.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center),
	})
	for i, info in ipairs({ { "Pets", "🐾 My Pets" }, { "Eggs", "🥚 Eggs" } }) do
		tabButtons[info[1]] = Lib.button({ Text = info[2], Color = T.Panel2, Size = UDim2.fromOffset(130, 34), LayoutOrder = i, Parent = top, OnClick = function()
			tab = info[1]
			refresh()
		end })
	end
	Lib.button({ Text = "⭐ Equip Best", Color = T.Accent, Size = UDim2.fromOffset(140, 34), LayoutOrder = 5, Parent = top, OnClick = function()
		State.Request("EquipBestPets")
	end })

	petsPage = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 1, -46), Parent = content })
	eggsPage = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 1, -46), Visible = false, Parent = content })
	slotsLabel = Lib.label({ Size = UDim2.new(0.64, 0, 0, 20), Text = "", TextColor3 = T.SubText, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 15, Parent = petsPage })
	bonusLabel = Lib.label({ Size = UDim2.new(0.64, 0, 0, 18), Position = UDim2.fromOffset(0, 20), Text = "", TextColor3 = T.Green, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 13, Parent = petsPage })
	grid = Lib.scroll({ Position = UDim2.fromOffset(0, 42), Size = UDim2.new(0.64, -8, 1, -42), Parent = petsPage })
	Lib.grid(UDim2.fromOffset(100, 114), 8).Parent = grid
	Lib.padding(4).Parent = grid
	local panel = Lib.panel({ Position = UDim2.new(0.64, 0, 0, 0), Size = UDim2.new(0.36, 0, 1, 0), Parent = petsPage })
	Lib.padding(10).Parent = panel
	detail.Viewport = new("ViewportFrame", { Size = UDim2.new(1, 0, 0.45, 0), BackgroundColor3 = T.Panel2, Parent = panel }, { Lib.corner(12) })
	detail.Name = Lib.label({ Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0.47, 0), Font = T.Title, MaxText = 22, Parent = panel })
	Lib.textStroke(1.5).Parent = detail.Name
	detail.Info = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0.3, 0),
		Position = UDim2.new(0, 0, 0.47, 32),
		Font = T.Body,
		TextSize = 15,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = T.SubText,
		Text = "",
		Parent = panel,
	})
	local buttons = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 1, -40), Parent = panel }, {
		Lib.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center),
	})
	detail.Equip = Lib.button({ Text = "Equip", Color = T.Green, Size = UDim2.new(0.48, 0, 1, 0), Parent = buttons, OnClick = function()
		local pet = findPet(selected)
		if pet then
			State.Request(pet.Equipped and "UnequipPet" or "EquipPet", pet.Uid)
		end
	end })
	detail.Delete = Lib.button({ Text = "Release", Color = T.Red, Size = UDim2.new(0.48, 0, 1, 0), Parent = buttons, OnClick = function()
		local pet = findPet(selected)
		if not pet then
			return
		end
		if os.clock() < confirmDelete then
			confirmDelete = 0
			State.Request("DeletePet", pet.Uid)
			selected = nil
		else
			confirmDelete = os.clock() + 3
			refreshDetail()
		end
	end })
	buildEggs()
	State.FullChanged.Event:Connect(refresh)
end

function Pets.OnOpen(arg)
	isOpen = true
	if arg == "Eggs" then
		tab = "Eggs"
	end
	refresh()
end

function Pets.OnClose()
	isOpen = false
	cleanup()
	cleanup = function() end
end

return Pets
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">Preview</string><ProtectedString name="Source"><![CDATA[-- Preview.lua
-- Rotating 3D treasure preview inside a ViewportFrame (built from the same
-- procedural model the world uses).

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TreasureModels = require(Shared.TreasureModels)

local Preview = {}

-- Fills `viewport` with the treasure. Returns a cleanup function.
function Preview.Show(viewport: ViewportFrame, def)
	viewport:ClearAllChildren()
	if not def then
		return function() end
	end
	local world = Instance.new("WorldModel")
	world.Parent = viewport
	local model = TreasureModels.Build(def, { Effects = false })
	model.Parent = world
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = viewport
	viewport.CurrentCamera = cam
	viewport.LightColor = Color3.fromRGB(255, 255, 255)
	viewport.Ambient = Color3.fromRGB(170, 170, 190)
	viewport.LightDirection = Vector3.new(-1, -1, -1)
	local height = TreasureModels.Height(def)
	local focus = Vector3.new(0, height / 2, 0)
	local dist = math.max(7, height * 2.1)
	local angle = 0
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		if not viewport.Parent or not model.Parent then
			conn:Disconnect()
			return
		end
		if not viewport.Visible then
			return
		end
		angle += dt * 0.9
		cam.CFrame = CFrame.lookAt(focus + Vector3.new(math.sin(angle) * dist, height * 0.45, math.cos(angle) * dist), focus)
	end)
	return function()
		conn:Disconnect()
		viewport:ClearAllChildren()
	end
end

-- Rotating preview of a pet.
function Preview.ShowPet(viewport: ViewportFrame, def)
	viewport:ClearAllChildren()
	if not def then
		return function() end
	end
	local PetModels = require(Shared.PetModels)
	local world = Instance.new("WorldModel")
	world.Parent = viewport
	local model = PetModels.Build(def, 1)
	model.Parent = world
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = viewport
	viewport.CurrentCamera = cam
	viewport.Ambient = Color3.fromRGB(170, 170, 190)
	viewport.LightDirection = Vector3.new(-1, -1, -1)
	local focus = Vector3.new(0, 1.4, 0)
	local angle = 0
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		if not viewport.Parent or not model.Parent then
			conn:Disconnect()
			return
		end
		angle += dt * 0.9
		cam.CFrame = CFrame.lookAt(focus + Vector3.new(math.sin(angle) * 7, 1.6, math.cos(angle) * 7), focus)
	end)
	return function()
		conn:Disconnect()
		viewport:ClearAllChildren()
	end
end

return Preview
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003D"><Properties><string name="Name">RebirthWindow</string><ProtectedString name="Source"><![CDATA[-- RebirthWindow.lua
-- Rebirth progress, permanent bonuses, milestone rewards and title picker.

local Lib = require(script.Parent.Lib)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local Rebirth = {}

local isOpen = false
local info: TextLabel
local setProgress
local rebirthButton: TextButton
local confirmUntil = 0
local rewardsList: Frame
local titlesList: Frame

local function refresh()
	if not isOpen or not State.Full then
		return
	end
	local full = State.Full
	local cost = full.RebirthCost
	local nextR = full.Rebirths + 1
	local bonus = math.floor(nextR * Config.Rebirth.IncomeBonusPerRebirth * 100)
	info.Text = ("You have rebirthed %d times.\nCurrent income multiplier: x%.2f\n\nRebirth %d gives: +%d%% total income, +%d walk speed and %s starting cash.\nYou keep: abilities, index, secrets, titles & exclusive treasures.\nYou lose: money, treasures and upgrades.")
		:format(full.Rebirths, full.Multiplier, nextR, bonus, Config.Rebirth.SpeedBonusPerRebirth, Util.Money(Config.StartingMoney + nextR * Config.Rebirth.StartingMoneyPerRebirth))
	setProgress(full.Money / cost, ("%s / %s"):format(Util.Money(full.Money), Util.Money(cost)))
	local req = full.RebirthReq
	if req then
		info.Text ..= ("\n\n📌 Also requires: %d × %s+ treasure%s"):format(req.Count, req.Rarity, req.Count > 1 and "s" or "")
	end
	local canAfford = full.Money >= cost
	if os.clock() < confirmUntil then
		rebirthButton.Text = "⚠️ TAP AGAIN TO CONFIRM"
		Lib.setButtonColor(rebirthButton, T.Orange)
	else
		rebirthButton.Text = canAfford and "🌀 REBIRTH NOW" or "🔒 NOT ENOUGH MONEY"
		Lib.setButtonColor(rebirthButton, canAfford and T.Pink or T.Panel2)
	end

	Lib.clear(rewardsList)
	local milestones = {}
	for n in pairs(Config.RebirthRewards) do
		table.insert(milestones, n)
	end
	table.sort(milestones)
	for i, n in ipairs(milestones) do
		local r = Config.RebirthRewards[n]
		local unlocked = full.Rebirths >= n
		local row = Lib.panel({ Size = UDim2.new(1, -6, 0, 44), BackgroundColor3 = unlocked and T.Green:Lerp(T.Panel, 0.5) or T.Panel2, LayoutOrder = i, Parent = rewardsList })
		local l = Lib.label({
			Size = UDim2.new(1, -16, 1, -8),
			Position = UDim2.fromOffset(8, 4),
			Text = ("%s Rebirth %d: %s + \"%s\" title + trail"):format(unlocked and "✅" or "🔒", n, r.Treasure, r.Title),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 16,
			Parent = row,
		})
		Lib.textStroke(1).Parent = l
	end

	Lib.clear(titlesList)
	local options = { "" }
	for _, t in ipairs(full.Titles) do
		table.insert(options, t)
	end
	for i, title in ipairs(options) do
		local active = full.Title == title
		Lib.button({
			Text = title == "" and "No title" or title,
			Color = active and T.Accent or T.Panel2,
			Size = UDim2.fromOffset(120, 32),
			LayoutOrder = i,
			MaxText = 16,
			Parent = titlesList,
			OnClick = function()
				State.Request("SetTitle", title)
			end,
		})
	end
end

function Rebirth.Build(content: Frame)
	local left = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.55, -8, 1, 0), Parent = content })
	local big = Lib.label({ Size = UDim2.new(1, 0, 0, 44), Text = "🌀 REBIRTH", Font = T.Title, TextColor3 = T.Pink, MaxText = 40, Parent = left })
	Lib.textStroke(2.5).Parent = big
	info = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 170),
		Position = UDim2.fromOffset(0, 48),
		Font = T.Body,
		TextSize = 15,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = T.SubText,
		Parent = left,
	})
	local _, setter = Lib.bar({ Size = UDim2.new(1, 0, 0, 32), Position = UDim2.new(0, 0, 0, 224), Color = T.Pink, Parent = left })
	setProgress = setter
	rebirthButton = Lib.button({
		Text = "REBIRTH",
		Color = T.Pink,
		Size = UDim2.new(1, 0, 0, 58),
		Position = UDim2.fromOffset(0, 266),
		MaxText = 28,
		Parent = left,
		OnClick = function()
			if os.clock() < confirmUntil then
				confirmUntil = 0
				State.Request("Rebirth")
			elseif State.Full and State.Full.Money >= State.Full.RebirthCost then
				confirmUntil = os.clock() + 4
				refresh()
				task.delay(4.1, refresh)
			else
				State.Request("Rebirth")
			end
		end,
	})
	local right = Lib.panel({ Position = UDim2.new(0.55, 0, 0, 0), Size = UDim2.new(0.45, 0, 1, 0), Parent = content })
	Lib.padding(8).Parent = right
	local h = Lib.label({ Size = UDim2.new(1, 0, 0, 26), Text = "🎁 Milestone Rewards", Font = T.Title, TextColor3 = T.Accent, MaxText = 20, Parent = right })
	Lib.textStroke(1.5).Parent = h
	rewardsList = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 200), Parent = right }, { Lib.list(Enum.FillDirection.Vertical, 6) })
	local h2 = Lib.label({ Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 236), Text = "🏷️ Your Titles", Font = T.Title, TextColor3 = T.Accent, MaxText = 20, Parent = right })
	Lib.textStroke(1.5).Parent = h2
	titlesList = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 266), Size = UDim2.new(1, 0, 1, -266), Parent = right }, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(120, 32), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	State.FullChanged.Event:Connect(refresh)
	State.StatsChanged.Event:Connect(refresh)
end

function Rebirth.OnOpen()
	isOpen = true
	refresh()
end

function Rebirth.OnClose()
	isOpen = false
end

return Rebirth
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003E"><Properties><string name="Name">SettingsWindow</string><ProtectedString name="Source"><![CDATA[-- SettingsWindow.lua
-- Music, sound effects, graphics quality, treasure effects and UI scale.
-- Settings are saved on the server with the rest of your progress.

local Lib = require(script.Parent.Lib)
local State = require(script.Parent.Parent.Controllers.State)

local T = Lib.Theme
local new = Lib.new

local Settings = {}

local toggles = {}
local scaleLabel: TextLabel
local saveLabel: TextLabel
local statsLabel: TextLabel

local OPTIONS = {
	{ Key = "Music", Text = "🎵 Music", Desc = "Background music" },
	{ Key = "Sfx", Text = "🔊 Sound Effects", Desc = "Pickups, alarms, purchases" },
	{ Key = "Effects", Text = "✨ Treasure Effects", Desc = "Particles, beams and glow on treasures" },
	{ Key = "LowGfx", Text = "📱 Performance Mode", Desc = "Lower quality for older phones (no shadows, simpler animations)" },
	{ Key = "Weather", Text = "🌧️ Weather Effects", Desc = "Rain, storms, fog and lightning" },
	{ Key = "Intro", Text = "🎬 Cinematic Intro", Desc = "Play the flyover camera when you join" },
}

local function current()
	return State.Full and State.Full.Settings or {}
end

local function refresh()
	local s = current()
	for key, b in pairs(toggles) do
		local on = s[key] == true
		b.Text = on and "ON" or "OFF"
		Lib.setButtonColor(b, on and T.Green or T.Red)
	end
	scaleLabel.Text = ("%d%%"):format(math.floor((s.UIScale or 1) * 100 + 0.5))
	if State.Full then
		saveLabel.Text = State.Full.CanSave and "💾 Progress saves automatically." or "⚠️ Saving disabled (Studio without API access)."
		local st = State.Full.Stats or {}
		statsLabel.Text = ("📊 Steals: %d   Robbed: %d   Defends: %d   Collected: %d   Trades: %d   Secrets: %d/3"):format(
			st.Steals or 0,
			st.Robbed or 0,
			st.Defends or 0,
			st.Collected or 0,
			st.Trades or 0,
			#(State.Full.Secrets or {})
		)
	end
end

function Settings.Build(content: Frame)
	local scroll = Lib.scroll({ Size = UDim2.fromScale(1, 1), Parent = content })
	Lib.list(Enum.FillDirection.Vertical, 8).Parent = scroll
	Lib.padding(4).Parent = scroll
	for i, opt in ipairs(OPTIONS) do
		local row = Lib.panel({ Size = UDim2.new(1, -8, 0, 62), LayoutOrder = i, Parent = scroll })
		local t = Lib.label({ Size = UDim2.new(1, -140, 0, 28), Position = UDim2.fromOffset(14, 6), Text = opt.Text, Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = row })
		Lib.textStroke(1.5).Parent = t
		Lib.label({ Size = UDim2.new(1, -140, 0, 20), Position = UDim2.fromOffset(14, 34), Text = opt.Desc, TextColor3 = T.SubText, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 14, Parent = row })
		toggles[opt.Key] = Lib.button({
			Text = "",
			Size = UDim2.fromOffset(100, 42),
			Position = UDim2.new(1, -12, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Parent = row,
			OnClick = function()
				local s = current()
				State.Ask("UpdateSettings", { [opt.Key] = not (s[opt.Key] == true) })
			end,
		})
	end
	local row = Lib.panel({ Size = UDim2.new(1, -8, 0, 62), LayoutOrder = 10, Parent = scroll })
	local t = Lib.label({ Size = UDim2.new(0.5, 0, 1, -12), Position = UDim2.fromOffset(14, 6), Text = "🔍 Interface Size", Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = row })
	Lib.textStroke(1.5).Parent = t
	local function change(d)
		local s = current()
		State.Ask("UpdateSettings", { UIScale = math.clamp((s.UIScale or 1) + d, 0.6, 1.4) })
	end
	Lib.button({ Text = "−", Size = UDim2.fromOffset(46, 42), Position = UDim2.new(1, -170, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Color = T.Panel2, Parent = row, OnClick = function()
		change(-0.1)
	end })
	scaleLabel = Lib.label({ Size = UDim2.fromOffset(60, 42), Position = UDim2.new(1, -120, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Text = "100%", Font = T.Title, Parent = row })
	Lib.button({ Text = "+", Size = UDim2.fromOffset(46, 42), Position = UDim2.new(1, -58, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Color = T.Panel2, Parent = row, OnClick = function()
		change(0.1)
	end })
	saveLabel = Lib.label({ Size = UDim2.new(1, -8, 0, 26), LayoutOrder = 20, TextColor3 = T.SubText, MaxText = 16, Parent = scroll })
	statsLabel = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 44),
		LayoutOrder = 21,
		Font = T.Body,
		TextSize = 14,
		TextWrapped = true,
		TextColor3 = T.SubText,
		Parent = scroll,
	})
	new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 190),
		LayoutOrder = 22,
		Font = T.Body,
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = T.SubText,
		Text = "HOW TO PLAY\n• Grab free treasures in the fields or buy them at the market, then carry them home.\n• Treasures on your platforms earn money every second.\n• Sneak into other bases and hold [E] on a treasure to steal it — get it home before they bonk you!\n• Lock your base with the red button. Upgrade walls, cameras and traps in 🛒 Upgrades.\n• Step on the 💰 pad in your base to collect income.\n• Keys: Shift Sprint • Q Dash • R Super Jump • F Cloak • T Emotes • B Items • P Pets • M Upgrades • L Lock\n• Gamepad: L3 Sprint • D-Pad menus • X Emotes",
		Parent = scroll,
	})
	if game:GetService("RunService"):IsStudio() then
		local h = Lib.label({ Size = UDim2.new(1, -8, 0, 26), LayoutOrder = 30, Text = "🧪 Studio test: start an event", Font = T.Title, TextColor3 = T.Accent, MaxText = 18, Parent = scroll })
		Lib.textStroke(1.5).Parent = h
		local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 84), LayoutOrder = 31, Parent = scroll }, {
			new("UIGridLayout", { CellSize = UDim2.fromOffset(120, 36), CellPadding = UDim2.fromOffset(6, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }),
		})
		for _, name in ipairs({ "DoubleMoney", "Meteor", "GoldenRain", "Lucky", "Secret", "Apocalypse", "Divine", "Lava", "Rainbow" }) do
			Lib.button({ Text = name, Color = T.Purple, MaxText = 14, Parent = row, OnClick = function()
				State.Request("DebugEvent", name)
			end })
		end
	end
	State.FullChanged.Event:Connect(refresh)
end

function Settings.OnOpen()
	refresh()
end

return Settings
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003F"><Properties><string name="Name">ShopWindow</string><ProtectedString name="Source"><![CDATA[-- ShopWindow.lua
-- Upgrades (speed, carry capacity, base expansion, protection, income) and
-- special abilities.

local Lib = require(script.Parent.Lib)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local UpgradeData = require(Shared.UpgradeData)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local Shop = {}

local rows = {}
local isOpen = false

local function makeRow(parent: Instance, order: number, icon: string, title: string, desc: string, color: Color3)
	local row = Lib.panel({ Size = UDim2.new(1, -8, 0, 84), BackgroundColor3 = T.Panel, LayoutOrder = order, Parent = parent })
	Lib.stroke(color, 2).Parent = row
	local iconBox = Lib.panel({ Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = color, Parent = row })
	Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(140, 140, 160)).Parent = iconBox
	Lib.label({ Size = UDim2.fromScale(1, 1), Text = icon, MaxText = 38, Parent = iconBox })
	local t = Lib.label({ Size = UDim2.new(1, -250, 0, 28), Position = UDim2.fromOffset(86, 8), Text = title, Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 22, Parent = row })
	Lib.textStroke(1.5).Parent = t
	local d = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -250, 0, 40),
		Position = UDim2.fromOffset(86, 36),
		Font = T.Body,
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = T.SubText,
		Text = desc,
		Parent = row,
	})
	local btn = Lib.button({ Text = "", Color = T.Green, Size = UDim2.fromOffset(150, 50), Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = row })
	return { Row = row, Title = t, Desc = d, Button = btn }
end

local function refresh()
	if not isOpen or not State.Full then
		return
	end
	local full = State.Full
	for rowKey, r in pairs(rows) do
		local key = r.Key or rowKey
		if r.Kind == "Upgrade" then
			local up = UpgradeData.Upgrades[key]
			local level = full.Upgrades[key] or 0
			r.UI.Title.Text = ("%s  (Lv %d/%d)"):format(up.Name, level, up.MaxLevel)
			if level >= up.MaxLevel then
				r.UI.Button.Text = "MAXED"
				Lib.setButtonColor(r.UI.Button, T.Panel2)
			else
				local cost = up.Cost(level)
				r.UI.Button.Text = Util.Money(cost)
				Lib.setButtonColor(r.UI.Button, full.Money >= cost and T.Green or T.Red)
			end
		elseif r.Kind == "Gear" then
			local item = UpgradeData.Gear[key]
			local gear = full.Gear or {}
			if key == "Bat" then
				local lvl = gear.Bat or 0
				local cost = item.Costs[lvl + 1]
				r.UI.Title.Text = ("%s  (%s)"):format(item.Name, UpgradeData.BatStats(lvl).Name)
				if cost then
					r.UI.Button.Text = Util.Money(cost)
					Lib.setButtonColor(r.UI.Button, full.Money >= cost and T.Green or T.Red)
				else
					r.UI.Button.Text = "MAXED"
					Lib.setButtonColor(r.UI.Button, T.Panel2)
				end
			elseif gear[key] then
				r.UI.Button.Text = "OWNED"
				Lib.setButtonColor(r.UI.Button, T.Panel2)
			else
				r.UI.Button.Text = Util.Money(item.Cost)
				Lib.setButtonColor(r.UI.Button, full.Money >= item.Cost and T.Green or T.Red)
			end
		else
			local ab = UpgradeData.Abilities[key]
			if full.Abilities[key] then
				r.UI.Button.Text = ab.Key and ("OWNED [" .. ab.Key .. "]") or "OWNED"
				Lib.setButtonColor(r.UI.Button, T.Panel2)
			else
				r.UI.Button.Text = Util.Money(ab.Cost)
				Lib.setButtonColor(r.UI.Button, full.Money >= ab.Cost and T.Green or T.Red)
			end
		end
	end
end

function Shop.Build(content: Frame)
	local scroll = Lib.scroll({ Size = UDim2.fromScale(1, 1), Parent = content })
	Lib.list(Enum.FillDirection.Vertical, 8).Parent = scroll
	Lib.padding(4).Parent = scroll
	local header1 = Lib.label({ Size = UDim2.new(1, 0, 0, 30), Text = "⬆️ UPGRADES", Font = T.Title, TextColor3 = T.Accent, LayoutOrder = 0, MaxText = 24, Parent = scroll })
	Lib.textStroke(2).Parent = header1
	local colors = { T.Blue, T.Orange, T.Green, T.Purple, T.Accent }
	for i, key in ipairs(UpgradeData.SortedKeys(UpgradeData.Upgrades)) do
		local up = UpgradeData.Upgrades[key]
		local ui = makeRow(scroll, i, up.Icon, up.Name, up.Description, colors[(i - 1) % #colors + 1])
		ui.Button.Activated:Connect(function()
			State.Request("BuyUpgrade", key)
		end)
		rows[key] = { Kind = "Upgrade", UI = ui }
	end
	local header2 = Lib.label({ Size = UDim2.new(1, 0, 0, 30), Text = "⚡ SPECIAL ABILITIES", Font = T.Title, TextColor3 = T.Pink, LayoutOrder = 50, MaxText = 24, Parent = scroll })
	Lib.textStroke(2).Parent = header2
	for i, key in ipairs(UpgradeData.SortedKeys(UpgradeData.Abilities)) do
		local ab = UpgradeData.Abilities[key]
		local desc = ab.Description .. (ab.Cooldown > 0 and ("  (cooldown %ds)"):format(ab.Cooldown) or "")
		local ui = makeRow(scroll, 50 + i, ab.Icon, ab.Name, desc, T.Pink)
		ui.Button.Activated:Connect(function()
			if not (State.Full and State.Full.Abilities[key]) then
				State.Request("BuyAbility", key)
			end
		end)
		rows[key] = { Kind = "Ability", UI = ui }
	end
	local header3 = Lib.label({ Size = UDim2.new(1, 0, 0, 30), Text = "🧰 GEAR", Font = T.Title, TextColor3 = T.Orange, LayoutOrder = 100, MaxText = 24, Parent = scroll })
	Lib.textStroke(2).Parent = header3
	for i, key in ipairs(UpgradeData.SortedKeys(UpgradeData.Gear)) do
		local item = UpgradeData.Gear[key]
		local ui = makeRow(scroll, 100 + i, item.Icon, item.Name, item.Description, T.Orange)
		ui.Button.Activated:Connect(function()
			State.Request("BuyGear", key)
		end)
		rows["Gear_" .. key] = { Kind = "Gear", Key = key, UI = ui }
	end
	State.FullChanged.Event:Connect(refresh)
	State.StatsChanged.Event:Connect(refresh)
end

function Shop.OnOpen()
	isOpen = true
	refresh()
end

function Shop.OnClose()
	isOpen = false
end

return Shop
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">TradeWindow</string><ProtectedString name="Source"><![CDATA[-- TradeWindow.lua
-- Trading UI: pick a player, then build offers (treasures + money), mark
-- ready and watch the confirm countdown. Everything is validated server side.

local Players = game:GetService("Players")

local Lib = require(script.Parent.Lib)
local Inventory = require(script.Parent.InventoryWindow)
local PetsWindow = require(script.Parent.PetsWindow)
local State = require(script.Parent.Parent.Controllers.State)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TreasureData = require(Shared.TreasureData)
local PetData = require(Shared.PetData)
local Remotes = require(Shared.Remotes)
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local T = Lib.Theme
local new = Lib.new

local Trade = {}

local Windows -- set in Build
local trade = nil -- current trade view from server
local isOpen = false

local lobby: Frame
local session: Frame
local playerList: ScrollingFrame
local myOffer: ScrollingFrame
local theirOffer: ScrollingFrame
local picker: ScrollingFrame
local myMoney: TextBox
local theirMoney: TextLabel
local myStatus: TextLabel
local theirStatus: TextLabel
local readyButton: TextButton
local countdown: TextLabel
local partnerLabel: TextLabel

local function offerUids(): { string }
	local list = {}
	if trade then
		for _, item in ipairs(trade.Mine.Items) do
			table.insert(list, item.Uid)
		end
	end
	return list
end

local function offerPets(): { string }
	local list = {}
	if trade then
		for _, p in ipairs(trade.Mine.Pets or {}) do
			table.insert(list, p.Uid)
		end
	end
	return list
end

local function sendOffer(uids, pets)
	local money = tonumber(myMoney.Text) or 0
	State.Request("TradeOffer", uids, money, pets or offerPets())
end

local function refreshLobby()
	Lib.clear(playerList)
	local count = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= Players.LocalPlayer then
			count += 1
			local row = Lib.panel({ Size = UDim2.new(1, -8, 0, 54), BackgroundColor3 = T.Panel2, LayoutOrder = count, Parent = playerList })
			new("ImageLabel", {
				Size = UDim2.fromOffset(44, 44),
				Position = UDim2.fromOffset(6, 5),
				BackgroundColor3 = T.Bg,
				Image = ("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48"):format(p.UserId),
				Parent = row,
			}, { Lib.corner(22) })
			local n = Lib.label({ Size = UDim2.new(1, -200, 1, -10), Position = UDim2.fromOffset(58, 5), Text = p.DisplayName, Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Parent = row })
			Lib.textStroke(1.5).Parent = n
			Lib.button({
				Text = "🤝 Request",
				Color = T.Accent,
				Size = UDim2.fromOffset(130, 40),
				Position = UDim2.new(1, -8, 0.5, 0),
				AnchorPoint = Vector2.new(1, 0.5),
				Parent = row,
				OnClick = function()
					State.Request("TradeRequest", p.UserId)
				end,
			})
		end
	end
	if count == 0 then
		Lib.label({ Size = UDim2.new(1, 0, 0, 40), Text = "No other players in this server yet.", TextColor3 = T.SubText, MaxText = 18, Parent = playerList })
	end
end

local function fillItems(container: ScrollingFrame, items, clickable: boolean, pets)
	Lib.clear(container)
	for i, pet in ipairs(pets or {}) do
		local def = PetData.Get(pet.Id)
		if def then
			local card = PetsWindow.Card(def, { Order = 100 + i, Sub = clickable and "tap to remove" or nil })
			if clickable then
				card.Activated:Connect(function()
					local list = offerPets()
					local idx = table.find(list, pet.Uid)
					if idx then
						table.remove(list, idx)
					end
					sendOffer(offerUids(), list)
				end)
			end
			card.Parent = container
		end
	end
	for i, item in ipairs(items) do
		local def = TreasureData.Get(item.Id)
		if def then
			local card = Inventory.Card(def, { Order = i, Sub = clickable and "tap to remove" or nil })
			if clickable then
				card.Activated:Connect(function()
					local uids = offerUids()
					local idx = table.find(uids, item.Uid)
					if idx then
						table.remove(uids, idx)
					end
					sendOffer(uids)
				end)
			end
			card.Parent = container
		end
	end
end

local function refreshPicker()
	Lib.clear(picker)
	local full = State.Full
	if not full or not trade then
		return
	end
	local offered = {}
	for _, uid in ipairs(offerUids()) do
		offered[uid] = true
	end
	local list = {}
	for _, t in ipairs(full.Treasures) do
		if not offered[t.Uid] and not t.Stealing then
			local def = TreasureData.Get(t.Id)
			if def then
				table.insert(list, { t = t, def = def })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.def.MPS > b.def.MPS
	end)
	for i, e in ipairs(list) do
		local card = Inventory.Card(e.def, { Order = i, Badge = e.t.Plot and "📍" or nil })
		card.Activated:Connect(function()
			local uids = offerUids()
			if #uids >= Config.Trade.MaxItems then
				return
			end
			table.insert(uids, e.t.Uid)
			sendOffer(uids)
		end)
		card.Parent = picker
	end
	-- pets
	local offeredPets = {}
	for _, uid in ipairs(offerPets()) do
		offeredPets[uid] = true
	end
	for i, p in ipairs(full.Pets or {}) do
		local def = PetData.Get(p.Id)
		if def and not offeredPets[p.Uid] then
			local card = PetsWindow.Card(def, { Order = 1000 + i, Badge = p.Equipped and "✅" or nil })
			card.Activated:Connect(function()
				local list = offerPets()
				if #list >= Config.Trade.MaxItems then
					return
				end
				table.insert(list, p.Uid)
				sendOffer(offerUids(), list)
			end)
			card.Parent = picker
		end
	end
end

local function refreshSession()
	if not trade then
		return
	end
	partnerLabel.Text = "Trading with " .. trade.Partner.Name
	fillItems(myOffer, trade.Mine.Items, true, trade.Mine.Pets)
	fillItems(theirOffer, trade.Theirs.Items, false, trade.Theirs.Pets)
	theirMoney.Text = "💰 " .. Util.Money(trade.Theirs.Money)
	if not myMoney:IsFocused() then
		myMoney.Text = tostring(trade.Mine.Money)
	end
	myStatus.Text = trade.Mine.Ready and "✅ READY" or "⏳ Not ready"
	myStatus.TextColor3 = trade.Mine.Ready and T.Green or T.SubText
	theirStatus.Text = trade.Theirs.Ready and "✅ READY" or "⏳ Not ready"
	theirStatus.TextColor3 = trade.Theirs.Ready and T.Green or T.SubText
	readyButton.Text = trade.Mine.Ready and "UNREADY" or "✅ READY"
	Lib.setButtonColor(readyButton, trade.Mine.Ready and T.Orange or T.Green)
	refreshPicker()
end

local function refresh()
	lobby.Visible = trade == nil
	session.Visible = trade ~= nil
	if trade then
		refreshSession()
	else
		refreshLobby()
	end
end

local function itemGrid(parent, pos, size)
	local s = Lib.scroll({ Position = pos, Size = size, Parent = parent })
	Lib.grid(UDim2.fromOffset(84, 98), 6).Parent = s
	Lib.padding(4).Parent = s
	return s
end

function Trade.Build(content: Frame, windows)
	Windows = windows
	-- Lobby
	lobby = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = content })
	local h = Lib.label({ Size = UDim2.new(1, 0, 0, 30), Text = "Choose a player to trade with", Font = T.Title, MaxText = 22, Parent = lobby })
	Lib.textStroke(1.5).Parent = h
	playerList = Lib.scroll({ Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 1, -36), Parent = lobby })
	Lib.list(Enum.FillDirection.Vertical, 6).Parent = playerList
	Lib.padding(4).Parent = playerList

	-- Session
	session = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = content })
	partnerLabel = Lib.label({ Size = UDim2.new(0.6, 0, 0, 28), Text = "", Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 22, Parent = session })
	Lib.textStroke(1.5).Parent = partnerLabel
	countdown = Lib.label({ Size = UDim2.new(0.4, 0, 0, 28), Position = UDim2.fromScale(0.6, 0), Text = "", Font = T.Title, TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Right, MaxText = 22, Parent = session })
	Lib.textStroke(1.5).Parent = countdown

	local mine = Lib.panel({ Position = UDim2.fromOffset(0, 34), Size = UDim2.new(0.5, -4, 0.5, -34), Parent = session })
	Lib.padding(6).Parent = mine
	Lib.label({ Size = UDim2.new(0.5, 0, 0, 22), Text = "YOUR OFFER", Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 18, Parent = mine })
	myStatus = Lib.label({ Size = UDim2.new(0.5, 0, 0, 22), Position = UDim2.fromScale(0.5, 0), Text = "", TextXAlignment = Enum.TextXAlignment.Right, MaxText = 16, Parent = mine })
	myOffer = itemGrid(mine, UDim2.fromOffset(0, 26), UDim2.new(1, 0, 1, -64))
	myMoney = new("TextBox", {
		Size = UDim2.new(1, 0, 0, 32),
		Position = UDim2.new(0, 0, 1, -34),
		BackgroundColor3 = T.Bg,
		Font = T.Body,
		TextSize = 16,
		TextColor3 = T.Text,
		PlaceholderText = "💰 Add money (number)",
		Text = "0",
		ClearTextOnFocus = false,
		Parent = mine,
	}, { Lib.corner(8) })
	myMoney.FocusLost:Connect(function()
		sendOffer(offerUids())
	end)

	local theirs = Lib.panel({ Position = UDim2.new(0.5, 4, 0, 34), Size = UDim2.new(0.5, -4, 0.5, -34), Parent = session })
	Lib.padding(6).Parent = theirs
	Lib.label({ Size = UDim2.new(0.5, 0, 0, 22), Text = "THEIR OFFER", Font = T.Title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 18, Parent = theirs })
	theirStatus = Lib.label({ Size = UDim2.new(0.5, 0, 0, 22), Position = UDim2.fromScale(0.5, 0), Text = "", TextXAlignment = Enum.TextXAlignment.Right, MaxText = 16, Parent = theirs })
	theirOffer = itemGrid(theirs, UDim2.fromOffset(0, 26), UDim2.new(1, 0, 1, -64))
	theirMoney = Lib.label({ Size = UDim2.new(1, 0, 0, 32), Position = UDim2.new(0, 0, 1, -34), Text = "", TextColor3 = T.Green, MaxText = 18, Parent = theirs })

	local pick = Lib.panel({ Position = UDim2.new(0, 0, 0.5, 6), Size = UDim2.new(1, 0, 0.5, -60), Parent = session })
	Lib.padding(6).Parent = pick
	Lib.label({ Size = UDim2.new(1, 0, 0, 20), Text = "Tap treasures or pets to add them (max " .. Config.Trade.MaxItems .. " each)", TextColor3 = T.SubText, MaxText = 15, Parent = pick })
	picker = itemGrid(pick, UDim2.fromOffset(0, 24), UDim2.new(1, 0, 1, -24))

	local buttons = new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -48), Size = UDim2.new(1, 0, 0, 46), Parent = session }, {
		Lib.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center),
	})
	readyButton = Lib.button({ Text = "READY", Color = T.Green, Size = UDim2.fromOffset(170, 44), Parent = buttons, OnClick = function()
		if trade then
			State.Request("TradeReady", not trade.Mine.Ready)
		end
	end })
	Lib.button({ Text = "✕ Cancel", Color = T.Red, Size = UDim2.fromOffset(150, 44), Parent = buttons, OnClick = function()
		State.Request("TradeCancel")
	end })

	Remotes.TradeUpdate.OnClientEvent:Connect(function(view, reason)
		local wasTrading = trade ~= nil
		trade = view or nil
		if view and not wasTrading then
			Windows.Open("Trade")
		end
		if not view and reason and Windows.IsOpen("Trade") then
			Windows.Close()
		end
		refresh()
	end)
	State.FullChanged.Event:Connect(function()
		if isOpen and trade then
			refreshPicker()
		end
	end)
	Players.PlayerAdded:Connect(function()
		if isOpen and not trade then
			refreshLobby()
		end
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(function()
			if isOpen and not trade then
				refreshLobby()
			end
		end)
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			if trade and trade.Status == "Confirming" then
				local left = math.max(0, trade.CountdownEnd - State.Now())
				countdown.Text = ("Trading in %.1fs..."):format(left)
			elseif countdown then
				countdown.Text = ""
			end
		end
	end)
end

function Trade.OnOpen()
	isOpen = true
	refresh()
end

function Trade.OnClose()
	isOpen = false
	if trade then
		-- closing the window cancels the trade so nobody gets stuck
		State.Ask("TradeCancel")
	end
end

return Trade
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">Windows</string><ProtectedString name="Source"><![CDATA[-- Windows.lua
-- Window manager: one menu open at a time, animated open/close, shared
-- title bar and close button. Each window module implements:
--   Build(content: Frame, api)  -- called once
--   OnOpen(arg)?                -- every time it opens
--   OnClose()?                  -- every time it closes

local TweenService = game:GetService("TweenService")

local Lib = require(script.Parent.Lib)
local Sound = require(script.Parent.Parent.Controllers.Sound)

local T = Lib.Theme
local new = Lib.new

local Windows = {}
Windows.Registry = {}
Windows.Current = nil :: string?
Windows.Changed = Instance.new("BindableEvent")

local gui: ScreenGui
local dim: Frame

function Windows.Register(name: string, module, opts)
	opts = opts or {}
	local frame = Lib.panel({
		Name = name .. "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = opts.Size or UDim2.fromScale(0.74, 0.8),
		BackgroundColor3 = T.Bg,
		Visible = false,
		ZIndex = 10,
		Radius = 18,
		Parent = gui,
	})
	new("UISizeConstraint", { MaxSize = opts.MaxSize or Vector2.new(920, 640), MinSize = Vector2.new(300, 260), Parent = frame })
	Lib.stroke(opts.Color or T.Accent, 3).Parent = frame
	local scale = new("UIScale", { Parent = frame })

	local header = Lib.panel({
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = opts.Color or T.Accent,
		Radius = 18,
		ZIndex = 11,
		Parent = frame,
	})
	Lib.gradient(Color3.new(1, 1, 1), Color3.fromRGB(180, 180, 180)).Parent = header
	-- square off the header's bottom corners
	new("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 1, -18),
		BackgroundColor3 = opts.Color or T.Accent,
		BorderSizePixel = 0,
		ZIndex = 11,
		Parent = header,
	}, { Lib.gradient(Color3.fromRGB(200, 200, 200), Color3.fromRGB(180, 180, 180)) })
	local title = Lib.label({
		Size = UDim2.new(1, -120, 1, -12),
		Position = UDim2.fromOffset(18, 6),
		Font = T.Title,
		Text = (opts.Icon or "") .. "  " .. (opts.Title or name),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 12,
		Parent = header,
		MaxText = 30,
	})
	Lib.textStroke(2).Parent = title
	Lib.button({
		Name = "Close",
		Text = "✕",
		Color = T.Red,
		Size = UDim2.fromOffset(42, 38),
		Position = UDim2.new(1, -10, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		ZIndex = 13,
		Parent = header,
		OnClick = function()
			Windows.Close()
		end,
	})
	local content = new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 62),
		Size = UDim2.new(1, -28, 1, -74),
		ZIndex = 11,
		Parent = frame,
	})
	local entry = { Name = name, Frame = frame, Scale = scale, Module = module, Content = content, Title = title }
	Windows.Registry[name] = entry
	module.Build(content, Windows)
	return entry
end

function Windows.IsOpen(name: string): boolean
	return Windows.Current == name
end

function Windows.Open(name: string, arg: any?)
	local entry = Windows.Registry[name]
	if not entry then
		return
	end
	if Windows.Current and Windows.Current ~= name then
		Windows.Close(true)
	end
	Windows.Current = name
	entry.Frame.Visible = true
	dim.Visible = true
	entry.Scale.Scale = 0.7
	TweenService:Create(entry.Scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	Sound.Play("Hover", 0.5)
	-- console: give the gamepad a selected button so menus are navigable
	local UserInputService = game:GetService("UserInputService")
	if UserInputService.GamepadEnabled then
		local close = entry.Frame:FindFirstChild("Header") and entry.Frame.Header:FindFirstChild("Close")
		if close then
			game:GetService("GuiService").SelectedObject = close
		end
	end
	if entry.Module.OnOpen then
		task.spawn(entry.Module.OnOpen, arg)
	end
	Windows.Changed:Fire(name)
end

function Windows.Close(instant: boolean?)
	local name = Windows.Current
	if not name then
		return
	end
	local entry = Windows.Registry[name]
	Windows.Current = nil
	if entry.Module.OnClose then
		task.spawn(entry.Module.OnClose)
	end
	if instant then
		entry.Frame.Visible = false
	else
		local tw = TweenService:Create(entry.Scale, TweenInfo.new(0.15), { Scale = 0.7 })
		tw:Play()
		tw.Completed:Once(function()
			if Windows.Current ~= name then
				entry.Frame.Visible = false
			end
		end)
	end
	dim.Visible = false
	if game:GetService("GuiService").SelectedObject and game:GetService("GuiService").SelectedObject:IsDescendantOf(entry.Frame) then
		game:GetService("GuiService").SelectedObject = nil
	end
	Windows.Changed:Fire(nil)
end

function Windows.Toggle(name: string, arg: any?)
	if Windows.Current == name then
		Windows.Close()
	else
		Windows.Open(name, arg)
	end
end

function Windows.Init(parentGui: ScreenGui)
	gui = parentGui
	dim = new("TextButton", {
		Name = "Dim",
		Size = UDim2.fromScale(1, 1),
